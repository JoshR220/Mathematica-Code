Cell[CellGroupData[{

Cell["3 Simulate cooling", "Chapter",
 CellChangeTimes->{{3.82176573707802*^9, 3.821765755056943*^9}, {
  3.821766182115901*^9, 3.8217661876982403`*^9}, {3.8217663204082403`*^9, 
  3.8217663473143063`*^9}, {3.8217664673784313`*^9, 
  3.821766472833169*^9}},ExpressionUUID->"cb5db831-ef1e-4149-8d31-\
d69c892fb051"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["3.1 Base functions", "Section",
 FontSize->24]], "Section",
 CellChangeTimes->{{3.8217660294858932`*^9, 3.821766045718274*^9}, 
   3.821766127869479*^9, {3.821766192909049*^9, 3.821766195875162*^9}, {
   3.8217663290470343`*^9, 
   3.821766359906027*^9}},ExpressionUUID->"b634f2df-f3a6-4043-addb-\
6b62abb11600"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"PDFfunct", "[", 
    RowBox[{"xd_", ",", "Cnmd_", ",", "a1d_", ",", "rngd_"}], "]"}], ":=", 
   RowBox[{"Piecewise", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"Cnmd", "[", 
           RowBox[{"[", 
            RowBox[{"i", "+", "1"}], "]"}], "]"}], "]"}], "^", "2"}], ",", 
        RowBox[{"xd", "\[Equal]", "i"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "0", ",", 
        RowBox[{"a1d", "+", "rngd"}]}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"heat", "[", "state_", "]"}], ":=", 
    RowBox[{"state", "-", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"state", "-", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], ",", 
         RowBox[{
          RowBox[{"#", ">", "0"}], "&"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", "0"}], "]"}]}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rmmSimulate", "[", 
   RowBox[{"state_", ",", "empty_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a1", ",", "a2", ",", 
      RowBox[{"g1", "=", 
       RowBox[{"state", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], ",", "a1ind", ",", "a2ind", ",", 
      "rng", ",", "rng1", ",", "ics", ",", "nval", ",", "Vnm", ",", "ln", ",",
       "vn", ",", "Cnm", ",", "randN", ",", "tmix", ",", 
      RowBox[{"newstate", "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}]}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"a1", "=", 
      RowBox[{"Abs", "[", 
       RowBox[{"Min", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"resDir", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", 
            RowBox[{"resDir", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ",", 
           RowBox[{"-", "1"}], ",", "1"}], "]"}], "*", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"state", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"state", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "*", 
         RowBox[{"resDir", "[", 
          RowBox[{"[", 
           RowBox[{";;", "2"}], "]"}], "]"}]}], "]"}], "]"}]}], ";", 
     RowBox[{"a1ind", "=", 
      RowBox[{
       RowBox[{"Position", "[", 
        RowBox[{"state", ",", "a1"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"a2", "=", 
      RowBox[{"Abs", "[", 
       RowBox[{"Max", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"resDir", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", 
            RowBox[{"resDir", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ",", 
           RowBox[{"-", "1"}], ",", "1"}], "]"}], "*", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"state", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"state", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "*", 
         RowBox[{"resDir", "[", 
          RowBox[{"[", 
           RowBox[{";;", "2"}], "]"}], "]"}]}], "]"}], "]"}]}], ";", 
     RowBox[{"a2ind", "=", 
      RowBox[{
       RowBox[{"Position", "[", 
        RowBox[{"state", ",", "a2"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rng", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"resDir", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", 
         RowBox[{"resDir", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ",", "g1", ",", 
        RowBox[{"Min", "[", 
         RowBox[{"a2", ",", "g1"}], "]"}]}], "]"}]}], ";", 
     RowBox[{"rng1", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"resDir", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", 
         RowBox[{"resDir", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ",", "a2", ",", 
        RowBox[{"Max", "[", 
         RowBox[{"a2", ",", "g1"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ics", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", 
        RowBox[{"a1", "+", "rng", "+", "1"}]}], "]"}]}], ";", 
     RowBox[{
      RowBox[{"ics", "[", 
       RowBox[{"[", 
        RowBox[{"g1", "+", "1", "-", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"resDir", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", 
            RowBox[{"resDir", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ",", "0", ",", 
           RowBox[{"Abs", "[", 
            RowBox[{"a1", "-", "rng1"}], "]"}]}], "]"}]}], "]"}], "]"}], "=", 
      "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"nval", "=", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"Reverse", "[", 
         RowBox[{"Range", "[", 
          RowBox[{"a1", "+", "rng"}], "]"}], "]"}], "*", 
        RowBox[{"Range", "[", 
         RowBox[{"a1", "+", "rng"}], "]"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"resDir", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", 
             RowBox[{"resDir", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], ",", 
            RowBox[{"Reverse", "[", 
             RowBox[{"Range", "[", 
              RowBox[{"a1", "+", "rng"}], "]"}], "]"}], ",", 
            RowBox[{"Range", "[", 
             RowBox[{"a1", "+", "rng"}], "]"}]}], "]"}], "+", 
          RowBox[{"Abs", "[", 
           RowBox[{"a1", "-", "rng1"}], "]"}]}], ")"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Vnm", "=", 
      RowBox[{
       RowBox[{"-", "I"}], "*", "Vnm0", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"DiagonalMatrix", "[", 
          RowBox[{"nval", ",", "1"}], "]"}], "+", 
         RowBox[{"DiagonalMatrix", "[", 
          RowBox[{"nval", ",", 
           RowBox[{"-", "1"}]}], "]"}]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ln", "=", 
      RowBox[{"N", "[", 
       RowBox[{"Eigenvalues", "[", "Vnm", "]"}], "]"}]}], ";", 
     RowBox[{"vn", "=", 
      RowBox[{"N", "[", 
       RowBox[{"Eigenvectors", "[", "Vnm", "]"}], "]"}]}], ";", 
     RowBox[{"vn", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Normalize", "[", 
         RowBox[{"vn", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"a1", "+", "rng", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tmix", "=", 
      RowBox[{"RandomReal", "[", 
       RowBox[{"{", 
        RowBox[{"1.*^-3", ",", "1*^-2"}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Cnm", "=", 
      RowBox[{
       RowBox[{"Chop", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Inverse", "[", 
              RowBox[{"Transpose", "[", "vn", "]"}], "]"}], ".", "ics"}], 
            ")"}], "*", 
           RowBox[{"Exp", "[", 
            RowBox[{"ln", "*", "tmix"}], "]"}]}], ")"}], ".", "vn"}], "]"}], "//",
        "FullSimplify"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"randN", "=", 
      RowBox[{"RandomVariate", "[", 
       RowBox[{"ProbabilityDistribution", "[", 
        RowBox[{
         RowBox[{"PDFfunct", "[", 
          RowBox[{"x", ",", "Cnm", ",", "a1", ",", "rng"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", 
           RowBox[{"a1", "+", "rng"}], ",", "1"}], "}"}]}], "]"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"newstate", "[", 
       RowBox[{"[", "a1ind", "]"}], "]"}], "=", 
      RowBox[{"a1", "+", "rng", "-", "randN"}]}], ";", 
     RowBox[{
      RowBox[{"newstate", "[", 
       RowBox[{"[", "a2ind", "]"}], "]"}], "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"resDir", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "==", 
         RowBox[{"resDir", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ",", 
        RowBox[{"a1", "+", "rng", "+", 
         RowBox[{"Abs", "[", 
          RowBox[{"a1", "-", "rng1"}], "]"}], "-", "randN"}], ",", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"g1", ">", "a2"}], ",", "randN", ",", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"a1", "-", "rng1"}], "]"}], "+", "randN"}]}], "]"}]}], 
       "]"}]}], ";", 
     RowBox[{
      RowBox[{"newstate", "[", 
       RowBox[{"[", "3", "]"}], "]"}], "=", 
      RowBox[{"randN", "+", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"resDir", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "\[NotEqual]", 
           RowBox[{"resDir", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "&&", 
          RowBox[{"g1", ">", "a2"}]}], ",", 
         RowBox[{"Abs", "[", 
          RowBox[{"a1", "-", "rng1"}], "]"}], ",", "0"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"heat", "[", "newstate", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 CellChangeTimes->{
  3.8217661372951927`*^9, 3.8217662014441023`*^9, {3.821766365335183*^9, 
   3.8217663666051197`*^9}},
 CellLabel->
  "In[2327]:=",ExpressionUUID->"9531c012-6e05-44da-86a6-dada427de082"]
}, Open  ]],

