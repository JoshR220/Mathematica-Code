Cell[CellGroupData[{

Cell["2 Get evolution of state", "Chapter",
 CellChangeTimes->{{3.82176573707802*^9, 3.821765755056943*^9}, {
  3.821766182115901*^9, 3.8217661876982403`*^9}, {3.8217663204082403`*^9, 
  3.821766321555135*^9}},ExpressionUUID->"3320d799-707b-4288-bcea-\
8fcb33531b49"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["2.1 Calculate interaction matrix", "Section",
 FontSize->24]], "Section",
 CellChangeTimes->{{3.8217660294858932`*^9, 3.821766045718274*^9}, 
   3.821766127869479*^9, {3.821766192909049*^9, 3.821766195875162*^9}, {
   3.8217663290470343`*^9, 
   3.821766330371011*^9}},ExpressionUUID->"e3737d35-35be-48a1-8e38-\
8d12b7532d42"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nx", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}]}], ";", 
  RowBox[{"nz", "=", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}]}], ";", 
  RowBox[{"(*", 
   RowBox[{"Enter", " ", "initial", " ", "mode", " ", "populations"}], "*)"}],
   "\[IndentingNewLine]", 
  RowBox[{"resModes", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "1"}], "}"}]}], ";", 
  RowBox[{"(*", 
   RowBox[{"Enter", " ", "resonance", " ", "modes"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"resDir", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "1"}], ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}]}], ";", 
  RowBox[{"(*", 
   RowBox[{"Enter", " ", "resonance", " ", "directions"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"Vnm0", "=", "20000"}], ";", 
  RowBox[{"(*", 
   RowBox[{
   "Enter", " ", "base", " ", "coupling", " ", "strength", " ", "here"}], 
   "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"a1", "=", 
   RowBox[{"Abs", "[", 
    RowBox[{"Min", "[", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"resDir", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", 
         RowBox[{"resDir", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ",", 
        RowBox[{"-", "1"}], ",", "1"}], "]"}], "*", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"nx", "[", 
         RowBox[{"[", 
          RowBox[{"resModes", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], ",", 
        RowBox[{"nx", "[", 
         RowBox[{"[", 
          RowBox[{"resModes", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}]}], "}"}], "*", 
      RowBox[{"resDir", "[", 
       RowBox[{"[", 
        RowBox[{";;", "2"}], "]"}], "]"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a2", "=", 
   RowBox[{"Abs", "[", 
    RowBox[{"Max", "[", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"resDir", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", 
         RowBox[{"resDir", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ",", 
        RowBox[{"-", "1"}], ",", "1"}], "]"}], "*", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"nx", "[", 
         RowBox[{"[", 
          RowBox[{"resModes", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], ",", 
        RowBox[{"nx", "[", 
         RowBox[{"[", 
          RowBox[{"resModes", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}]}], "}"}], "*", 
      RowBox[{"resDir", "[", 
       RowBox[{"[", 
        RowBox[{";;", "2"}], "]"}], "]"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g1", "=", 
   RowBox[{"nz", "[", 
    RowBox[{"[", 
     RowBox[{"resModes", "[", 
      RowBox[{"[", "3", "]"}], "]"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rng", "=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"resDir", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", 
      RowBox[{"resDir", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ",", "g1", ",", 
     RowBox[{"Min", "[", 
      RowBox[{"a2", ",", "g1"}], "]"}]}], "]"}]}], ";", 
  RowBox[{"rng1", "=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"resDir", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", 
      RowBox[{"resDir", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ",", "a2", ",", 
     RowBox[{"Max", "[", 
      RowBox[{"a2", ",", "g1"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ics", "=", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{"0", ",", 
      RowBox[{"a1", "+", "rng", "+", "1"}]}], "]"}]}], ";", 
   RowBox[{
    RowBox[{"ics", "[", 
     RowBox[{"[", 
      RowBox[{"g1", "+", "1", "-", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"resDir", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", 
          RowBox[{"resDir", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ",", "0", ",", 
         RowBox[{"Abs", "[", 
          RowBox[{"a1", "-", "rng1"}], "]"}]}], "]"}]}], "]"}], "]"}], "=", 
    "1"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nval", "=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{"Reverse", "[", 
      RowBox[{"Range", "[", 
       RowBox[{"a1", "+", "rng"}], "]"}], "]"}], "*", 
     RowBox[{"Range", "[", 
      RowBox[{"a1", "+", "rng"}], "]"}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"resDir", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", 
          RowBox[{"resDir", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ",", 
         RowBox[{"Reverse", "[", 
          RowBox[{"Range", "[", 
           RowBox[{"a1", "+", "rng"}], "]"}], "]"}], ",", 
         RowBox[{"Range", "[", 
          RowBox[{"a1", "+", "rng"}], "]"}]}], "]"}], "+", 
       RowBox[{"Abs", "[", 
        RowBox[{"a1", "-", "rng1"}], "]"}]}], ")"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Vnm", "=", 
   RowBox[{
    RowBox[{"-", "I"}], "*", "Vnm0", "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{"nval", ",", "1"}], "]"}], "+", 
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{"nval", ",", 
        RowBox[{"-", "1"}]}], "]"}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ln", "=", 
    RowBox[{"N", "[", 
     RowBox[{"Eigenvalues", "[", "Vnm", "]"}], "]"}]}], ";", 
   RowBox[{"vn", "=", 
    RowBox[{"N", "[", 
     RowBox[{"Eigenvectors", "[", "Vnm", "]"}], "]"}]}], ";", 
   RowBox[{"vn", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Normalize", "[", 
       RowBox[{"vn", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"a1", "+", "rng", "+", "1"}]}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Cnm", "=", 
   RowBox[{
    RowBox[{"Chop", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Inverse", "[", 
           RowBox[{"Transpose", "[", "vn", "]"}], "]"}], ".", "ics"}], ")"}], 
        "*", 
        RowBox[{"Exp", "[", 
         RowBox[{"ln", "*", "t"}], "]"}]}], ")"}], ".", "vn"}], "]"}], "//", 
    "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", 
      RowBox[{"a1", "+", "rng"}]}], "]"}], ",", 
    RowBox[{"Reverse", "[", 
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", 
       RowBox[{"a1", "+", "rng"}]}], "]"}], "]"}], ",", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"resDir", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", 
        RowBox[{"resDir", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ",", 
       RowBox[{"Reverse", "[", 
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", 
          RowBox[{"a1", "+", "rng"}]}], "]"}], "]"}], ",", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", 
         RowBox[{"a1", "+", "rng"}]}], "]"}]}], "]"}], "+", 
     RowBox[{"Abs", "[", 
      RowBox[{"a1", "-", "rng1"}], "]"}]}]}], "}"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nAvg", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", "Cnm", "]"}], "^", "2"}], "*", 
       RowBox[{"%", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "3"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{3.8217661372951927`*^9, 3.8217662014441023`*^9, 
  3.821766414791007*^9},
 CellLabel->
  "In[2314]:=",ExpressionUUID->"75508ee6-3562-4342-8bd8-8501c0993844"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["2.2 Plot state populations", "Section",
 FontSize->24]], "Section",
 CellChangeTimes->{{3.8217660294858932`*^9, 3.821766045718274*^9}, 
   3.821766127869479*^9, {3.821766192909049*^9, 3.821766195875162*^9}, {
   3.8217663290470343`*^9, 3.821766330371011*^9}, {3.821766434033389*^9, 
   3.821766439481326*^9}},ExpressionUUID->"34717a2b-0556-417b-8765-\
7fa0f86d2841"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"tmax", "=", 
   RowBox[{"6", "*", "2", "*", 
    RowBox[{"Pi", "/", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", "ln", "]"}], "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"Cnm", "[", 
         RowBox[{"[", "]"}], "]"}], "]"}], "^", "2"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", 
     RowBox[{"PlotLegends", "\[Rule]", "Automatic"}], ",", 
     RowBox[{"ImageSize", "\[Rule]", "Large"}], ",", 
     RowBox[{"Frame", "\[Rule]", "True"}], ",", 
     RowBox[{"PlotLabel", "\[Rule]", "\"\<State Evolution\>\""}], ",", 
     RowBox[{"FrameLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<Time (s)\>\"", ",", "\"\<State Population\>\""}], "}"}]}],
      ",", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "tmax"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}]}], "]"}], ",", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", "nAvg", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", 
     RowBox[{"PlotLegends", "\[Rule]", "Automatic"}], ",", 
     RowBox[{"ImageSize", "\[Rule]", "Large"}], ",", 
     RowBox[{"Frame", "\[Rule]", "True"}], ",", 
     RowBox[{"PlotLabel", "\[Rule]", "\"\<Average Mode Population\>\""}], ",", 
     RowBox[{"FrameLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<Time (s)\>\"", ",", "\"\<Phonon Number\>\""}], "}"}]}]}], 
    "]"}]}], "}"}]}], "Input",
 CellChangeTimes->{
  3.8217661372951927`*^9, 3.8217662014441023`*^9, {3.821766414791007*^9, 
   3.821766444053265*^9}},
