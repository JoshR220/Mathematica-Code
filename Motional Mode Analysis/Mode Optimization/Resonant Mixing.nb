Cell[BoxData[{
 RowBox[{
  RowBox[{"iterations", "=", "20"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"system", "=", 
   RowBox[{"FoldList", "[", 
    RowBox[{"rmmSimulate", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"nx", "[", 
        RowBox[{"[", 
         RowBox[{"resModes", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], ",", 
       RowBox[{"nx", "[", 
        RowBox[{"[", 
         RowBox[{"resModes", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], ",", 
       RowBox[{"nz", "[", 
        RowBox[{"[", 
         RowBox[{"resModes", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"Range", "[", "iterations", "]"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{
  3.8217661372951927`*^9, 3.8217662014441023`*^9, {3.821766365335183*^9, 
   3.821766388609337*^9}},
 CellLabel->
