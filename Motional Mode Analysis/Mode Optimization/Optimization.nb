        RowBox[{"ImageSize", "\[Rule]", "Medium"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "Num"}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
    
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"Evaluate", "@", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"vRatx", "[", 
               RowBox[{
               "V0", ",", "x2", ",", "U", ",", "x1", ",", "r0", ",", "z0"}], 
               "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "j"}], "]"}], "]"}], "]"}], "//", 
            "FullSimplify"}], ",", 
           RowBox[{"{", 
            RowBox[{"x1", ",", "wmin", ",", "wmax", ",", "wstep"}], "}"}], 
