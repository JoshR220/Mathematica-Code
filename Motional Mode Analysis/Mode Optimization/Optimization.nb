   3.821767365907434*^9}},ExpressionUUID->"0bce2c6c-18ef-4c64-a751-\
0edd361d54c2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"V0", ",", "V1", ",", "U", ",", "w", ",", "r0", ",", "z0"}], 
    "}"}], "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"V0", ",", "V1", ",", "U", ",", "w", ",", "r0", ",", "z0"}], 
     "}"}], "/.", "solnsDJ"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"V0range", "=", "150"}], ";", 
   RowBox[{"V0step", "=", "30"}], ";", 
   RowBox[{"wmin", "=", "10"}], ";", 
   RowBox[{"wmax", "=", "40"}], ";", 
   RowBox[{"wstep", "=", "4"}], ";", 
   RowBox[{"Umin", "=", "0"}], ";", 
   RowBox[{"Umax", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"4.059*^-27", "*", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"V0", "/", "w"}], ")"}], "^", "2"}], "/", "m0"}]}], "+", 
       "V1"}], ")"}], "*", 
     RowBox[{"2", "/", "3"}]}]}], ";", 
   RowBox[{"Ustep", "=", "1"}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Enter", " ", "range", " ", "and", " ", "step", " ", "for", " ", "V0"}], 
    ",", " ", "U", ",", " ", 
    RowBox[{"and", " ", "w", " ", 
     RowBox[{"(", 
      RowBox[{
      "w", " ", "is", " ", "in", " ", "units", " ", "of", " ", "2", "pi", " ",
        "MHz"}], ")"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"xmin", "=", "0"}], ";", 
   RowBox[{"xmax", "=", "V1max"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"Evaluate", "@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"qrmsRatx", "[", 
           RowBox[{
           "x1", ",", "V1", ",", "x2", ",", "w", ",", "r0", ",", "z0"}], 
           "]"}], "//", "FullSimplify"}], ",", 
         RowBox[{"{", 
          RowBox[{"x1", ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"V0", "\[LessEqual]", "V0range"}], ",", "0", ",", 
             RowBox[{"V0", "-", "V0range"}]}], "]"}], ",", 
           RowBox[{"V0", "+", "V0range"}], ",", "V0step"}], "}"}]}], "]"}]}], 
      ",", 
      RowBox[{"{", 
       RowBox[{"x2", ",", "xmin", ",", "xmax"}], "}"}], ",", 
      RowBox[{"PlotLegends", "\[Rule]", 
       RowBox[{"LineLegend", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"ConstantArray", "[", 
             RowBox[{"i", ",", 
              RowBox[{"Num", "-", "1"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"V0", "\[LessEqual]", "V0range"}], ",", "0", ",", 
                RowBox[{"V0", "-", "V0range"}]}], "]"}], ",", 
              RowBox[{"V0", "+", "V0range"}], ",", "V0step"}], "}"}]}], "]"}],
           "]"}], ",", 
         RowBox[{"LegendLabel", "\[Rule]", "\"\<Driving Voltage (V0)\>\""}]}],
