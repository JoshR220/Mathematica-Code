Cell[TextData[StyleBox["3.3 Plot ratios for position fluctuation - U", \
"Section",
 FontSize->24]], "Section",
 CellChangeTimes->{{3.8217660294858932`*^9, 3.821766045718274*^9}, 
   3.821766127869479*^9, {3.821766192909049*^9, 3.821766195875162*^9}, {
   3.8217663290470343`*^9, 3.821766381441923*^9}, {3.821766905103161*^9, 
   3.8217669062543707`*^9}, {3.82176729544445*^9, 3.821767296988393*^9}, {
