                    RowBox[{
                    RowBox[{"-", "I"}], "*", "t", "*", "wmhz", "*", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"wmvals", "[", 
                    RowBox[{"[", 
                    RowBox[{"3", ",", "k"}], "]"}], "]"}], "+", 
                    RowBox[{"wmvals", "[", 
                    RowBox[{"[", 
                    RowBox[{"d", ",", "j"}], "]"}], "]"}]}], ")"}]}], 
                    "]"}]}]}], ")"}], "/", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"wmvals", "[", 
                    RowBox[{"[", 
                    RowBox[{"d", ",", "i"}], "]"}], "]"}], "^", "2"}], "-", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"wmvals", "[", 
                    RowBox[{"[", 
                    RowBox[{"3", ",", "k"}], "]"}], "]"}], "+", 
                    RowBox[{"wmvals", "[", 
                    RowBox[{"[", 
                    RowBox[{"d", ",", "j"}], "]"}], "]"}]}], ")"}], "^", 
                   "2"}]}], ")"}]}], "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"\[Eta]0", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "3", ",", "k"}], "]"}], "]"}], "*", 
                    RowBox[{"\[Eta]0", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ",", "d", ",", "j"}], "]"}], "]"}]}], ")"}], 
                   "*", 
                   RowBox[{"Exp", "[", 
                    RowBox[{"I", "*", "t", "*", "wmhz", "*", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"wmvals", "[", 
                    RowBox[{"[", 
                    RowBox[{"3", ",", "k"}], "]"}], "]"}], "-", 
                    RowBox[{"wmvals", "[", 
                    RowBox[{"[", 
                    RowBox[{"d", ",", "j"}], "]"}], "]"}]}], ")"}]}], "]"}]}],
                   "+", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"\[Eta]0", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ",", "3", ",", "k"}], "]"}], "]"}], "*", 
                    RowBox[{"\[Eta]0", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "d", ",", "j"}], "]"}], "]"}]}], ")"}], 
                   "*", 
                   RowBox[{"Exp", "[", 
                    RowBox[{
                    RowBox[{"-", "I"}], "*", "t", "*", "wmhz", "*", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"wmvals", "[", 
                    RowBox[{"[", 
                    RowBox[{"3", ",", "k"}], "]"}], "]"}], "-", 
                    RowBox[{"wmvals", "[", 
                    RowBox[{"[", 
                    RowBox[{"d", ",", "j"}], "]"}], "]"}]}], ")"}]}], 
                    "]"}]}]}], ")"}], "/", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"wmvals", "[", 
                    RowBox[{"[", 
