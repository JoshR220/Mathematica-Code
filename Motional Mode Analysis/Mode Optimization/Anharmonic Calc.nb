  RowBox[{
   RowBox[{
    RowBox[{"wmvalsRDX", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"wmvals", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{"wmvals", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], "}"}]}], ";", 
    RowBox[{"gimRDX", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"gim", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{"gim", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"cmnp", "[", 
      RowBox[{"i_", ",", "j_", ",", "k_"}], "]"}], ":=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"i", ",", "j"}], "]"}], "-", 
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"di", ",", "j"}], "]"}]}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"i", ",", "k"}], "]"}], "-", 
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"di", ",", "k"}], "]"}]}], ")"}], "*", 
        RowBox[{"Sign", "[", 
         RowBox[{"di", "-", "i"}], "]"}], "*", 
        RowBox[{"L0Mn", "[", 
         RowBox[{"i", ",", "di", ",", 
          RowBox[{"-", "4"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"di", ",", "Num"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ah", "=", 
     RowBox[{"Array", "[", 
      RowBox[{"aop", ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "Num"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"DefineOperatorOnKets", "[", 
       RowBox[{
        RowBox[{"aop", "[", 
         RowBox[{"d", ",", "i"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          TagBox[
