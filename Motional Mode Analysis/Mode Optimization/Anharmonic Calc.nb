Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"perturbation", " ", "coefficients"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"cmnp", "[", 
      RowBox[{"i_", ",", "j_", ",", "k_"}], "]"}], ":=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"i", ",", "j"}], "]"}], "-", 
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"di", ",", "j"}], "]"}]}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"i", ",", "k"}], "]"}], "-", 
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"di", ",", "k"}], "]"}]}], ")"}], "*", 
        RowBox[{"Sign", "[", 
         RowBox[{"di", "-", "i"}], "]"}], "*", 
        RowBox[{"L0Mn", "[", 
         RowBox[{"i", ",", "di", ",", 
          RowBox[{"-", "4"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"di", ",", "Num"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Dijk", "[", 
      RowBox[{"d_", ",", "i_", ",", "j_", ",", "k_"}], "]"}], ":=", 
     RowBox[{"0.5", "*", 
      RowBox[{"ke2", "/", 
       RowBox[{"l0", "^", "4"}]}], "*", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"cmnp", "[", 
           RowBox[{"id", ",", "jd", ",", "kd"}], "]"}], "/", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{"m", "[", 
             RowBox[{"[", "id", "]"}], "]"}], "*", 
            RowBox[{"m", "[", 
             RowBox[{"[", "jd", "]"}], "]"}], "*", 
            RowBox[{"m", "[", 
             RowBox[{"[", "kd", "]"}], "]"}]}], "]"}]}], "*", 
         RowBox[{"gimmw", "[", 
          RowBox[{"[", 
           RowBox[{"3", ",", "id", ",", "i"}], "]"}], "]"}], "*", 
         RowBox[{"gimmw", "[", 
          RowBox[{"[", 
           RowBox[{"d", ",", "jd", ",", "j"}], "]"}], "]"}], "*", 
         RowBox[{"gimmw", "[", 
          RowBox[{"[", 
           RowBox[{"d", ",", "kd", ",", "k"}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"id", ",", "Num"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"jd", ",", "Num"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"kd", ",", "Num"}], "}"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"oVect", "[", 
      RowBox[{"d_", ",", "i_", ",", "\[Eta]0_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Eta]0", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "d", ",", "i"}], "]"}], "]"}], "*", 
       RowBox[{"Exp", "[", 
        RowBox[{"I", "*", "t", "*", "wmhz", "*", 
         RowBox[{"wmvals", "[", 
          RowBox[{"[", 
           RowBox[{"d", ",", "i"}], "]"}], "]"}]}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"\[Eta]0", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", "d", ",", "i"}], "]"}], "]"}], "*", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "I"}], "*", "t", "*", "wmhz", "*", 
         RowBox[{"wmvals", "[", 
          RowBox[{"[", 
           RowBox[{"d", ",", "i"}], "]"}], "]"}]}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"petVect", "[", 
      RowBox[{"d_", ",", "i_", ",", "\[Eta]0_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"3", "*", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Dijk", "[", 
            RowBox[{"d", ",", "i", ",", "j", ",", "k"}], "]"}], "/", 
           RowBox[{"wmhz", "^", "2"}]}], "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"d", "\[Equal]", "1"}], ",", "2", ",", 
               RowBox[{"-", "1"}]}], "]"}], "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"\[Eta]0", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "3", ",", "k"}], "]"}], "]"}], "*", 
                    RowBox[{"\[Eta]0", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "d", ",", "j"}], "]"}], "]"}]}], ")"}], 
                   "*", 
                   RowBox[{"Exp", "[", 
                    RowBox[{"I", "*", "t", "*", "wmhz", "*", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"wmvals", "[", 
                    RowBox[{"[", 
                    RowBox[{"3", ",", "k"}], "]"}], "]"}], "+", 
