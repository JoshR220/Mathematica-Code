            RowBox[{"\[VerticalSeparator]", 
             TagBox[
              SubscriptBox[
               RowBox[{"(", 
                RowBox[{"n", "-", "1"}], ")"}], 
               OverscriptBox[
                RowBox[{"i", "+", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"d", "-", "1"}], ")"}], "*", "Num"}]}], "^"]],
              Quantum`Notation`zz080KetArgs,
              BaseStyle->{ShowSyntaxStyles -> True},
              Editable->True,
              Selectable->True], "\[RightAngleBracket]"}],
            Quantum`Notation`zz080Ket,
            BaseStyle->{ShowSyntaxStyles -> False},
            Editable->False,
            Selectable->False]}]}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"d", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "Num"}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"DefineOperatorOnKets", "[", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"aop", "[", 
           RowBox[{"d", ",", "i"}], "]"}], ")"}], "\[Dagger]"], ",", 
        RowBox[{"{", 
         RowBox[{
          TagBox[
           RowBox[{"\[VerticalSeparator]", 
            TagBox[
             SubscriptBox["n_", 
              OverscriptBox[
               RowBox[{"i", "+", 
                RowBox[{
                 RowBox[{"(", 
