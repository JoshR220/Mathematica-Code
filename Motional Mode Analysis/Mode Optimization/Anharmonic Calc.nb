   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"0.5", "*", 
       RowBox[{"ke2", "/", 
        RowBox[{"l0", "^", "4"}]}]}], ")"}], "*", 
     RowBox[{"Sum", "[", 
      RowBox[{
