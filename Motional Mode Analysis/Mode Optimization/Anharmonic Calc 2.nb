   3.825479602187647*^9}},ExpressionUUID->"20c40907-5d47-4cac-b605-\
241d7557cd77"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"z0M", " ", "=", " ", 
   RowBox[{"Array", "[", 
    RowBox[{"z0", ",", "Num"}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"L0EQ", " ", "[", "i_", "]"}], ":=", 
   RowBox[{
    RowBox[{"z0M", "[", 
     RowBox[{"[", "i", "]"}], "]"}], "\[Equal]", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"z0M", "[", 
            RowBox[{"[", "i", "]"}], "]"}], " ", "-", " ", 
           RowBox[{"z0M", "[", 
            RowBox[{"[", "k", "]"}], "]"}]}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{"-", "2"}], ")"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", 
          RowBox[{"i", "-", "1"}]}], "}"}]}], "]"}], " ", "-", " ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"z0M", "[", 
            RowBox[{"[", "i", "]"}], "]"}], " ", "-", " ", 
           RowBox[{"z0M", "[", 
            RowBox[{"[", "k", "]"}], "]"}]}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{"-", "2"}], ")"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", 
          RowBox[{"i", "+", "1"}], ",", "Num"}], "}"}]}], "]"}]}], 
     ")"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L0EQlist", " ", "=", 
   RowBox[{
    RowBox[{"L0EQ", "/@", 
     RowBox[{"Range", "[", "Num", "]"}]}], "//", "FullSimplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"guessz0", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{"-", "#"}], ",", "#", ",", 
       RowBox[{"2", "*", 
        RowBox[{"#", "/", 
         RowBox[{"(", 
          RowBox[{"Num", "-", "1"}], ")"}]}]}]}], "]"}], "&"}], "[", 
    RowBox[{"0.7", "*", 
     RowBox[{"Num", "^", 
      RowBox[{"(", 
       RowBox[{"2", "/", "3"}], ")"}]}]}], "]"}]}], ";", 
  RowBox[{"pos", "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"Append", "[", 
     RowBox[{
      RowBox[{"{", "z0M", "}"}], ",", "guessz0"}], "]"}], "]"}]}], ";", 
  RowBox[{"z0M", "=", 
   RowBox[{"z0M", "/.", 
    RowBox[{"Chop", "[", 
     RowBox[{"FindRoot", "[", 
      RowBox[{"L0EQlist", ",", "pos"}], "]"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L0Mn", "[", 
   RowBox[{"i_", ",", "j_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"i", "==", "j"}], ",", "0", ",", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"z0M", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "-", 
       RowBox[{"z0M", "[", 
        RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "^", "n"}]}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{
