Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"subbing", " ", "in", " ", "mass"}], " ", "&"}], " ", "secular", 
    " ", "frequency", " ", "values"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"m0", "=", 
     RowBox[{"138", "*", "1.66054*^-27"}]}], ";", 
    RowBox[{"m1hold", "=", 
     RowBox[{"171", "*", "1.66054*^-27"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"V0", "=", "100.0"}], ";", 
    RowBox[{"V1", "=", "0"}], ";", 
    RowBox[{"U", "=", "1.488"}], ";", 
    RowBox[{"w", "=", "40"}], ";", 
    RowBox[{"r0", "=", "0.2"}], ";", 
    RowBox[{"z0", "=", "0.4"}], ";", 
    RowBox[{"\[Kappa]r", "=", "1"}], ";", 
    RowBox[{"\[Kappa]z", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"k", "[", 
        RowBox[{"1", ",", "1"}], "]"}], ",", 
       RowBox[{"k", "[", 
        RowBox[{"1", ",", "2"}], "]"}]}], "}"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"\[Kappa]r", "^", "2"}], "*", "3.25*^-40", "*", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"V0", "^", "2"}], "/", 
           RowBox[{"w", "^", "2"}]}], "/", 
          RowBox[{"r0", "^", "4"}]}], "/", 
         RowBox[{"{", 
          RowBox[{"m0", ",", "m1"}], "}"}]}]}], "+", 
       RowBox[{"1.602*^-13", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Kappa]r", "*", 
           RowBox[{"V1", "/", 
            RowBox[{"r0", "^", "2"}]}]}], "-", 
          RowBox[{"\[Kappa]z", "*", 
           RowBox[{"U", "/", 
            RowBox[{"z0", "^", "2"}]}]}]}], ")"}]}]}], "//", 
      "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"k", "[", 
        RowBox[{"2", ",", "1"}], "]"}], ",", 
       RowBox[{"k", "[", 
        RowBox[{"2", ",", "2"}], "]"}]}], "}"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"\[Kappa]r", "^", "2"}], "*", "3.25*^-40", "*", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"V0", "^", "2"}], "/", 
           RowBox[{"w", "^", "2"}]}], "/", 
          RowBox[{"r0", "^", "4"}]}], "/", 
         RowBox[{"{", 
          RowBox[{"m0", ",", "m1"}], "}"}]}]}], "+", 
       RowBox[{"1.602*^-13", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "\[Kappa]r"}], "*", 
           RowBox[{"V1", "/", 
            RowBox[{"r0", "^", "2"}]}]}], "-", 
          RowBox[{"\[Kappa]z", "*", 
           RowBox[{"U", "/", 
            RowBox[{"z0", "^", "2"}]}]}]}], ")"}]}]}], "//", 
      "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kz", "=", 
     RowBox[{
      RowBox[{"3.204*^-13", "*", "\[Kappa]z", "*", 
       RowBox[{"U", "/", 
        RowBox[{"z0", "^", "2"}]}]}], "//", "FullSimplify"}]}], ";", 
    RowBox[{"l0", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"ke2", "/", "kz"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"1", "/", "3"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"create", " ", "matrix"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ics", "=", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"Append", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"xM", "[", 
             RowBox[{"[", 
              RowBox[{"d", ",", "i"}], "]"}], "]"}], "\[Rule]", "0"}], ",", 
           RowBox[{"{", 
            RowBox[{"d", ",", "2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "Num"}], "}"}]}], "]"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"xM", "[", 
               RowBox[{"[", 
                RowBox[{"3", ",", "i"}], "]"}], "]"}], "-", 
              RowBox[{"xM", "[", 
               RowBox[{"[", 
                RowBox[{"3", ",", "j"}], "]"}], "]"}]}], ")"}], "\[Rule]", 
            RowBox[{
             RowBox[{"L0Mn", "[", 
              RowBox[{"i", ",", "j", ",", "1"}], "]"}], "*", "l0"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "Num"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", 
             RowBox[{"i", "+", "1"}], ",", "Num"}], "}"}]}], "]"}]}], "]"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"2", "*", "Num"}], "+", 
         RowBox[{"Num", "*", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Num", "-", "1"}], ")"}], "/", "2"}]}]}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Uel", "=", 
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"0.5", "*", "kM", "*", 
         RowBox[{"(", 
          RowBox[{"xM", "^", "2"}], ")"}]}], ",", "2"}], "]"}], "+", 
      RowBox[{"ke2", "*", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Total", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"xM", "[", 
                RowBox[{"[", 
                 RowBox[{";;", ",", "i"}], "]"}], "]"}], "-", 
               RowBox[{"xM", "[", 
                RowBox[{"[", 
                 RowBox[{";;", ",", "j"}], "]"}], "]"}]}], ")"}], "^", "2"}], 
            "]"}], ")"}], "^", 
          RowBox[{"(", 
           RowBox[{"-", "0.5"}], ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "Num"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{"i", "+", "1"}], ",", "Num"}], "}"}]}], "]"}]}]}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Vel1", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"Uel", ",", 
             RowBox[{"{", 
              RowBox[{"xM", "[", 
               RowBox[{"[", 
                RowBox[{"d", ",", "i"}], "]"}], "]"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"xM", "[", 
               RowBox[{"[", 
                RowBox[{"d", ",", "j"}], "]"}], "]"}], "}"}]}], "]"}], "/", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{"m", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "*", 
             RowBox[{"m", "[", 
              RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"d", ",", "3"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "Num"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "Num"}], "}"}]}], "]"}]}], "/.", "ics"}], "//", 
      "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "eigen", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eigenholder", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Eigensystem", "[", 
        RowBox[{
         RowBox[{"Vel1", "[", 
          RowBox[{"[", "d", "]"}], "]"}], "/.", 
         RowBox[{"{", 
          RowBox[{"m1", "\[Rule]", "m1hold"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"d", ",", "3"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wmvals", "=", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"-", 
        RowBox[{"eigenholder", "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", "1"}], "]"}], "]"}]}], "]"}], "/", "wmhz"}]}], 
    ";", 
    RowBox[{"vvals", "=", 
     RowBox[{"eigenholder", "[", 
      RowBox[{"[", 
       RowBox[{";;", ",", "2"}], "]"}], "]"}]}], ";", 
    RowBox[{"gim", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"vvals", "[", 
         RowBox[{"[", "d", "]"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"d", ",", "3"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eigenholder", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Eigensystem", "[", 
        RowBox[{
         RowBox[{"Vel1", "[", 
          RowBox[{"[", "d", "]"}], "]"}], "/.", 
         RowBox[{"{", 
          RowBox[{"m1", "\[Rule]", "m0"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"d", ",", "3"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wmvalsnorm", "=", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"eigenholder", "[", 
          RowBox[{"[", 
           RowBox[{";;", ",", "1"}], "]"}], "]"}]}], "/.", 
        RowBox[{"{", 
         RowBox[{"m1", "\[Rule]", "m0"}], "}"}]}], "]"}], "/", "wmhz"}]}], 
    ";", 
    RowBox[{"vvalsnorm", "=", 
     RowBox[{
      RowBox[{"eigenholder", "[", 
       RowBox[{"[", 
        RowBox[{";;", ",", "2"}], "]"}], "]"}], "//", "FullSimplify"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gimnorm", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"vvalsnorm", "[", 
