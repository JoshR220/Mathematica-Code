Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"m", "=", 
    RowBox[{"{", 
     RowBox[{"m0", ",", "m1"}], "}"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Enter", " ", "chain", " ", "configuration", " ", 
     RowBox[{"here", ":", " ", 
      RowBox[{"1", " ", "is", " ", "lower", " ", "mass", " ", "ion"}]}]}], 
    ",", " ", 
    RowBox[{"a", " ", "is", " ", "higher", " ", "mass", " ", "ion"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"wmhz", "=", 
    RowBox[{"2", "*", "Pi", "*", "1*^6"}]}], ";", 
   RowBox[{"ke2", "=", "2.306569*^-28"}], ";", 
   RowBox[{"Num", " ", "=", 
    RowBox[{"Length", "[", "m", "]"}]}], ";"}], 
  " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kM", " ", "=", 
   RowBox[{"Append", "[", " ", 
    RowBox[{
     RowBox[{"Array", "[", 
      RowBox[{"k", ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "2"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"kz", ",", "kz"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"kM", "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"m", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "===", "m0"}], ",", 
        RowBox[{"kM", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"1", ";;"}], ",", "1"}], "]"}], "]"}], ",", 
        RowBox[{"kM", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"1", ";;"}], ",", "2"}], "]"}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "Num"}], "}"}]}], "]"}], "]"}]}], ";", 
  RowBox[{"xM", " ", "=", " ", 
   RowBox[{"Array", "[", 
    RowBox[{"x", ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "Num"}], "}"}]}], "]"}]}], ";"}]}], "Input",
