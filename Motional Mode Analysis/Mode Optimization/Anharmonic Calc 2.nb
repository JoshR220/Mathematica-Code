Cell[TextData[StyleBox["1.2 Calculate Equilibrium Positions", "Section",
 FontSize->24]], "Section",
 CellChangeTimes->{{3.8217660294858932`*^9, 3.821766045718274*^9}, 
   3.821766127869479*^9, {3.8217662642794237`*^9, 3.821766266498681*^9}, {
