 FontSize->24]], "Section",
 CellChangeTimes->{{3.8217660294858932`*^9, 3.821766045718274*^9}, 
   3.821766127869479*^9, {3.821766192909049*^9, 
   3.821766195875162*^9}},ExpressionUUID->"7e5ceafc-260d-4a70-8085-\
f267e0cb44a1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rMat", "[", 
   RowBox[{"A0_", ",", "B0_", ",", "ad_", ",", "qd_", ",", "ord_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"C2n", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"recur", "[", 
          RowBox[{"#", ",", "ord", ",", "1"}], "]"}], "&"}], "/@", 
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", "ord"}], "]"}]}]}], ",", 
      RowBox[{"Cn2n", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"recur", "[", 
          RowBox[{"#", ",", "ord", ",", 
           RowBox[{"-", "1"}]}], "]"}], "&"}], "/@", 
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", "ord"}], "]"}]}]}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"C2n", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Apply", "[", 
         RowBox[{"Times", ",", 
          RowBox[{"C2n", "[", 
           RowBox[{"[", 
            RowBox[{";;", "#"}], "]"}], "]"}]}], "]"}], "&"}], "/@", 
       RowBox[{"Range", "[", "ord", "]"}]}]}], ";", 
     RowBox[{"Cn2n", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Apply", "[", 
         RowBox[{"Times", ",", 
          RowBox[{"Cn2n", "[", 
           RowBox[{"[", 
            RowBox[{";;", "#"}], "]"}], "]"}]}], "]"}], "&"}], "/@", 
       RowBox[{"Range", "[", "ord", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"A0", "*", 
            RowBox[{"Cos", "[", 
             RowBox[{"\[Beta]", "*", "t"}], "]"}]}], "+", 
           RowBox[{"B0", "*", 
            RowBox[{"Sin", "[", 
             RowBox[{"\[Beta]", "*", "t"}], "]"}]}]}], ")"}], "+", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"C2n", "[", 
              RowBox[{"[", "n", "]"}], "]"}], "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"A0", "*", 
                RowBox[{"Cos", "[", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"2", "*", "n"}], "+", "\[Beta]"}], ")"}], "*", 
                  "t"}], "]"}]}], "+", 
               RowBox[{"B0", "*", 
                RowBox[{"Sin", "[", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"2", "*", "n"}], "+", "\[Beta]"}], ")"}], "*", 
                  "t"}], "]"}]}]}], ")"}]}], "+", 
            RowBox[{
             RowBox[{"Cn2n", "[", 
              RowBox[{"[", "n", "]"}], "]"}], "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"A0", "*", 
                RowBox[{"Cos", "[", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"-", "2"}], "*", "n"}], "+", "\[Beta]"}], ")"}], 
                  "*", "t"}], "]"}]}], "+", 
               RowBox[{"B0", "*", 
                RowBox[{"Sin", "[", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"-", "2"}], "*", "n"}], "+", "\[Beta]"}], ")"}], 
                  "*", "t"}], "]"}]}]}], ")"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "1", ",", "ord"}], "}"}]}], "]"}]}], "/.", 
        RowBox[{"Normal", "[", 
         RowBox[{"solveMathieu", "[", 
          RowBox[{"ord", ",", "ord"}], "]"}], "]"}]}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"a", "\[Rule]", "ad"}], ",", 
         RowBox[{"q", "\[Rule]", "qd"}]}], "}"}]}], "//", 
      "FullSimplify"}]}]}], "]"}]}]], "Input",
