Cell[CellGroupData[{

Cell["1 Find \[Beta]", "Chapter",
 CellChangeTimes->{{3.82176573707802*^9, 
  3.821765755056943*^9}},ExpressionUUID->"21347177-cb1a-46c8-a209-\
2da23cd8620d"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["1.1 Base functions", "Section",
 FontSize->24]], "Section",
 CellChangeTimes->{{3.8217660294858932`*^9, 3.821766045718274*^9}, 
   3.821766127869479*^9},ExpressionUUID->"7a6e3c3e-63c2-4459-8636-\
5d7b71fee98d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "q", ",", "\[Beta]"}], "}"}], ",", "Constant"}], "]"}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"D2n", "[", "n_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"a", "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "*", "n"}], "-", "\[Beta]"}], ")"}], "^", "2"}]}], 
     ")"}], "/", "q"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"recur", "[", 
     RowBox[{"i_", ",", "stop_", ",", "dir_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"D2n", "[", 
         RowBox[{"i", "*", "dir"}], "]"}], "-", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"i", "\[GreaterEqual]", "stop"}], ",", "0", ",", 
          RowBox[{"recur", "[", 
           RowBox[{
            RowBox[{"i", "+", "1"}], ",", "stop", ",", "dir"}], "]"}]}], 
         "]"}]}], ")"}]}], "//", "FullSimplify"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"getBetaEQ", "[", 
    RowBox[{"ordD_", ",", "ordAQ_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Normal", "[", 
     RowBox[{"Series", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"a", "-", 
         RowBox[{"q", "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"recur", "[", 
             RowBox[{"1", ",", 
              RowBox[{"ordD", "+", "1"}], ",", "1"}], "]"}], "+", 
            RowBox[{"recur", "[", 
             RowBox[{"1", ",", 
              RowBox[{"ordD", "+", "1"}], ",", 
              RowBox[{"-", "1"}]}], "]"}]}], ")"}]}]}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"a", "\[Rule]", 
           RowBox[{"\[Epsilon]", "*", "a"}]}], ",", 
          RowBox[{"q", "->", 
           RowBox[{"\[Epsilon]", "*", "q"}]}], ",", 
          RowBox[{"\[Beta]", "\[Rule]", 
           RowBox[{"\[Epsilon]", "*", "\[Beta]"}]}]}], "}"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Epsilon]", ",", "0", ",", 
         RowBox[{"ordAQ", "+", "1"}]}], "}"}]}], "]"}], "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{"\[Epsilon]", "\[Rule]", "1"}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"solveMathieu", "[", 
   RowBox[{"ordD_", ",", "ordAQ_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Beta]", "^", "2"}], "\[Equal]", 
      RowBox[{"getBetaEQ", "[", 
       RowBox[{"ordD", ",", "ordAQ"}], "]"}]}], ",", "\[Beta]", ",", 
     "PositiveReals"}], "]"}], "//", "FullSimplify", " ", 
   RowBox[{"(*", 
    RowBox[{
    "This", " ", "is", " ", "just", " ", "for", " ", "ease", " ", "of", " ", 
     "use"}], "*)"}]}]}]}], "Input",
 CellChangeTimes->{3.8217661372951927`*^9},
 CellLabel->"In[8]:=",ExpressionUUID->"ad0f9c48-49b8-4628-b56e-34d1fe7bd933"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["1.2 Exact expressions for comparison of \[Beta] ", \
"Section",
 FontSize->24]], "Section",
 CellChangeTimes->{{3.8217660294858932`*^9, 
  3.821766045718274*^9}},ExpressionUUID->"0145edd7-6fce-4ec6-921e-\
bdea3eb8dab4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fourthOrd\[Beta]", "=", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"a", "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"a", "-", "1"}], ")"}], "*", 
        RowBox[{
         RowBox[{"q", "^", "2"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "*", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"a", "-", "1"}], ")"}], "^", "2"}]}], "-", 
           RowBox[{"q", "^", "2"}]}], ")"}]}]}], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"5", "*", "a"}], "+", "7"}], ")"}], "*", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"q", "^", "4"}], "/", "32"}], "/", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"a", "-", "1"}], ")"}], "^", "3"}]}], "/", 
         RowBox[{"(", 
          RowBox[{"a", "-", "4"}], ")"}]}]}]}], "]"}], "//", 
     "FullSimplify"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Given", " ", "in", " ", 
    RowBox[{"arXiv", ":", 
     RowBox[{"quant", "-", 
      RowBox[{
       RowBox[{"ph", "/", "0505025"}], " ", "v2"}]}]}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"firstOrd\[Beta]", "=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"a", "+", 
     RowBox[{"0.5", "*", 
      RowBox[{"q", "^", "2"}]}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"e1c710d1-6359-4144-9d7d-42add1c7b29d"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["1.3 Solve!", "Section",
 FontSize->24]], "Section",
 CellChangeTimes->{{3.8217660294858932`*^9, 3.821766045718274*^9}, 
   3.821766165509102*^9},ExpressionUUID->"ff62f6f3-9c39-471d-8d9e-\
ceb13924be9d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"wsec", "=", 
   RowBox[{"solveMathieu", "[", 
    RowBox[{"4", ",", "4"}], "]"}]}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Enter", " ", "order", " ", "of", " ", "approximation", " ", 
     RowBox[{"here", ":", " ", 
      RowBox[{
      "first", " ", "number", " ", "is", " ", "order", " ", "of", " ", 
       "D"}]}]}], ",", " ", 
    RowBox[{
    "second", " ", "number", " ", "is", " ", "order", " ", "of", " ", "terms",
      " ", "to", " ", "keep"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"params", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "\[Rule]", "0.2"}], ",", 
     RowBox[{"q", "\[Rule]", "0.2"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ve", "=", 
   RowBox[{"Chop", "[", 
    RowBox[{
     RowBox[{"\[Beta]", "/.", "wsec"}], "/.", "params"}], "]"}]}], ";", 
  RowBox[{"v4", "=", 
   RowBox[{"fourthOrd\[Beta]", "/.", "params"}]}], ";", 
  RowBox[{"v1", "=", 
   RowBox[{"firstOrd\[Beta]", "/.", "params"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Abs", "[", 
    RowBox[{"v4", "-", "v1"}], "]"}], "/", "v4"}], "*", 
  "100"}], "\[IndentingNewLine]", 
 RowBox[{"NSolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"fourthOrd\[Beta]", "-", "firstOrd\[Beta]"}], "]"}], "/", 
       "v4"}], "*", "100"}], "\[Equal]", "1"}], "/.", 
    RowBox[{"{", 
     RowBox[{"a", "\[Rule]", "q"}], "}"}]}], ",", "q", ",", "PositiveReals"}],
   "]"}]}], "Input",
 CellChangeTimes->{3.8217661702542763`*^9},
 CellLabel->"In[15]:=",ExpressionUUID->"46e72194-e7a4-419b-91b1-879f68623fd9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"\[Beta]", "\[Rule]", 
    TemplateBox[{
      RowBox[{
        FractionBox["1", "8"], " ", 
        SqrtBox[
         FractionBox[
          RowBox[{
            RowBox[{"2048", " ", "a"}], "+", 
            RowBox[{"16", " ", 
              RowBox[{"(", 
                RowBox[{"4", "+", "a"}], ")"}], " ", 
              RowBox[{"(", 
                RowBox[{"16", "+", 
                  SuperscriptBox["a", "2"]}], ")"}], " ", 
              SuperscriptBox["q", "2"]}], "+", 
            RowBox[{
              RowBox[{"(", 
                RowBox[{"16", "+", 
                  RowBox[{"9", " ", "a"}]}], ")"}], " ", 
              SuperscriptBox["q", "4"]}]}], 
          RowBox[{"32", "-", 
            RowBox[{"2", " ", 
              RowBox[{"(", 
                RowBox[{"6", "+", 
                  RowBox[{"5", " ", "a"}]}], ")"}], " ", 
              SuperscriptBox["q", "2"]}]}]]]}], 
      RowBox[{
        RowBox[{"q", ">", "0"}], "&&", 
        RowBox[{"a", ">", "0"}], "&&", 
        RowBox[{
          RowBox[{"6", "+", 
            RowBox[{"5", " ", "a"}]}], "<", 
          FractionBox["16", 
           SuperscriptBox["q", "2"]]}]}]},
     "ConditionalExpression"]}], "}"}], "}"}]], "Output",
