Cell[CellGroupData[{

Cell["1.4.1 Functions", "Subsection",
 CellChangeTimes->{{3.851540701144451*^9, 
  3.851540712920401*^9}},ExpressionUUID->"085d44bf-5df4-485e-a744-\
c5f06601e339"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Mathieu\[Omega]", "[", 
   RowBox[{"q0_", ",", "a0_", ",", 
    RowBox[{"order_", ":", "1"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"params", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"q", "->", "q0"}], ",", 
         RowBox[{"a", "->", "a0"}]}], "}"}]}], ",", "D2n", ",", "recur", ",", 
      "\[Beta]eq", ",", "\[Beta]soln"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"D2n", "[", "n_", "]"}], ":=", 
      FractionBox[
       RowBox[{"(", 
        RowBox[{"a", "-", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "*", "n"}], "-", "\[Beta]"}], ")"}], "2"]}], ")"}], 
       "q"]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"recur", "[", 
       RowBox[{"i_", ",", "stop_", ",", "dir_"}], "]"}], ":=", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"D2n", "[", 
          RowBox[{"i", "*", "dir"}], "]"}], "-", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"i", "\[GreaterEqual]", "stop"}], ",", "0", ",", 
           RowBox[{"recur", "[", 
            RowBox[{
             RowBox[{"i", "+", "1"}], ",", "stop", ",", "dir"}], "]"}]}], 
          "]"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Beta]eq", "=", 
      RowBox[{
       RowBox[{"Normal", "[", 
        RowBox[{"Series", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"a", "-", 
            RowBox[{"q", "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"recur", "[", 
                RowBox[{"1", ",", 
                 RowBox[{"order", "+", "3"}], ",", "1"}], "]"}], "+", 
               RowBox[{"recur", "[", 
                RowBox[{"1", ",", 
                 RowBox[{"order", "+", "3"}], ",", 
                 RowBox[{"-", "1"}]}], "]"}]}], ")"}]}]}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"a", "\[Rule]", 
              RowBox[{"\[Epsilon]", "*", "a"}]}], ",", 
             RowBox[{"q", "->", 
              RowBox[{"\[Epsilon]", "*", "q"}]}], ",", 
             RowBox[{"\[Beta]", "\[Rule]", 
              RowBox[{"\[Epsilon]", "*", "\[Beta]"}]}]}], "}"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"\[Epsilon]", ",", "0", ",", 
            RowBox[{"order", "+", "1"}]}], "}"}]}], "]"}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{"\[Epsilon]", "\[Rule]", "1"}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Beta]soln", "=", 
      RowBox[{
       RowBox[{"NSolve", "[", 
        RowBox[{
         RowBox[{
          SuperscriptBox["\[Beta]", "2"], "\[Equal]", 
          RowBox[{"Evaluate", "[", 
           RowBox[{"\[Beta]eq", "/.", "params"}], "]"}]}], ",", "\[Beta]", 
         ",", "PositiveReals"}], "]"}], "//", "FullSimplify"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      FractionBox["\[Omega]RF", "2"], "*", 
      RowBox[{"Normal", "[", 
       RowBox[{"\[Beta]", "/.", "\[Beta]soln"}], "]"}]}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.851164458700593*^9, 3.851164459290657*^9}, {
   3.851164587166009*^9, 3.851164611892653*^9}, {3.8511647945194273`*^9, 
   3.851164813004961*^9}, {3.851164881976345*^9, 3.851164892379072*^9}, {
