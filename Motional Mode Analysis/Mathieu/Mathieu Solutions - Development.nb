   3.851165130255322*^9}, {3.851165187656486*^9, 3.8511652161042223`*^9}, {
   3.85116528636244*^9, 3.851165287938755*^9}, {3.851165698824581*^9, 
   3.851165705880979*^9}, 3.85116583177124*^9, 3.851165999689357*^9, {
   3.8511660475941467`*^9, 3.8511660527201014`*^9}, {3.851166092833905*^9, 
   3.851166111202157*^9}, {3.8511662441020727`*^9, 3.8511662733643007`*^9}, {
   3.85116640691278*^9, 3.851166430777849*^9}, {3.8515683882442713`*^9, 
   3.851568402052024*^9}},
