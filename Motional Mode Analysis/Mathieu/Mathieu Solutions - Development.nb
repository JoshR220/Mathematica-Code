 CellChangeTimes->{{3.851540701144451*^9, 
  3.85154070901826*^9}},ExpressionUUID->"74edff32-7c7a-4bf3-a0d2-\
b87de3453511"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Mathieu\[Omega]2", "[", 
   RowBox[{"\[Omega]DJ_", ",", "a0_", ",", "\[Omega]RF_", ",", 
    RowBox[{"order_", ":", "1"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"D2n", ",", "recur", ",", 
      RowBox[{"\[Beta]DJ", "=", 
       RowBox[{
        FractionBox["2", "\[Omega]RF"], "*", "\[Omega]DJ"}]}], ",", "qeq", 
      ",", "qsoln"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"D2n", "[", "n_", "]"}], ":=", 
      FractionBox[
       RowBox[{"(", 
        RowBox[{"a", "-", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "*", "n"}], "-", "\[Beta]"}], ")"}], "2"]}], ")"}], 
       "q"]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"recur", "[", 
       RowBox[{"i_", ",", "stop_", ",", "dir_"}], "]"}], ":=", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"D2n", "[", 
          RowBox[{"i", "*", "dir"}], "]"}], "-", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"i", "\[GreaterEqual]", "stop"}], ",", "0", ",", 
           RowBox[{"recur", "[", 
            RowBox[{
             RowBox[{"i", "+", "1"}], ",", "stop", ",", "dir"}], "]"}]}], 
          "]"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"qeq", "=", 
      RowBox[{
       RowBox[{"Normal", "[", 
        RowBox[{"Series", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"a", "-", 
            RowBox[{"q", "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"recur", "[", 
                RowBox[{"1", ",", 
                 RowBox[{"order", "+", "3"}], ",", "1"}], "]"}], "+", 
               RowBox[{"recur", "[", 
                RowBox[{"1", ",", 
                 RowBox[{"order", "+", "3"}], ",", 
                 RowBox[{"-", "1"}]}], "]"}]}], ")"}]}]}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"a", "\[Rule]", 
              RowBox[{"\[Epsilon]", "*", "a"}]}], ",", 
             RowBox[{"q", "->", 
              RowBox[{"\[Epsilon]", "*", "q"}]}], ",", 
             RowBox[{"\[Beta]", "\[Rule]", 
              RowBox[{"\[Epsilon]", "*", "\[Beta]"}]}]}], "}"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"\[Epsilon]", ",", "0", ",", 
            RowBox[{"order", "+", "1"}]}], "}"}]}], "]"}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{"\[Epsilon]", "\[Rule]", "1"}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"qsoln", "=", 
      RowBox[{
       RowBox[{"NSolve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["\[Beta]", "2"], "\[Equal]", "qeq"}], ")"}], "/.", 
          
          RowBox[{"{", 
           RowBox[{
            RowBox[{"a", "->", "a0"}], ",", 
            RowBox[{"\[Beta]", "->", "\[Beta]DJ"}]}], "}"}]}], ",", "q", ",", 
         "PositiveReals"}], "]"}], "//", "FullSimplify"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"q", "/.", "qsoln"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.851164458700593*^9, 3.851164459290657*^9}, {
