Cell[BoxData[{
 RowBox[{
  RowBox[{"q0", ":=", 
   FractionBox[
    RowBox[{"2", "*", "qe", "*", "VRF"}], 
    RowBox[{"mIon", "*", 
     SuperscriptBox["\[Omega]RF", "2"], "*", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"\[Kappa]r", "*", "r0"}], ")"}], "2"]}]]}], ";", 
  RowBox[{"a0", ":=", 
   RowBox[{
    FractionBox[
     RowBox[{"4", "*", "qe"}], 
     RowBox[{"mIon", "*", 
      SuperscriptBox["\[Omega]RF", "2"]}]], 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{"\[Kappa]r", "*", "V0"}], 
       SuperscriptBox["r0", "2"]], "-", 
      FractionBox[
       RowBox[{"\[Kappa]z", "*", "U"}], 
       SuperscriptBox["z0", "2"]]}], ")"}]}]}], ";", 
  RowBox[{"\[Omega]0", ":=", 
   RowBox[{
    FractionBox["\[Omega]RF", "2"], "*", 
    SqrtBox[
     RowBox[{
      FractionBox[
       SuperscriptBox["q0", "2"], "2"], "+", "a0"}]]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"params", "=", 
   RowBox[{"{", 
