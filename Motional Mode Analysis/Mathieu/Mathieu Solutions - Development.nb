Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "recursion", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"D2n", "[", "n_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"a", "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "*", "n"}], "-", "\[Beta]"}], ")"}], "^", "2"}]}], 
       ")"}], "/", "q"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"recur", "[", 
      RowBox[{"i_", ",", "stop_", ",", "dir_"}], "]"}], ":=", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"D2n", "[", 
         RowBox[{"i", "*", "dir"}], "]"}], "-", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"i", "\[GreaterEqual]", "stop"}], ",", "0", ",", 
          RowBox[{"recur", "[", 
           RowBox[{
            RowBox[{"i", "+", "1"}], ",", "stop", ",", "dir"}], "]"}]}], 
         "]"}]}], ")"}]}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{
  3.8217661372951927`*^9, {3.848634029503058*^9, 3.848634052335023*^9}, {
   3.8511661260499353`*^9, 3.851166126337225*^9}},
 CellLabel->
  "In[164]:=",ExpressionUUID->"ad0f9c48-49b8-4628-b56e-34d1fe7bd933"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"get", " ", "recursive", " ", "equation"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"getBetaEQ", "[", 
      RowBox[{"ordD_", ",", "ordAQ_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Normal", "[", 
       RowBox[{"Series", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"a", "-", 
           RowBox[{"q", "*", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"recur", "[", 
               RowBox[{"1", ",", 
                RowBox[{"ordD", "+", "1"}], ",", "1"}], "]"}], "+", 
              RowBox[{"recur", "[", 
               RowBox[{"1", ",", 
                RowBox[{"ordD", "+", "1"}], ",", 
                RowBox[{"-", "1"}]}], "]"}]}], ")"}]}]}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"a", "\[Rule]", 
             RowBox[{"\[Epsilon]", "*", "a"}]}], ",", 
            RowBox[{"q", "->", 
             RowBox[{"\[Epsilon]", "*", "q"}]}], ",", 
            RowBox[{"\[Beta]", "\[Rule]", 
             RowBox[{"\[Epsilon]", "*", "\[Beta]"}]}]}], "}"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Epsilon]", ",", "0", ",", 
           RowBox[{"ordAQ", "+", "1"}]}], "}"}]}], "]"}], "]"}], "/.", 
      RowBox[{"{", 
       RowBox[{"\[Epsilon]", "\[Rule]", "1"}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"solveMathieu", "[", 
     RowBox[{"ordD_", ",", "ordAQ_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Beta]", "^", "2"}], "\[Equal]", 
        RowBox[{"getBetaEQ", "[", 
         RowBox[{"ordD", ",", "ordAQ"}], "]"}]}], ",", "\[Beta]", ",", 
       "PositiveReals"}], "]"}], "//", "FullSimplify"}]}]}]}]], "Input",
 CellChangeTimes->{{3.848634058528646*^9, 3.848634074215473*^9}},
 CellLabel->
  "In[166]:=",ExpressionUUID->"89247145-f3bf-4a3e-b4f3-fd7a349aab32"]
}, Closed]],

