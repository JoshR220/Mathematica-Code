Cell[BoxData[
 RowBox[{
  RowBox[{"MotionalModes", "[", 
   RowBox[{"mArr_List", ",", "radialfreq_List", ",", "axialfreq_List"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ke2", "=", "2.30707751*^-28"}], ",", 
      RowBox[{"chain", "=", 
       RowBox[{"{", 
        RowBox[{"radialfreq", ",", "axialfreq"}], "}"}]}], ",", 
      RowBox[{"numIons", "=", 
       RowBox[{"Length", "[", "mArr", "]"}]}], ",", 
      RowBox[{"l0", "=", 
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox["2.30707751*^-28", 
          RowBox[{
           RowBox[{"mArr", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "*", 
           SuperscriptBox[
            RowBox[{"axialfreq", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "2"]}]], ")"}], 
        RowBox[{"(", 
         RowBox[{"1", "/", "3"}], ")"}]]}], ",", "z0eq", ",", "z0eqArr", ",", 
      "L0EQlist", ",", "guessz0eq", ",", "L0Mn", ",", "VMatZ", ",", "VMatX"}],
      "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"z0eqArr", " ", "=", " ", 
      RowBox[{"Array", "[", 
       RowBox[{"z0eq", ",", "numIons"}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"L0EQlist", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"z0eqArr", "[", 
          RowBox[{"[", "#", "]"}], "]"}], "\[Equal]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Sum", "[", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{
                RowBox[{"z0eqArr", "[", 
                 RowBox[{"[", "#", "]"}], "]"}], " ", "-", " ", 
