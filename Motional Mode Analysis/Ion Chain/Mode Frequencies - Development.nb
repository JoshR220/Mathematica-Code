Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"create", " ", "secular", " ", "frequency", " ", "matrix"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"wsecvalsMAT", ":=", 
    RowBox[{"Transpose", "[", 
     RowBox[{
      RowBox[{"mArr", "/.", 
       RowBox[{"{", 
        RowBox[{"mMol", "\[Rule]", "wsecMol"}], "}"}]}], "/.", 
      RowBox[{"{", 
       RowBox[{"mAtom", "\[Rule]", "wsecAtom"}], "}"}]}], "]"}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{{3.827784970895178*^9, 3.827784988534824*^9}, 
   3.829723598255393*^9, {3.830846973127438*^9, 3.830846980999145*^9}, {
   3.8515277159058943`*^9, 3.8515277230804253`*^9}},
 CellLabel->
