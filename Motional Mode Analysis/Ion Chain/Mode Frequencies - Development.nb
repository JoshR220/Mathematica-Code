                 RowBox[{"[", "k", "]"}], "]"}]}], ")"}], 
              RowBox[{"-", "2"}]], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", " ", 
               RowBox[{"#", "+", "1"}], ",", "numIons"}], "}"}]}], "]"}]}], 
          ")"}]}], "&"}], "/@", 
       RowBox[{"Range", "[", "numIons", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"guessz0eq", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"-", "#"}], ",", "#", ",", 
           RowBox[{"2", "*", 
            RowBox[{"#", "/", 
             RowBox[{"(", 
              RowBox[{"numIons", "-", "1"}], ")"}]}]}]}], "]"}], "&"}], "[", 
        SuperscriptBox["numIons", 
         RowBox[{"(", 
          RowBox[{"1", "/", "3"}], ")"}]], "]"}], "//", "N"}]}], ";", 
     RowBox[{"guessz0eq", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", "z0eqArr", "}"}], ",", 
         RowBox[{"{", "guessz0eq", "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"z0eqArr", "=", 
      RowBox[{"z0eqArr", "/.", 
       RowBox[{"Chop", "[", 
        RowBox[{"FindRoot", "[", 
         RowBox[{"L0EQlist", ",", "guessz0eq"}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"L0Mn", "=", 
      RowBox[{"Abs", "[", 
       RowBox[{"Table", "[", 
