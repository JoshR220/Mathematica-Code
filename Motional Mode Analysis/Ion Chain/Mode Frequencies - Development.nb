       RowBox[{"Length", "[", "mArr", "]"}]}], ",", 
      RowBox[{"l0", "=", 
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox["ke2", 
          RowBox[{
           RowBox[{"mArr", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "*", 
           SuperscriptBox[
            RowBox[{"axialfreqArr", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "2"]}]], ")"}], 
        RowBox[{"(", 
         RowBox[{"1", "/", "3"}], ")"}]]}], ",", "L0EQlist", ",", "z0eq", ",",
       "z0eqArr", ",", "guessz0eq"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"z0eqArr", " ", "=", " ", 
      RowBox[{"Array", "[", 
       RowBox[{"z0eq", ",", "numIons"}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"L0EQlist", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"z0eqArr", "[", 
          RowBox[{"[", "#", "]"}], "]"}], "\[Equal]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Sum", "[", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{
                RowBox[{"z0eqArr", "[", 
                 RowBox[{"[", "#", "]"}], "]"}], " ", "-", " ", 
                RowBox[{"z0eqArr", "[", 
                 RowBox[{"[", "k", "]"}], "]"}]}], ")"}], 
              RowBox[{"-", "2"}]], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "1", ",", 
               RowBox[{"#", "-", "1"}]}], "}"}]}], "]"}], " ", "-", " ", 
           RowBox[{"Sum", "[", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{
                RowBox[{"z0eqArr", "[", 
                 RowBox[{"[", "#", "]"}], "]"}], " ", "-", " ", 
                RowBox[{"z0eqArr", "[", 
                 RowBox[{"[", "k", "]"}], "]"}]}], ")"}], 
              RowBox[{"-", "2"}]], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", " ", 
               RowBox[{"#", "+", "1"}], ",", "numIons"}], "}"}]}], "]"}]}], 
          ")"}]}], "&"}], "/@", 
       RowBox[{"Range", "[", "numIons", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"guessz0eq", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"-", "#"}], ",", "#", ",", 
           RowBox[{"2", "*", 
            RowBox[{"#", "/", 
             RowBox[{"(", 
              RowBox[{"numIons", "-", "1"}], ")"}]}]}]}], "]"}], "&"}], "[", 
        SuperscriptBox["numIons", 
         RowBox[{"(", 
          RowBox[{"1", "/", "3"}], ")"}]], "]"}], "//", "N"}]}], ";", 
     RowBox[{"guessz0eq", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", "z0eqArr", "}"}], ",", 
         RowBox[{"{", "guessz0eq", "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"z0eqArr", "=", 
      RowBox[{"z0eqArr", "/.", 
       RowBox[{"Chop", "[", 
        RowBox[{"FindRoot", "[", 
         RowBox[{"L0EQlist", ",", "guessz0eq"}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"l0", "*", "z0eqArr"}]}]}], "]"}]}]], "Input",
