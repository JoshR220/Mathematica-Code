                 RowBox[{"[", "k", "]"}], "]"}]}], ")"}], 
              RowBox[{"-", "2"}]], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "1", ",", 
               RowBox[{"#", "-", "1"}]}], "}"}]}], "]"}], " ", "-", " ", 
           RowBox[{"Sum", "[", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{
                RowBox[{"z0eqArr", "[", 
                 RowBox[{"[", "#", "]"}], "]"}], " ", "-", " ", 
