Cell[BoxData[
 RowBox[{
  RowBox[{"Mathieu\[Omega]", "[", 
   RowBox[{"q0_", ",", "a0_", ",", 
    RowBox[{"order_", ":", "1"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"params", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"q", "->", "q0"}], ",", 
         RowBox[{"a", "->", "a0"}]}], "}"}]}], ",", "D2n", ",", "recur", ",", 
      "\[Beta]eq", ",", "\[Beta]soln"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"D2n", "[", "n_", "]"}], ":=", 
      FractionBox[
       RowBox[{"(", 
        RowBox[{"a", "-", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "*", "n"}], "-", "\[Beta]"}], ")"}], "2"]}], ")"}], 
       "q"]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"recur", "[", 
       RowBox[{"i_", ",", "stop_", ",", "dir_"}], "]"}], ":=", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"D2n", "[", 
          RowBox[{"i", "*", "dir"}], "]"}], "-", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"i", "\[GreaterEqual]", "stop"}], ",", "0", ",", 
           RowBox[{"recur", "[", 
            RowBox[{
             RowBox[{"i", "+", "1"}], ",", "stop", ",", "dir"}], "]"}]}], 
          "]"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"AbsoluteTiming", "[", 
       RowBox[{
        RowBox[{"\[Beta]eq", "=", 
         RowBox[{
          RowBox[{"Normal", "[", 
           RowBox[{"Series", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"a", "-", 
               RowBox[{"q", "*", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"recur", "[", 
                   RowBox[{"1", ",", 
                    RowBox[{"order", "+", "3"}], ",", "1"}], "]"}], "+", 
                  RowBox[{"recur", "[", 
                   RowBox[{"1", ",", 
                    RowBox[{"order", "+", "3"}], ",", 
                    RowBox[{"-", "1"}]}], "]"}]}], ")"}]}]}], "/.", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"a", "\[Rule]", 
                 RowBox[{"\[Epsilon]", "*", "a"}]}], ",", 
                RowBox[{"q", "->", 
                 RowBox[{"\[Epsilon]", "*", "q"}]}], ",", 
                RowBox[{"\[Beta]", "\[Rule]", 
                 RowBox[{"\[Epsilon]", "*", "\[Beta]"}]}]}], "}"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"\[Epsilon]", ",", "0", ",", 
               RowBox[{"order", "+", "1"}]}], "}"}]}], "]"}], "]"}], "/.", 
          RowBox[{"{", 
           RowBox[{"\[Epsilon]", "\[Rule]", "1"}], "}"}]}]}], ";"}], "]"}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"AbsoluteTiming", "[", 
       RowBox[{
        RowBox[{"\[Beta]soln", "=", 
         RowBox[{
          RowBox[{"NSolve", "[", 
           RowBox[{
            RowBox[{
             SuperscriptBox["\[Beta]", "2"], "\[Equal]", 
             RowBox[{"Evaluate", "[", 
              RowBox[{"\[Beta]eq", "/.", "params"}], "]"}]}], ",", "\[Beta]", 
            ",", "PositiveReals"}], "]"}], "//", "FullSimplify"}]}], ";"}], 
       "]"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
