         RowBox[{
          FractionBox["1", "2"], 
          SuperscriptBox[
           RowBox[{"(", 
            FractionBox[
             RowBox[{"2", "*", "1.60217*^-19", "*", 
              RowBox[{"(", 
               RowBox[{"VRF", "*", "\[Kappa]r"}], ")"}]}], 
             RowBox[{"mass", "*", 
              SuperscriptBox["\[Omega]RF", "2"], "*", 
              SuperscriptBox["r0", "2"]}]], ")"}], "2"]}], "-", 
         RowBox[{"(", 
          RowBox[{"#", "-", 
           FractionBox[
            RowBox[{"4", "*", "1.60217*^-19", "*", "\[Kappa]r", "*", "V0"}], 
            RowBox[{"mass", "*", 
             SuperscriptBox["\[Omega]RF", "2"], "*", 
             SuperscriptBox["r0", "2"]}]]}], ")"}]}], ",", 
        RowBox[{"2.", "*", "#"}]}], "}"}], "]"}]}], "&"}], "[", 
   RowBox[{"(", 
    FractionBox[
     RowBox[{"4", "*", "1.60217*^-19", "*", "\[Kappa]z", "*", "Vz"}], 
     RowBox[{"mass", "*", 
      SuperscriptBox["\[Omega]RF", "2"], "*", 
      SuperscriptBox["z0", "2"]}]], ")"}], "]"}]}]], "Input",
