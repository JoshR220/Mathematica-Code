Cell[BoxData[
 RowBox[{
  RowBox[{"SecularFrequency", "[", 
   RowBox[{
   "mass_", ",", "VRF_", ",", "\[Omega]RF_", ",", "r0_", ",", "Vz_", ",", 
    "z0_", ",", 
    RowBox[{"\[Kappa]r_", ":", "1"}], ",", 
    RowBox[{"\[Kappa]z_", ":", "1"}], ",", 
    RowBox[{"V0_", ":", "0"}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{
     FractionBox["\[Omega]RF", "2"], "*", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"{", 
       RowBox[{
