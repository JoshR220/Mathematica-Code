               RowBox[{"[", "j", "]"}], "]"}]}], ")"}], 
            RowBox[{"-", "3"}]]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "numIons"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "numIons"}], "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"VMatZ", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         SqrtBox[
          FractionBox[
           RowBox[{"mArr", "[", 
            RowBox[{"[", "i", "]"}], "]"}], 
           RowBox[{"mArr", "[", 
            RowBox[{"[", "j", "]"}], "]"}]]], "*", 
