Cell[BoxData[{
 RowBox[{
  RowBox[{"qMol", ":=", 
   FractionBox[
    RowBox[{"2", "*", "qe", "*", 
     RowBox[{"(", 
      RowBox[{"VRF", "*", "\[Kappa]r"}], ")"}]}], 
    RowBox[{"mMol", "*", 
     SuperscriptBox["\[Omega]RF", "2"], "*", 
     SuperscriptBox["r0", "2"]}]]}], ";", 
  RowBox[{"qAtom", ":=", 
   FractionBox[
    RowBox[{"2", "*", "qe", "*", 
     RowBox[{"(", 
      RowBox[{"VRF", "*", "\[Kappa]r"}], ")"}]}], 
    RowBox[{"mAtom", "*", 
     SuperscriptBox["\[Omega]RF", "2"], "*", 
     SuperscriptBox["r0", "2"]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wsecMol", ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox["\[Omega]RF", "2"], "*", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          FractionBox[
           SuperscriptBox["qMol", "2"], "2"], "-", 
          RowBox[{"(", 
           RowBox[{"#", "-", 
