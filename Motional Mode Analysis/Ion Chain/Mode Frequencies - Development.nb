Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"create", " ", "eigen", " ", "matrices"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"L0Mn", ":=", 
     RowBox[{"Abs", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"i", "==", "j"}], ",", "0", ",", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"z0eqArr", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "-", 
             RowBox[{"z0eqArr", "[", 
              RowBox[{"[", "j", "]"}], "]"}]}], ")"}], 
           RowBox[{"-", "3"}]]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "numIons"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "numIons"}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"VMatZ", ":=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        SqrtBox[
         FractionBox[
          RowBox[{"mArr", "[", 
           RowBox[{"[", "i", "]"}], "]"}], 
          RowBox[{"mArr", "[", 
           RowBox[{"[", "j", "]"}], "]"}]]], "*", 
        SuperscriptBox[
         RowBox[{"wsecvalsMAT", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "i"}], "]"}], "]"}], "2"], "*", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"i", "==", "j"}], ",", 
          RowBox[{"1", "+", 
           RowBox[{"2", "*", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{"L0Mn", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "id"}], "]"}], "]"}], ",", 
              RowBox[{"{", 
