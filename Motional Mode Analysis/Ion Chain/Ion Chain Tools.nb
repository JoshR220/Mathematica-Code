Cell[BoxData[
 RowBox[{
  RowBox[{"SecularFrequency", "[", 
   RowBox[{
   "mass_", ",", "VRF_", ",", "\[Omega]RF_", ",", "r0_", ",", "Vz_", ",", 
    "z0_", ",", 
    RowBox[{"\[Kappa]r_", ":", "1"}], ",", 
    RowBox[{"\[Kappa]z_", ":", "1"}], ",", 
    RowBox[{"V0_", ":", "0"}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{
     FractionBox["\[Omega]RF", "2"], "*", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          FractionBox["1", "2"], 
          SuperscriptBox[
           RowBox[{"(", 
            FractionBox[
             RowBox[{"2", "*", "1.60217*^-19", "*", 
              RowBox[{"(", 
               RowBox[{"VRF", "*", "\[Kappa]r"}], ")"}]}], 
             RowBox[{"mass", "*", 
              SuperscriptBox["\[Omega]RF", "2"], "*", 
              SuperscriptBox["r0", "2"]}]], ")"}], "2"]}], "-", "#"}], ",", 
        RowBox[{"2.", "*", 
         FractionBox[
          RowBox[{"4", "*", "1.60217*^-19"}], 
          RowBox[{"mass", "*", 
           SuperscriptBox["\[Omega]RF", "2"]}]], "*", 
         FractionBox[
          RowBox[{"\[Kappa]z", "*", "Vz"}], 
          SuperscriptBox["z0", "2"]]}]}], "}"}], "]"}]}], "&"}], "[", 
   RowBox[{
    FractionBox[
     RowBox[{"4", "*", "1.60217*^-19"}], 
     RowBox[{"mass", "*", 
      SuperscriptBox["\[Omega]RF", "2"]}]], "*", 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{"\[Kappa]z", "*", "Vz"}], 
       SuperscriptBox["z0", "2"]], "-", 
      FractionBox[
       RowBox[{"\[Kappa]r", "*", "V0"}], 
       SuperscriptBox["r0", "2"]]}], ")"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8504391512685013`*^9, 3.8504393797473707`*^9}, {
