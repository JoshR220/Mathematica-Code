Cell[BoxData[
 RowBox[{
  RowBox[{"MotionalModes", "[", 
   RowBox[{"mArr_List", ",", "chain_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"numIons", "=", 
       RowBox[{"Length", "[", "mArr", "]"}]}], ",", 
      RowBox[{"ke2", "=", "2.30707751*^-28"}], ",", "l0", ",", "z0eq", ",", 
      "z0eqArr", ",", "L0EQlist", ",", "guessz0eq", ",", "L0Mn", ",", "VMatZ",
       ",", "VMatX"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"l0", "=", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["ke2", 
         RowBox[{
          RowBox[{"mArr", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "*", 
          SuperscriptBox[
           RowBox[{"chain", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "2"}], "]"}], "]"}], "2"]}]], ")"}], 
       RowBox[{"(", 
        RowBox[{"1", "/", "3"}], ")"}]]}], ";", 
     RowBox[{"Print", "[", "l0", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"z0eqArr", " ", "=", " ", 
      RowBox[{"Array", "[", 
       RowBox[{"z0eq", ",", "numIons"}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"L0EQlist", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"z0eqArr", "[", 
          RowBox[{"[", "#", "]"}], "]"}], "\[Equal]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Sum", "[", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{
                RowBox[{"z0eqArr", "[", 
                 RowBox[{"[", "#", "]"}], "]"}], " ", "-", " ", 
                RowBox[{"z0eqArr", "[", 
                 RowBox[{"[", "k", "]"}], "]"}]}], ")"}], 
              RowBox[{"-", "2"}]], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "1", ",", 
               RowBox[{"#", "-", "1"}]}], "}"}]}], "]"}], " ", "-", " ", 
           RowBox[{"Sum", "[", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{
                RowBox[{"z0eqArr", "[", 
                 RowBox[{"[", "#", "]"}], "]"}], " ", "-", " ", 
                RowBox[{"z0eqArr", "[", 
                 RowBox[{"[", "k", "]"}], "]"}]}], ")"}], 
              RowBox[{"-", "2"}]], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", " ", 
               RowBox[{"#", "+", "1"}], ",", "numIons"}], "}"}]}], "]"}]}], 
          ")"}]}], "&"}], "/@", 
       RowBox[{"Range", "[", "numIons", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"guessz0eq", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"-", "#"}], ",", "#", ",", 
           RowBox[{"2", "*", 
            RowBox[{"#", "/", 
             RowBox[{"(", 
              RowBox[{"numIons", "-", "1"}], ")"}]}]}]}], "]"}], "&"}], "[", 
        SuperscriptBox["numIons", 
         RowBox[{"(", 
          RowBox[{"1", "/", "3"}], ")"}]], "]"}], "//", "N"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"guessz0eq", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", "z0eqArr", "}"}], ",", 
         RowBox[{"{", "guessz0eq", "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"z0eqArr", "=", 
      RowBox[{"z0eqArr", "/.", 
       RowBox[{"Chop", "[", 
        RowBox[{"FindRoot", "[", 
         RowBox[{"L0EQlist", ",", "guessz0eq"}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"L0Mn", "=", 
      RowBox[{"Abs", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"i", "==", "j"}], ",", "0", ",", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{"z0eqArr", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "-", 
              RowBox[{"z0eqArr", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}], ")"}], 
            RowBox[{"-", "3"}]]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "numIons"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "numIons"}], "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"VMatZ", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         SqrtBox[
          FractionBox[
           RowBox[{"mArr", "[", 
            RowBox[{"[", "i", "]"}], "]"}], 
           RowBox[{"mArr", "[", 
            RowBox[{"[", "j", "]"}], "]"}]]], "*", 
         SuperscriptBox[
          RowBox[{"chain", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "i"}], "]"}], "]"}], "2"], "*", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"i", "==", "j"}], ",", 
           RowBox[{"1", "+", 
            RowBox[{"2", "*", 
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{"L0Mn", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "id"}], "]"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"id", ",", "numIons"}], "}"}]}], "]"}]}]}], ",", 
           RowBox[{
            RowBox[{"-", "2"}], "*", 
            RowBox[{"L0Mn", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j"}], "]"}], "]"}]}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "numIons"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "numIons"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"VMatX", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         SqrtBox[
          FractionBox[
           RowBox[{"mArr", "[", 
            RowBox[{"[", "i", "]"}], "]"}], 
           RowBox[{"mArr", "[", 
            RowBox[{"[", "j", "]"}], "]"}]]], "*", 
         SuperscriptBox[
          RowBox[{"chain", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "i"}], "]"}], "]"}], "2"], "*", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"i", "==", "j"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"chain", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "i"}], "]"}], "]"}], "/", 
               RowBox[{"chain", "[", 
                RowBox[{"[", 
                 RowBox[{"2", ",", "i"}], "]"}], "]"}]}], ")"}], "^", "2"}], 
            "-", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{"L0Mn", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "id"}], "]"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"id", ",", "numIons"}], "}"}]}], "]"}]}], ",", 
           RowBox[{"L0Mn", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "j"}], "]"}], "]"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "numIons"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "numIons"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"#", "[", 
           RowBox[{"[", 
            RowBox[{";;", ",", "1"}], "]"}], "]"}], "]"}], ",", 
         RowBox[{"#", "[", 
          RowBox[{"[", 
           RowBox[{";;", ",", "2"}], "]"}], "]"}]}], "}"}], "&"}], "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Eigensystem", "[", "VMatX", "]"}], ",", 
        RowBox[{"Eigensystem", "[", "VMatZ", "]"}]}], "}"}], "]"}]}]}], 
   "]"}]}]], "Input",
