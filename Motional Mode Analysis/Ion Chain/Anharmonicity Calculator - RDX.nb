         RowBox[{"{", 
          RowBox[{"wsecMol", ",", "wsecAtom"}], "}"}], "\[IndentingNewLine]", 
         "]"}], "/", "wmhz"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"configtitle", "=", 
