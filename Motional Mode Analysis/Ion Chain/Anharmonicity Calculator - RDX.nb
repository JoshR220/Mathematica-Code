     RowBox[{
      FractionBox["\[Omega]RF", "2"], "*", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          FractionBox[
           SuperscriptBox["qMol", "2"], "2"], "-", 
          RowBox[{"(", 
           RowBox[{"#", "-", 
            FractionBox[
             RowBox[{"4", "*", "qe", "*", "\[Kappa]r", "*", "V0"}], 
             RowBox[{"mMol", "*", 
              SuperscriptBox["\[Omega]RF", "2"], "*", 
              SuperscriptBox["r0", "2"]}]]}], ")"}]}], ",", 
         RowBox[{
          FractionBox[
           SuperscriptBox["qMol", "2"], "2"], "-", 
          RowBox[{"(", 
           RowBox[{"#", "+", 
            FractionBox[
             RowBox[{"4", "*", "qe", "*", "\[Kappa]r", "*", "V0"}], 
             RowBox[{"mMol", "*", 
              SuperscriptBox["\[Omega]RF", "2"], "*", 
              SuperscriptBox["r0", "2"]}]]}], ")"}]}], ",", 
         RowBox[{"2.", "*", "#"}]}], "}"}], "]"}]}], "&"}], "[", 
    RowBox[{"(", 
     FractionBox[
      RowBox[{"4", "*", "qe", "*", "\[Kappa]z", "*", "U"}], 
      RowBox[{"mMol", "*", 
       SuperscriptBox["\[Omega]RF", "2"], "*", 
       SuperscriptBox["z0", "2"]}]], ")"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wsecAtom", ":=", 
