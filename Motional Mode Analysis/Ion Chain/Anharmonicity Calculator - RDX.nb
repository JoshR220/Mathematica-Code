Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Create", " ", "matrices"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"VMatZ", ":=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"mArr", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "/", 
          RowBox[{"mArr", "[", 
           RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "*", 
        RowBox[{
         RowBox[{"wsecvalsMAT", "[", 
          RowBox[{"[", 
           RowBox[{"3", ",", "i"}], "]"}], "]"}], "^", "2"}], "*", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"i", "==", "j"}], ",", 
          RowBox[{"1", "+", 
           RowBox[{"2", "*", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{"L0Mn", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "id"}], "]"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"id", ",", "numIons"}], "}"}]}], "]"}]}]}], ",", 
          RowBox[{
           RowBox[{"-", "2"}], "*", 
           RowBox[{"L0Mn", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "j"}], "]"}], "]"}]}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "numIons"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "numIons"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"VMatY", ":=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"mArr", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "/", 
          RowBox[{"mArr", "[", 
           RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "*", 
        RowBox[{
         RowBox[{"wsecvalsMAT", "[", 
          RowBox[{"[", 
           RowBox[{"3", ",", "i"}], "]"}], "]"}], "^", "2"}], "*", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"i", "==", "j"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"wsecvalsMAT", "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", "i"}], "]"}], "]"}], "/", 
              RowBox[{"wsecvalsMAT", "[", 
               RowBox[{"[", 
                RowBox[{"3", ",", "i"}], "]"}], "]"}]}], ")"}], "^", "2"}], 
           "-", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{"L0Mn", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "id"}], "]"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"id", ",", "numIons"}], "}"}]}], "]"}]}], ",", 
          RowBox[{"L0Mn", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "j"}], "]"}], "]"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "numIons"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "numIons"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"VMatX", ":=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"mArr", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "/", 
          RowBox[{"mArr", "[", 
           RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "*", 
        RowBox[{
         RowBox[{"wsecvalsMAT", "[", 
          RowBox[{"[", 
           RowBox[{"3", ",", "i"}], "]"}], "]"}], "^", "2"}], "*", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"i", "==", "j"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"wsecvalsMAT", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "i"}], "]"}], "]"}], "/", 
              RowBox[{"wsecvalsMAT", "[", 
               RowBox[{"[", 
                RowBox[{"3", ",", "i"}], "]"}], "]"}]}], ")"}], "^", "2"}], 
           "-", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{"L0Mn", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "id"}], "]"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"id", ",", "numIons"}], "}"}]}], "]"}]}], ",", 
          RowBox[{"L0Mn", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "j"}], "]"}], "]"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "numIons"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "numIons"}], "}"}]}], "]"}]}], ";"}]}]}]], "Input",
