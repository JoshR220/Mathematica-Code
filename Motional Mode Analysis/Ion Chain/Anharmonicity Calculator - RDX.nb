          RowBox[{
           RowBox[{"#", "===", "mMol"}], ",", "\"\<Q\>\"", ",", "\"\<A\>\""}],
           "]"}], "&"}], "/@", "mArr"}]}], ",", "\[IndentingNewLine]", 
      "display1", ",", "display2"}], "\[IndentingNewLine]", "}"}], ",", 
    "\[IndentingNewLine]", 
