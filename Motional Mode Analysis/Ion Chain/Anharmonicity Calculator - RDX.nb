             RowBox[{
              RowBox[{"Basis", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{";;", "numPhononStates"}], ",", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"numQubits", "+", "1"}], ")"}], "+", "#"}]}], 
                "]"}], "]"}], ",", 
              RowBox[{"\[Alpha]Arr2", "[", 
               RowBox[{"[", "#", "]"}], "]"}]}], "]"}], "]"}], "&"}], ",", 
          RowBox[{"Range", "[", "numModesTOT", "]"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
