Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CoherentState", "[", 
    RowBox[{"qubitstate_", ",", "\[Alpha]Arr_"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"startInd", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Reverse", "[", 
             RowBox[{"Apply", "[", 
              RowBox[{"Times", ",", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"Reverse", "[", "numLevels", "]"}], "[", 
                  RowBox[{"[", 
                   RowBox[{";;", 
                    RowBox[{"#", "-", "1"}]}], "]"}], "]"}], "&"}], "/@", 
                RowBox[{"Range", "[", "numQubits", "]"}]}], ",", "2"}], "]"}],
              "]"}], ".", "qubitstate"}], ")"}], "*", "numPhononStates"}], 
         "+", "1"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"\[Alpha]Arr2", "=", 
        RowBox[{"Flatten", "[", "\[Alpha]Arr", "]"}]}], ",", "coherentfunc", 
       ",", "prob"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"coherentfunc", "[", 
        RowBox[{"n_", ",", "\[Alpha]_"}], "]"}], ":=", 
       FractionBox[
        SuperscriptBox["\[Alpha]", "n"], 
