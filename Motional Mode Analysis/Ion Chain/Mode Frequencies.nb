Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Calculate", " ", "equilibrium", " ", "positions", " ", 
    RowBox[{"(", 
     RowBox[{"axial", " ", "crystal"}], ")"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"z0eqArr", " ", "=", " ", 
     RowBox[{"Array", "[", 
      RowBox[{"z0eq", ",", "numIons"}], "]"}]}], ";", 
    RowBox[{"l0", ":=", 
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox["ke2", 
        RowBox[{"mMol", "*", 
         RowBox[{
          RowBox[{"wsecMol", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "^", "2"}]}]], ")"}], 
      RowBox[{"(", 
       RowBox[{"1", "/", "3"}], ")"}]]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"L0EQlist", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"z0eqArr", "[", 
         RowBox[{"[", "#", "]"}], "]"}], "\[Equal]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Sum", "[", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               RowBox[{"z0eqArr", "[", 
                RowBox[{"[", "#", "]"}], "]"}], " ", "-", " ", 
               RowBox[{"z0eqArr", "[", 
                RowBox[{"[", "k", "]"}], "]"}]}], ")"}], 
             RowBox[{"-", "2"}]], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "1", ",", 
              RowBox[{"#", "-", "1"}]}], "}"}]}], "]"}], " ", "-", " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               RowBox[{"z0eqArr", "[", 
                RowBox[{"[", "#", "]"}], "]"}], " ", "-", " ", 
               RowBox[{"z0eqArr", "[", 
                RowBox[{"[", "k", "]"}], "]"}]}], ")"}], 
             RowBox[{"-", "2"}]], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", " ", 
              RowBox[{"#", "+", "1"}], ",", "numIons"}], "}"}]}], "]"}]}], 
         ")"}]}], "&"}], "/@", 
      RowBox[{"Range", "[", "numIons", "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"guessz0eq", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{"-", "#"}], ",", "#", ",", 
          RowBox[{"2", "*", 
           RowBox[{"#", "/", 
            RowBox[{"(", 
             RowBox[{"numIons", "-", "1"}], ")"}]}]}]}], "]"}], "&"}], "[", 
       RowBox[{"numIons", "^", 
        RowBox[{"(", 
         RowBox[{"1", "/", "3"}], ")"}]}], "]"}], "//", "N"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"guessz0eq", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", "z0eqArr", "}"}], ",", 
        RowBox[{"{", "guessz0eq", "}"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"z0eqArr", "=", 
     RowBox[{"z0eqArr", "/.", 
      RowBox[{"Chop", "[", 
       RowBox[{"FindRoot", "[", 
        RowBox[{"L0EQlist", ",", "guessz0eq"}], "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"L0Mn", "=", 
     RowBox[{"Abs", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"i", "==", "j"}], ",", "0", ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"z0eqArr", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "-", 
             RowBox[{"z0eqArr", "[", 
              RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "^", 
           RowBox[{"(", 
            RowBox[{"-", "3"}], ")"}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "numIons"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "numIons"}], "}"}]}], "]"}], "]"}]}], 
    ";"}]}]}]], "Input",
