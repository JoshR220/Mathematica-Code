          RowBox[{
           RowBox[{"-", "2"}], "*", 
           RowBox[{"L0Mn", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "j"}], "]"}], "]"}]}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "numIons"}], "}"}], ",", 
