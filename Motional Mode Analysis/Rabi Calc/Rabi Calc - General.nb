Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"solve", " ", "generalized", " ", "eigenvalue", " ", "problem"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"eigenval", ",", "eigenvec"}], "}"}], "=", 
     RowBox[{
      RowBox[{"Eigensystem", "[", 
       RowBox[{"{", 
        RowBox[{"BMat", ",", "DMat"}], "}"}], "]"}], "//", "Chop"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"normalize", " ", "eigenvectors"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kNorm", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{
          FractionBox["\[Pi]", "4"], "/", 
          RowBox[{"(", 
           RowBox[{"#", ".", "XklDJ", ".", "#"}], ")"}]}], "]"}], "&"}], "/@",
        "eigenvec"}], "//", "Re"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eigenvec", "*=", "kNorm"}], ";"}]}]}]], "Input",
