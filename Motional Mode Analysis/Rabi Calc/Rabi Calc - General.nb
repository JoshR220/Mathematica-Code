Cell["1.3.1 Encapsulation for Sweep", "Subsection",
 CellChangeTimes->{{3.826307022255446*^9, 3.826307027490992*^9}, {
  3.826307190401413*^9, 3.8263071933959084`*^9}, {3.826308806676347*^9, 
  3.8263088079659233`*^9}, {3.826670975355315*^9, 3.826670981336882*^9}, {
  3.8309447063813553`*^9, 3.8309447084290333`*^9}, {3.8311476451348143`*^9, 
  3.83114765995898*^9}, {3.831166579830421*^9, 3.831166589055887*^9}, {
  3.831171854307043*^9, 3.831171854497293*^9}, {3.831184328900889*^9, 
  3.831184329036425*^9}, {3.83118449295238*^9, 3.8311844953341007`*^9}, {
  3.8311850584952917`*^9, 3.831185074031704*^9}, {3.831197893961411*^9, 
  3.8311978946214437`*^9}, {3.831201426077252*^9, 
  3.831201432436843*^9}},ExpressionUUID->"e4db2ffa-d094-44fb-8373-\
5afd5af7911d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SweepFid", "[", 
   RowBox[{"u_", ",", "temp_", ",", "ions_", ",", "dir_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"XHolder", "=", 
       RowBox[{"Xkl", "[", 
        RowBox[{"u", ",", "ions", ",", "dir"}], "]"}]}], ",", 
      RowBox[{"BHolder", "=", 
       RowBox[{"Bkl", "[", 
        RowBox[{"u", ",", "temp", ",", "ions", ",", "dir"}], "]"}]}], ",", 
      "DMat", ",", "BMat", ",", "eigenval", ",", "eigenvec", ",", "kNorm", 
      ",", "validres", ",", "bestvec", ",", "fidres"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"DMat", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "+", 
         RowBox[{"Transpose", "[", "#", "]"}]}], "&"}], "[", "XHolder", 
       "]"}]}], ";", 
     RowBox[{"BMat", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "+", 
         RowBox[{"Transpose", "[", "#", "]"}]}], "&"}], "[", "BHolder", 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"eigenval", ",", "eigenvec"}], "}"}], "=", 
      RowBox[{"Chop", "[", 
       RowBox[{"Eigensystem", "[", 
        RowBox[{"{", 
         RowBox[{"BMat", ",", "DMat"}], "}"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"kNorm", "=", 
      RowBox[{"Re", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{
           FractionBox["\[Pi]", "4"], "/", 
           RowBox[{"(", 
            RowBox[{"#", ".", "XHolder", ".", "#"}], ")"}]}], "]"}], "&"}], "/@",
         "eigenvec"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"eigenvec", "*=", "kNorm"}], ";", "\[IndentingNewLine]", 
     RowBox[{"validres", "=", 
      RowBox[{"Intersection", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{
           RowBox[{"Total", "[", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"Re", "[", "eigenvec", "]"}], "]"}], ",", 
             RowBox[{"{", "2", "}"}]}], "]"}], ",", 
           RowBox[{"_", "?", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"#", "!=", "0"}], "&"}], ")"}]}]}], "]"}], "//", 
         "Flatten"}], ",", 
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{
           RowBox[{"Total", "[", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"Im", "[", "eigenvec", "]"}], "]"}], ",", 
             RowBox[{"{", "2", "}"}]}], "]"}], ",", 
           RowBox[{"_", "?", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"#", "==", "0"}], "&"}], ")"}]}]}], "]"}], "//", 
         "Flatten"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"eigenval", "=", 
      RowBox[{"eigenval", "[", 
       RowBox[{"[", "validres", "]"}], "]"}]}], ";", 
     RowBox[{"eigenvec", "=", 
      RowBox[{"eigenvec", "[", 
       RowBox[{"[", "validres", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"bestvec", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "validres", "]"}], "\[Equal]", "0"}], ",", 
        RowBox[{"{", "}"}], ",", 
        RowBox[{"eigenvec", "[", 
         RowBox[{"[", 
          RowBox[{"First", "@", 
           RowBox[{"Ordering", "[", 
            RowBox[{
             RowBox[{"Abs", "[", "eigenval", "]"}], ",", "1"}], "]"}]}], 
          "]"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"fidres", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "validres", "]"}], "\[Equal]", "0"}], ",", 
        "0", ",", 
        RowBox[{"Fid", "[", 
         RowBox[{"u", ",", "temp", ",", "bestvec", ",", "ions", ",", "dir"}], 
         "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"fidres", ",", "bestvec"}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.831202643460623*^9, 3.831202643581959*^9}, {
