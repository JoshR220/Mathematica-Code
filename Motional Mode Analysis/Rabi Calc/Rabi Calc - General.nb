         RowBox[{"[", 
          RowBox[{"dir", ",", "mode"}], "]"}], "]"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"UpperFunc1", "[", "t_", "]"}], ":=", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["u", "2"], "-", 
           SuperscriptBox["w", "2"]}], ")"}], 
         RowBox[{"-", "1"}]], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"u", "*", 
           RowBox[{"Sin", "[", 
            RowBox[{"u", "*", "t"}], "]"}], "*", 
           RowBox[{"Cos", "[", 
            RowBox[{"w", "*", "t"}], "]"}]}], "-", 
          RowBox[{"w", "*", 
           RowBox[{"Sin", "[", 
            RowBox[{"w", "*", "t"}], "]"}], "*", 
           RowBox[{"Cos", "[", 
            RowBox[{"u", "*", "t"}], "]"}]}]}], ")"}]}]}], ";", 
      RowBox[{"upper1", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"2", ";;"}], "]"}], "]"}], "-", 
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{";;", 
              RowBox[{"-", "2"}]}], "]"}], "]"}]}], ")"}], "&"}], "[", 
        RowBox[{"UpperFunc1", "/@", "tArr"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"UpperFunc2", "[", "t_", "]"}], ":=", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["u", "2"], "-", 
           SuperscriptBox["w", "2"]}], ")"}], 
         RowBox[{"-", "1"}]], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"w", "*", 
           RowBox[{"Cos", "[", 
            RowBox[{"w", "*", "t"}], "]"}], "*", 
           RowBox[{"Cos", "[", 
            RowBox[{"u", "*", "t"}], "]"}]}], "+", 
          RowBox[{"u", "*", 
           RowBox[{"Sin", "[", 
            RowBox[{"w", "*", "t"}], "]"}], "*", 
