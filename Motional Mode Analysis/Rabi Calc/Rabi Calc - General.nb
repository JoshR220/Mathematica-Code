Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"XklInd", "[", 
    RowBox[{"u_", ",", "mode_", ",", "dir_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "UpperFunc1", ",", "UpperFunc2", ",", "upper1", ",", "upper2", ",", 
