            RowBox[{"u", "*", "t"}], "]"}]}]}], ")"}]}]}], ";", 
      RowBox[{"upper2", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"2", ";;"}], "]"}], "]"}], "-", 
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{";;", 
              RowBox[{"-", "2"}]}], "]"}], "]"}]}], ")"}], "&"}], "[", 
        RowBox[{"UpperFunc2", "/@", "tArr"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"DiagFunc", "[", 
        RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
       RowBox[{
        FractionBox[
         RowBox[{"-", "1"}], 
         RowBox[{
          SuperscriptBox["u", "2"], "-", 
          SuperscriptBox["w", "2"]}]], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           FractionBox["w", "2"], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"b", "-", "a"}], ")"}], "+", 
             FractionBox[
              RowBox[{
               RowBox[{"Sin", "[", 
                RowBox[{"2", "*", "u", "*", "b"}], "]"}], "-", 
               RowBox[{"Sin", "[", 
                RowBox[{"2", "*", "u", "*", "a"}], "]"}]}], 
              RowBox[{"2", "*", "u"}]]}], ")"}]}], "+", 
          RowBox[{
           FractionBox[
            RowBox[{"u", "*", 
             RowBox[{"Sin", "[", 
              RowBox[{"u", "*", "a"}], "]"}]}], 
            RowBox[{
             SuperscriptBox["u", "2"], "-", 
             SuperscriptBox["w", "2"]}]], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"w", "*", 
              RowBox[{"Cos", "[", 
               RowBox[{"w", "*", 
                RowBox[{"(", 
                 RowBox[{"b", "-", "a"}], ")"}]}], "]"}], "*", 
              RowBox[{"Cos", "[", 
               RowBox[{"u", "*", "b"}], "]"}]}], "+", 
             RowBox[{"u", "*", 
              RowBox[{"Sin", "[", 
               RowBox[{"u", "*", "b"}], "]"}], "*", 
              RowBox[{"Sin", "[", 
               RowBox[{"w", "*", 
                RowBox[{"(", 
                 RowBox[{"b", "-", "a"}], ")"}]}], "]"}]}], "-", 
             RowBox[{"w", "*", 
              RowBox[{"Cos", "[", 
               RowBox[{"u", "*", "a"}], "]"}]}]}], ")"}]}], "-", 
          RowBox[{
           FractionBox[
            RowBox[{"w", "*", 
             RowBox[{"Cos", "[", 
              RowBox[{"u", "*", "a"}], "]"}]}], 
            RowBox[{
             SuperscriptBox["u", "2"], "-", 
             SuperscriptBox["w", "2"]}]], "*", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"u", "*", 
              RowBox[{"Cos", "[", 
               RowBox[{"w", "*", 
                RowBox[{"(", 
                 RowBox[{"b", "-", "a"}], ")"}]}], "]"}], "*", 
              RowBox[{"Sin", "[", 
               RowBox[{"u", "*", "b"}], "]"}]}], "-", 
             RowBox[{"w", "*", 
              RowBox[{"Sin", "[", 
               RowBox[{"w", "*", 
                RowBox[{"(", 
                 RowBox[{"b", "-", "a"}], ")"}]}], "]"}], "*", 
              RowBox[{"Cos", "[", 
               RowBox[{"u", "*", "b"}], "]"}]}], "-", 
             RowBox[{"u", "*", 
              RowBox[{"Sin", "[", 
               RowBox[{"u", "*", "a"}], "]"}]}]}], ")"}]}]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"upper", "=", 
