Cell[BoxData[
 RowBox[{
  RowBox[{"XklInd", "[", 
   RowBox[{"u_", ",", "mode_", ",", "dir_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"upper1", "=", 
       RowBox[{"upper1f", "[", 
        RowBox[{
         RowBox[{"u", "+", 
          RowBox[{"wmvals", "[", 
           RowBox[{"[", 
            RowBox[{"dir", ",", "mode"}], "]"}], "]"}]}], ",", 
         RowBox[{"u", "-", 
          RowBox[{"wmvals", "[", 
           RowBox[{"[", 
            RowBox[{"dir", ",", "mode"}], "]"}], "]"}]}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"upper2", "=", 
       RowBox[{"upper2f", "[", 
        RowBox[{
         RowBox[{"u", "+", 
          RowBox[{"wmvals", "[", 
           RowBox[{"[", 
            RowBox[{"dir", ",", "mode"}], "]"}], "]"}]}], ",", 
         RowBox[{"u", "-", 
          RowBox[{"wmvals", "[", 
           RowBox[{"[", 
            RowBox[{"dir", ",", "mode"}], "]"}], "]"}]}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"diag1", "=", 
       RowBox[{"diag1f", "[", 
        RowBox[{
         RowBox[{"u", "+", 
          RowBox[{"wmvals", "[", 
           RowBox[{"[", 
            RowBox[{"dir", ",", "mode"}], "]"}], "]"}]}], ",", 
         RowBox[{"u", "-", 
          RowBox[{"wmvals", "[", 
           RowBox[{"[", 
            RowBox[{"dir", ",", "mode"}], "]"}], "]"}]}], ",", "u", ",", 
         RowBox[{"wmvals", "[", 
          RowBox[{"[", 
           RowBox[{"dir", ",", "mode"}], "]"}], "]"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", "upperMat", ",", "diagMat"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"upperMat", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"LowerTriangularize", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", "#1", "]"}], "-", "#1"}], "]"}], "&"}], 
        ")"}], "[", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"upper1", "\[LeftDoubleBracket]", 
           RowBox[{"2", ";;"}], "\[RightDoubleBracket]"}], "-", 
          RowBox[{"upper1", "\[LeftDoubleBracket]", 
           RowBox[{"1", ";;", 
            RowBox[{"-", "2"}]}], "\[RightDoubleBracket]"}]}], ",", 
         RowBox[{
          RowBox[{"upper2", "\[LeftDoubleBracket]", 
           RowBox[{"2", ";;"}], "\[RightDoubleBracket]"}], "-", 
          RowBox[{"upper2", "\[LeftDoubleBracket]", 
           RowBox[{"1", ";;", 
            RowBox[{"-", "2"}]}], "\[RightDoubleBracket]"}]}]}], "]"}], 
       "]"}]}], ";", 
     RowBox[{"diagMat", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"DiagonalMatrix", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
