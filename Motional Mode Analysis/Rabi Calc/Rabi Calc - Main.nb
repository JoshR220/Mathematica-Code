Cell[BoxData[
 RowBox[{
  RowBox[{"diag1f", "=", 
   RowBox[{"Compile", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"up", ",", "_Real"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"um", ",", "_Real"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"u", ",", "_Real"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"w", ",", "_Real"}], "}"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      FractionBox["0.25", 
       RowBox[{"(", 
        RowBox[{"up", "*", "um"}], ")"}]], 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"2.", "*", "w", "*", "u", "*", "tArr"}], "+", 
          RowBox[{"u", " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"2.", "*", "w", "*", "tArr"}], "]"}]}], "-", 
          RowBox[{"w", " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"2.", "*", "u", "*", "tArr"}], "]"}]}]}], "u"], "-", 
        RowBox[{"0.5", "*", 
         FractionBox[
          RowBox[{
           RowBox[{
            SuperscriptBox["um", "2"], " ", 
            RowBox[{"Sin", "[", 
             RowBox[{"2.", "*", "up", "*", "tArr"}], "]"}]}], "+", 
