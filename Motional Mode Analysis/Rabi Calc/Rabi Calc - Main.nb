   RowBox[{"cost", "[", "\[Theta]_", "]"}], ":=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"NIntegrate", "[", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{"\[ImaginaryI]", "*", "#"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", 
             RowBox[{"tArr", "[", 
              RowBox[{"[", 
               RowBox[{"-", "1"}], "]"}], "]"}]}], "}"}]}], "]"}], ")"}], 
        "2"], "&"}], "[", 
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{"\[Theta]", "[", "t1", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"t1", ",", "0", ",", "t"}], "}"}]}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "numIons"}], "}"}]}], "]"}]}]}]], "Input",
