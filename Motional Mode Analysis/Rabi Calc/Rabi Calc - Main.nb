Cell[BoxData[
 RowBox[{
  RowBox[{"Aim", "=", 
   RowBox[{"Compile", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"u", ",", "_Real"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"w", ",", "_Real"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Eta]", ",", "_Real"}], "}"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         FractionBox["\[Eta]", 
          RowBox[{
           SuperscriptBox["u", "2"], "-", 
           SuperscriptBox["w", "2"]}]], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;", 
             RowBox[{"-", "1"}]}], "]"}], "]"}], "-", 
          RowBox[{"#", "[", 
           RowBox[{"[", 
            RowBox[{";;", 
             RowBox[{"-", "2"}]}], "]"}], "]"}]}], ")"}]}], "&"}], "[", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"\[ImaginaryI]", "*", "w", "*", "tArr"}], "]"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"u", "*", 
          RowBox[{"Cos", "[", 
           RowBox[{"u", "*", "tArr"}], "]"}]}], "-", 
         RowBox[{"\[ImaginaryI]", "*", "w", "*", 
          RowBox[{"Sin", "[", 
           RowBox[{"u", "*", "tArr"}], "]"}]}]}], ")"}]}], "]"}], ",", 
     RowBox[{"CompilationTarget", "\[Rule]", "\"\<C\>\""}]}], "]"}]}], 
