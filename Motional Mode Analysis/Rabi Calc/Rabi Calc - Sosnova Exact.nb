   "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"w", "=", 
      RowBox[{"wmvals", "[", 
       RowBox[{"[", 
        RowBox[{"dir", ",", "mode"}], "]"}], "]"}]}], "}"}], ",", 
