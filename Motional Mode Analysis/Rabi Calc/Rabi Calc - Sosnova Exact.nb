  RowBox[{
   RowBox[{
    RowBox[{"VMatZ", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"mArr", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "/", 
