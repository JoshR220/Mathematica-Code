            RowBox[{"[", "2", "]"}], "]"}], "^", "2"}]}], ")"}]}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"1", "/", "3"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"L0EQlist", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"z0eqArr", "[", 
         RowBox[{"[", "#", "]"}], "]"}], "\[Equal]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"z0eqArr", "[", 
                RowBox[{"[", "#", "]"}], "]"}], " ", "-", " ", 
               RowBox[{"z0eqArr", "[", 
                RowBox[{"[", "k", "]"}], "]"}]}], ")"}], "^", 
             RowBox[{"(", 
              RowBox[{"-", "2"}], ")"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "1", ",", 
              RowBox[{"#", "-", "1"}]}], "}"}]}], "]"}], " ", "-", " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"z0eqArr", "[", 
                RowBox[{"[", "#", "]"}], "]"}], " ", "-", " ", 
               RowBox[{"z0eqArr", "[", 
                RowBox[{"[", "k", "]"}], "]"}]}], ")"}], "^", 
             RowBox[{"(", 
              RowBox[{"-", "2"}], ")"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", " ", 
              RowBox[{"#", "+", "1"}], ",", "numIons"}], "}"}]}], "]"}]}], 
         ")"}]}], "&"}], "/@", 
      RowBox[{"Range", "[", "numIons", "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"guessz0eq", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{"-", "#"}], ",", "#", ",", 
          RowBox[{"2", "*", 
           RowBox[{"#", "/", 
            RowBox[{"(", 
             RowBox[{"numIons", "-", "1"}], ")"}]}]}]}], "]"}], "&"}], "[", 
       RowBox[{"numIons", "^", 
        RowBox[{"(", 
         RowBox[{"1", "/", "3"}], ")"}]}], "]"}], "//", "N"}]}], ";", 
    RowBox[{"guessz0eq", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", "z0eqArr", "}"}], ",", 
        RowBox[{"{", "guessz0eq", "}"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"z0eqArr", "=", 
     RowBox[{"z0eqArr", "/.", 
      RowBox[{"Chop", "[", 
       RowBox[{"FindRoot", "[", 
        RowBox[{"L0EQlist", ",", "guessz0eq"}], "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"L0Mn", "=", 
     RowBox[{"Abs", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"If", "[", 
