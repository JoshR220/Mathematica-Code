        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"i", "==", "j"}], ",", 
          RowBox[{"1", "+", 
           RowBox[{"2", "*", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{"L0Mn", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "id"}], "]"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"id", ",", "numIons"}], "}"}]}], "]"}]}]}], ",", 
          RowBox[{
           RowBox[{"-", "2"}], "*", 
           RowBox[{"L0Mn", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "j"}], "]"}], "]"}]}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "numIons"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "numIons"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"VMatX", "=", 
