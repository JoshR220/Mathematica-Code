          RowBox[{"mArr", "[", 
           RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "*", 
        RowBox[{
         RowBox[{"wsecvalsMAT", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "i"}], "]"}], "]"}], "^", "2"}], "*", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"i", "==", "j"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"wsecvalsMAT", "[", 
               RowBox[{"[", 
