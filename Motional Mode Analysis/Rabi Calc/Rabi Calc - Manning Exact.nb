      RowBox[{"(", 
       RowBox[{"1", "/", "3"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"L0EQlist", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"z0eqArr", "[", 
         RowBox[{"[", "#", "]"}], "]"}], "\[Equal]", 
        RowBox[{"(", 
