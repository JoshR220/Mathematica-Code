               RowBox[{"z0eqArr", "[", 
                RowBox[{"[", "#", "]"}], "]"}], " ", "-", " ", 
               RowBox[{"z0eqArr", "[", 
                RowBox[{"[", "k", "]"}], "]"}]}], ")"}], "^", 
             RowBox[{"(", 
              RowBox[{"-", "2"}], ")"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", " ", 
              RowBox[{"#", "+", "1"}], ",", "numIons"}], "}"}]}], "]"}]}], 
         ")"}]}], "&"}], "/@", 
      RowBox[{"Range", "[", "numIons", "]"}]}]}], ";"}], 
