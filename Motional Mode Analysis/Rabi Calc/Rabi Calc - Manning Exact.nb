  3.831184329036425*^9}, {3.83118449295238*^9, 3.8311844953341007`*^9}, {
  3.8311850584952917`*^9, 3.831185074031704*^9}, {3.831197893961411*^9, 
  3.8311978946214437`*^9}, {3.831201426077252*^9, 
