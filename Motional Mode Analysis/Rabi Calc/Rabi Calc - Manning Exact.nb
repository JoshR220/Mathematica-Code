  RowBox[{
   RowBox[{
    RowBox[{"z0eqArr", " ", "=", " ", 
     RowBox[{"Array", "[", 
      RowBox[{"z0eq", ",", "numIons"}], "]"}]}], ";", 
    RowBox[{"l0", ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"ke2", "/", 
