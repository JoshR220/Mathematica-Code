Cell[BoxData[
 RowBox[{
  RowBox[{"Aim", "[", 
   RowBox[{
   "u_Real", ",", "ion_Integer", ",", "mode_Integer", ",", "dir_Integer"}], 
   "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"w", "=", 
      RowBox[{"wmvals", "[", 
       RowBox[{"[", 
        RowBox[{"dir", ",", "mode"}], "]"}], "]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"(", 
      FractionBox[
       RowBox[{"\[Eta]", "[", 
        RowBox[{"[", 
         RowBox[{"dir", ",", "ion", ",", "mode"}], "]"}], "]"}], 
       RowBox[{
        SuperscriptBox["u", "2"], "-", 
        SuperscriptBox["w", "2"]}]], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"#1", "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], "-", 
          RowBox[{"#1", "[", 
           RowBox[{"[", 
            RowBox[{";;", 
             RowBox[{"-", "2"}]}], "]"}], "]"}]}], ")"}], "&"}], "[", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"\[ImaginaryI]", "*", "w", "*", "tArr"}], "]"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[ImaginaryI]", "*", "w", "*", 
           RowBox[{"Sin", "[", 
            RowBox[{"u", "*", "tArr"}], "]"}]}], "-", 
          RowBox[{"u", "*", 
           RowBox[{"Cos", "[", 
            RowBox[{"u", "*", "tArr"}], "]"}]}]}], ")"}]}], "]"}], ")"}]}]}], 
