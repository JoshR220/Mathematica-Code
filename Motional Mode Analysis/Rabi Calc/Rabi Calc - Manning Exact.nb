                RowBox[{"[", "k", "]"}], "]"}]}], ")"}], "^", 
             RowBox[{"(", 
              RowBox[{"-", "2"}], ")"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "1", ",", 
              RowBox[{"#", "-", "1"}]}], "}"}]}], "]"}], " ", "-", " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
