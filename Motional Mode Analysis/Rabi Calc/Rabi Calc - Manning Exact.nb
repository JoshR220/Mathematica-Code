5afd5af7911d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SweepFid", "[", 
   RowBox[{"u_", ",", "temp_", ",", "ions_", ",", "dir_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"XHolder", "=", 
       RowBox[{"Xkl", "[", 
        RowBox[{"u", ",", "ions", ",", "dir"}], "]"}]}], ",", 
      RowBox[{"BHolder", "=", 
       RowBox[{"Bkl", "[", 
        RowBox[{"u", ",", "temp", ",", "ions", ",", "dir"}], "]"}]}], ",", 
      "DMat", ",", "BMat", ",", "eigenval", ",", "eigenvec", ",", "kNorm", 
      ",", "fids"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"DMat", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "+", 
         RowBox[{"Transpose", "[", "#", "]"}]}], "&"}], "[", "XHolder", 
       "]"}]}], ";", 
     RowBox[{"BMat", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "+", 
         RowBox[{"Transpose", "[", "#", "]"}]}], "&"}], "[", "BHolder", 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"eigenval", ",", "eigenvec"}], "}"}], "=", 
      RowBox[{"Chop", "[", 
       RowBox[{"Eigensystem", "[", 
        RowBox[{"{", 
         RowBox[{"BMat", ",", "DMat"}], "}"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"kNorm", "=", 
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{
           FractionBox["\[Pi]", "4"], "/", 
           RowBox[{"(", 
            RowBox[{"#", ".", "XHolder", ".", "#"}], ")"}]}], "]"}], "&"}], "/@",
         "eigenvec"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"eigenvec", "*=", "kNorm"}], ";", "\[IndentingNewLine]", 
     RowBox[{"fids", "=", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Fid", "[", 
          RowBox[{"u", ",", "temp", ",", "#", ",", "ions", ",", "dir"}], 
          "]"}], "&"}], ",", "eigenvec"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"validres", "=", 
        RowBox[{"Intersection", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{"Total", "[", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"Re", "[", "eigenvec", "]"}], "]"}], ",", 
               RowBox[{"{", "2", "}"}]}], "]"}], ",", 
             RowBox[{"_", "?", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"#", "!=", "0"}], "&"}], ")"}]}]}], "]"}], "//", 
           "Flatten"}], ",", 
          RowBox[{
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{"Total", "[", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"Im", "[", "eigenvec", "]"}], "]"}], ",", 
               RowBox[{"{", "2", "}"}]}], "]"}], ",", 
             RowBox[{"_", "?", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"#", "==", "0"}], "&"}], ")"}]}]}], "]"}], "//", 
           "Flatten"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"eigenval", "=", 
        RowBox[{"eigenval", "[", 
         RowBox[{"[", "validres", "]"}], "]"}]}], ";", 
       RowBox[{"eigenvec", "=", 
        RowBox[{"eigenvec", "[", 
         RowBox[{"[", "validres", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"bestvec", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "validres", "]"}], "\[Equal]", "0"}], ",", 
          RowBox[{"{", "}"}], ",", 
          RowBox[{"eigenvec", "[", 
           RowBox[{"[", 
            RowBox[{"First", "@", 
             RowBox[{"Ordering", "[", 
              RowBox[{
               RowBox[{"Abs", "[", "eigenval", "]"}], ",", "1"}], "]"}]}], 
            "]"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"fidres", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "validres", "]"}], "\[Equal]", "0"}], ",", 
          "0", ",", 
          RowBox[{"Fid", "[", 
           RowBox[{
           "u", ",", "temp", ",", "bestvec", ",", "ions", ",", "dir"}], 
           "]"}]}], "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Fid", "[", 
          RowBox[{"u", ",", "temp", ",", "#", ",", "ions", ",", "dir"}], 
          "]"}], ",", "#"}], "}"}], "&"}], "[", 
      RowBox[{"eigenvec", "[", 
       RowBox[{"[", 
        RowBox[{"First", "@", 
         RowBox[{"Ordering", "[", 
          RowBox[{
           RowBox[{"Abs", "[", "fids", "]"}], ",", 
           RowBox[{"-", "1"}]}], "]"}]}], "]"}], "]"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.831202643460623*^9, 3.831202643581959*^9}, {
