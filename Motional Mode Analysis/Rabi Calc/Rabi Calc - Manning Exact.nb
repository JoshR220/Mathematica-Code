Cell[BoxData[
 RowBox[{
  RowBox[{"XklInd", "[", 
   RowBox[{"u_", ",", "mode_", ",", "dir_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"w", "=", 
       RowBox[{"wmvals", "\[LeftDoubleBracket]", 
        RowBox[{"dir", ",", "mode"}], "\[RightDoubleBracket]"}]}], ",", 
      RowBox[{"up", "=", 
       RowBox[{"u", "+", 
        RowBox[{"wmvals", "\[LeftDoubleBracket]", 
         RowBox[{"dir", ",", "mode"}], "\[RightDoubleBracket]"}]}]}], ",", 
      RowBox[{"um", "=", 
       RowBox[{"u", "-", 
        RowBox[{"wmvals", "\[LeftDoubleBracket]", 
         RowBox[{"dir", ",", "mode"}], "\[RightDoubleBracket]"}]}]}], ",", 
      "upper1", ",", "upper2", ",", "diag1", ",", "upperMat", ",", 
      "diagMat"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"upper1", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          RowBox[{
           RowBox[{"up", "*", 
            RowBox[{"Sin", "[", 
             RowBox[{"um", "*", "#1"}], "]"}]}], "-", 
           RowBox[{"um", "*", 
            RowBox[{"Sin", "[", 
             RowBox[{"up", "*", "#1"}], "]"}]}]}], 
          RowBox[{"2", " ", 
           RowBox[{"(", 
            RowBox[{"up", "*", "um"}], ")"}]}]], "&"}], ")"}], "/@", 
       "tArr"}]}], ";", 
     RowBox[{"upper2", "=", 
      RowBox[{"-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{
            RowBox[{"up", " ", 
             RowBox[{"Cos", "[", 
              RowBox[{"um", " ", "#1"}], "]"}]}], "+", 
            RowBox[{"um", " ", 
             RowBox[{"Cos", "[", 
              RowBox[{"up", " ", "#1"}], "]"}]}]}], 
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{"up", "*", "um"}], ")"}]}]], "&"}], ")"}], "/@", 
        "tArr"}]}]}], ";", 
     RowBox[{"diag1", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         FractionBox["1", 
          RowBox[{"4", " ", 
           RowBox[{"(", 
            RowBox[{"up", "*", "um"}], ")"}]}]], 
         RowBox[{"(", 
          RowBox[{
           FractionBox[
            RowBox[{
             RowBox[{"2", " ", "w", " ", "u", " ", "#1"}], "+", 
             RowBox[{"u", " ", 
              RowBox[{"Sin", "[", 
               RowBox[{"2", " ", "w", " ", "#1"}], "]"}]}], "-", 
             RowBox[{"w", " ", 
              RowBox[{"Sin", "[", 
               RowBox[{"2", " ", "u", " ", "#1"}], "]"}]}]}], "u"], "-", 
           FractionBox[
            RowBox[{
             RowBox[{
              SuperscriptBox["um", "2"], " ", 
              RowBox[{"Sin", "[", 
               RowBox[{"2", " ", "up", " ", "#1"}], "]"}]}], "+", 
             RowBox[{
              SuperscriptBox["up", "2"], " ", 
              RowBox[{"Sin", "[", 
               RowBox[{"2", " ", "um", " ", "#1"}], "]"}]}]}], 
            RowBox[{"2", " ", 
             RowBox[{"(", 
              RowBox[{"up", "*", "um"}], ")"}]}]]}], ")"}]}], "&"}], "/@", 
       "tArr"}]}], ";", 
     RowBox[{"upperMat", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"LowerTriangularize", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", "#1", "]"}], "-", "#1"}], "]"}], "&"}], 
        ")"}], "[", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"upper1", "\[LeftDoubleBracket]", 
           RowBox[{"2", ";;", "All"}], "\[RightDoubleBracket]"}], "-", 
          RowBox[{"upper1", "\[LeftDoubleBracket]", 
           RowBox[{"1", ";;", 
            RowBox[{"-", "2"}]}], "\[RightDoubleBracket]"}]}], ",", 
         RowBox[{
          RowBox[{"upper2", "\[LeftDoubleBracket]", 
           RowBox[{"2", ";;", "All"}], "\[RightDoubleBracket]"}], "-", 
          RowBox[{"upper2", "\[LeftDoubleBracket]", 
           RowBox[{"1", ";;", 
            RowBox[{"-", "2"}]}], "\[RightDoubleBracket]"}]}]}], "]"}], 
       "]"}]}], ";", 
     RowBox[{"diagMat", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"DiagonalMatrix", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"#1", "\[LeftDoubleBracket]", 
               RowBox[{"2", ";;", "All"}], "\[RightDoubleBracket]"}], "+", 
              RowBox[{"#1", "\[LeftDoubleBracket]", 
               RowBox[{"1", ";;", 
                RowBox[{"-", "2"}]}], "\[RightDoubleBracket]"}]}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"#2", "\[LeftDoubleBracket]", 
               RowBox[{"2", ";;", "All"}], "\[RightDoubleBracket]"}], "-", 
              RowBox[{"#2", "\[LeftDoubleBracket]", 
               RowBox[{"1", ";;", 
                RowBox[{"-", "2"}]}], "\[RightDoubleBracket]"}]}], ")"}]}], 
           "-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"#3", "\[LeftDoubleBracket]", 
              RowBox[{"2", ";;", "All"}], "\[RightDoubleBracket]"}], "-", 
             RowBox[{"#3", "\[LeftDoubleBracket]", 
              RowBox[{"1", ";;", 
               RowBox[{"-", "2"}]}], "\[RightDoubleBracket]"}]}], ")"}]}], 
          "]"}], "&"}], ")"}], "[", 
       RowBox[{"upper1", ",", "upper2", ",", "diag1"}], "]"}]}], ";", 
     RowBox[{"2", " ", 
      RowBox[{"(", 
       RowBox[{"upperMat", "+", "diagMat"}], ")"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8315074803590117`*^9, 3.83150755112147*^9}},
 CellLabel->
  "In[527]:=",ExpressionUUID->"433a3b3d-8bce-4798-b12f-64030cbb213a"],

