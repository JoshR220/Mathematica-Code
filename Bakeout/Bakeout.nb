Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"reshape", "[", "file_", "]"}], ":=", 
   RowBox[{"ArrayReshape", "[", 
    RowBox[{"file", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "file", "]"}], "/", "2"}], ",", "2"}], "}"}]}],
     "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"reformat", "[", 
    RowBox[{"file_", ",", 
     RowBox[{"const_", ":", "0"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"pressArr", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{"file", "[", 
          RowBox[{"[", 
           RowBox[{"2", ";;", ";;", "2"}], "]"}], "]"}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"timeArrTxt", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"ToExpression", "[", 
           RowBox[{"StringSplit", "[", 
            RowBox[{"#", ",", "\"\<:\>\""}], "]"}], "]"}], "&"}], "/@", 
         RowBox[{"Flatten", "[", 
          RowBox[{"file", "[", 
           RowBox[{"[", 
            RowBox[{"1", ";;", ";;", "2"}], "]"}], "]"}], "]"}]}]}], ",", 
       "\[IndentingNewLine]", "timeArrNum"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"timeArrNum", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "+", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "/", "60"}], "+", "const"}], 
           ")"}], "]"}], "&"}], "/@", "timeArrTxt"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"timeArrNum", ",", "pressArr"}], "}"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"day", "=", "24"}], ";"}]}], "Input",
 CellChangeTimes->{{3.8498140283654823`*^9, 3.849814054110182*^9}, {
