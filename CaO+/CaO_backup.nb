         RowBox[{
          RowBox[{
           SubscriptBox["n", 
            RowBox[{"0", ",", "J"}]], "[", "t", "]"}], "/.", "sln"}], "/.", 
         RowBox[{"t", "\[Rule]", "tProbe"}]}], ",", 
        RowBox[{"{", 
