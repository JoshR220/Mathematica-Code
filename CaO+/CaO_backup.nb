 CellLabel->
  "In[101]:=",ExpressionUUID->"9c54fd16-d16b-4134-9934-bfd52e953db2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"to", " ", "make", " ", "sure", " ", "i", " ", 
     RowBox[{"didn", "'"}], "t", " ", "mess", " ", "up"}], ",", " ", 
    RowBox[{
     RowBox[{"let", "'"}], "s", " ", "compare", " ", "to", " ", "a", " ", 
     "Maxwell", " ", "Boltzmann", " ", "distribution", " ", "to", " ", "if", 
     " ", "they", " ", "have", " ", "agreement"}]}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Be", "=", 
     RowBox[{".09", " ", "h", " ", "100", " ", "c"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Omega]e", "=", 
     RowBox[{"328", " ", "100", " ", "c", " ", "2", " ", "\[Pi]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vibMaxBoltz", "[", 
     RowBox[{"v_", ",", "T_"}], "]"}], ":=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "\[HBar]"}], " ", 
          FractionBox["\[Omega]e", 
           RowBox[{"2", "kb", " ", "T"}]]}], "]"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "\[HBar]"}], " ", 
             FractionBox["\[Omega]e", 
              RowBox[{"kb", " ", "T"}]]}], "]"}]}], ")"}], 
         RowBox[{"-", "1"}]]}], ")"}], 
      RowBox[{"-", "1"}]], 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "\[HBar]"}], " ", 
       FractionBox[
        RowBox[{"\[Omega]e", 
         RowBox[{"(", 
          RowBox[{"v", "+", 
           RowBox[{"1", "/", "2"}]}], ")"}]}], 
        RowBox[{"kb", " ", "T"}]]}], "]"}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"MaxBoltz", "[", 
     RowBox[{"v_", ",", "J_", ",", "T_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"vibMaxBoltz", "[", 
      RowBox[{"v", ",", "T"}], "]"}], 
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "J"}], "+", "1"}], ")"}], 
       RowBox[{"Exp", "[", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{" ", 
           RowBox[{"Be", " ", "J", 
            RowBox[{"(", 
             RowBox[{"J", "+", "1"}], ")"}]}]}], 
          RowBox[{"kb", " ", "T"}]]}], "]"}]}], 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "k"}], "+", "1"}], ")"}], 
         RowBox[{"Exp", "[", 
          RowBox[{"-", 
           FractionBox[
            RowBox[{" ", 
             RowBox[{"Be", " ", "k", 
              RowBox[{"(", 
               RowBox[{"k", "+", "1"}], ")"}]}]}], 
            RowBox[{"kb", " ", "T"}]]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "0", ",", "300"}], "}"}]}], "]"}]]}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"for", " ", "comparison", " ", "of", " ", "Max"}], "-", 
      RowBox[{
      "Boltz", " ", "vibrational", " ", "populations", " ", "with", " ", 
       "model"}]}], ",", " ", 
     RowBox[{"sum", " ", "over", " ", "rotational", " ", "levels"}]}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vibLevel", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"vib1", "[", "t_", "]"}], "=", 
     RowBox[{"Total", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            SubscriptBox["n", 
             RowBox[{"i", ",", "j"}]], "[", "t", "]"}], "/.", "sln"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "0", ",", 
            RowBox[{"jMax", "-", "1"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "vibLevel", ",", "vibLevel"}], "}"}]}], "]"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vibLevel", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"vib2", "[", "t_", "]"}], "=", 
     RowBox[{"Total", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            SubscriptBox["n", 
             RowBox[{"i", ",", "j"}]], "[", "t", "]"}], "/.", "sln"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "0", ",", 
            RowBox[{"jMax", "-", "1"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "vibLevel", ",", "vibLevel"}], "}"}]}], "]"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vibLevel", "=", "2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"vib3", "[", "t_", "]"}], "=", 
     RowBox[{"Total", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            SubscriptBox["n", 
             RowBox[{"i", ",", "j"}]], "[", "t", "]"}], "/.", "sln"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "0", ",", 
            RowBox[{"jMax", "-", "1"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "vibLevel", ",", "vibLevel"}], "}"}]}], "]"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"MBVib", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"MaxBoltz", "[", 
          RowBox[{"i", ",", "k", ",", "T"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "0", ",", 
           RowBox[{"jMax", "-", "1"}]}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
