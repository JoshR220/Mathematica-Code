         RowBox[{"vMax", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tProbe", "=", "10"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "this", " ", "plots", " ", "the", " ", "expected", " ", "vibrational", 
      " ", "populations", " ", "for", " ", "both", " ", "the", " ", "model", 
      " ", "and", " ", "Max"}], "-", 
