   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"rotUp", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "=", 
