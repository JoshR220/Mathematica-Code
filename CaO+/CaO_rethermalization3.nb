Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "here", " ", "I", " ", "set", " ", "the", " ", "initial", " ", 
     "conditions", " ", "to", " ", "be", " ", "perverse"}], ",", " ", 
