        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "\[HBar]"}], " ", 
             FractionBox["\[Omega]e", 
              RowBox[{"kb", " ", "T"}]]}], "]"}]}], ")"}], 
         RowBox[{"-", "1"}]]}], ")"}], 
      RowBox[{"-", "1"}]], 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "\[HBar]"}], " ", 
       FractionBox[
        RowBox[{"\[Omega]e", 
         RowBox[{"(", 
          RowBox[{"v", "+", 
           RowBox[{"1", "/", "2"}]}], ")"}]}], 
        RowBox[{"kb", " ", "T"}]]}], "]"}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"MaxBoltz", "[", 
     RowBox[{"v_", ",", "J_", ",", "T_"}], "]"}], ":=", 
    RowBox[{
