Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Now", " ", 
    RowBox[{"let", "'"}], "s", " ", "look", " ", "at", " ", "rotational", " ",
     "level", " ", "populations"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"tProbe", "=", "40000"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rotationalPop", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           SubscriptBox["n", 
            RowBox[{"0", ",", "J"}]], "[", "t", "]"}], "/.", "sln"}], "/.", 
         RowBox[{"t", "\[Rule]", "tProbe"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"J", ",", "0", ",", 
          RowBox[{"jMax", "-", "1"}]}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"MBrotPop", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"MaxBoltz", "[", 
        RowBox[{"0", ",", "J", ",", "T"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"J", ",", "0", ",", 
         RowBox[{"jMax", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rotationalPop", ",", "MBrotPop"}], "}"}], ",", 
     RowBox[{"AxesLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<rotational number\>\"", ",", "\"\<rotational pop.\>\""}], 
       "}"}]}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"Blue", ",", 
        RowBox[{"{", 
         RowBox[{"Red", ",", "Dashed"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"okay", ",", " ", 
     RowBox[{
     "it", " ", "looks", " ", "in", " ", "model", " ", "the", " ", 
      "molecules", " ", 
      RowBox[{"aren", "'"}], "t", " ", "equillibrated", " ", "rotationally"}],
      ",", " ", 
     RowBox[{"even", " ", "at", " ", "10000", " ", 
      RowBox[{"sec", ".", " ", "Blackbody"}], " ", "spectrum", " ", 
      RowBox[{"isn", "'"}], "t", " ", "peaked", " ", "very", " ", "strongly", 
      " ", "in", " ", "the", " ", "microwave", " ", "regime", " ", "so", " ", 
      "this", " ", 
      RowBox[{"isn", "'"}], "t", " ", 
      RowBox[{"surprising", ".", " ", "But"}], " ", "the", " ", "lack", " ", 
      "of", " ", "equillibriation", " ", "is", " ", "also", " ", "partly", 
      " ", "because", " ", "I", " ", "started", " ", "with", " ", "crazy", 
      " ", "initial", " ", 
      RowBox[{"conditions", ".", " ", "If"}], " ", "I", " ", "make", " ", 
      "it", " ", "more", " ", "reasonable"}], ",", " ", 
     RowBox[{
     "the", " ", "boltzman", " ", "distribution", " ", "should", " ", "be", 
      " ", "fine"}], ",", " ", 
     RowBox[{
     "or", " ", "I", " ", "could", " ", "just", " ", "wait", " ", "longer", 
      " ", "for", " ", "the", " ", "populations", " ", "to", " ", 
      RowBox[{"redistribute", ".", " ", "But"}], " ", "I", " ", 
      RowBox[{"can", "'"}], "t", " ", "propogate", " ", "my", " ", "rate", 
      " ", "equation", " ", "model", " ", "past", " ", "10000", " ", "sec", 
      " ", "without", " ", "crashing", " ", "my", " ", "computer", " ", "so", 
      " ", 
      RowBox[{"I", "'"}], "m", " ", "going", " ", "to", " ", "leave", " ", 
      "it", " ", "for", " ", "now"}]}], "*)"}]}]}]], "Input",
