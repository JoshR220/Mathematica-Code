Cell[CellGroupData[{

Cell["Find electric field as a function of axial position", "Subsubsection",
 CellChangeTimes->{{3.8000207927977023`*^9, 
  3.800020853156962*^9}},ExpressionUUID->"b133e292-60e0-4e60-8616-\
15f857213439"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalOmega]", "=", 
    RowBox[{"2", "\[Pi]", 
     RowBox[{"(", "20", ")"}], 
     SuperscriptBox["10", "6"]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"e", "=", 
    RowBox[{"1.602", " ", 
     SuperscriptBox["10", 
      RowBox[{"-", "19"}]]}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"For", " ", "+", 
     RowBox[{"/", 
      RowBox[{"-", " ", "V"}]}]}], ",", " ", 
    RowBox[{"not", " ", "for", " ", "2", " ", "rods", " ", "grounded"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    FractionBox["V", 
     SuperscriptBox[
      SubscriptBox["r", "0"], "2"]], " ", "\[Equal]", " ", 
    FractionBox["m\[Omega]\[CapitalOmega]", 
     RowBox[{
      SqrtBox["2"], "e"}]]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Ex", "=", 
    RowBox[{"2", 
     RowBox[{"(", 
      FractionBox[
       RowBox[{"m", " ", "\[Omega]", " ", "\[CapitalOmega]"}], 
       RowBox[{
        SqrtBox["2"], "e"}]], ")"}], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["10", 
        RowBox[{"-", "9"}]], "x"}], ")"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"xE", "=", 
    RowBox[{
     FractionBox["Efield", "2"], 
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        SqrtBox["2"], "e"}], 
       RowBox[{"m", " ", "\[Omega]", " ", "\[CapitalOmega]"}]], ")"}]}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{"Ex", ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "xMin", ",", "xMax"}], "}"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x (nm)\>\"", ",", "\"\<E (V/m)\>\""}], "}"}]}], ",", 
   RowBox[{"ImageSize", "\[Rule]", "600"}], ",", 
   RowBox[{"FrameStyle", "\[Rule]", 
    RowBox[{"Directive", "[", 
     RowBox[{"Black", ",", "16"}], "]"}]}]}], "]"}]}], "Input",
