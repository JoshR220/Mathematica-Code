Notebook[{

Cell[CellGroupData[{
Cell["Find wavefunction as a function of axial position", "Subsubsection",
 CellChangeTimes->{{3.8000207927977023`*^9, 
  3.800020830356782*^9}},ExpressionUUID->"41fcffb0-8ec7-45b1-b417-\
5803c66ddd46"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Omega]", "=", 
    RowBox[{"2", "\[Pi]", 
     RowBox[{"(", "3.0", ")"}], 
     SuperscriptBox["10", "6"]}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"axial", " ", "secular", " ", "frequency"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"m", "=", 
    RowBox[{"56", " ", "1.66", " ", 
     SuperscriptBox["10", 
      RowBox[{"-", "27"}]]}]}], ";", 
   RowBox[{"(*", "mass", "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"\[HBar]", "=", 
    RowBox[{"1.055", " ", 
     SuperscriptBox["10", 
      RowBox[{"-", "34"}]]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Psi]", "[", 
     RowBox[{"n_", ",", "x_"}], "]"}], ":=", 
    RowBox[{
     FractionBox["1", 
      SqrtBox[
       RowBox[{
        SuperscriptBox["2", "n"], 
        RowBox[{"n", "!"}]}]]], 
     SuperscriptBox["\[Pi]", 
      RowBox[{
       RowBox[{"-", "1"}], "/", "4"}]], 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox["x", 
           SqrtBox[
            RowBox[{"\[HBar]", "/", 
             RowBox[{"(", 
              RowBox[{"m", " ", "\[Omega]"}], ")"}]}]]], ")"}], "2"]}], "/", 
       "2"}], "]"}], 
     RowBox[{"HermiteH", "[", 
      RowBox[{"n", ",", 
       RowBox[{"(", 
        FractionBox["x", 
         SqrtBox[
          RowBox[{"\[HBar]", "/", 
           RowBox[{"(", 
            RowBox[{"m", " ", "\[Omega]"}], ")"}]}]]], ")"}]}], "]"}]}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nMin", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nMax", "=", "2"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xMin", "=", 
   RowBox[{"-", "50"}]}], ";", 
  RowBox[{"(*", "nm", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"xMax", "=", "50"}], ";", 
  RowBox[{"(*", "nm", "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"plotData", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"\[Psi]", "[", 
      RowBox[{"n", ",", 
       RowBox[{
        SuperscriptBox["10", 
         RowBox[{"-", "9"}]], "x"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "nMin", ",", "nMax"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{"plotData", ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "xMin", ",", "xMax"}], "}"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "\"\<x (nm)\>\"", ",", 
      "\"\<\!\(\*SubscriptBox[\(\[Psi]\), \(n\)]\)(x)\>\""}], "}"}]}], ",", 
   RowBox[{"ImageSize", "\[Rule]", "600"}], ",", 
   RowBox[{"FrameStyle", "\[Rule]", 
    RowBox[{"Directive", "[", 
     RowBox[{"Black", ",", "16"}], "]"}]}], ",", 
   RowBox[{"PlotLegends", "\[Rule]", 
    RowBox[{"Placed", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"\"\<n = \>\"", "<>", 
         RowBox[{"ToString", "[", "n", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "nMin", ",", "nMax"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"0.9", ",", "0.85"}], "}"}]}], "]"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.800019240439209*^9, 3.800019266119732*^9}, {
