Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sln", "=", 
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"Join", "[", 
       RowBox[{"totalEqns", ",", "initialCon"}], "]"}], ",", 
      RowBox[{"Reverse", "[", "eqnSolve", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "120000"}], "}"}], ",", 
      RowBox[{"Method", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<EquationSimplification\>\"", "->", "\"\<Residual\>\""}], 
        "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.7731692230187254`*^9, 3.7731692261304064`*^9}, {
   3.773169397163086*^9, 3.7731693979300346`*^9}, {3.773169588975274*^9, 
   3.773169589797077*^9}, 3.79826763489424*^9, 3.7982710384896755`*^9},
 CellLabel->
  "In[997]:=",ExpressionUUID->"9c54fd16-d16b-4134-9934-bfd52e953db2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"to", " ", "make", " ", "sure", " ", "i", " ", 
     RowBox[{"didn", "'"}], "t", " ", "mess", " ", "up"}], ",", " ", 
    RowBox[{
     RowBox[{"let", "'"}], "s", " ", "compare", " ", "to", " ", "a", " ", 
     "Maxwell", " ", "Boltzmann", " ", "distribution", " ", "to", " ", "if", 
     " ", "they", " ", "have", " ", "agreement"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Be", "=", 
     RowBox[{".368", "h", " ", "100", " ", "c"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Omega]e", "=", 
     RowBox[{"634", " ", "100", " ", "c", " ", "2", " ", "\[Pi]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vibMaxBoltz", "[", 
     RowBox[{"v_", ",", "T_"}], "]"}], ":=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "\[HBar]"}], " ", 
          FractionBox["\[Omega]e", 
           RowBox[{"2", "kb", " ", "T"}]]}], "]"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "\[HBar]"}], " ", 
             FractionBox["\[Omega]e", 
              RowBox[{"kb", " ", "T"}]]}], "]"}]}], ")"}], 
         RowBox[{"-", "1"}]]}], ")"}], 
      RowBox[{"-", "1"}]], 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "\[HBar]"}], " ", 
       FractionBox[
        RowBox[{"\[Omega]e", 
         RowBox[{"(", 
          RowBox[{"v", "+", 
           RowBox[{"1", "/", "2"}]}], ")"}]}], 
        RowBox[{"kb", " ", "T"}]]}], "]"}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"MaxBoltz", "[", 
     RowBox[{"v_", ",", "J_", ",", "T_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"vibMaxBoltz", "[", 
      RowBox[{"v", ",", "T"}], "]"}], 
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "J"}], "+", "1"}], ")"}], 
       RowBox[{"Exp", "[", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{" ", 
           RowBox[{"Be", " ", "J", 
            RowBox[{"(", 
             RowBox[{"J", "+", "1"}], ")"}]}]}], 
          RowBox[{"kb", " ", "T"}]]}], "]"}]}], 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "k"}], "+", "1"}], ")"}], 
         RowBox[{"Exp", "[", 
          RowBox[{"-", 
           FractionBox[
            RowBox[{" ", 
             RowBox[{"Be", " ", "k", 
              RowBox[{"(", 
               RowBox[{"k", "+", "1"}], ")"}]}]}], 
            RowBox[{"kb", " ", "T"}]]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", 
          RowBox[{"3", "/", "2"}], ",", "jMax"}], "}"}]}], "]"}]]}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"for", " ", "comparison", " ", "of", " ", "Max"}], "-", 
