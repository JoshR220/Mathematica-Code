                    RowBox[{"[", 
                    RowBox[{"2", ",", "i"}], "]"}], "]"}]}], ")"}], "^", 
                 "2"}], "-", 
                RowBox[{"Sum", "[", 
                 RowBox[{
                  RowBox[{"L0Mn", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "id"}], "]"}], "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"id", ",", "numIons"}], "}"}]}], "]"}]}], ",", 
               RowBox[{"L0Mn", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j"}], "]"}], "]"}]}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "numIons"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "numIons"}], "}"}]}], "]"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"imval", "=", 
       RowBox[{"Total", "[", 
        RowBox[{"Abs", "[", "wmvalsDJ", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"imval", ",", 
        RowBox[{"wDJ", "+", "wzsearchstep"}]}], "}"}]}]}], "]"}]}], 
