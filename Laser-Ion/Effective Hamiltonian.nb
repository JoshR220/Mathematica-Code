Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"th", "[", "wDJ_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"wsecDJ", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{
            RowBox[{"mArr", "/.", 
             RowBox[{"{", 
              RowBox[{"mMol", "\[Rule]", "wDJ"}], "}"}]}], "/.", 
            RowBox[{"{", 
             RowBox[{"mAtom", "\[Rule]", "#"}], "}"}]}], "]"}], "&"}], "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{
              SuperscriptBox[
               RowBox[{"wDJ", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "2"], "*", 
              SuperscriptBox[
               RowBox[{"(", 
                FractionBox["mMol", "mAtom"], ")"}], "2"]}], "+", 
             RowBox[{
              FractionBox["1", "2"], 
              RowBox[{"(", 
               RowBox[{"1", "-", 
                SuperscriptBox[
                 RowBox[{"(", 
                  FractionBox["mMol", "mAtom"], ")"}], "2"]}], ")"}]}]}], 
            "]"}], ",", 
           RowBox[{
            RowBox[{"wDJ", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "*", 
            SqrtBox[
             FractionBox["mMol", "mAtom"]]}]}], "}"}], "]"}]}], ",", 
       "wmvalsDJ", ",", "imval"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"wmvalsDJ", "=", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"Eigensystem", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Sqrt", "[", 
              RowBox[{
               RowBox[{"mArr", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "/", 
               RowBox[{"mArr", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "*", 
             RowBox[{
              RowBox[{"wsecDJ", "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", "i"}], "]"}], "]"}], "^", "2"}], "*", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"i", "==", "j"}], ",", 
