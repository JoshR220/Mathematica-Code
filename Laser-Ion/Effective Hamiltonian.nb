Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ShowTrap", "[", "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"trapres", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"ValueQ", "[", "U", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"VRF", ",", "U", ",", 
            RowBox[{"\[Omega]RF", "/", "wmhz"}], ",", 
            RowBox[{"r0", "/", "mm"}], ",", 
            RowBox[{"z0", "/", "mm"}], ",", "qMol", ",", "\[Kappa]r", ",", 
            "\[Kappa]z"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"VRF", ",", 
            RowBox[{"\[Omega]RF", "/", "wmhz"}], ",", 
            RowBox[{"r0", "/", "mm"}], ",", "qMol"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"traplabels", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"ValueQ", "[", "U", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{
           "\"\<\!\(\*SubscriptBox[\(V\), \(RF\)]\) (V)\>\"", ",", 
            "\"\<\!\(\*SubscriptBox[\(V\), \(DC\)]\) (V)\>\"", ",", 
            "\"\<\!\(\*SubscriptBox[\(\[Omega]\), \(RF\)]\) (x2\[Pi] \
MHz)\>\"", ",", "\"\<r0 (mm)\>\"", ",", "\"\<z0 (mm)\>\"", ",", 
            "\"\<q (Mol)\>\"", ",", "\"\<\[Kappa]r\>\"", ",", 
            "\"\<\[Kappa]z\>\""}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
