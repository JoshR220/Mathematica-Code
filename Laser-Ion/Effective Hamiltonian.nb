          RowBox[{"[", 
           RowBox[{"dir", ",", "n"}], "]"}], "]"}]}], "]"}], "]"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Basis", "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", 
           RowBox[{
