Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"pulsesweep", "[", 
    RowBox[{"t_", ",", "tl_", ",", "tk_"}], "]"}], ":=", 
   RowBox[{"0.5", "*", 
    RowBox[{"(", 
     RowBox[{"Erfc", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"t", "-", "tl"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"0.5", "*", "tk"}], ")"}]}], "]"}], ")"}], "*", 
    FractionBox[
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"Erf", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "t"}], "/", 
          RowBox[{"(", 
           RowBox[{"0.5", "*", "tk"}], ")"}]}], "+", "2"}], " ", "]"}]}], 
      ")"}], "2"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pulseArr", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"pulsesweep", "[", 
      RowBox[{"t", ",", "#", ",", "tconst"}], "]"}], "&"}], "/@", 
    "tsweepArr"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{"{", 
       RowBox[{"pulseArr", "[", 
        RowBox[{"[", 
         RowBox[{"{", 
          RowBox[{"#1", ",", "#2"}], "}"}], "]"}], "]"}], "}"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", 
       RowBox[{"tminArr", "[", 
        RowBox[{"[", "#1", "]"}], "]"}], ",", 
       RowBox[{"tmaxArr", "[", 
        RowBox[{"[", "#1", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"PlotRange", "\[Rule]", "Full"}], ",", 
     RowBox[{"ImageSize", "\[Rule]", "Large"}]}], "]"}], "&"}], "[", 
  RowBox[{"5", ",", 
   RowBox[{"-", "1"}]}], "]"}]}], "Input",
