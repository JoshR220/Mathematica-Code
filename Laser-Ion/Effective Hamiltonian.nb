 RowBox[{
  RowBox[{"GetPoints", "[", 
   RowBox[{"func_", ",", "t1_", ",", "t2_", ",", 
    RowBox[{"numPoints_", ":", "300"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"func2", ",", 
      RowBox[{"tArr", "=", 
       RowBox[{"Range", "[", 
        RowBox[{"t1", ",", "t2", ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"t2", "-", "t1"}], ")"}], "/", 
          RowBox[{"(", "numPoints", ")"}]}]}], "]"}]}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"func2", "[", "tDJ_", "]"}], ":=", 
      RowBox[{"Evaluate", "[", 
       RowBox[{"func", "/.", 
        RowBox[{"{", 
         RowBox[{"t", "\[Rule]", "tDJ"}], "}"}]}], "]"}]}], ";", 
     RowBox[{"Thread", "[", 
      RowBox[{"func2", "[", "tArr", "]"}], "]"}]}]}], "]"}]}]], "Input",
