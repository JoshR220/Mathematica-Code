Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TempAvg", "[", 
    RowBox[{"state_", ",", "mode_", ",", "dir_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"\[HBar]", "*", 
       RowBox[{"wmvals", "[", 
        RowBox[{"[", 
         RowBox[{"dir", ",", "mode"}], "]"}], "]"}]}], 
      RowBox[{"kb", "*", 
       RowBox[{"Log", "[", 
        RowBox[{
         FractionBox["1", "#1"], "+", "1"}], "]"}]}]], "&"}], "[", 
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"Conjugate", "[", "state", "]"}], ",", 
       RowBox[{"t", "\[Element]", "Reals"}]}], "]"}], ".", 
     RowBox[{"nh", "[", 
      RowBox[{"[", 
       RowBox[{"mode", ",", "dir"}], "]"}], "]"}], ".", "state"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[353]:=",ExpressionUUID->"e8e058ce-4651-4ce9-9f36-8baba2ffb123"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"optimal", " ", "gate", " ", "config"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[Delta]Ideal", "[", 
      RowBox[{
       RowBox[{"Vm_", ":", "1"}], ",", "ions_", ",", "mode_", ",", "dir_"}], 
      "]"}], ":=", 
     RowBox[{"8", "*", "\[CapitalOmega]m", "*", "Vm", "*", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Times", "@@", 
        RowBox[{"Abs", "[", 
         RowBox[{"\[Eta]", "[", 
          RowBox[{"[", 
           RowBox[{"dir", ",", "ions", ",", "mode"}], "]"}], "]"}], "]"}]}], 
       "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Tau]Ideal", "[", 
      RowBox[{
       RowBox[{"Vm_", ":", "1"}], ",", "ions_", ",", "mode_", ",", "dir_"}], 
      "]"}], ":=", 
     FractionBox["\[Pi]", 
      RowBox[{"4", "*", "\[CapitalOmega]m", "*", "Vm", "*", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"Times", "@@", 
         RowBox[{"Abs", "[", 
          RowBox[{"\[Eta]", "[", 
           RowBox[{"[", 
            RowBox[{"dir", ",", "ions", ",", "mode"}], "]"}], "]"}], "]"}]}], 
        "]"}]}]]}], ";"}]}]}]], "Input",
