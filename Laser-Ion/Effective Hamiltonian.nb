Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ShowEigen", "[", "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"eigenres", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"MatrixForm", "[", 
             RowBox[{"vmvals", "[", 
              RowBox[{"[", 
               RowBox[{"d", ",", "j"}], "]"}], "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{"wmvals", "[", 
              RowBox[{"[", 
               RowBox[{"d", ",", "j"}], "]"}], "]"}], "/", "wmhz"}]}], "}"}], 
          ",", 
          RowBox[{"{", 
           RowBox[{"d", ",", "2"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "numIons"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"wsecres", "=", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Append", "[", 
             RowBox[{"wsecMol", ",", "wzsecMolmax"}], "]"}], ",", 
            RowBox[{"Append", "[", 
             RowBox[{"wsecAtom", ",", "wzsecAtommax"}], "]"}]}], "}"}], "]"}],
          "/", "wmhz"}]}], ",", 
       RowBox[{"configtitle", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"#", "===", "mMol"}], ",", "\"\<Q\>\"", ",", 
            "\"\<A\>\""}], "]"}], "&"}], "/@", "mArr"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"Labeled", "[", 
        RowBox[{
         RowBox[{"TableForm", "[", 
          RowBox[{"wsecres", ",", 
           RowBox[{"TableHeadings", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
               "\"\<Radial\>\"", ",", "\"\<Axial\>\"", ",", 
                "\"\<Max Axial\>\""}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"\"\<Molecule\>\"", ",", "\"\<Atom\>\""}], "}"}]}], 
             "}"}]}]}], "]"}], ",", 
         "\"\<Secular Frequencies (x2\[Pi] MHz)\>\"", ",", "Top"}], "]"}], 
       ",", "\"\<  \>\"", ",", 
       RowBox[{"Labeled", "[", 
        RowBox[{
         RowBox[{"TableForm", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"TableForm", "[", 
               RowBox[{"#", ",", 
                RowBox[{"TableHeadings", "\[Rule]", 
                 RowBox[{"{", 
                  RowBox[{"None", ",", 
                   RowBox[{"{", 
                    RowBox[{
                    "\"\<Eigenvector\>\"", ",", " ", 
