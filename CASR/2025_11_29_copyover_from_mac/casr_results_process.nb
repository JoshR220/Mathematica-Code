Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "process", " ", "linescan", " ", "datasets", " ", "for", " ", 
     "sensitivity", " ", "scaling", " ", "figure"}], " ", "-", " ", 
    "simulation"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "BatchProcessSimSenseScalingRabi", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"BatchProcessSimSenseScalingRabi", "[", 
      RowBox[{"paramList_", ",", "dataset_List"}], "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"datasetDJ", "=", 
          RowBox[{"Sort", "[", 
           RowBox[{"dataset", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"First", "[", "#1", "]"}], "<", 
              RowBox[{"First", "[", "#2", "]"}]}], "&"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"break", " ", "out", " ", "parameter", " ", "list"}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"pulseTimeUS", "=", 
          RowBox[{"paramList", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", 
         RowBox[{"fockN", "=", 
          RowBox[{"paramList", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
         "fitfunc", ",", "fitRes", ",", "fitParams", ",", "summaryFigure", 
         ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         "\[CapitalGamma]Guess", ",", "peakIndDJ"}], "\[IndentingNewLine]", 
        "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "fit", " ", "function", " ", "and", " ", "fix", " ", "extra", " ", 
         "params"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"fitfunc", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1.", "-", 
             RowBox[{
              RowBox[{"Exp", "[", 
               RowBox[{"-", 
                SuperscriptBox["#", "2."]}], "]"}], "*", 
              SuperscriptBox[
               RowBox[{"LaguerreL", "[", 
                RowBox[{"fockN", ",", 
                 SuperscriptBox["#", "2"]}], "]"}], "2."]}]}], ")"}], "&"}], 
          "[", "\[IndentingNewLine]", 
          RowBox[{"\[Alpha]0", "*", 
           RowBox[{"Sinc", "[", 
            RowBox[{
             RowBox[{
              FractionBox[
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"\[Delta]", "-", "\[Delta]0"}], ")"}], "*", "tDJ"}], 
               "2."], "*", 
              RowBox[{"(", 
               RowBox[{"wkhz", "*", "\[Mu]s"}], ")"}]}], "+", "1.*^-8"}], 
            "]"}]}], "\[IndentingNewLine]", "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"fit", "!"}], " ", "and", " ", "get", " ", "results"}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"fitRes", "=", 
         RowBox[{"NonlinearModelFit", "[", "\[IndentingNewLine]", 
          RowBox[{
          "datasetDJ", ",", "\[IndentingNewLine]", "fitfunc", ",", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"fit", " ", "guesses"}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\[Alpha]0", ",", "0.4"}], 
              RowBox[{"(*", 
               RowBox[{"-", 
                RowBox[{"Log", "[", 
                 RowBox[{"1.", "-", 
                  RowBox[{"Abs", "[", 
                   RowBox[{"Subtract", "@@", 
                    RowBox[{"MinMax", "[", 
                    RowBox[{"datasetDJ", "[", 
                    RowBox[{"[", 
                    RowBox[{";;", ",", "2"}], "]"}], "]"}], "]"}]}], "]"}]}], 
                 "]"}]}], "*)"}], "}"}], ",", "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{"\[Delta]0", ",", 
               RowBox[{"First", "@", 
                RowBox[{"datasetDJ", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"Ordering", "[", 
                    RowBox[{
                    RowBox[{"datasetDJ", "[", 
                    RowBox[{"[", 
                    RowBox[{";;", ",", "2"}], "]"}], "]"}], ",", 
                    RowBox[{"-", "1"}]}], "]"}], ",", "1"}], "]"}], "]"}]}]}],
               "}"}], ",", 
             RowBox[{"(*", "linecenter", "*)"}], "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{"tDJ", ",", "pulseTimeUS"}], "}"}]}], 
            RowBox[{"(*", 
             RowBox[{"pulse", " ", "time"}], "*)"}], "\[IndentingNewLine]", 
            "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"fit", " ", "parameter"}], "*)"}], "\[IndentingNewLine]", 
           "\[Delta]"}], "\[IndentingNewLine]", "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"(*", 
          RowBox[{
          "fit", " ", "function", " ", "and", " ", "fix", " ", "extra", " ", 
           "params"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"fitfunc", "=", 
           RowBox[{"A", "*", 
            FractionBox["\[CapitalGamma]", 
             RowBox[{
              SuperscriptBox["\[CapitalGamma]", "2."], "+", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"x", "-", "f"}], ")"}], "2."]}]]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"peakIndDJ", "=", 
           RowBox[{"First", "@", 
            RowBox[{"Ordering", "[", 
             RowBox[{
              RowBox[{"datasetDJ", "[", 
               RowBox[{"[", 
                RowBox[{";;", ",", "2"}], "]"}], "]"}], ",", 
              RowBox[{"-", "1"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"\[CapitalGamma]Guess", "=", 
           RowBox[{
            FractionBox["0.5", "pulseTimeUS"], "*", 
            RowBox[{"Sqrt", "[", "2", "]"}]}]}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"fit", "!"}], " ", "and", " ", "get", " ", "results"}], 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{"fitRes", "=", 
           RowBox[{"NonlinearModelFit", "[", "\[IndentingNewLine]", 
            RowBox[{
            "datasetDJ", ",", "\[IndentingNewLine]", "fitfunc", ",", 
             "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{"fit", " ", "guesses"}], "*)"}], "\[IndentingNewLine]", 
             
             RowBox[{"{", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"A", ",", 
                 RowBox[{
                  RowBox[{"Abs", "[", 
                   RowBox[{"Subtract", "@@", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"datasetDJ", "[", 
                    RowBox[{"[", 
                    RowBox[{"peakIndDJ", ",", "2"}], "]"}], "]"}], ",", 
                    RowBox[{"Min", "[", 
                    RowBox[{"datasetDJ", "[", 
                    RowBox[{"[", 
                    RowBox[{";;", ",", "2"}], "]"}], "]"}], "]"}]}], "}"}]}], 
                   "]"}], "*", 
                  SuperscriptBox["\[CapitalGamma]Guess", "1."]}]}], "}"}], 
               ",", "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"\[CapitalGamma]", ",", "\[CapitalGamma]Guess"}], 
                "}"}], ",", 
               RowBox[{"(*", "linewidth", "*)"}], "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"f", ",", 
                 RowBox[{"First", "@", 
                  RowBox[{"datasetDJ", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"Ordering", "[", 
                    RowBox[{
                    RowBox[{"datasetDJ", "[", 
                    RowBox[{"[", 
                    RowBox[{";;", ",", "2"}], "]"}], "]"}], ",", 
                    RowBox[{"-", "1"}]}], "]"}], ",", "1"}], "]"}], "]"}]}]}],
                 "}"}]}], 
              RowBox[{"(*", "linecenter", "*)"}], "\[IndentingNewLine]", 
              "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{"fit", " ", "parameter"}], "*)"}], 
             "\[IndentingNewLine]", "x"}], "\[IndentingNewLine]", "]"}]}], 
          ";"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"plot", " ", "summary", " ", "figure"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"summaryFigure", "=", 
         RowBox[{"Show", "[", "\[IndentingNewLine]", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"ListPlot", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"{", "\[IndentingNewLine]", 
               RowBox[{"datasetDJ", ",", "datasetDJ"}], "\[IndentingNewLine]",
                "}"}], ",", "\[IndentingNewLine]", 
              RowBox[{"PlotRange", "->", 
               RowBox[{"{", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"Full", ",", "Full"}], "}"}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{"{", 
                  RowBox[{"0.", ",", "1."}], "}"}]}], "\[IndentingNewLine]", 
                "}"}]}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"FrameLabel", "\[Rule]", 
               RowBox[{"{", " ", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Style", "[", 
                    RowBox[{
                    RowBox[{"StringForm", "[", 
                    RowBox[{"\"\<``\>\"", ",", "\"\<D-5/2 Probability\>\""}], 
                    "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"Black", ",", 
                    RowBox[{"Directive", "[", "15", "]"}]}], "}"}]}], "]"}], 
