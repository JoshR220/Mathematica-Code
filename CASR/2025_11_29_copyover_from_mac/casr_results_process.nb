                   RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], "}"}], ",",
               "\[IndentingNewLine]", 
              RowBox[{"PlotRange", "->", "Full"}]}], "\[IndentingNewLine]", 
             "]"}]}], "\[IndentingNewLine]", "}"}], "\[IndentingNewLine]", 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"fitParams", "=", 
         RowBox[{"Style", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{
            "fitRes", "[", "\"\<ParameterConfidenceIntervalTable\>\"", "]"}], 
            "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Background", "->", "White"}], ",", 
             RowBox[{"FontColor", "->", "Black"}], ",", 
             RowBox[{"FontSize", "->", "15"}]}], "}"}]}], 
          "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"clear", " ", "before", " ", "returning"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"tha", "=", 
         RowBox[{"Max", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"fitRes", "[", "#", "]"}], "&"}], "/@", 
           RowBox[{"Range", "[", 
            RowBox[{
             RowBox[{"dsN", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
             RowBox[{"dsN", "[", 
              RowBox[{"[", 
