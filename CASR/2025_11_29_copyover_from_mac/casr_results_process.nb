   RowBox[{
    RowBox[{"SeparateFockDatasets", "[", 
     RowBox[{"dataProcessed_List", ",", 
      RowBox[{"fockN", ":", 
       RowBox[{"(", 
        RowBox[{"_Integer", "|", "_Real"}], ")"}]}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Sort", "[", "\[IndentingNewLine]", 
