          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"fisherInfoData", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "2"}], "]"}], "]"}], ")"}], "2."], "/", 
          "probVar"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Return", "[", "fisherInfoData", "]"}], ";"}]}], 
      "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], 
    ";"}]}]}]], "Input",
