                    RowBox[{
                    RowBox[{"StringForm", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    "\"\<`` - n=``\\nPulse Time: ``\[Mu]s, Linecenter \
Precision: `` Hz\>\"", ",", "\[IndentingNewLine]", "figureTitle", ",", 
                    "fockN", ",", "pulseTimeUS", ",", 
                    RowBox[{"NumberForm", "[", 
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"1000.", "*", 
                    RowBox[{"Subtract", "@@", 
                    RowBox[{
                    RowBox[{
                    "fitRes", "[", "\"\<ParameterConfidenceIntervals\>\"", 
                    "]"}], "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}], ",", "5"}], 
                    "]"}]}], "\[IndentingNewLine]", "]"}], ",", 
                    "\[IndentingNewLine]", 
