Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "select", " ", "only", " ", "processed", " ", "results", " ", "which", " ", 
    RowBox[{"haven", "'"}], "t", " ", "returned", " ", "an", " ", "empty", 
    " ", "list"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"validBatchFitIndices", "=", 
    RowBox[{"First", "/@", 
     RowBox[{"Position", "[", "\[IndentingNewLine]", 
      RowBox[{"resADEVScaling", ",", "\[IndentingNewLine]", 
       RowBox[{"n_List", "/;", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"n", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], ">", "0"}], "&&", 
         RowBox[{
