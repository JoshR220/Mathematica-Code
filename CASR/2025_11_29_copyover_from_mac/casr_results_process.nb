Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "process", " ", "linescan", " ", "datasets", " ", "for", " ", 
    "sensitivity", " ", "scaling", " ", "figure"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "BatchProcessFitSensitivityScalingDataRabi", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"BatchProcessFitSensitivityScalingDataRabi", "[", "rid_", "]"}], 
     ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"datafileList", "=", 
          RowBox[{"ImportDatasetARTIQ", "[", 
           RowBox[{"directoryString", ",", 
            RowBox[{"ToString", "[", "rid", "]"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", "dataset", ",", "parameters", ",", "ADJFix", 
         ",", "CDJFix", ",", "\[IndentingNewLine]", "datasetProcessed", ",", 
         "dsN", ",", "fitfunc", ",", "\[IndentingNewLine]", "fitRes", ",", 
         "\[IndentingNewLine]", "dsPlotTMP", ",", "summaryFigure", ",", 
         "fitParams", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         "peakIndDJ", ",", "\[CapitalGamma]Guess", ",", "\[IndentingNewLine]",
          "\[IndentingNewLine]", "tha"}], "\[IndentingNewLine]", "}"}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "merge", " ", "datasets", " ", "and", " ", "get", " ", "parameter", 
         " ", "list"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"dataset", ",", "parameters"}], "}"}], "=", 
         "datafileList"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        
        RowBox[{
         RowBox[{"{", 
          RowBox[{"ADJFix", ",", "CDJFix"}], "}"}], "=", 
         RowBox[{"Switch", "[", 
          RowBox[{
           RowBox[{"parameters", "[", "\"\<fock_num_prep\>\"", "]"}], ",", 
           "\[IndentingNewLine]", "0", ",", 
           RowBox[{"{", 
            RowBox[{"0.926687", ",", "0.0059494"}], "}"}], ",", 
           "\[IndentingNewLine]", "1", ",", 
           RowBox[{"{", 
            RowBox[{"0.79492", ",", "0.077884"}], "}"}], ",", 
           "\[IndentingNewLine]", "2", ",", 
           RowBox[{"{", 
            RowBox[{"0.72353", ",", "0.117476"}], "}"}], ",", 
           "\[IndentingNewLine]", "3", ",", 
           RowBox[{"{", 
            RowBox[{"0.619214", ",", "0.18123"}], "}"}]}], 
          "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"datasetProcessed", "=", 
         RowBox[{"ThresholdCounts", "[", 
          RowBox[{
           RowBox[{"dataset", "[", 
            RowBox[{"[", 
             RowBox[{";;", ",", 
              RowBox[{"{", 
               RowBox[{"sweepCol", ",", "countCol"}], "}"}]}], "]"}], "]"}], 
           ",", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"datasetProcessed", "=", 
         RowBox[{"Transpose", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", "datasetProcessed", "]"}], "*", 
           RowBox[{"{", 
            RowBox[{"sweepUnits", ",", "1"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"dsN", "=", 
         RowBox[{"CollateDataSimple", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"datasetProcessed", "[", 
            RowBox[{"[", 
             RowBox[{";;", ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", "1", "}"}]}], "\[IndentingNewLine]", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "replace", " ", "0", " ", "uncertainty", " ", "with", " ", "0.01"}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"dsN", "[", 
          RowBox[{"[", 
           RowBox[{";;", ",", "3"}], "]"}], "]"}], "=", 
         RowBox[{
          RowBox[{"dsN", "[", 
           RowBox[{"[", 
            RowBox[{";;", ",", "3"}], "]"}], "]"}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"0", "|", "0."}], ")"}], "->", "0.01"}], "}"}]}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "fit", " ", "function", " ", "and", " ", "fix", " ", "extra", " ", 
          "params"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"fitfunc", "=", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"ADJFix", "*", 
             RowBox[{"(", 
              RowBox[{"1.", "-", 
               RowBox[{
                RowBox[{"Exp", "[", 
                 RowBox[{"-", 
                  SuperscriptBox["#", "2."]}], "]"}], "*", 
                SuperscriptBox[
                 RowBox[{"LaguerreL", "[", 
                  RowBox[{
                   RowBox[{"parameters", "[", "\"\<fock_num_prep\>\"", "]"}], 
                   ",", 
                   SuperscriptBox["#", "2"]}], "]"}], "2."]}]}], ")"}]}], "+",
             "CDJFix"}], "&"}], "[", "\[IndentingNewLine]", 
          RowBox[{"\[Alpha]0", "*", 
           RowBox[{"Sinc", "[", 
            RowBox[{
             RowBox[{
              FractionBox[
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"\[Delta]", "-", "\[Delta]0"}], ")"}], "*", "tDJ"}], 
               "2."], "*", 
              RowBox[{"(", 
               RowBox[{"wkhz", "*", "\[Mu]s"}], ")"}]}], "+", "1.*^-8"}], 
            "]"}]}], "\[IndentingNewLine]", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"fit", "!"}], " ", "and", " ", "get", " ", "results"}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"fitRes", "=", 
         RowBox[{"NonlinearModelFit", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"dsN", "[", 
            RowBox[{"[", 
             RowBox[{";;", ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}], ",", 
           "\[IndentingNewLine]", "fitfunc", ",", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"fit", " ", "guesses"}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\[Alpha]0", ",", 
               RowBox[{"-", 
                RowBox[{"Log", "[", 
                 RowBox[{"1.", "-", 
                  RowBox[{"Abs", "[", 
                   RowBox[{"Subtract", "@@", 
                    RowBox[{"MinMax", "[", 
                    RowBox[{"dsN", "[", 
                    RowBox[{"[", 
                    RowBox[{";;", ",", "2"}], "]"}], "]"}], "]"}]}], "]"}]}], 
                 "]"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{"\[Delta]0", ",", 
               RowBox[{"First", "@", 
                RowBox[{"dsN", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"Ordering", "[", 
                    RowBox[{
                    RowBox[{"dsN", "[", 
                    RowBox[{"[", 
                    RowBox[{";;", ",", "2"}], "]"}], "]"}], ",", 
                    RowBox[{"-", "1"}]}], "]"}], ",", "1"}], "]"}], "]"}]}]}],
               "}"}], ",", 
             RowBox[{"(*", "linecenter", "*)"}], "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{"tDJ", ",", 
               RowBox[{
                RowBox[{"parameters", "[", "\"\<time_heating_us\>\"", "]"}], 
                "+", 
                RowBox[{"0.5", "*", 
                 RowBox[{
                 "parameters", "[", "\"\<time_pulse_shape_rolloff_us\>\"", 
                  "]"}], "*", 
                 RowBox[{
                 "parameters", "[", "\"\<enable_pulse_shaping\>\"", 
                  "]"}]}]}]}], "}"}]}], 
            RowBox[{"(*", 
             RowBox[{"pulse", " ", "time"}], "*)"}], "\[IndentingNewLine]", 
            "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"fit", " ", "parameter"}], "*)"}], "\[IndentingNewLine]", 
           "\[Delta]", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"fit", " ", "weights"}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"Weights", "->", 
            SuperscriptBox[
             RowBox[{"dsN", "[", 
              RowBox[{"[", 
               RowBox[{";;", ",", "3"}], "]"}], "]"}], 
             RowBox[{"-", "2."}]]}]}], "\[IndentingNewLine]", "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"(*", 
          RowBox[{
          "fit", " ", "function", " ", "and", " ", "fix", " ", "extra", " ", 
           "params"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"fitfunc", "=", 
           RowBox[{"A", "*", 
            FractionBox["\[CapitalGamma]", 
             RowBox[{
              SuperscriptBox["\[CapitalGamma]", "2."], "+", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"x", "-", "f"}], ")"}], "2."]}]]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"peakIndDJ", "=", 
           RowBox[{"First", "@", 
            RowBox[{"Ordering", "[", 
             RowBox[{
              RowBox[{"dsN", "[", 
               RowBox[{"[", 
                RowBox[{";;", ",", "2"}], "]"}], "]"}], ",", 
              RowBox[{"-", "1"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"\[CapitalGamma]Guess", "=", 
           RowBox[{
            FractionBox["0.5", 
             RowBox[{
              RowBox[{"parameters", "[", "\"\<time_heating_us\>\"", "]"}], 
              "+", 
              RowBox[{"0.5", "*", 
               RowBox[{
               "parameters", "[", "\"\<time_pulse_shape_rolloff_us\>\"", 
                "]"}], "*", 
               RowBox[{
               "parameters", "[", "\"\<enable_pulse_shaping\>\"", "]"}]}]}]], 
            "*", 
            RowBox[{"Sqrt", "[", "2", "]"}]}]}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"fit", "!"}], " ", "and", " ", "get", " ", "results"}], 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{"fitRes", "=", 
           RowBox[{"NonlinearModelFit", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"dsN", "[", 
              RowBox[{"[", 
               RowBox[{";;", ",", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}], ",", 
             "\[IndentingNewLine]", "fitfunc", ",", "\[IndentingNewLine]", 
             "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{"fit", " ", "guesses"}], "*)"}], "\[IndentingNewLine]", 
             
             RowBox[{"{", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"A", ",", 
                 RowBox[{
                  RowBox[{"Abs", "[", 
                   RowBox[{"Subtract", "@@", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"dsN", "[", 
                    RowBox[{"[", 
                    RowBox[{"peakIndDJ", ",", "2"}], "]"}], "]"}], ",", 
                    RowBox[{"Min", "[", 
                    RowBox[{"dsN", "[", 
                    RowBox[{"[", 
                    RowBox[{";;", ",", "2"}], "]"}], "]"}], "]"}]}], "}"}]}], 
                   "]"}], "*", 
                  SuperscriptBox["\[CapitalGamma]Guess", "1."]}]}], "}"}], 
               ",", "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"\[CapitalGamma]", ",", "\[CapitalGamma]Guess"}], 
                "}"}], ",", 
               RowBox[{"(*", "linewidth", "*)"}], "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"f", ",", 
                 RowBox[{"First", "@", 
                  RowBox[{"dsN", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"Ordering", "[", 
                    RowBox[{
                    RowBox[{"dsN", "[", 
                    RowBox[{"[", 
                    RowBox[{";;", ",", "2"}], "]"}], "]"}], ",", 
                    RowBox[{"-", "1"}]}], "]"}], ",", "1"}], "]"}], "]"}]}]}],
                 "}"}]}], 
              RowBox[{"(*", "linecenter", "*)"}], "\[IndentingNewLine]", 
              "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{"fit", " ", "parameter"}], "*)"}], 
             "\[IndentingNewLine]", "x", ",", "\[IndentingNewLine]", 
             "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{"fit", " ", "weights"}], "*)"}], "\[IndentingNewLine]", 
             
             RowBox[{"Weights", "->", 
              SuperscriptBox[
               RowBox[{"dsN", "[", 
                RowBox[{"[", 
                 RowBox[{";;", ",", "3"}], "]"}], "]"}], 
               RowBox[{"-", "2."}]]}]}], "\[IndentingNewLine]", "]"}]}], 
          ";"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"plot", " ", "summary", " ", "figure"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"dsPlotTMP", "=", 
         RowBox[{"dsN", "[", 
          RowBox[{"[", 
           RowBox[{";;", ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"dsPlotTMP", "[", 
          RowBox[{"[", 
           RowBox[{";;", ",", "2"}], "]"}], "]"}], "=", 
         RowBox[{"Around", "@@@", 
          RowBox[{"dsN", "[", 
           RowBox[{"[", 
            RowBox[{";;", ",", 
             RowBox[{"{", 
              RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"summaryFigure", "=", 
         RowBox[{"Show", "[", "\[IndentingNewLine]", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"ListPlot", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"{", "\[IndentingNewLine]", 
               RowBox[{"dsPlotTMP", ",", "dsPlotTMP"}], "\[IndentingNewLine]",
                "}"}], ",", "\[IndentingNewLine]", 
              RowBox[{"PlotRange", "->", 
               RowBox[{"{", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"Full", ",", "Full"}], "}"}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{"{", 
                  RowBox[{"0.", ",", "1."}], "}"}]}], "\[IndentingNewLine]", 
                "}"}]}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"FrameLabel", "\[Rule]", 
               RowBox[{"{", " ", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Style", "[", 
                    RowBox[{"\"\<D-5/2 Probability\>\"", ",", 
                    RowBox[{"{", 
                    RowBox[{"Black", ",", 
                    RowBox[{"Directive", "[", "15", "]"}]}], "}"}]}], "]"}], 
                   ",", "None"}], "}"}], ",", "\[IndentingNewLine]", 
                 RowBox[{"{", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"Style", "[", 
                    RowBox[{"xAxisLabel", ",", 
                    RowBox[{"{", 
                    RowBox[{"Black", ",", 
                    RowBox[{"Directive", "[", "15", "]"}]}], "}"}]}], "]"}], 
                   ",", "\[IndentingNewLine]", 
                   RowBox[{"Style", "[", 
                    RowBox[{
                    RowBox[{"StringForm", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    "\"\<`` - RID: ``, n=``\\nPulse Time: ``\[Mu]s, \
Linecenter Precision: `` Hz\>\"", ",", "\[IndentingNewLine]", 
                    "\"\<Fock Linescan\>\"", ",", "rid", ",", 
                    RowBox[{"parameters", "[", "\"\<fock_num_prep\>\"", "]"}],
                     ",", 
                    RowBox[{
                    "parameters", "[", "\"\<time_heating_us\>\"", "]"}], ",", 
                    
                    RowBox[{"NumberForm", "[", 
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"1000.", "*", 
                    RowBox[{"Subtract", "@@", 
                    RowBox[{
                    RowBox[{
                    "fitRes", "[", "\"\<ParameterConfidenceIntervals\>\"", 
                    "]"}], "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}], ",", "5"}], 
                    "]"}]}], "\[IndentingNewLine]", "]"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"{", 
                    RowBox[{"Black", ",", 
