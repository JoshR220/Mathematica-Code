                RowBox[{"x", "-", "x0"}], ")"}]}], "]"}], "2."]}], "+", 
           "COff"}], "/.", 
          RowBox[{"{", 
           RowBox[{"T", "->", "guessFitFreq"}], "}"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"fitRes", "=", 
         RowBox[{"NonlinearModelFit", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"dsN", "[", 
            RowBox[{"[", 
             RowBox[{";;", ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}], ",", 
