Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"calculate", " ", "FI", " ", "using", " ", "data", " ", 
     RowBox[{"w", "/", " ", "experimental"}], " ", "uncertainties"}], " ", 
    "-", " ", "numerical"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "FisherInformationExpNum", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"FisherInformationExpNum", "[", 
      RowBox[{"data_List", ",", "numAvgs_"}], "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"scoreData", "=", 
          RowBox[{"Join", "[", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"first", " ", "point"}], " ", "-", " ", 
             RowBox[{"asymmetric", " ", "difference", " ", "quotient"}]}], 
            "*)"}], "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"data", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
               FractionBox[
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"data", "[", 
                   RowBox[{"[", 
                    RowBox[{"2", ",", "2"}], "]"}], "]"}], "-", 
                  RowBox[{"data", "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ")"}], 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"data", "[", 
                   RowBox[{"[", 
                    RowBox[{"2", ",", "1"}], "]"}], "]"}], "-", 
                  RowBox[{"data", "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ")"}]]}], "}"}], 
             "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"other", " ", "points"}], " ", "-", " ", 
              RowBox[{"symmetric", " ", "difference", " ", "quotient"}]}], 
             "*)"}], "\[IndentingNewLine]", 
            RowBox[{"Transpose", "[", 
             RowBox[{"{", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"data", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"2", ";;", 
                   RowBox[{"-", "2"}]}], ",", "1"}], "]"}], "]"}], ",", 
               "\[IndentingNewLine]", 
               FractionBox[
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"data", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"3", ";;"}], ",", "2"}], "]"}], "]"}], "-", 
                  RowBox[{"data", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"1", ";;", 
                    RowBox[{"-", "3"}]}], ",", "2"}], "]"}], "]"}]}], ")"}], 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"data", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"3", ";;"}], ",", "1"}], "]"}], "]"}], "-", 
                  RowBox[{"data", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"1", ";;", 
                    RowBox[{"-", "3"}]}], ",", "1"}], "]"}], "]"}]}], 
                 ")"}]]}], "\[IndentingNewLine]", "}"}], "]"}], ",", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"last", " ", "point"}], " ", "-", " ", 
              RowBox[{
              "asymmetric", " ", "difference", " ", "quotient", " ", 
               "again"}]}], "*)"}], "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"data", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}], ",", 
               FractionBox[
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"data", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"-", "1"}], ",", "2"}], "]"}], "]"}], "-", 
                  RowBox[{"data", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"-", "2"}], ",", "2"}], "]"}], "]"}]}], ")"}], 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"data", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}], "-", 
                  RowBox[{"data", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"-", "2"}], ",", "1"}], "]"}], "]"}]}], ")"}]]}], 
              "}"}], "}"}]}], "\[IndentingNewLine]", "]"}]}], ",", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "get", " ", "variance", " ", "of", " ", "underlying", " ", 
           "probabilities"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"probVar", "=", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", "\"\<Uncertainty\>\"", "]"}], "&"}], "/@", 
              RowBox[{"data", "[", 
               RowBox[{"[", 
                RowBox[{";;", ",", "2"}], "]"}], "]"}]}], ")"}], "2."], "*", 
           "numAvgs"}]}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         "fisherInfoData"}], "\[IndentingNewLine]", "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", "probVar", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", "scoreData", "]"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"fisherInfoData", "=", "scoreData"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"fisherInfoData", "[", 
          RowBox[{"[", 
           RowBox[{";;", ",", "2"}], "]"}], "]"}], "=", 
