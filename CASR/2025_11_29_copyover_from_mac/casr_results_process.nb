                RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}], ",", 
             RowBox[{"Abs", "[", 
              FractionBox[
               RowBox[{
                RowBox[{"dsN", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "1"}], "]"}], "]"}], "-", 
                RowBox[{"dsN", "[", 
                 RowBox[{"[", 
                  RowBox[{"2", ",", "1"}], "]"}], "]"}]}], "1000."], "]"}]}], 
            "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ClearInOut", "[", "]"}], ";", 
        RowBox[{"Clear", "[", 
         RowBox[{
         "datafileList", ",", "dataset", ",", "datasetProcessed", ",", "dsN", 
          ",", "dsPlotTMP"}], "]"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
