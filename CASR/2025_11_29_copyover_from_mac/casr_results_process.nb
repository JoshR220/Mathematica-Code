           ")"}]}]}], ";", 
        RowBox[{"First", "@", 
         RowBox[{"dataFFTFreqs", "[", 
          RowBox[{"[", 
           RowBox[{"Ordering", "[", 
            RowBox[{"dataFFTFull", ",", 
             RowBox[{"-", "1"}]}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"sine", " ", "freq", " ", "sweep", " ", "fit"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"fitfuncDJ", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"AOff", "*", 
            SuperscriptBox[
             RowBox[{"Cos", "[", 
