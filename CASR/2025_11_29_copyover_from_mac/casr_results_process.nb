           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"fit", " ", "guesses"}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"AOff", ",", 
               RowBox[{"Abs", "[", 
                RowBox[{"Subtract", "@@", 
                 RowBox[{"MinMax", "[", 
                  RowBox[{"dsN", "[", 
                   RowBox[{"[", 
                    RowBox[{";;", ",", "2"}], "]"}], "]"}], "]"}]}], "]"}]}], 
              "}"}], ",", 
