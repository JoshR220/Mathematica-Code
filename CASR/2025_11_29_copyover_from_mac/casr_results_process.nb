Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"create", " ", "fisher", " ", "info", " ", "function"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "PrecisionFisherInfo", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"PrecisionFisherInfo", "[", 
      RowBox[{"\[Alpha]_", ",", "Tperiod_", ",", "Tfinal_", ",", 
       RowBox[{"fockN_", ":", "0"}]}], "]"}], ":=", 
     SuperscriptBox[
      RowBox[{"(", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"4.", "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2.", "*", "fockN"}], "+", "1."}], ")"}]}], ")"}], 
        "\[IndentingNewLine]", "*", 
        RowBox[{"(", 
         RowBox[{
          FractionBox["1.", "6."], "*", 
          SuperscriptBox["\[Alpha]", "2"], "*", 
          FractionBox[
           SuperscriptBox["Tfinal", "3"], "Tperiod"]}], ")"}]}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{"0.209", "*", 
            RowBox[{"Tperiod", "^", "3"}]}], ")"}]}], "\[IndentingNewLine]", 
         "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[Alpha]", "^", "2"}], "*", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"250", "*", "\[Mu]s"}], ")"}], "^", "2"}], "*", 
           RowBox[{"Tfinal", "^", "3"}]}], ")"}]}], "*)"}], 
       "\[IndentingNewLine]", ")"}], 
      RowBox[{"-", "0.5"}]]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.96897771037947*^9, 3.968977809668964*^9}, {
   3.9689787988700485`*^9, 3.968978824771655*^9}, 3.97026308056254*^9, {
