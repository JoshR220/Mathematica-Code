Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "process", " ", "ramsey", " ", "linescan", " ", "datasets", " ", "for", 
     " ", "sensitivity", " ", "scaling", " ", "figure"}], " ", "-", " ", 
    "simulation"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "BatchProcessSimSenseScalingRamsey", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"BatchProcessSimSenseScalingRamsey", "[", 
      RowBox[{"paramList_", ",", "dataset_List"}], "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"datasetDJ", "=", 
          RowBox[{"Sort", "[", 
           RowBox[{"dataset", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"First", "[", "#1", "]"}], "<", 
              RowBox[{"First", "[", "#2", "]"}]}], "&"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"break", " ", "out", " ", "parameter", " ", "list"}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"pulseTimeUS", "=", 
          RowBox[{"paramList", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", 
         RowBox[{"fockN", "=", 
          RowBox[{"paramList", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
         "fitfunc", ",", "fitRes", ",", "fitParams", ",", "summaryFigure", 
         ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"guess", " ", "periodicity", " ", "via", " ", "FFT"}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"numPoints", "=", 
          RowBox[{"Length", "[", "dataset", "]"}]}], ",", 
         "\[IndentingNewLine]", "fmax", ",", "dataFFTFreqs", ",", 
         "dataFFTFull"}], "\[IndentingNewLine]", "}"}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"guess", " ", "periodicity", " ", "via", " ", "FFT"}], "*)"}],
        "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"fmax", "=", 
         RowBox[{"1.", "/", 
          RowBox[{"Mean", "[", 
           RowBox[{
            RowBox[{"datasetDJ", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"2", ";;"}], ",", "1"}], "]"}], "]"}], "-", 
