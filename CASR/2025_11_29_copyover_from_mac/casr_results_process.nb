Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "process", " ", "linescan", " ", "datasets", " ", "for", " ", 
    "sensitivity", " ", "scaling", " ", "figure"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "Clear", "[", "BatchProcessFitSensitivityScalingDataRamsey", "]"}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
     "BatchProcessFitSensitivityScalingDataRamsey", "[", "rid_", "]"}], ":=", 
     
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"datafileList", "=", 
          RowBox[{"ImportDatasetARTIQ", "[", 
           RowBox[{"directoryString", ",", 
            RowBox[{"ToString", "[", "rid", "]"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", "dataset", ",", "parameters", ",", "ADJFix", 
         ",", "CDJFix", ",", "\[IndentingNewLine]", "datasetProcessed", ",", 
         "dsN", ",", "fitfunc", ",", "\[IndentingNewLine]", "fitRes", ",", 
         "\[IndentingNewLine]", "dsPlotTMP", ",", "summaryFigure", ",", 
         "fitParams", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         "fmax", ",", "dataFFTFreqs", ",", "dataFFTFull", ",", "numPoints", 
         ",", "guessFitFreq", ",", "fitfuncDJ"}], "\[IndentingNewLine]", 
        "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "merge", " ", "datasets", " ", "and", " ", "get", " ", "parameter", 
         " ", "list"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"dataset", ",", "parameters"}], "}"}], "=", 
         "datafileList"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"ADJFix", ",", "CDJFix"}], "}"}], "=", 
           RowBox[{"Switch", "[", 
            RowBox[{
             RowBox[{"parameters", "[", "\"\<fock_num_prep\>\"", "]"}], ",", 
             "\[IndentingNewLine]", "0", ",", 
             RowBox[{"{", 
              RowBox[{"0.926687", ",", "0.0059494"}], "}"}], ",", 
             "\[IndentingNewLine]", "1", ",", 
             RowBox[{"{", 
              RowBox[{"0.79492", ",", "0.077884"}], "}"}], ",", 
             "\[IndentingNewLine]", "2", ",", 
             RowBox[{"{", 
              RowBox[{"0.72353", ",", "0.117476"}], "}"}], ",", 
             "\[IndentingNewLine]", "3", ",", 
             RowBox[{"{", 
              RowBox[{"0.619214", ",", "0.18123"}], "}"}]}], 
            "\[IndentingNewLine]", "]"}]}], ";"}], "*)"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"process", " ", "dataset"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"datasetProcessed", "=", 
         RowBox[{"ThresholdCounts", "[", 
          RowBox[{
           RowBox[{"dataset", "[", 
            RowBox[{"[", 
             RowBox[{";;", ",", 
              RowBox[{"{", 
               RowBox[{"sweepCol", ",", "countCol"}], "}"}]}], "]"}], "]"}], 
           ",", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"datasetProcessed", "=", 
         RowBox[{"Transpose", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", "datasetProcessed", "]"}], "*", 
           RowBox[{"{", 
            RowBox[{"sweepUnits", ",", "1"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"dsN", "=", 
         RowBox[{"CollateDataSimple", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"datasetProcessed", "[", 
            RowBox[{"[", 
             RowBox[{";;", ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", "1", "}"}]}], "\[IndentingNewLine]", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "replace", " ", "0", " ", "uncertainty", " ", "with", " ", "0.01"}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"dsN", "[", 
          RowBox[{"[", 
           RowBox[{";;", ",", "3"}], "]"}], "]"}], "=", 
         RowBox[{
          RowBox[{"dsN", "[", 
           RowBox[{"[", 
            RowBox[{";;", ",", "3"}], "]"}], "]"}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"0", "|", "0."}], ")"}], "->", "0.01"}], "}"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"numPoints", "=", 
         RowBox[{"Length", "[", "dsN", "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"guess", " ", "periodicity", " ", "via", " ", "FFT"}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"fmax", "=", 
         RowBox[{"1.", "/", 
          RowBox[{"Mean", "[", 
           RowBox[{
            RowBox[{"dsN", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"2", ";;"}], ",", "1"}], "]"}], "]"}], "-", 
            RowBox[{"dsN", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"1", ";;", 
                RowBox[{"-", "2"}]}], ",", "1"}], "]"}], "]"}]}], "]"}]}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"dataFFTFreqs", "=", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", 
            FractionBox["fmax", "2."], ",", 
            FractionBox["fmax", 
             RowBox[{"numPoints", "-", "1"}]]}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{";;", 
            RowBox[{"IntegerPart", "[", 
             FractionBox["numPoints", "2."], "]"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"dataFFTFull", "=", 
         RowBox[{"Abs", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Fourier", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"dsN", "[", 
               RowBox[{"[", 
                RowBox[{";;", ",", "2"}], "]"}], "]"}], "-", 
              RowBox[{"Mean", "[", 
               RowBox[{"dsN", "[", 
                RowBox[{"[", 
                 RowBox[{";;", ",", "2"}], "]"}], "]"}], "]"}]}], ",", 
             "\[IndentingNewLine]", 
