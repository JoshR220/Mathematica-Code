               RowBox[{"1", ",", 
                RowBox[{"-", "1"}]}], "}"}]}]}], "\[IndentingNewLine]", "]"}],
            "[", 
           RowBox[{"[", 
            RowBox[{";;", 
             RowBox[{"IntegerPart", "[", 
              FractionBox["numPoints", "2."], "]"}]}], "]"}], "]"}], 
          "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"guess", " ", "frequency"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"guessFitFreq", "=", 
         RowBox[{"1.*^-3", "*", 
          RowBox[{"(", 
           RowBox[{"First", "@", 
            RowBox[{
