dc41b27446db"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "create", " ", "func", " ", "to", " ", "fit", " ", "lorentzian", " ", "to",
     " ", "subranges", " ", "of", " ", "known", " ", "dataset"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "FitSubsetFunc", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"FitSubsetFunc", "[", "subRange_", "]"}], ":=", 
     RowBox[{"With", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{"dataFFTFitTMP", "=", 
         RowBox[{"dataFFTMag", "[", 
          RowBox[{"[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"1", ",", 
              RowBox[{"peakIndDJ", "-", "subRange"}]}], "]"}], ";;", 
            "\[IndentingNewLine]", 
            RowBox[{"Min", "[", 
             RowBox[{
              RowBox[{"Length", "[", "dataFFTMag", "]"}], ",", 
              RowBox[{"peakIndDJ", "+", "subRange"}]}], "]"}]}], 
           "\[IndentingNewLine]", "]"}], "]"}]}], "\[IndentingNewLine]", 
        "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Return", "[", "\[IndentingNewLine]", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"x", "-", 
            RowBox[{"axis", " ", 
             RowBox[{"value", ":", " ", 
              RowBox[{"#", " ", "of", " ", "points"}]}]}]}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Length", "[", "dataFFTFitTMP", "]"}], ",", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"result", ":", " ", 
             RowBox[{"fit", " ", "result"}]}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"NonlinearModelFit", "[", "\[IndentingNewLine]", 
            RowBox[{"dataFFTFitTMP", ",", "\[IndentingNewLine]", 
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"{", "fitfunc", "}"}], ",", "fitConstraintsDJ"}], 
              "]"}], ",", "\[IndentingNewLine]", "fitGuessDJ", ",", 
             "\[IndentingNewLine]", "x", ",", "\[IndentingNewLine]", 
             "\[IndentingNewLine]", 
             RowBox[{"Method", "->", "fitMethodDJ"}]}], "\[IndentingNewLine]",
             "]"}]}], "\[IndentingNewLine]", "}"}], "\[IndentingNewLine]", 
         "]"}], ";"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}]}]], "Input",
