Cell[CellGroupData[{

Cell["2ary: Precision vs # of FFT Points Used for Fit", "Title",
 CellChangeTimes->{{3.9619822521391845`*^9, 3.961982256810952*^9}, {
  3.9619848369103327`*^9, 3.961984879556754*^9}, {3.968465968410338*^9, 
