Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"process", " ", "statistics", " ", "on", " ", "FFT"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "FFTStatsProcess", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"FFTStatsProcess", "[", "\[IndentingNewLine]", 
      RowBox[{"dataFFT_List", ",", "\[IndentingNewLine]", 
       RowBox[{"OptionsPattern", "[", "]"}]}], "\[IndentingNewLine]", "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"bgrPoints", "=", 
          RowBox[{"dataFFT", "[", 
           RowBox[{"[", 
            RowBox[{";;", ",", "2"}], "]"}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "calculate", " ", "background", " ", "threshold", " ", "as", " ", 
           "x", " ", "stdevs", " ", "above", " ", "mean"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"bgrThreshold", "=", 
          RowBox[{
           RowBox[{"Mean", "[", 
            RowBox[{"dataFFT", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "2"}], "]"}], "]"}], "]"}], "+", 
           RowBox[{
            RowBox[{"StandardDeviation", "[", 
             RowBox[{"dataFFT", "[", 
              RowBox[{"[", 
               RowBox[{";;", ",", "2"}], "]"}], "]"}], "]"}], "*", 
            RowBox[{
            "OptionValue", "[", "\"\<BackgroundStdevs\>\"", "]"}]}]}]}], ",", 
         "\[IndentingNewLine]", "bgrPointsReduced", ",", "bgrDistFit", ",", 
         "\[IndentingNewLine]", "bgrHistBinSize", ",", "bgrHistPlot", ",", 
         "bgrDistFitPlot"}], "\[IndentingNewLine]", "}"}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "remove", " ", "peak", " ", "points", " ", "to", " ", "make", " ", 
         "hist", " ", "happier"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"note", ":", " ", 
         RowBox[{"exclude", " ", "0", " ", "points", " ", 
          RowBox[{"b", "/", "c"}], " ", "it", " ", "makes", " ", 
          "EstimatedDistribution", " ", "unhappy"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"bgrPointsReduced", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"bgrPoints", ",", 
           RowBox[{
            RowBox[{
             SuperscriptBox["10.", 
              RowBox[{"-", "9"}]], "<", "#", "<", "bgrThreshold"}], "&"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "fit", " ", "FFT", " ", "background", " ", "to", " ", "a", " ", 
          "Gamma", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"i", ".", "e", ".", " ", "\[CapitalGamma]"}], 
            RowBox[{"(", 
             RowBox[{"\[Alpha]", ",", " ", "\[Lambda]"}], ")"}]}], ")"}], " ",
           "distribution"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"bgrDistFit", "=", 
         RowBox[{"EstimatedDistribution", "[", 
          RowBox[{"bgrPointsReduced", ",", 
           RowBox[{"GammaDistribution", "[", 
            RowBox[{"\[Alpha]", ",", "\[Lambda]"}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "get", " ", "histogram", " ", "bin", " ", "size", " ", "from", " ", 
          "HistogramList", " ", "lol"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"bgrHistBinSize", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Mean", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{"2", ";;", 
                RowBox[{"-", "1"}]}], "]"}], "]"}], "-", 
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{"1", ";;", 
                RowBox[{"-", "2"}]}], "]"}], "]"}]}], "]"}], "&"}], "[", 
          RowBox[{
           RowBox[{"HistogramList", "[", 
            RowBox[{
            "bgrPointsReduced", ",", "\"\<Scott\>\"", ",", 
             "\"\<Probability\>\""}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"plot", " ", "data", " ", "histogram"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"bgrHistPlot", "=", 
         RowBox[{"Histogram", "[", "\[IndentingNewLine]", 
          RowBox[{
          "bgrPointsReduced", ",", "\[IndentingNewLine]", "\"\<Scott\>\"", 
           ",", "\[IndentingNewLine]", "\"\<Probability\>\"", ",", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"FrameLabel", "\[Rule]", 
            RowBox[{"{", "\[IndentingNewLine]", " ", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{
                  RowBox[{"StringForm", "[", 
                   RowBox[{"\"\<``\>\"", ",", "\"\<Probability\>\""}], "]"}], 
                  ",", 
                  RowBox[{"{", 
                   RowBox[{"Black", ",", 
                    RowBox[{"Directive", "[", "15", "]"}]}], "}"}]}], "]"}], 
                ",", "None"}], "}"}], ",", "\[IndentingNewLine]", 
              RowBox[{"{", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{
                  RowBox[{"StringForm", "[", 
                   RowBox[{
                   "\"\<``\>\"", ",", 
                    "\"\<Power (\!\(\*SuperscriptBox[\(Ampl\), \
\(2\)]\))\>\""}], "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"Black", ",", 
                    RowBox[{"Directive", "[", "15", "]"}]}], "}"}]}], "]"}], 
                ",", "\[IndentingNewLine]", 
                RowBox[{"Style", "[", 
                 RowBox[{
                  RowBox[{"StringForm", "[", 
                   RowBox[{
                   "\"\<FFT Background Statistics: N = ``\\nRID: ``\>\"", ",",
                     "numSamplePoints", ",", "rid"}], "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"Black", ",", 
                    RowBox[{"Directive", "[", "15", "]"}]}], "}"}]}], "]"}]}],
                "\[IndentingNewLine]", "}"}]}], "\[IndentingNewLine]", 
             "}"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"ImageSize", "->", 
            RowBox[{"Scaled", "[", "0.4", "]"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"PerformanceGoal", "->", "\"\<Speed\>\""}]}], 
          "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
