Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"implement", " ", "FFTBlockFit"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"FFTBlockFit", "[", "\[IndentingNewLine]", 
     RowBox[{"data_List", ",", "\[IndentingNewLine]", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "\[IndentingNewLine]", "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "use", " ", "block", " ", "to", " ", "define", " ", "local", " ", 
         "variables"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
       "A", ",", "\[CapitalGamma]", ",", "x", ",", "f", ",", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "extract", " ", "user", " ", "configured", " ", "parameters"}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"fitMethod", "=", 
         RowBox[{"OptionValue", "[", "\"\<FitMethod\>\"", "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"fitFudgeArr", "=", 
         RowBox[{"OptionValue", "[", "\"\<FitFudgeArray\>\"", "]"}]}]}], 
       "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"helper", " ", "variables"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"numSamplePoints", "=", 
           RowBox[{"Length", "[", "data", "]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"tmax", "=", 
           RowBox[{
            RowBox[{"data", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}], "-", 
            RowBox[{"data", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}]}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"fmax", "=", 
             FractionBox["1.", 
              RowBox[{"Mean", "[", 
               RowBox[{
                RowBox[{"data", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"2", ";;"}], ",", "1"}], "]"}], "]"}], "-", 
                RowBox[{"data", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"1", ";;", 
                    RowBox[{"-", "2"}]}], ",", "1"}], "]"}], "]"}]}], 
               "]"}]]}], ","}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"fmax", "=", 
           FractionBox["1.", 
            RowBox[{
             RowBox[{"data", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", "1"}], "]"}], "]"}], "-", 
             RowBox[{"data", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}]}]]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"dfProcessed", "=", 
           RowBox[{
            FractionBox["1.", 
             RowBox[{
              RowBox[{"data", "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", "1"}], "]"}], "]"}], "-", 
              RowBox[{"data", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "1"}], "]"}], "]"}]}]], "*", 
            FractionBox["1.", 
             RowBox[{
              RowBox[{"Length", "[", "data", "]"}], "-", "1"}]]}]}], ",", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"fft", "-", "related"}], "*)"}], "\[IndentingNewLine]", 
          "dataFFTMag", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"lorentzian", " ", "fitting"}], "*)"}], 
          "\[IndentingNewLine]", "fitGuess", ",", "peakIndDJ", ",", "fitRes", 
          ",", "\[CapitalGamma]guess", ",", "\[IndentingNewLine]", 
          "peakFitIndMin", ",", "peakFitIndMax"}], "\[IndentingNewLine]", 
         "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"do", " ", "FFT"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"dataFFTMag", "=", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"fft", " ", "freqs"}], " ", "-", " ", "x", "-", 
              "axis"}], "*)"}], "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"Range", "[", 
               RowBox[{"0", ",", 
                FractionBox["fmax", "2."], ",", "dfProcessed"}], "]"}], "[", 
              RowBox[{"[", 
               RowBox[{";;", 
                RowBox[{"IntegerPart", "[", 
                 FractionBox["numSamplePoints", "2."], "]"}]}], "]"}], "]"}], 
             ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{"fft", " ", "values"}], " ", "-", " ", 
               RowBox[{"power", " ", 
                RowBox[{"(", 
                 RowBox[{"i", ".", "e", ".", " ", 
                  SuperscriptBox["ampl", "2"]}], ")"}]}]}], "*)"}], 
             "\[IndentingNewLine]", 
             SuperscriptBox[
              RowBox[{"Abs", "[", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Fourier", "[", "\[IndentingNewLine]", 
                 RowBox[{"(*", 
                  RowBox[{
                  "subtract", " ", "DC", " ", "offsets", " ", "from", " ", 
                   "the", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"data", "[", 
                    RowBox[{"[", 
                    RowBox[{";;", ",", "2"}], "]"}], "]"}], "-", 
                   RowBox[{"Mean", "[", 
                    RowBox[{"data", "[", 
                    RowBox[{"[", 
                    RowBox[{";;", ",", "2"}], "]"}], "]"}], "]"}]}], ",", 
                  "\[IndentingNewLine]", "\[IndentingNewLine]", 
                  RowBox[{"(*", 
                   RowBox[{
                    RowBox[{"fourier", " ", "parameters"}], " ", "-", " ", 
                    RowBox[{
                    RowBox[{"don", "'"}], "t", " ", "normalize"}]}], "*)"}], 
                  "\[IndentingNewLine]", 
                  RowBox[{"FourierParameters", "->", 
                   RowBox[{"{", 
                    RowBox[{"1", ",", 
                    RowBox[{"-", "1"}]}], "}"}]}]}], "\[IndentingNewLine]", 
                 "\[IndentingNewLine]", 
                 RowBox[{"(*", 
                  RowBox[{
                  "extract", " ", "results", " ", "only", " ", "up", " ", 
                   "until", " ", "the", " ", "nyquist", " ", "limit"}], 
                  "*)"}], "\[IndentingNewLine]", "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{";;", 
                  RowBox[{"IntegerPart", "[", 
                   FractionBox["numSamplePoints", "2."], "]"}]}], "]"}], 
                "]"}], "\[IndentingNewLine]", "]"}], "2."]}], 
            "\[IndentingNewLine]", "}"}], "]"}]}], ";", "\[IndentingNewLine]",
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"prepare", " ", "fitting"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"peakIndDJ", "=", 
          RowBox[{"First", "@", 
           RowBox[{"Ordering", "[", 
            RowBox[{
             RowBox[{"dataFFTMag", "[", 
              RowBox[{"[", 
               RowBox[{";;", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"-", "1"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"\[CapitalGamma]guess", "=", 
          RowBox[{
           FractionBox["1.", "tmax"], "*", 
           RowBox[{"(", 
            SuperscriptBox["2", "0.5"], ")"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"\[CapitalGamma]guess", "=", 
          RowBox[{"Mean", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"Guess\[CapitalGamma]Lorentzian", "[", 
              RowBox[{"#", ",", 
               RowBox[{"dataFFTMag", "[", 
                RowBox[{"[", "peakIndDJ", "]"}], "]"}]}], "]"}], "&"}], "/@", 
            RowBox[{"dataFFTMag", "[", 
             RowBox[{"[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"peakIndDJ", "-", "1"}], ",", 
                RowBox[{"peakIndDJ", "+", "1"}]}], "}"}], "]"}], "]"}]}], 
           "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"fitGuess", "=", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"A", ",", 
              RowBox[{
               SuperscriptBox["\[CapitalGamma]guess", "1."], "*", 
               RowBox[{"(", 
                RowBox[{"Subtract", "@@", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"dataFFTMag", "[", 
                    RowBox[{"[", 
                    RowBox[{"peakIndDJ", ",", "2"}], "]"}], "]"}], ",", 
                   RowBox[{"Min", "[", 
                    RowBox[{"dataFFTMag", "[", 
                    RowBox[{"[", 
                    RowBox[{";;", ",", "2"}], "]"}], "]"}], "]"}]}], "}"}]}], 
                ")"}], "*", 
               RowBox[{"fitFudgeArr", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"\[CapitalGamma]", ",", 
              RowBox[{
               SuperscriptBox["\[CapitalGamma]guess", "1."], "*", 
               RowBox[{"fitFudgeArr", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"f", ",", 
              RowBox[{
               RowBox[{"dataFFTMag", "[", 
                RowBox[{"[", 
                 RowBox[{"peakIndDJ", ",", "1"}], "]"}], "]"}], "+", 
               RowBox[{"(", 
                RowBox[{"dfProcessed", "*", 
                 RowBox[{"fitFudgeArr", "[", 
                  RowBox[{"[", "3", "]"}], "]"}]}], ")"}]}]}], "}"}]}], 
           "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "get", " ", "points", " ", "to", " ", "use", " ", "for", " ", 
           "fit"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"OptionValue", "[", "\"\<PeakFitNumPoints\>\"", "]"}], ">=",
             "1"}], ",", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"true", " ", 
             RowBox[{"case", ":", " ", 
              RowBox[{"use", " ", "valid", " ", "PeakFitNumPoints"}]}]}], 
            "*)"}], "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"peakFitIndMin", ",", "peakFitIndMax"}], "}"}], "=", 
             RowBox[{"{", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Max", "[", 
                RowBox[{"1", ",", 
                 RowBox[{"peakIndDJ", "-", 
                  RowBox[{
                  "OptionValue", "[", "\"\<PeakFitNumPoints\>\"", "]"}]}]}], 
                "]"}], ",", "\[IndentingNewLine]", 
               RowBox[{"Min", "[", 
                RowBox[{
                 RowBox[{"Length", "[", "dataFFTMag", "]"}], ",", 
                 RowBox[{"peakIndDJ", "+", 
                  RowBox[{
                  "OptionValue", "[", "\"\<PeakFitNumPoints\>\"", "]"}]}]}], 
                "]"}]}], "\[IndentingNewLine]", "}"}]}], ";"}], ",", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"false", " ", 
             RowBox[{"case", ":", " ", 
              RowBox[{"use", " ", "full", " ", "range"}]}]}], "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"peakFitIndMin", ",", "peakFitIndMax"}], "}"}], "=", 
             RowBox[{"{", 
              RowBox[{"1", ",", 
               RowBox[{"-", "1"}]}], "}"}]}], ";"}]}], "\[IndentingNewLine]", 
          "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"do", " ", "fit"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"fitRes", "=", 
          RowBox[{"NonlinearModelFit", "[", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"raw", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"dataFFTMag", "[", 
             RowBox[{"[", 
              RowBox[{"peakFitIndMin", ";;", "peakFitIndMax"}], "]"}], "]"}], 
            ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"fit", " ", "function"}], "*)"}], "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"A", "*", 
              FractionBox["\[CapitalGamma]", 
               RowBox[{
                SuperscriptBox["\[CapitalGamma]", "2."], "+", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"x", "-", "f"}], ")"}], "2."]}]]}], "}"}], ",", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"fit", " ", "guesses"}], "*)"}], "\[IndentingNewLine]", 
            "fitGuess", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"fit", " ", "variable"}], "*)"}], "\[IndentingNewLine]", 
            "x", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"configure", " ", "solving"}], "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"MaxIterations", "->", "Automatic"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Method", "->", "fitMethod"}]}], "\[IndentingNewLine]", 
           "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "clean", " ", "up", " ", "to", " ", "reduce", " ", "overheads"}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"Clear", "[", 
          RowBox[{
          "numSamplePoints", ",", "tmax", ",", "fmax", ",", "dfProcessed", 
           ",", "peakIndDJ", ",", "\[CapitalGamma]guess", ",", 
           "peakFitIndMin", ",", "peakFitIndMax"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"ClearInOut", "[", "]"}], ";", 
         RowBox[{"ClearSystemCache", "[", "]"}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "return", " ", "both", " ", "the", " ", "processed", " ", "data", 
           " ", "and", " ", "the", " ", "fitted", " ", "result"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"Return", "[", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"dataFFTMag", ",", "fitGuess", ",", "fitRes"}], "}"}], 
          "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
       "]"}]}], "]"}]}], ";"}]}]], "Input",
