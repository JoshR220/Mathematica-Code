Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"fit", " ", "Around", " ", "data", " ", "for", " ", "log"}], "-", 
    RowBox[{
     RowBox[{"log", "'"}], "d", " ", "linear", " ", "model"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "FitLinearFuncLog", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"FitLinearFuncLog", "[", "dataset_List", "]"}], ":=", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", "x", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Module", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"dataRaw", "=", 
             RowBox[{"Log", "[", "dataset", "]"}]}], ",", 
            "\[IndentingNewLine]", "dataValues", ",", "dataWeights"}], 
           "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "separate", " ", "data", " ", "values", " ", "from", " ", 
            "uncertainties"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"dataValues", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{
