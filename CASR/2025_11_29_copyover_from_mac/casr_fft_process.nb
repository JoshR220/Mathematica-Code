    "add", " ", "24", " ", "hours", " ", "when", " ", "we", " ", "cross", " ",
      "over"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dateVals", "=", 
     RowBox[{"MapThread", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"DatePlus", "[", 
         RowBox[{"#1", ",", "#2"}], "]"}], "&"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", "\[IndentingNewLine]", 
