         "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"stop", " ", "execution", " ", "if", " ", "file", " ", 
         RowBox[{"doesn", "'"}], "t", " ", "exist"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "filenameDJ", "]"}], "==", "0"}], ",", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"MessageDialog", "[", 
           RowBox[{"\"\<Failure :(\\nError: Specified file not found (\>\"", "<>", 
            RowBox[{"ToString", "[", "ridName", "]"}], "<>", "\"\<).\>\""}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{
          "FrontEndTokenExecute", "[", "\"\<EvaluatorAbort\>\"", "]"}]}], ",",
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"filenameDJ", "=", 
           RowBox[{"First", "@", "filenameDJ"}]}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "extract", " ", "file", " ", "results", " ", "as", " ", "list", " ", 
         "and", " ", "parameters", " ", "as", " ", "an", " ", "association"}],
         "*)"}], "\[IndentingNewLine]", 
       RowBox[{"datasetRaw", "=", 
        RowBox[{"Import", "[", 
         RowBox[{"filenameDJ", ",", 
          RowBox[{"{", "\"\</datasets/results\>\"", "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"parameterList", "=", 
