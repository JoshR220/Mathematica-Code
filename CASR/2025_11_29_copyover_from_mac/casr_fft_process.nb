Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"batch", " ", "display", " ", "function"}], " ", "-", " ", 
     RowBox[{"uses", " ", "FFTBlockPlot"}]}], ",", " ", 
    RowBox[{
    "which", " ", "in", " ", "turn", " ", "uses", " ", "FFTBlockFit"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"FFTBlockPlotNicer", "[", "\[IndentingNewLine]", 
    RowBox[{"datasetRaw_List", ",", "\[IndentingNewLine]", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "\[IndentingNewLine]", "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"get", " ", "results", " ", "from", " ", "FFTBlockPlot"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"localDataDJ", "=", 
        RowBox[{"FFTBlockPlot", "[", "\[IndentingNewLine]", 
         RowBox[{"datasetRaw", ",", "\[IndentingNewLine]", 
          RowBox[{"\"\<FitMethod\>\"", "->", 
           RowBox[{"OptionValue", "[", "\"\<FitMethod\>\"", "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<FitFudgeArray\>\"", "->", 
           RowBox[{"OptionValue", "[", "\"\<FitFudgeArray\>\"", "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<PeakFitNumPoints\>\"", "->", 
           RowBox[{"OptionValue", "[", "\"\<PeakFitNumPoints\>\"", "]"}]}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{"\"\<ReducedPointSpanPlot\>\"", "->", 
           RowBox[{
           "OptionValue", "[", "\"\<ReducedPointSpanPlot\>\"", "]"}]}]}], 
         "\[IndentingNewLine]", "]"}]}], ",", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", "dataFFTMagDJ", ",", "fitResDJ", ",", 
       "fitParamsDJ", ",", "plotDataFFTMagDJ", ",", "\[IndentingNewLine]", 
       "plotFittedFFTMagDJ", ",", "resString", ",", "summaryPlot"}], 
      "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "break", " ", "out", " ", "results", " ", "from", " ", "FFTBlockPlot", 
       " ", "function"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"dataFFTMagDJ", ",", "fitResDJ"}], "}"}], "=", 
       RowBox[{"localDataDJ", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "3"}], "}"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "fitParamsDJ", ",", "plotDataFFTMagDJ", ",", "plotFittedFFTMagDJ"}], 
        "}"}], "=", 
       RowBox[{"localDataDJ", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "print", " ", "freq", " ", "precision", " ", "to", " ", "3", "dp"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"resString", "=", 
       RowBox[{"StringForm", "[", "\[IndentingNewLine]", 
        RowBox[{
        "\"\<Linecenter Precision: `` \[Mu]Hz\>\"", ",", 
         "\[IndentingNewLine]", 
         RowBox[{"NumberForm", "[", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"1.*^6", "*", 
             RowBox[{"Subtract", "@@", 
              RowBox[{
               RowBox[{
               "fitResDJ", "[", "\"\<ParameterConfidenceIntervals\>\"", "]"}],
                "[", 
               RowBox[{"[", "3", "]"}], "]"}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Infinity]", ",", "3"}], "}"}]}], "]"}]}], 
        "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"create", " ", "summary", " ", "plot"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"summaryPlot", "=", 
       RowBox[{"Show", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
          "plotDataFFTMagDJ", ",", "\[IndentingNewLine]", 
           "plotFittedFFTMagDJ"}], "\[IndentingNewLine]", "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"Full", ",", "Full"}], "}"}], ",", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"{", 
              RowBox[{"Full", ",", 
               RowBox[{"Max", "[", 
                RowBox[{"dataFFTMagDJ", "[", 
                 RowBox[{"[", 
                  RowBox[{";;", ",", "2"}], "]"}], "]"}], "]"}]}], 
              RowBox[{"(*", 
               RowBox[{"*", "3."}], "*)"}], "}"}], "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"Full", ",", "Full"}], "}"}]}], "\[IndentingNewLine]", 
           "}"}]}]}], "\[IndentingNewLine]", "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"clean", " ", "up", " ", "after", " ", "ourselves"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Clear", "[", 
       RowBox[{
       "localDataDJ", ",", "dataFFTMagDJ", ",", "fitResDJ", ",", 
        "plotDataFFTMagDJ", ",", "plotFittedFFTMagDJ"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ClearInOut", "[", "]"}], ";", 
      RowBox[{"ClearSystemCache", "[", "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"Return", "[", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"resString", ",", "fitParamsDJ", ",", "summaryPlot"}], "}"}], 
       "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9687000754442577`*^9, 3.968700413318821*^9}, {
