Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", 
   RowBox[{"power", "-", 
    RowBox[{
    "law", " ", "fit", " ", "function", "\[IndentingNewLine]", "used", " ", 
     "here", " ", "mostly", " ", "for", " ", "ADEV", " ", "trendline", " ", 
     "fitting"}]}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"FitPowerFunc", "[", "dataset_", "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
       "A", ",", "x", ",", "K", ",", "B", ",", "\[IndentingNewLine]", 
        "guessK", ",", "guessA", ",", "\[IndentingNewLine]", 
        RowBox[{"logData", "=", 
         RowBox[{"Log", "[", "dataset", "]"}]}]}], "\[IndentingNewLine]", 
       "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"guess", " ", "parameter", " ", "values"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"guessK", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Mean", "[", 
           FractionBox[
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "2"}], "]"}], "]"}], 
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "1"}], "]"}], "]"}]], "]"}], "&"}], "[", 
         RowBox[{
          RowBox[{"logData", "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], "-", 
          RowBox[{"logData", "[", 
           RowBox[{"[", 
            RowBox[{";;", 
             RowBox[{"-", "2"}]}], "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"guessA", "=", 
        RowBox[{"Exp", "[", 
         RowBox[{"Mean", "[", 
          RowBox[{
           RowBox[{"logData", "[", 
            RowBox[{"[", 
             RowBox[{";;", ",", "2"}], "]"}], "]"}], "-", 
           RowBox[{"guessK", "*", 
            RowBox[{"logData", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "1"}], "]"}], "]"}]}]}], "]"}], "]"}]}], ";",
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"do", " ", 
         RowBox[{"fit", "!"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "\[IndentingNewLine]", 
        RowBox[{"NonlinearModelFit", "[", 
         RowBox[{"dataset", ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"A", "*", 
            SuperscriptBox["x", "K"]}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"A", ",", "guessA"}], "}"}], ",", "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"K", ",", "guessK"}], "}"}]}], "}"}], ",", 
          "\[IndentingNewLine]", "x"}], "\[IndentingNewLine]", "]"}], 
        "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}]}],
    ";"}]}]], "Input",
