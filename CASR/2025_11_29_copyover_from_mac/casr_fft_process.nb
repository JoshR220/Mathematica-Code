    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"convert", " ", "into", " ", "date", " ", "objects"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dateVals", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"DateObject", "[", 
        RowBox[{"Join", "[", 
         RowBox[{"dateDJ", ",", "#"}], "]"}], "]"}], "&"}], "/@", 
      RowBox[{"valProc", "[", 
