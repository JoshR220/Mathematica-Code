Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"(*", 
   RowBox[{"todo", ":", " ", "document"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Clear", "[", "OverlapBlockProcess", "]"}], ";"}], 
     "\[IndentingNewLine]", 
     RowBox[{"OverlapBlockProcess", "[", "\[IndentingNewLine]", 
      RowBox[{"dataset_List", ",", "\[IndentingNewLine]", 
       RowBox[{"blockSize", ":", 
        RowBox[{"(", 
         RowBox[{"_Integer", "|", "_Real"}], ")"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"peakFreq_", ":", 
        RowBox[{"(", 
         RowBox[{"_Integer", "|", "_Real"}], ")"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"peakTol", ":", 
        RowBox[{"(", 
         RowBox[{"_Integer", "|", "_Real"}], ")"}]}]}], "\[IndentingNewLine]",
       "]"}]}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"partition", " ", "dataset", " ", "into", " ", "non"}], "-", 
         RowBox[{"overlapping", " ", "blocks"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"dsBlocks", "=", 
         RowBox[{"Partition", "[", 
          RowBox[{"dataset", ",", "blockSize"}], "]"}]}], ",", 
        "\[IndentingNewLine]", "procRes", ",", "validProcRes", ",", 
        "precisionADEVData", ",", "resolutionADEVData"}], 
       "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"process", " ", "all", " ", "non"}], "-", 
        RowBox[{"overlapping", " ", "blocks"}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"procRes", "=", 
        RowBox[{"Map", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"FFTBlockFit", "[", "\[IndentingNewLine]", 
            RowBox[{"#", ",", "\[IndentingNewLine]", 
             RowBox[{"\"\<FitMethod\>\"", "->", "fitMethodScalingProcess"}], 
             ",", "\[IndentingNewLine]", 
             RowBox[{
             "\"\<PeakFitNumPoints\>\"", "->", 
              "numPointsPeakFitScalingADEV"}], ",", "\[IndentingNewLine]", 
             RowBox[{
             "\"\<FitFudgeArray\>\"", "->", "fitFudgeScalingProcess"}]}], 
            "\[IndentingNewLine]", "]"}], "&"}], ",", "\[IndentingNewLine]", 
          "dsBlocks"}], "\[IndentingNewLine]", "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "select", " ", "only", " ", "results", " ", "which", " ", "fit", " ", 
         "OK"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"validProcRes", "=", 
        RowBox[{"Select", "[", "\[IndentingNewLine]", 
         RowBox[{"procRes", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"f", "/.", 
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "3", "]"}], "]"}], "[", 
                 "\"\<BestFitParameters\>\"", "]"}]}], ")"}], "-", 
              "peakFreq"}], "]"}], "<", "peakTol"}], "&"}]}], 
         "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"StringForm", "[", 
           RowBox[{
           "\"\<Block Size: ``\\tStart: `` => Valid: ``\>\"", ",", 
            "blockSize", ",", 
            RowBox[{"Length", "[", "procRes", "]"}], ",", 
            RowBox[{"Length", "[", "validProcRes", "]"}]}], "]"}], "]"}], 
         ";"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"precision", ":", " ", 
         RowBox[{
         "extract", " ", "confidence", " ", "intervals", " ", "from", " ", 
          "fit", " ", "results", " ", "for", " ", "plotting"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"precisionADEVData", "=", 
          RowBox[{"Map", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", "\"\<ParameterConfidenceIntervals\>\"", "]"}],
               "[", 
              RowBox[{"[", "3", "]"}], "]"}], "&"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"validProcRes", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "3"}], "]"}], "]"}]}], "\[IndentingNewLine]",
            "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"precisionADEVData", "=", 
          RowBox[{"Subtract", "@@@", "precisionADEVData"}]}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"precision", ":", " ", 
         RowBox[{
         "take", " ", "as", " ", "uncertainty", " ", "of", " ", 
          "linecenter"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"precisionProcStyle", "==", "\"\<ERR\>\""}], ",", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"case", ":", " ", 
           RowBox[{"error", " ", "style"}]}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"precisionADEVData", "=", 
           RowBox[{"Map", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", "\"\<ParameterTableEntries\>\"", "]"}], "[", 
               RowBox[{"[", 
                RowBox[{"3", ",", "2"}], "]"}], "]"}], "&"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"validProcRes", "[", 
              RowBox[{"[", 
               RowBox[{";;", ",", "3"}], "]"}], "]"}]}], 
            "\[IndentingNewLine]", "]"}]}], ";"}], ",", "\[IndentingNewLine]",
          "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"case", ":", " ", 
           RowBox[{"95", "%", " ", "confint", " ", "style"}]}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"precisionADEVData", "=", 
           RowBox[{"Map", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
               "#", "[", "\"\<ParameterConfidenceIntervals\>\"", "]"}], "[", 
               RowBox[{"[", "3", "]"}], "]"}], "&"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"validProcRes", "[", 
              RowBox[{"[", 
               RowBox[{";;", ",", "3"}], "]"}], "]"}]}], 
            "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"precisionADEVData", "=", 
           RowBox[{"Subtract", "@@@", "precisionADEVData"}]}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{"extract", " ", "precision"}], " ", "&"}], " ", 
         "resolution", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"resolutionADEVData", "=", 
        RowBox[{"Map", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"\[CapitalGamma]", "/.", 
            RowBox[{"#", "[", "\"\<BestFitParameters\>\"", "]"}]}], "&"}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{"validProcRes", "[", 
           RowBox[{"[", 
            RowBox[{";;", ",", "3"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
         "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"clean", " ", "up", " ", "after", " ", "ourselves"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"Clear", "[", 
        RowBox[{"procRes", ",", "dsBlocks", ",", "validProcRes"}], "]"}], ";", 
       RowBox[{"ClearInOut", "[", "]"}], ";", 
       RowBox[{"ClearSystemCache", "[", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "need", " ", "to", " ", "ensure", " ", "results", " ", "are", " ", 
           "positive", " ", "otherwise", " ", "booboo"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Abs", "[", "precisionADEVData", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Abs", "[", "resolutionADEVData", "]"}]}], 
         "\[IndentingNewLine]", "}"}], "]"}], ";"}]}], "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "]"}]}], ";"}], "*)"}]], "Input",
