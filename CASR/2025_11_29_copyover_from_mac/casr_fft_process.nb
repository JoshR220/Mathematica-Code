4149202e0115"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"function", " ", "that", " ", "takes", " ", "raw", " ", "time"}],
      "-", 
     RowBox[{"series", " ", "data"}]}], ",", " ", 
    RowBox[{"then", " ", "calls", " ", "FFTBlockFit"}], ",", " ", 
    RowBox[{"then", " ", "plots", " ", "fit", " ", "with", " ", "raw"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "FFTBlockPlot", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "FFTBlockPlot", "]"}], "=", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "method", " ", "to", " ", "use", " ", "for", " ", 
        "NonlinearModelFit"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\"\<FitMethod\>\"", "->", "\"\<ConjugateGradient\>\""}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "fudge", " ", "factors", " ", "for", " ", "initial", " ", "guesses", 
         " ", "for", " ", 
         RowBox[{"{", 
          RowBox[{"A", ",", "\[CapitalGamma]", ",", "f"}], "}"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<FitFudgeArray\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"1.", ",", "1.", ",", "0."}], "}"}]}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "number", " ", "of", " ", "points", " ", "about", " ", "peak", " ", 
         "to", " ", "use", " ", "for", " ", "fitting"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<PeakFitNumPoints\>\"", "->", 
        RowBox[{"-", "1"}]}], ",", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "reduced", " ", "number", " ", "of", " ", "points", " ", "to", " ", 
         "plot", " ", "around", " ", "the", " ", "fit"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<ReducedPointSpanPlot\>\"", "->", 
        RowBox[{"-", "1"}]}]}], "\[IndentingNewLine]", "}"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.968714006367483*^9, 3.968714006513248*^9}, {
  3.970268055556344*^9, 3.970268056083398*^9}, {3.970270810685383*^9, 
