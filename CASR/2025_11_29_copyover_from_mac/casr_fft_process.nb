Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"batch", " ", "display", " ", "function"}], " ", "-", " ", 
     RowBox[{"uses", " ", "FFTBlockPlot"}]}], ",", " ", 
    RowBox[{
    "which", " ", "in", " ", "turn", " ", "uses", " ", "FFTBlockFit"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "FFTBlockPlotNicer", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "FFTBlockPlotNicer", "]"}], "=", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "method", " ", "to", " ", "use", " ", "for", " ", 
        "NonlinearModelFit"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\"\<FitMethod\>\"", "->", "\"\<ConjugateGradient\>\""}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "fudge", " ", "factors", " ", "for", " ", "initial", " ", "guesses", 
         " ", "for", " ", 
         RowBox[{"{", 
          RowBox[{"A", ",", "\[CapitalGamma]", ",", "f"}], "}"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<FitFudgeArray\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"1.", ",", "1.", ",", "0."}], "}"}]}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "number", " ", "of", " ", "points", " ", "about", " ", "peak", " ", 
         "to", " ", "use", " ", "for", " ", "fitting", " ", "AND", " ", 
         "plotting"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"\"\<PeakFitNumPoints\>\"", "->", 
        RowBox[{"-", "1"}]}], ",", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "reduced", " ", "number", " ", "of", " ", "points", " ", "to", " ", 
         "plot", " ", "around", " ", "the", " ", "fit"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<ReducedPointSpanPlot\>\"", "->", 
        RowBox[{"-", "1"}]}]}], "\[IndentingNewLine]", "}"}]}], 
    ";"}]}]}]], "Input",
