         RowBox[{
          RowBox[{"Head", "[", "fileDirectories", "]"}], "==", "String"}], 
         ",", "\[IndentingNewLine]", 
         RowBox[{"fileDirectories", "=", 
          RowBox[{"{", "filedirs", "}"}]}]}], "\[IndentingNewLine]", "]"}], 
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"ensure", " ", "import", " ", "directory", " ", "exists"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"AnyTrue", "[", 
           RowBox[{"DirectoryQ", "/@", "filedirs"}], "]"}]}], ",", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "stop", " ", "execution", " ", "if", " ", "import", " ", 
           "directory", " ", 
           RowBox[{"doesn", "'"}], "t", " ", "exist"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
          "MessageDialog", "[", 
