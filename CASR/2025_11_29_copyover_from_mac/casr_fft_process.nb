Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"implement", " ", "FFTBlockPlot"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"note", ":", " ", 
    RowBox[{
    "function", " ", "requires", " ", "\"\<rid\>\"", " ", "variable", " ", 
     "to", " ", "be", " ", "defined"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"FFTBlockPlot", "[", "\[IndentingNewLine]", 
    RowBox[{"data_List", ",", "\[IndentingNewLine]", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "\[IndentingNewLine]", "]"}], ":=", 
   RowBox[{"Block", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
      "A", ",", "\[CapitalGamma]", ",", "f", ",", "x", ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "extract", " ", "user", " ", "configured", " ", "parameters"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"fitMethod", "=", 
        RowBox[{"OptionValue", "[", "\"\<FitMethod\>\"", "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"fitFudgeArr", "=", 
        RowBox[{"OptionValue", "[", "\"\<FitFudgeArray\>\"", "]"}]}]}], 
      "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"get", " ", "FFT", " ", "and", " ", "fitted", " ", "data"}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"dataProcRes", "=", 
          RowBox[{"FFTBlockFit", "[", "\[IndentingNewLine]", 
           RowBox[{"data", ",", "\[IndentingNewLine]", 
            RowBox[{"\"\<FitMethod\>\"", "->", "fitMethod"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"\"\<FitFudgeArray\>\"", "->", "fitFudgeArr"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"\"\<PeakFitNumPoints\>\"", "->", 
             RowBox[{
             "OptionValue", "[", "\"\<PeakFitNumPoints\>\"", "]"}]}]}], 
           "\[IndentingNewLine]", "]"}]}], ",", "\[IndentingNewLine]", 
         "dataFFTMag", ",", "fitGuess", ",", "fitRes", ",", "fftStepSize", 
         ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", "plots", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"fitModel", "=", 
          RowBox[{"A", "*", 
           FractionBox["\[CapitalGamma]", 
            RowBox[{
             SuperscriptBox["\[CapitalGamma]", "2"], "+", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"x", "-", "f"}], ")"}], "2"]}]]}]}], ",", 
         "\[IndentingNewLine]", "fitGuessModel", ",", "plotDataFFTMag", ",", 
         "plotFittedFFTMag", ",", "fitParams", ",", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"reduced", " ", "plot", " ", "range"}], "*)"}], 
         "\[IndentingNewLine]", "peakIndDJ", ",", "freqSpanShowMin", ",", 
         "freqSpanShowMax"}], "\[IndentingNewLine]", "}"}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"expand", " ", "dataProcRes"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"dataFFTMag", ",", "fitGuess", ",", "fitRes"}], "}"}], "=", 
         "dataProcRes"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "calculate", " ", "FFT", " ", "step", " ", "size", " ", "for", " ", 
          "convenience"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"fftStepSize", "=", 
         FractionBox[
          RowBox[{"2.", "*", 
           RowBox[{"dataFFTMag", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], 
          RowBox[{
           RowBox[{"Length", "[", "dataFFTMag", "]"}], "-", "1"}]]}], ";", 
        RowBox[{"(*", 
         RowBox[{
         "2", "x", " ", "max", " ", "freq", " ", "in", " ", "dataFFTMag", " ", 
          RowBox[{"b", "/", "c"}], " ", "nyquist"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "process", " ", "fit", " ", "parameters", " ", "into", " ", 
          "something", " ", "nice"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"fitParams", "=", 
         RowBox[{"Style", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{
            "fitRes", "[", "\"\<ParameterConfidenceIntervalTable\>\"", "]"}], 
            "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Background", "->", "White"}], ",", 
             RowBox[{"FontColor", "->", "Black"}], ",", 
             RowBox[{"FontSize", "->", "15"}]}], "}"}]}], 
          "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"get", " ", "reduced", " ", "fft", " ", "span"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"peakIndDJ", "=", 
         RowBox[{"First", "@", 
          RowBox[{"Ordering", "[", 
           RowBox[{
            RowBox[{"dataFFTMag", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "2"}], "]"}], "]"}], ",", 
            RowBox[{"-", "1"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"OptionValue", "[", "\"\<ReducedPointSpanPlot\>\"", "]"}], 
           ">=", "1"}], ",", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"true", " ", 
            RowBox[{"case", ":", " ", 
             RowBox[{"use", " ", "valid", " ", "ReducedPointSpanPlot"}]}]}], 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"freqSpanShowMin", ",", "freqSpanShowMax"}], "}"}], "=", 
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Max", "[", 
               RowBox[{"1", ",", 
                RowBox[{"peakIndDJ", "-", 
                 RowBox[{
                 "OptionValue", "[", "\"\<ReducedPointSpanPlot\>\"", 
                  "]"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{"Min", "[", 
               RowBox[{
                RowBox[{"Length", "[", "dataFFTMag", "]"}], ",", 
                RowBox[{"peakIndDJ", "+", 
                 RowBox[{
                 "OptionValue", "[", "\"\<ReducedPointSpanPlot\>\"", 
                  "]"}]}]}], "]"}]}], "\[IndentingNewLine]", "}"}]}], ";"}], 
          ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"false", " ", 
            RowBox[{"case", ":", " ", 
             RowBox[{"use", " ", "full", " ", "range"}]}]}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"freqSpanShowMin", ",", "freqSpanShowMax"}], "}"}], "=", 
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"-", "1"}]}], "}"}]}], ";"}]}], "\[IndentingNewLine]", 
         "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"plot", " ", "raw", " ", "data"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"plotDataFFTMag", "=", 
         RowBox[{"ListPlot", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"dataFFTMag", "[", 
              RowBox[{"[", 
               RowBox[{"freqSpanShowMin", ";;", "freqSpanShowMax"}], "]"}], 
              "]"}], ",", "\[IndentingNewLine]", 
             RowBox[{"dataFFTMag", "[", 
              RowBox[{"[", 
               RowBox[{"freqSpanShowMin", ";;", "freqSpanShowMax"}], "]"}], 
              "]"}]}], "\[IndentingNewLine]", "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"PlotRange", "->", 
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"Full", ",", "Full"}], "}"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"Full", ",", "Full"}], "}"}]}], "\[IndentingNewLine]", 
             "}"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"PlotRangePadding", "->", "False"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"FrameLabel", "\[Rule]", 
            RowBox[{"{", "\[IndentingNewLine]", " ", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{
                  RowBox[{"StringForm", "[", 
                   RowBox[{
                   "\"\<``\>\"", ",", 
                    "\"\<Power (\!\(\*SuperscriptBox[\(Ampl\), \
\(2\)]\))\>\""}], "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"Black", ",", 
                    RowBox[{"Directive", "[", "15", "]"}]}], "}"}]}], "]"}], 
                ",", "None"}], "}"}], ",", "\[IndentingNewLine]", 
              RowBox[{"{", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{
                  RowBox[{"StringForm", "[", 
                   RowBox[{"\"\<``\>\"", ",", "\"\<Frequency (Hz)\>\""}], 
                   "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"Black", ",", 
                    RowBox[{"Directive", "[", "15", "]"}]}], "}"}]}], "]"}], 
                ",", "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{"note", " ", "-", " ", 
                  RowBox[{"possible", " ", "bug"}], " ", "-", " ", 
                  RowBox[{
                  "requires", " ", "\"\<rid\>\"", " ", "variable", " ", "to", 
                   " ", "be", " ", "defined"}]}], "*)"}], 
                "\[IndentingNewLine]", 
                RowBox[{"Style", "[", 
                 RowBox[{
                  RowBox[{"StringForm", "[", 
                   RowBox[{"\"\<CASR FFT (RID: ``)\>\"", ",", 
                    RowBox[{"ToString", "[", "rid", "]"}]}], "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"Black", ",", 
                    RowBox[{"Directive", "[", "15", "]"}]}], "}"}]}], "]"}]}],
                "\[IndentingNewLine]", "}"}]}], "\[IndentingNewLine]", 
             "}"}]}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"Joined", "->", 
            RowBox[{"{", 
             RowBox[{"False", ",", "True"}], "}"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"PlotStyle", "->", 
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"DefaultPlotColors", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{"PointSize", "[", "0.011", "]"}]}], "}"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"DefaultPlotColors", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", "Dashed", ",", 
                RowBox[{"Thickness", "[", "0.004", "]"}]}], "}"}]}], 
             "\[IndentingNewLine]", "}"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"PlotLegends", "->", 
              RowBox[{"{", "\"\<FFT Power\>\"", "}"}]}], ","}], "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"ImageSize", "->", 
            RowBox[{"Scaled", "[", "0.45", "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"PerformanceGoal", "->", "\"\<Speed\>\""}]}], 
          "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "create", " ", "function", " ", "to", " ", "plot", " ", "initial", 
          " ", "guess"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"fitGuessModel", "=", 
         RowBox[{"ApplyFitGuess", "[", 
          RowBox[{"fitModel", ",", "fitGuess"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"plot", " ", "fitted", " ", 
          RowBox[{"lorentzian", "!"}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"plotFittedFFTMag", "=", 
         RowBox[{"Plot", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"fitRes", "[", "x", "]"}], ",", "\[IndentingNewLine]", 
             "fitGuessModel"}], "\[IndentingNewLine]", "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"x", ",", 
             RowBox[{"dataFFTMag", "[", 
              RowBox[{"[", 
               RowBox[{"freqSpanShowMin", ",", "1"}], "]"}], "]"}], ",", 
             RowBox[{"dataFFTMag", "[", 
              RowBox[{"[", 
               RowBox[{"freqSpanShowMax", ",", "1"}], "]"}], "]"}]}], "}"}], 
           ",", "\[IndentingNewLine]", 
           RowBox[{"PlotRange", "->", 
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"dataFFTMag", "[", 
                 RowBox[{"[", 
                  RowBox[{"freqSpanShowMin", ",", "1"}], "]"}], "]"}], ",", 
                RowBox[{"dataFFTMag", "[", 
                 RowBox[{"[", 
                  RowBox[{"freqSpanShowMax", ",", "1"}], "]"}], "]"}]}], 
               "}"}], ",", "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{"{", 
                RowBox[{"Full", ",", 
                 RowBox[{"Max", "[", 
                  RowBox[{"dataFFTMag", "[", 
                   RowBox[{"[", 
                    RowBox[{";;", ",", "2"}], "]"}], "]"}], "]"}]}], "}"}], 
               "*)"}], "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"Full", ",", "Full"}], "}"}]}], "\[IndentingNewLine]", 
             "}"}]}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
            "focus", " ", "plotting", " ", "around", " ", "important", " ", 
             "points"}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"PlotPoints", "->", 
            RowBox[{"{", 
             RowBox[{"2000", ",", 
              RowBox[{"{", 
               RowBox[{"f", "/.", 
                RowBox[{"fitRes", "[", "\"\<BestFitParameters\>\"", "]"}]}], 
               "}"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"PlotStyle", "->", 
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"Red", ",", 
                RowBox[{"Thickness", "[", "0.003", "]"}], ",", 
                RowBox[{"Opacity", "[", "0.88", "]"}]}], "}"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"Green", ",", 
                RowBox[{"Thickness", "[", "0.003", "]"}], ",", 
                RowBox[{"Opacity", "[", "0.88", "]"}]}], "}"}]}], 
             "\[IndentingNewLine]", "}"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"PlotLegends", "->", 
              RowBox[{"{", "\[IndentingNewLine]", 
               RowBox[{
               "\"\<Lorentzian NLSQ Fit\>\"", ",", "\[IndentingNewLine]", 
                "\"\<Initial Guess\>\""}], "\[IndentingNewLine]", "}"}]}], 
             ","}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"PerformanceGoal", "->", "\"\<Quality\>\""}]}], 
          "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"clean", " ", "up", " ", "after", " ", "ourselves"}], "*)"}],
         "\[IndentingNewLine]", 
        RowBox[{"Clear", "[", 
         RowBox[{
         "dataProcRes", ",", "fftStepSize", ",", "fitModel", ",", 
          "fitGuessModel"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"ClearInOut", "[", "]"}], ";", 
        RowBox[{"ClearSystemCache", "[", "]"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"return", " ", "results"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"Return", "[", "\[IndentingNewLine]", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"numerical", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"dataFFTMag", ",", "fitGuess", ",", "fitRes"}], "}"}], 
           ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", 
