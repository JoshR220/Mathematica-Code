ec87dd854fb1"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"first", " ", "test"}], " ", "-", " ", "naive"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"kkc", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"BernoulliDistribution", "[", "#", "]"}], "&"}], "/@", 
      "probSampledArr"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"th0", "=", 
      RowBox[{"RandomInteger", "/@", "kkc"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"th1", "=", 
      RowBox[{
       RowBox[{"Fourier", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"th0", "-", 
          RowBox[{"Mean", "[", "th0", "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"FourierParameters", "->", 
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"-", "1"}]}], "}"}]}]}], "\[IndentingNewLine]", "]"}], 
       "[", 
       RowBox[{"[", 
        RowBox[{";;", 
         RowBox[{"IntegerPart", "[", 
          FractionBox["numSamplePoints", "2."], "]"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"th2", "=", 
      SuperscriptBox[
       RowBox[{"Max", "[", 
        RowBox[{"Abs", "[", "th1", "]"}], "]"}], "2."]}]}], 
