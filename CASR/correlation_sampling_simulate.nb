  RowBox[{
   RowBox[{
    RowBox[{"fmax", "=", 
     RowBox[{"1.", "/", 
      RowBox[{"Mean", "[", 
       RowBox[{
        RowBox[{"timeSecSampleArr", "[", 
         RowBox[{"[", 
          RowBox[{"2", ";;"}], "]"}], "]"}], "-", 
        RowBox[{"timeSecSampleArr", "[", 
         RowBox[{"[", 
          RowBox[{"1", ";;", 
           RowBox[{"-", "2"}]}], "]"}], "]"}]}], "]"}]}]}], ";"}], 
   RowBox[{"(*", 
    RowBox[{
    "guess", " ", "fmax", " ", "by", " ", "averaged", " ", "sample", " ", 
     "period"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dataFFTFreqs", "=", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", 
