Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"calculate", " ", "x"}], "-", 
    RowBox[{"axis", " ", "for", " ", "FFT", " ", 
     RowBox[{"(", 
