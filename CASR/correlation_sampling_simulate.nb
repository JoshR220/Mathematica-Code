Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "do", " ", "fast", " ", "evaluation", " ", "of", " ", "a", " ", 
    "bernoulli", " ", "process", " ", "given", " ", "an", " ", "array", " ", 
    "of", " ", "probabilities"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"FastBernoulliRandom", "[", "probArr_", "]"}], ":=", 
