Cell[CellGroupData[{

Cell["Generalized Polar Modulation Blocks", "Chapter",
 CellChangeTimes->{{3.919649618733327*^9, 3.9196496227192783`*^9}, {
   3.9577481170618553`*^9, 3.957748120136897*^9}, 
   3.957751828235499*^9},ExpressionUUID->"6d1b7e28-123b-43db-b86e-\
f808b119ed12"],

Cell[TextData[{
 "For discrete polar modulation (i.e. discrete blocks with variable amplitude \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalOmega]", "n"], TraditionalForm]],ExpressionUUID->
  "48514b5e-da0b-4f65-a3d8-f875171d7b7a"],
 " and phase ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Phi]", "n"], TraditionalForm]],ExpressionUUID->
  "d8b619ef-daf7-4faa-a7ea-161db958504c"],
 "), the resultant displacement is given by\n\t",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "Total"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "edcdba68-0767-4cda-b5db-54ca3f46fbc9"],
 " = ",
 Cell[BoxData[
  RowBox[{
   UnderoverscriptBox["\[Sum]", 
    RowBox[{"n", "=", "1"}], "N"], 
   SubscriptBox["\[Alpha]", "n"]}]],ExpressionUUID->
  "eb4a532c-49fe-4a6d-bfcc-27118c69027a"],
 ", where\n\t",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "n"], TraditionalForm]],ExpressionUUID->
  "812da917-c095-4e63-b762-cfce0484c189"],
 " = \[Tau] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalOmega]", "n"], TraditionalForm]],ExpressionUUID->
  "3e9f4049-7e47-41d9-aaed-c44efc8d8794"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Sinc", "[", 
    FractionBox["\[Delta]\[Tau]", "2"], "]"}], TraditionalForm]],
  ExpressionUUID->"3aa7a6ba-8f41-4680-8d75-88777f1d68c9"],
 "  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"\[ImaginaryI]\[Delta]\[Tau]", "(", 
       RowBox[{"n", "-", 
        FractionBox["1", "2"]}], ")"}]}], " ", "+", 
     SubscriptBox["\[ImaginaryI]\[Phi]", "n"]}], "]"}], TraditionalForm]],
  ExpressionUUID->"9c93d777-7338-4585-a03a-5befee5262c7"],
 "\n\t\t\[RightArrow] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "n"], TraditionalForm]],ExpressionUUID->
  "451c5525-b40a-4fd1-8dfe-833a80564c78"],
 " = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "baf6ca9e-4055-4771-9c05-abfdd9c7c9ea"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Sinc", "[", 
    FractionBox["\[Delta]\[Tau]", "2"], "]"}], TraditionalForm]],
  ExpressionUUID->"a99f86a8-7c5e-418a-89e2-0a3984e5f70d"],
 "  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"\[ImaginaryI]\[Delta]\[Tau]", "(", 
       RowBox[{"n", "-", 
        FractionBox["1", "2"]}], ")"}]}], " ", "+", 
     SubscriptBox["\[ImaginaryI]\[Phi]", "n"]}], "]"}], TraditionalForm]],
  ExpressionUUID->"aeb7ee5c-3d66-4bcf-96cb-3d90063490df"],
 "\n\t\t(since displacement magnitude is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "0"], "=", 
    RowBox[{
     SubscriptBox["\[CapitalOmega]", "n"], "\[Tau]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0e48562f-cd78-4789-825c-5f160a320ce7"],
 ")"
}], "Text",
 CellChangeTimes->{{3.957749518251791*^9, 3.9577498148454027`*^9}, {
  3.9597100233050117`*^9, 3.959710024053852*^9}, {3.961116081679953*^9, 
  3.9611161360855093`*^9}, {3.961116177554038*^9, 
  3.961116247613645*^9}},ExpressionUUID->"22aa76b1-112a-4175-9a28-\
992db880885b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Create", " ", "an", " ", "expression", " ", "for", " ", "a", " ", 
     "displacement", " ", "as", " ", "a", " ", "function", " ", "of", " ", 
     "detuning", " ", 
     RowBox[{"(", "\[Delta]", ")"}], " ", "and", " ", "total", " ", "time", 
     " ", 
     RowBox[{
      RowBox[{"(", "T", ")"}], ".", "\[IndentingNewLine]", "The"}], " ", 
     "returned", " ", "expression", " ", "gives", " ", "only", " ", "the", 
     " ", "FINAL", " ", "displacement", " ", "at", " ", "the", " ", "end"}], 
    ",", " ", 
    RowBox[{"not", " ", "the", " ", "time", " ", 
     RowBox[{"evolution", ".", "\[IndentingNewLine]", "Assumes"}], " ", 
     "constituent", " ", "blocks", " ", "are", " ", "evenly", " ", 
     RowBox[{"spaced", "."}]}]}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Alpha]Block", "[", 
     RowBox[{"\[Delta]_", ",", "\[Alpha]Arr_List", ",", "\[Phi]Arr_List"}], 
     "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"T", ",", "t0"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"With", "[", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"predeclare", " ", "variables"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\[Tau]", "=", 
           FractionBox["T", 
            RowBox[{"Length", "[", "\[Alpha]Arr", "]"}]]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"expArr", "=", 
           RowBox[{"Exp", "[", 
            RowBox[{"\[ImaginaryI]", "*", 
             RowBox[{"(", 
              RowBox[{"\[Phi]Arr", "+", 
               RowBox[{
                FractionBox[
                 RowBox[{"\[Delta]", "*", "T"}], 
                 RowBox[{"Length", "[", "\[Alpha]Arr", "]"}]], "*", 
                RowBox[{"(", 
                 RowBox[{"Range", "[", 
                  RowBox[{"0.5", ",", 
                   RowBox[{
                    RowBox[{"Length", "[", "\[Alpha]Arr", "]"}], "-", 
                    "0.5"}]}], "]"}], ")"}]}]}], ")"}]}], "]"}]}]}], 
         "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"create", " ", "waveform", " ", "function"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Return", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Sinc", "[", 
            FractionBox[
             RowBox[{"\[Delta]", "*", "\[Tau]"}], "2"], "]"}], "*", 
           RowBox[{"(", 
            RowBox[{"\[Alpha]Arr", ".", "expArr"}], ")"}], "*", 
           RowBox[{"Exp", "[", 
            RowBox[{"\[ImaginaryI]", "*", "\[Delta]", "*", "t0"}], "]"}]}], 
          "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
       "]"}]}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.919648971633575*^9, 3.919649091051612*^9}, {
   3.919649231169485*^9, 3.9196492431237183`*^9}, {3.9577481496112127`*^9, 
