Cell[BoxData[
 RowBox[{"(*", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "use", " ", "vectorization", " ", "of", " ", "randominteger", " ", "by", 
     " ", "batching", " ", "calls"}], " ", "-", " ", 
    RowBox[{"kinda", " ", "like", " ", "compression"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Length", "[", "probSampledArr", "]"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"DeleteDuplicates", "[", "probSampledArr", "]"}], "//", 
     "Length"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"DeleteDuplicates", "[", 
      RowBox[{"Round", "[", 
       RowBox[{"probSampledArr", ",", "1.*^-5"}], "]"}], "]"}], "//", 
     "Length"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"kk0", "=", 
      RowBox[{"Round", "[", 
       RowBox[{"probSampledArr", ",", "1.*^-8"}], "]"}]}], ";"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"kk1", "=", 
      RowBox[{"DeleteDuplicates", "[", "kk0", "]"}]}], ";"}], 
    "\[IndentingNewLine]", 
    RowBox[{"kk2", "=", 
     RowBox[{"Tally", "[", "kk0", "]"}]}]}], ";"}], "*)"}]], "Input",
 CellChangeTimes->{{3.961819449969742*^9, 3.961819470765583*^9}, {
  3.961819519126257*^9, 3.961819523710353*^9}, {3.961820244115076*^9, 
