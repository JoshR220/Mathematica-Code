Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"RAP", " ", 
    RowBox[{"readout", ":", " ", 
     RowBox[{
     "convert", " ", "displacement", " ", "to", " ", "a", " ", "probability", 
      " ", 
      RowBox[{"(", 
       SubscriptBox["P", "Dark"], ")"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
  
  RowBox[{
   RowBox[{
    RowBox[{"ReadoutRAP", "[", 
     RowBox[{"\[Alpha]_", ",", 
      RowBox[{"n_", ":", "0"}]}], "]"}], ":=", 
    RowBox[{"1.", "-", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"-", 
        SuperscriptBox[
         RowBox[{"Abs", "[", "\[Alpha]", "]"}], "2."]}], "]"}], "*", 
      SuperscriptBox[
       RowBox[{"LaguerreL", "[", 
        RowBox[{"n", ",", 
         SuperscriptBox[
          RowBox[{"Abs", "[", "\[Alpha]", "]"}], "2."]}], "]"}], "2."]}]}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{{3.9611182698135242`*^9, 3.961118293312313*^9}, {
  3.961118532468828*^9, 3.9611186333776503`*^9}, {3.9611187562905684`*^9, 
  3.961118787079022*^9}, {3.961118926598031*^9, 3.961118931975327*^9}, {
  3.961121886733364*^9, 3.961121914714052*^9}},
 CellLabel->"In[87]:=",ExpressionUUID->"cd9cc8ee-c12c-4849-9ced-5ba2bc733dd1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "precompute", " ", "values", " ", "for", " ", "the", " ", "PSRSB", " ", 
    "special", " ", "function"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"nMax", "=", "20"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"PSRSBArr", "=", 
       RowBox[{
        RowBox[{
         FractionBox[
          RowBox[{
           RowBox[{"Cos", "[", 
            RowBox[{
             FractionBox["\[Pi]", "2."], "*", 
             RowBox[{"Sqrt", "[", "#", "]"}]}], "]"}], "*", 
           RowBox[{"Sin", "[", 
            RowBox[{
             FractionBox["\[Pi]", "2."], "*", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"#", "+", "1."}], "]"}]}], "]"}]}], 
          RowBox[{
           RowBox[{"#", "!"}], "*", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"#", "+", "1."}], "]"}]}]], "&"}], "/@", 
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", "nMax"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
     "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.961128949135602*^9, 3.96112904823987*^9}, 
   3.961129125979793*^9, {3.9611294261088953`*^9, 3.961129504901826*^9}},
 CellLabel->"In[88]:=",ExpressionUUID->"6e8f61be-aec8-4865-8738-bc06741dcba1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"PSRSB", " ", "special", " ", "function"}], " ", "-", " ", 
    RowBox[{
    "see", " ", "shaun", " ", "burd", " ", "thesis", " ", "pg", " ", "98"}]}],
    "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"PSRSBfunc", "[", "\[Alpha]_", "]"}], ":=", 
     RowBox[{"With", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Alpha]Arr", "=", 
         RowBox[{
          RowBox[{
           SuperscriptBox[
            RowBox[{"Abs", "[", 
             RowBox[{"\[Alpha]", "+", "1.*^-7"}], "]"}], 
            RowBox[{"2.", "*", "#"}]], "&"}], "/@", 
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", "nMax"}], "]"}]}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Return", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"-", 
            SuperscriptBox[
             RowBox[{"Abs", "[", "\[Alpha]", "]"}], "2."]}], "]"}], "*", 
          RowBox[{"(", 
           RowBox[{"\[Alpha]Arr", ".", "PSRSBArr"}], ")"}]}], 
         "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"PSRSBfunc", "[", "\[Alpha]_", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"-", "#"}], "]"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          SuperscriptBox["#", 
           RowBox[{"Range", "[", 
            RowBox[{"0", ",", "nMax"}], "]"}]], ")"}], ".", "PSRSBArr"}], 
        ")"}]}], "&"}], "[", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Abs", "[", "\[Alpha]", "]"}], "+", "1.*^-8"}], ")"}], "2."], 
     "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{
