Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"tmpFuncAvg", "[", "probArr_", "]"}], ":=", 
   RowBox[{"With", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{"yz0", "=", 
       RowBox[{"FastBernoulliRandom", "[", "probArr", "]"}]}], 
      "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "\[IndentingNewLine]", 
      SuperscriptBox[
       RowBox[{"Max", "[", 
        RowBox[{"Abs", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Fourier", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"yz0", "-", 
             RowBox[{"Mean", "[", "yz0", "]"}]}], ",", "\[IndentingNewLine]", 
            
            RowBox[{"FourierParameters", "->", 
             RowBox[{"{", 
              RowBox[{"1", ",", 
               RowBox[{"-", "1"}]}], "}"}]}]}], "\[IndentingNewLine]", "]"}], 
          "[", 
          RowBox[{"[", 
           RowBox[{";;", 
            RowBox[{"IntegerPart", "[", 
             FractionBox["numSamplePoints", "2."], "]"}]}], "]"}], "]"}], 
         "\[IndentingNewLine]", "]"}], "]"}], "2."], "\[IndentingNewLine]", 
      "]"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
