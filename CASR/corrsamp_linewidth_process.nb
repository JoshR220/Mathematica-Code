Cell["ADEV Linear Fitting", "Section",
 CellChangeTimes->{{3.962040415026677*^9, 
  3.962040419634898*^9}},ExpressionUUID->"423e4c88-91f4-43f5-bd5e-\
31762cf5dec7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"fit", " ", "function"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"FitPowerFunc", "[", "dataset_", "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
       "A", ",", "x", ",", "K", ",", "B", ",", "\[IndentingNewLine]", 
        "guessK", ",", "guessA", ",", "\[IndentingNewLine]", 
        RowBox[{"logData", "=", 
         RowBox[{"Log", "[", "dataset", "]"}]}]}], "\[IndentingNewLine]", 
       "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"guessK", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Mean", "[", 
           FractionBox[
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "2"}], "]"}], "]"}], 
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "1"}], "]"}], "]"}]], "]"}], "&"}], "[", 
         RowBox[{
          RowBox[{"logData", "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], "-", 
          RowBox[{"logData", "[", 
           RowBox[{"[", 
            RowBox[{";;", 
             RowBox[{"-", "2"}]}], "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"guessA", "=", 
        RowBox[{"Exp", "[", 
         RowBox[{"Mean", "[", 
          RowBox[{
           RowBox[{"logData", "[", 
            RowBox[{"[", 
             RowBox[{";;", ",", "2"}], "]"}], "]"}], "-", 
           RowBox[{"guessK", "*", 
            RowBox[{"logData", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "1"}], "]"}], "]"}]}]}], "]"}], "]"}]}], ";",
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "\[IndentingNewLine]", 
        RowBox[{"NonlinearModelFit", "[", 
         RowBox[{"dataset", ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"A", "*", 
            SuperscriptBox["x", "K"]}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"A", ",", "guessA"}], "}"}], ",", "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"K", ",", "guessK"}], "}"}]}], "}"}], ",", 
          "\[IndentingNewLine]", "x"}], "\[IndentingNewLine]", "]"}], 
        "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}]}],
    ";"}]}]], "Input",
 CellChangeTimes->{{3.9620372256760187`*^9, 3.9620373524171963`*^9}, {
   3.9620375728401203`*^9, 3.962037584962194*^9}, {3.962037713842207*^9, 
