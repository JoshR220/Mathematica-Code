Cell[CellGroupData[{

Cell["FFT Fit", "Section",
 CellChangeTimes->{{3.962040406883007*^9, 
  3.962040411100127*^9}},ExpressionUUID->"859d28fc-8645-4d03-bcfc-\
9c521483dc32"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"direct", " ", "process"}], " ", "&"}], " ", "fit", " ", "FFT"}],
    "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "FFTBlockFit", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"FFTBlockFit", "[", "data_", "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"helper", " ", "variables"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"numSamplePoints", "=", 
          RowBox[{"Length", "[", "data", "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"tmax", "=", 
          RowBox[{
           RowBox[{"data", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}], "-", 
           RowBox[{"data", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1"}], "]"}], "]"}]}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"fmax", "=", 
          RowBox[{"1.", "/", 
           RowBox[{"Mean", "[", 
            RowBox[{
             RowBox[{"data", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"2", ";;"}], ",", "1"}], "]"}], "]"}], "-", 
             RowBox[{"data", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"1", ";;", 
                 RowBox[{"-", "2"}]}], ",", "1"}], "]"}], "]"}]}], "]"}]}]}], 
         ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"fft", "-", "related"}], "*)"}], "\[IndentingNewLine]", 
         "dataFFTMag", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"lorentzian", " ", "fitting"}], "*)"}], 
         "\[IndentingNewLine]", "peakIndDJ", ",", "fitRes", ",", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", "tmptmp", "*)"}], "\[IndentingNewLine]", "peakIndDJ1", 
         ",", "peakIndDJ2"}], "\[IndentingNewLine]", "}"}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"do", " ", "FFT"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"dataFFTMag", "=", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"fft", " ", "freqs"}], " ", "-", " ", "x", "-", "axis"}],
             "*)"}], "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"0", ",", 
               FractionBox["fmax", "2."], ",", 
               FractionBox["fmax", 
                RowBox[{"numSamplePoints", "-", "1"}]]}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{";;", 
               RowBox[{"IntegerPart", "[", 
                FractionBox["numSamplePoints", "2."], "]"}]}], "]"}], "]"}], 
            ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"fft", " ", "values"}], " ", "-", " ", 
              RowBox[{"power", " ", 
               RowBox[{"(", 
                RowBox[{"i", ".", "e", ".", " ", 
                 SuperscriptBox["ampl", "2"]}], ")"}]}]}], "*)"}], 
            "\[IndentingNewLine]", 
            SuperscriptBox[
             RowBox[{"Abs", "[", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Fourier", "[", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{
                  RowBox[{"data", "[", 
                   RowBox[{"[", 
                    RowBox[{";;", ",", "2"}], "]"}], "]"}], "-", 
                  RowBox[{"Mean", "[", 
                   RowBox[{"data", "[", 
                    RowBox[{"[", 
                    RowBox[{";;", ",", "2"}], "]"}], "]"}], "]"}]}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{"FourierParameters", "->", 
                  RowBox[{"{", 
                   RowBox[{"1", ",", 
                    RowBox[{"-", "1"}]}], "}"}]}]}], "\[IndentingNewLine]", 
                "]"}], "[", 
               RowBox[{"[", 
                RowBox[{";;", 
                 RowBox[{"IntegerPart", "[", 
                  FractionBox["numSamplePoints", "2."], "]"}]}], "]"}], "]"}],
               "\[IndentingNewLine]", "]"}], "2."]}], "\[IndentingNewLine]", 
           "}"}], "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"prepare", " ", "fitting"}], ",", " ", 
          RowBox[{"then", " ", "do", " ", "fit"}]}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"peakIndDJ", "=", 
         RowBox[{"First", "@", 
          RowBox[{"Ordering", "[", 
           RowBox[{
            RowBox[{"dataFFTMag", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "2"}], "]"}], "]"}], ",", 
            RowBox[{"-", "1"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Print", "[", "peakIndDJ", "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"dataFFTMag", "[", 
            RowBox[{"[", "peakIndDJ", "]"}], "]"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"Dimensions", "[", "dataFFTMag", "]"}], "]"}], ";"}], 
         "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"do", " ", "fit"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"fitRes", "=", 
         RowBox[{"NonlinearModelFit", "[", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"raw", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"dataFFTMag", ",", 
           RowBox[{"(*", "full", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"dataFFTMag", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"2", ";;", 
                 RowBox[{"IntegerPart", "[", 
                  RowBox[{
                   RowBox[{"2", "*", "peakIndDJ"}], "-", "2"}], "]"}]}], ",", 
                ";;"}], "]"}], "]"}], ","}], 
            RowBox[{"(*", 
             RowBox[{"only", " ", "until", " ", "2", "nd", " ", "harmonic"}], 
             "*)"}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"dataFFTMag", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{
                 RowBox[{"peakIndDJ", "-", "2"}], ";;", 
                 RowBox[{"peakIndDJ", "+", "2"}]}], ",", ";;"}], "]"}], "]"}],
              ","}], 
            RowBox[{"(*", 
             RowBox[{"3", "-", 
              RowBox[{"ish", " ", "points", " ", "only"}]}], "*)"}], "*)"}], 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"fit", " ", "function"}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"{", 
            FractionBox["A", 
             RowBox[{
              SuperscriptBox["\[CapitalGamma]", "2."], "+", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"x", "-", "f"}], ")"}], "2."]}]], "}"}], ",", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"fit", " ", "guesses"}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"A", ",", 
               RowBox[{"1.", "*", 
                RowBox[{"Abs", "[", 
                 RowBox[{"Subtract", "@@", 
                  RowBox[{"MinMax", "[", 
                   RowBox[{"dataFFTMag", "[", 
                    RowBox[{"[", 
                    RowBox[{";;", ",", "2"}], "]"}], "]"}], "]"}]}], "]"}], 
                "*", 
                SuperscriptBox[
                 RowBox[{"(", 
                  FractionBox["0.25", "tmax"], ")"}], "2."]}]}], "}"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{"\[CapitalGamma]", ",", 
               FractionBox["0.25", "tmax"]}], "}"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{"f", ",", 
               RowBox[{"1.", "*", 
                RowBox[{"dataFFTMag", "[", 
                 RowBox[{"[", 
                  RowBox[{"peakIndDJ", ",", "1"}], "]"}], "]"}]}]}], "}"}]}], 
            "}"}], ",", "\[IndentingNewLine]", "x"}], "\[IndentingNewLine]", 
          "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"Return", "[", "fitRes", "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9619951541234264`*^9, 3.9619953864194293`*^9}, {
