Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"sinc", "-", 
    RowBox[{
    "squared", " ", "function", " ", "for", " ", "spetroscopy", " ", 
     "fitting"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SincModel", "[", 
     RowBox[{
     "\[Alpha]_", ",", "\[Beta]_", ",", "\[Delta]_", ",", "t_", ",", "x_"}], 
     "]"}], ":=", 
    RowBox[{
     RowBox[{"\[Alpha]", "*", 
      SuperscriptBox[
       RowBox[{"Sinc", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[Pi]", "*", "t"}], ")"}], "*", 
          RowBox[{"(", 
