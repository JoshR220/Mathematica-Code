Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "fit", " ", "sinc", " ", "and", " ", "return", " ", "params", " ", "with", 
    " ", "error", " ", "and", " ", "confidence", " ", "intervals"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"FitSinc", "[", 
     RowBox[{"dataset_List", ",", 
      RowBox[{"timeSinc", ":", 
       RowBox[{"(", 
        RowBox[{"_Integer", "|", "_Real"}], ")"}]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"guessMax", "=", 
         RowBox[{"dataset", "[", 
          RowBox[{"[", 
           RowBox[{"First", "@", 
            RowBox[{"Ordering", "[", 
             RowBox[{
              RowBox[{"dataset", "[", 
               RowBox[{"[", 
                RowBox[{";;", ",", "2"}], "]"}], "]"}], ",", 
              RowBox[{"-", "1"}]}], "]"}]}], "]"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"guessOffset", "=", 
         RowBox[{"Mean", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Median", "[", 
             RowBox[{"dataset", "[", 
              RowBox[{"[", 
