            RowBox[{"(", 
             RowBox[{"x", "-", "\[Beta]"}], ")"}], "*", "khz"}], ")"}]}], "+",
          "0.0000000001"}], "]"}], "2"]}], "+", "\[Delta]"}]}], 
   ";"}]}]], "Input",
