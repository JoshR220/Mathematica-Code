          RowBox[{"[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"1", ",", 
              RowBox[{"peakIndDJ", "-", "subRange"}]}], "]"}], ";;", 
            "\[IndentingNewLine]", 
            RowBox[{"Min", "[", 
             RowBox[{
