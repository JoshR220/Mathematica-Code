   RowBox[{
    RowBox[{"Clear", "[", "PrecisionFisherInfo", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"PrecisionFisherInfo", "[", 
      RowBox[{"\[Alpha]_", ",", "Tperiod_", ",", "Tfinal_", ",", 
       RowBox[{"fockN_", ":", "0"}]}], "]"}], ":=", 
     SuperscriptBox[
      RowBox[{"(", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"4.", "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2.", "*", "fockN"}], "+", "1."}], ")"}]}], ")"}], 
        "\[IndentingNewLine]", "*", 
        RowBox[{"(", 
         RowBox[{
          FractionBox["1.", "6."], "*", 
          SuperscriptBox["\[Alpha]", "2"], "*", 
          FractionBox[
           SuperscriptBox["Tfinal", "3"], "Tperiod"]}], ")"}]}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{"0.209", "*", 
            RowBox[{"Tperiod", "^", "3"}]}], ")"}]}], "\[IndentingNewLine]", 
