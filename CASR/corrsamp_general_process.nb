Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"FFTBlockFit", ":", " ", 
      RowBox[{"directly", " ", "process", " ", "data"}]}], " ", "&"}], " ", 
    "fit", " ", "FFT", " ", "with", " ", "lorentzian"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "FFTBlockFit", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "FFTBlockFit", "]"}], "=", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "method", " ", "to", " ", "use", " ", "for", " ", 
        "NonlinearModelFit"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\"\<FitMethod\>\"", "->", "\"\<ConjugateGradient\>\""}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "fudge", " ", "factors", " ", "for", " ", "initial", " ", "guesses", 
         " ", "for", " ", 
         RowBox[{"{", 
          RowBox[{"A", ",", "\[CapitalGamma]", ",", "f"}], "}"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<FitFudgeArray\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"1.", ",", "1.", ",", "0."}], "}"}]}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "number", " ", "of", " ", "points", " ", "about", " ", "peak", " ", 
         "to", " ", "use", " ", "for", " ", "fitting"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<PeakFitNumPoints\>\"", "->", 
        RowBox[{"-", "1"}]}]}], "\[IndentingNewLine]", "}"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.970265715688816*^9, 3.9702657510510883`*^9}},
