Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"tmp", " ", "batch", " ", "display", " ", "function"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "FFTBlockPlotNicer", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "FFTBlockPlotNicer", "]"}], "=", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "method", " ", "to", " ", "use", " ", "for", " ", 
        "NonlinearModelFit"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\"\<FitMethod\>\"", "->", "\"\<ConjugateGradient\>\""}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "fudge", " ", "factors", " ", "for", " ", "initial", " ", "guesses", 
         " ", "for", " ", 
         RowBox[{"{", 
          RowBox[{"A", ",", "\[CapitalGamma]", ",", "f"}], "}"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<FitFudgeArray\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"1.", ",", "1.", ",", "0."}], "}"}]}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "number", " ", "of", " ", "points", " ", "about", " ", "peak", " ", 
         "to", " ", "use", " ", "for", " ", "fitting"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<PeakFitNumPoints\>\"", "->", 
        RowBox[{"-", "1"}]}]}], "\[IndentingNewLine]", "}"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.968714139953466*^9, 3.968714142793961*^9}, {
  3.970268101246912*^9, 3.9702681021053057`*^9}, {3.9702708918183107`*^9, 
  3.970270902761182*^9}},
 CellLabel->
  "In[361]:=",ExpressionUUID->"9f3a640b-9a24-49a1-9494-f6f4fbcc2f98"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"tmp", " ", "batch", " ", "display", " ", "function"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"FFTBlockPlotNicer", "[", "\[IndentingNewLine]", 
    RowBox[{"datasetRaw_List", ",", "\[IndentingNewLine]", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "\[IndentingNewLine]", "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"localDataDJ", "=", 
        RowBox[{"FFTBlockPlot", "[", "\[IndentingNewLine]", 
         RowBox[{"datasetRaw", ",", "\[IndentingNewLine]", 
          RowBox[{"\"\<FitMethod\>\"", "->", 
           RowBox[{"OptionValue", "[", "\"\<FitMethod\>\"", "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<FitFudgeArray\>\"", "->", 
           RowBox[{"OptionValue", "[", "\"\<FitFudgeArray\>\"", "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<PeakFitNumPoints\>\"", "->", 
           RowBox[{"OptionValue", "[", "\"\<PeakFitNumPoints\>\"", "]"}]}]}], 
         "\[IndentingNewLine]", "]"}]}], ",", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", "dataFFTMagDJ", ",", "fitGuessDJ", ",", 
       "fitResDJ", ",", "\[IndentingNewLine]", "fitParamsDJ", ",", 
       "plotDataFFTMagDJ", ",", "plotFittedFFTMagDJ", ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "resString", ",", 
       "summaryPlot", ",", "\[IndentingNewLine]", "freqSpanShowMin", ",", 
       "freqSpanShowMax", ",", "peakIndDJ", ",", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"tmpPointsSpan", "=", "20"}]}], "\[IndentingNewLine]", "}"}], 
     ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"break", " ", "out", " ", "results"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"dataFFTMagDJ", ",", "fitGuessDJ", ",", "fitResDJ"}], "}"}], 
       "=", 
       RowBox[{"localDataDJ", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "fitParamsDJ", ",", "plotDataFFTMagDJ", ",", "plotFittedFFTMagDJ"}], 
        "}"}], "=", 
       RowBox[{"localDataDJ", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"points", " ", "around", " ", "peak", " ", "to", " ", 
        RowBox[{"show", ":", " ", 
         RowBox[{"about", " ", "100"}]}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"peakIndDJ", "=", 
       RowBox[{"First", "@", 
        RowBox[{"Ordering", "[", 
         RowBox[{
          RowBox[{"dataFFTMagDJ", "[", 
           RowBox[{"[", 
            RowBox[{";;", ",", "2"}], "]"}], "]"}], ",", 
          RowBox[{"-", "1"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"freqSpanShowMin", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"1", ",", 
         RowBox[{"peakIndDJ", "-", "tmpPointsSpan"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"freqSpanShowMax", "=", 
       RowBox[{"Min", "[", 
        RowBox[{
         RowBox[{"peakIndDJ", "+", "tmpPointsSpan"}], ",", 
         RowBox[{"Length", "[", "dataFFTMagDJ", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"print", " ", "freq", " ", "precision"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"resString", "=", 
       RowBox[{"StringForm", "[", 
        RowBox[{"\"\<Linecenter Precision: `` \[Mu]Hz\>\"", ",", 
         RowBox[{"NumberForm", "[", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"1.*^6", "*", 
             RowBox[{"Subtract", "@@", 
              RowBox[{
               RowBox[{
               "fitResDJ", "[", "\"\<ParameterConfidenceIntervals\>\"", "]"}],
                "[", 
               RowBox[{"[", "3", "]"}], "]"}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Infinity]", ",", "3"}], "}"}]}], "]"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"create", " ", "summary", " ", "plot"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"summaryPlot", "=", 
       RowBox[{"Show", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
          "plotDataFFTMagDJ", ",", "\[IndentingNewLine]", 
           "plotFittedFFTMagDJ"}], "\[IndentingNewLine]", "}"}], ",", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"20.20", ",", "20.26"}], "}"}], ","}], "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"dataFFTMagDJ", "[", 
               RowBox[{"[", 
                RowBox[{"freqSpanShowMin", ",", "1"}], "]"}], "]"}], ",", 
              RowBox[{"dataFFTMagDJ", "[", 
               RowBox[{"[", 
                RowBox[{"freqSpanShowMax", ",", "1"}], "]"}], "]"}]}], "}"}], 
            ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"Full", ",", 
              RowBox[{
               RowBox[{"Max", "[", 
                RowBox[{"dataFFTMagDJ", "[", 
                 RowBox[{"[", 
                  RowBox[{";;", ",", "2"}], "]"}], "]"}], "]"}], "*", 
               "3."}]}], "}"}]}], "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"{", 
             RowBox[{"Full", ",", "Full"}], "}"}], "*)"}], 
           "\[IndentingNewLine]", "}"}]}]}], "\[IndentingNewLine]", "]"}]}], 
      ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"Return", "[", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"resString", ",", "fitParamsDJ", ",", "summaryPlot"}], "}"}], 
       "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
    "]"}]}]}]], "Input",
