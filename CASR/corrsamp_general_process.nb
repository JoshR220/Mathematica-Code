Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"process", " ", "statistics", " ", "on", " ", "FFT"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "FFTStatsProcess", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"FFTStatsProcess", "[", "dataFFT_List", "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"bgrPoints", "=", 
          RowBox[{"dataFFT", "[", 
           RowBox[{"[", 
            RowBox[{";;", ",", "2"}], "]"}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"bgrThreshold", "=", 
          RowBox[{
           RowBox[{"Mean", "[", 
            RowBox[{"dataFFT", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "2"}], "]"}], "]"}], "]"}], "+", 
           RowBox[{
            RowBox[{"StandardDeviation", "[", 
             RowBox[{"dataFFT", "[", 
              RowBox[{"[", 
               RowBox[{";;", ",", "2"}], "]"}], "]"}], "]"}], "*", "5."}]}]}],
          ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         "bgrPointsReduced", ",", "bgrDistFit", ",", "\[IndentingNewLine]", 
         "bgrHistBinSize", ",", "bgrHistPlot", ",", "bgrDistFitPlot"}], 
        "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "remove", " ", "peak", " ", "points", " ", "to", " ", "make", " ", 
         "hist", " ", "happier"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"note", ":", " ", 
         RowBox[{"exclude", " ", "0", " ", "points", " ", 
          RowBox[{"b", "/", "c"}], " ", "it", " ", "makes", " ", 
          "EstimatedDistribution", " ", "unhappy"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"bgrPointsReduced", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"bgrPoints", ",", 
           RowBox[{
            RowBox[{"1.*^-9", "<", "#", "<", "bgrThreshold"}], "&"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "fit", " ", "FFT", " ", "background", " ", "to", " ", "a", " ", 
          "Gamma", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"i", ".", "e", ".", " ", "\[CapitalGamma]"}], 
            RowBox[{"(", 
             RowBox[{"\[Alpha]", ",", " ", "\[Lambda]"}], ")"}]}], ")"}], " ",
           "distribution"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"bgrDistFit", "=", 
         RowBox[{"EstimatedDistribution", "[", 
          RowBox[{"bgrPointsReduced", ",", 
           RowBox[{"GammaDistribution", "[", 
            RowBox[{"\[Alpha]", ",", "\[Lambda]"}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "get", " ", "histogram", " ", "bin", " ", "size", " ", "from", " ", 
          "HistogramList", " ", "lol"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"bgrHistBinSize", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Mean", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{"2", ";;", 
                RowBox[{"-", "1"}]}], "]"}], "]"}], "-", 
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{"1", ";;", 
                RowBox[{"-", "2"}]}], "]"}], "]"}]}], "]"}], "&"}], "[", 
          RowBox[{
           RowBox[{"HistogramList", "[", 
            RowBox[{
            "bgrPointsReduced", ",", "\"\<Scott\>\"", ",", 
             "\"\<Probability\>\""}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"plot", " ", "data", " ", "histogram"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"bgrHistPlot", "=", 
         RowBox[{"Histogram", "[", "\[IndentingNewLine]", 
          RowBox[{
          "bgrPointsReduced", ",", "\[IndentingNewLine]", "\"\<Scott\>\"", 
           ",", "\[IndentingNewLine]", "\"\<Probability\>\"", ",", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"FrameLabel", "\[Rule]", 
            RowBox[{"{", "\[IndentingNewLine]", " ", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{"\"\<Probability\>\"", ",", 
                  RowBox[{"{", 
                   RowBox[{"Black", ",", 
                    RowBox[{"Directive", "[", "15", "]"}]}], "}"}]}], "]"}], 
                ",", "None"}], "}"}], ",", "\[IndentingNewLine]", 
              RowBox[{"{", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{
                 "\"\<Power (\!\(\*SuperscriptBox[\(Ampl\), \(2\)]\))\>\"", 
                  ",", 
                  RowBox[{"{", 
                   RowBox[{"Black", ",", 
                    RowBox[{"Directive", "[", "15", "]"}]}], "}"}]}], "]"}], 
                ",", "\[IndentingNewLine]", 
                RowBox[{"Style", "[", 
                 RowBox[{
                  RowBox[{"StringForm", "[", 
                   RowBox[{
                   "\"\<FFT Background Statistics: N = ``\\nRID: ``\>\"", ",",
                     "numSamplePoints", ",", "rid"}], "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"Black", ",", 
                    RowBox[{"Directive", "[", "15", "]"}]}], "}"}]}], "]"}]}],
                "\[IndentingNewLine]", "}"}]}], "\[IndentingNewLine]", 
             "}"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"ImageSize", "->", 
            RowBox[{"Scaled", "[", "0.4", "]"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"PerformanceGoal", "->", "\"\<Speed\>\""}]}], 
          "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"plot", " ", "fitted", " ", "distribution"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"bgrDistFitPlot", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Plot", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"bgrHistBinSize", "*", 
              RowBox[{"PDF", "[", 
               RowBox[{"bgrDistFit", ",", "x"}], "]"}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{"x", ",", "#1", ",", "#2"}], "}"}], ",", 
             "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"ImageSize", "->", 
              RowBox[{"Scaled", "[", "0.4", "]"}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"PerformanceGoal", "->", "\"\<Speed\>\""}]}], 
            "\[IndentingNewLine]", "]"}], "&"}], "[", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "x_min", " ", "for", " ", "plotting", " ", "distribution"}], 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"0.", ",", 
             RowBox[{
              RowBox[{"Mean", "[", "bgrDistFit", "]"}], "-", 
              RowBox[{"4.", "*", 
               RowBox[{"StandardDeviation", "[", "bgrDistFit", "]"}]}]}]}], 
            "]"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
            "x_max", " ", "for", " ", "plotting", " ", "distribution"}], 
            "*)"}], "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Mean", "[", "bgrDistFit", "]"}], "+", 
            RowBox[{"4.", "*", 
             RowBox[{"StandardDeviation", "[", "bgrDistFit", "]"}]}]}]}], 
          "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"Return", "[", "\[IndentingNewLine]", 
         RowBox[{"<|", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"\"\<Max\>\"", "->", 
