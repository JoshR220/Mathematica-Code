Cell[CellGroupData[{

Cell["Fitting w/ Around[]", "Subsection",
 CellChangeTimes->{{3.96898079945059*^9, 
  3.9689808084540915`*^9}},ExpressionUUID->"f1031fcd-8bf1-4d86-ab03-\
2b43e21b6651"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"fit", " ", "Around", " ", "data", " ", "for", " ", "log"}], "-", 
    RowBox[{
     RowBox[{"log", "'"}], "d", " ", "linear", " ", "model"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "FitLinearFuncLog", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"FitLinearFuncLog", "[", "dataset_List", "]"}], ":=", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", "x", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Module", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"dataRaw", "=", 
             RowBox[{"Log", "[", "dataset", "]"}]}], ",", 
            "\[IndentingNewLine]", "dataValues", ",", "dataWeights"}], 
           "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "separate", " ", "data", " ", "values", " ", "from", " ", 
            "uncertainties"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"dataValues", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "[", "\"\<Value\>\"", 
                 "]"}]}], "}"}], "&"}], "/@", "dataRaw"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"dataWeights", "=", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "[", 
                   "\"\<Uncertainty\>\"", "]"}], "&"}], "/@", "dataRaw"}], 
                ")"}], "^", 
               RowBox[{"-", "2."}]}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"scale", " ", "weights", " ", "for", " ", "log"}], "-", 
             RowBox[{"log", " ", "fit"}]}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"dataWeights", "=", 
            SuperscriptBox[
             RowBox[{"(", "\[IndentingNewLine]", 
              RowBox[{"1.", "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "[", 
                    "\"\<Uncertainty\>\"", "]"}], "&"}], "/@", "dataRaw"}], 
                 ")"}], "/", 
                RowBox[{"dataValues", "[", 
                 RowBox[{"[", 
                  RowBox[{";;", ",", "2"}], "]"}], "]"}]}]}], 
              "\[IndentingNewLine]", ")"}], 
             RowBox[{"-", "2."}]]}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"Return", "[", "\[IndentingNewLine]", 
            RowBox[{"LinearModelFit", "[", "\[IndentingNewLine]", 
             RowBox[{"dataValues", ",", "\[IndentingNewLine]", 
              RowBox[{"{", "x", "}"}], ",", "\[IndentingNewLine]", "x", ",", 
              "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"Weights", "->", "dataWeights"}]}], 
             "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", "]"}], 
           ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.968979853697692*^9, 3.968979862275057*^9}, 
   3.968979949899233*^9, {3.9689800531880274`*^9, 3.9689801503622265`*^9}, {
   3.9689803383980937`*^9, 3.9689803395354443`*^9}, {3.968980659379644*^9, 
