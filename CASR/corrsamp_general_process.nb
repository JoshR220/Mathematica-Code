              "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"DefaultPlotColors", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", "Dashed", ",", 
                RowBox[{"Thickness", "[", "0.004", "]"}]}], "}"}]}], 
             "\[IndentingNewLine]", "}"}]}], ",", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"PlotLegends", "->", 
            RowBox[{
            "{", "\[IndentingNewLine]", 
             "\"\<FFT Data - \!\(\*SuperscriptBox[\(Ampl\), \(2\)]\)\>\"", 
             "\[IndentingNewLine]", "}"}]}], ",", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"ImageSize", "->", 
            RowBox[{"Scaled", "[", "0.45", "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"PerformanceGoal", "->", "\"\<Speed\>\""}]}], 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"MaxPlotPoints", "->", 
            RowBox[{"IntegerPart", "[", "1.*^4", "]"}]}], "*)"}], 
          "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "create", " ", "function", " ", "to", " ", "plot", " ", "initial", 
          " ", "guess"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"fitGuessModel", "=", 
         RowBox[{"fitModel", "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"A", "->", 
             RowBox[{"fitGuess", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", 
            RowBox[{"\[CapitalGamma]", "->", 
             RowBox[{"fitGuess", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ",", 
            RowBox[{"f", "->", 
             RowBox[{"fitGuess", "[", 
              RowBox[{"[", 
               RowBox[{"3", ",", "2"}], "]"}], "]"}]}]}], "}"}]}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "adjust", " ", "plot", " ", "range", " ", "to", " ", "capture", " ", 
          "only", " ", "important", " ", "parts", " ", "of", " ", "the", " ", 
          "lorentzian"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"fitPlotMinF", "=", 
