Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "add", " ", "plot", " ", "points", " ", "to", " ", "ensure", " ", "we", 
    " ", "plot", " ", "important", " ", "parts", " ", "of", " ", 
    "lorentzian"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"lorentzianExtraPlotPoints", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Range", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"f", "/.", 
              RowBox[{"fitRes", "[", "\"\<BestFitParameters\>\"", "]"}]}], 
             ")"}], "-", "#"}], ",", "\[IndentingNewLine]", 
           FractionBox["fmax", 
            RowBox[{"numSamplePoints", "-", "1"}]]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Min", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"f", "/.", 
              RowBox[{"fitRes", "[", "\"\<BestFitParameters\>\"", "]"}]}], 
             ")"}], "+", "#"}], ",", "\[IndentingNewLine]", 
           FractionBox["fmax", "2."]}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          FractionBox["fmax", 
           RowBox[{"numSamplePoints", "-", "1"}]], "*", "5"}]}], 
        "\[IndentingNewLine]", "]"}], "&"}], "[", 
      RowBox[{
       FractionBox["fmax", 
        RowBox[{"numSamplePoints", "-", "1"}]], "*", "10"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"%", "//", "Length"}]}]}]], "Input",
