Cell[CellGroupData[{

Cell["Axial COM Mode Shift", "Subsection",
 CellChangeTimes->{{3.9949829915724163`*^9, 
  3.994982998739913*^9}},ExpressionUUID->"345ccf1a-3443-4627-a9d6-\
3c91ea7f938e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"simVoltageList", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{"Voltage", ",", "  ", 
     RowBox[{"{", 
      RowBox[{"Voltage", ",", " ", 
       RowBox[{
        FractionBox[
         RowBox[{"-", "voltRange"}], "2"], "+", "voltMidPoint"}], ",", " ", 
       RowBox[{
        FractionBox["voltRange", "2"], "+", "voltMidPoint"}], ",", "0.1"}], 
      "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"secFreqs", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"getSecFreqs", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           FractionBox[
            RowBox[{"\[Kappa]", "*", 
             RowBox[{"(", 
              RowBox[{"Volt", "-", "voltMidPoint"}], ")"}]}], 
            RowBox[{"Sqrt", "[", "2", "]"}]], ",", 
           FractionBox[
            RowBox[{"\[Kappa]", "*", 
             RowBox[{"(", 
              RowBox[{"Volt", "-", "voltMidPoint"}], ")"}]}], 
            RowBox[{"Sqrt", "[", "2", "]"}]], ",", "0"}], "}"}], ",", " ", 
         "massArr", ",", " ", "knownSecFreqs", ",", " ", "knownMass", ",", 
         " ", "numIons", ",", " ", "ionPositions"}], "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"Volt", ",", " ", "simVoltageList"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"maxSecFreq", " ", "=", " ", 
    RowBox[{"Max", "[", "secFreqs", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"getSecFreqs", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               FractionBox[
                RowBox[{"\[Kappa]", "*", 
                 RowBox[{"(", 
                  RowBox[{"Voltage", "-", "voltMidPoint"}], ")"}]}], 
                RowBox[{"Sqrt", "[", "2", "]"}]], ",", 
               FractionBox[
                RowBox[{"\[Kappa]", "*", 
                 RowBox[{"(", 
                  RowBox[{"Voltage", "-", "voltMidPoint"}], ")"}]}], 
                RowBox[{"Sqrt", "[", "2", "]"}]], ",", "0"}], "}"}], ",", " ",
              "massArr", ",", " ", "knownSecFreqs", ",", " ", "knownMass", ",",
              " ", "numIons", ",", " ", "ionPositions"}], "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], "-", " ", "maxSecFreq"}], ")"}], "*",
        "MHz"}], ",", "\n", 
      RowBox[{"{", 
       RowBox[{"Voltage", ",", " ", 
        RowBox[{
         FractionBox[
          RowBox[{"-", "voltRange"}], "2"], "+", "voltMidPoint"}], ",", 
        RowBox[{
         FractionBox["voltRange", "2"], "+", "voltMidPoint"}]}], "}"}], ",", 
