Cell["Initialization Code", "Subsection",
 CellChangeTimes->{{3.998148927179323*^9, 
  3.9981489343105583`*^9}},ExpressionUUID->"5c6ac33c-43b6-674b-b7f7-\
506466757975"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ll", "[", 
    RowBox[{"q_", ",", " ", "secFreqsMHz_"}], "]"}], ":=", " ", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"\[HBar]", "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", "2", "*", "\[Pi]", "*", 
       RowBox[{"secFreqsMHz", "[", 
        RowBox[{"[", "q", "]"}], "]"}], "*", "MHz"}], ")"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"quarticDiagonalTerms", "[", 
   RowBox[{
