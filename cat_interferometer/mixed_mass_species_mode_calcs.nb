Cell[BoxData[{
 RowBox[{
  RowBox[{"eggFreqSpan", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{"eggsFreq", ",", " ", 
     RowBox[{"{", 
      RowBox[{"eggsFreq", ",", " ", "1.775", ",", " ", "1.825", ",", ".002"}],
       "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"freqShift", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"SimDiffSecFreqs", "[", 
      RowBox[{".710", ",", 
       RowBox[{"eggsFreq", "-", ".3"}], ",", "eggsFreq"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"eggsFreq", ",", " ", "eggFreqSpan"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"shiftData", " ", "=", " ", 
   RowBox[{"Transpose", "@", 
    RowBox[{"{", 
     RowBox[{"eggFreqSpan", ",", " ", "freqShift"}], "}"}]}]}], ";"}], "\n", 
