Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"acutal", " ", "data"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"knownMass", " ", "=", " ", "39.962590863"}], ";"}], " ", "\n", 
   RowBox[{
    RowBox[{"mUnknown", " ", "=", " ", "36"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"knownSecFreqs", " ", "=", " ", 
     RowBox[{"2", "*", "\[Pi]", "*", "MHz", "*", 
      RowBox[{"{", 
       RowBox[{".71", ",", " ", "1.3242", ",", " ", "1.6096"}], "}"}]}]}], 
    ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Frequencies", " ", "from", " ", 
      RowBox[{"Hao", "'"}], "s", " ", "Calibration", " ", "on", " ", "06"}], "-",
      "04", " ", "-", " ", 
     RowBox[{
     "keep", " ", "these", " ", "and", " ", "if", " ", "need", " ", "to", " ",
       "change", " ", "override", " ", "later"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"massArr", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"knownMass", ",", " ", "mUnknown", ",", " ", "knownMass"}], 
      "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"actualVoltageList", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
      "42.79", ",", " ", "62.79", ",", " ", "52.79", ",", " ", "44.79", ",", 
       " ", "60.79", ",", " ", "47.8", ",", " ", "52.79", ",", " ", "57.8", ",",
        "55.79", ",", "52.79", ",", " ", "58.8", ",", " ", "56.8"}], "}"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"offsetSecFreqHz", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "485"}], ",", " ", 
       RowBox[{"-", "635"}], ",", " ", "18", ",", " ", 
       RowBox[{"-", "530"}], ",", " ", 
       RowBox[{"-", "356"}], ",", " ", 
       RowBox[{"-", "181"}], ",", " ", "72", ",", " ", "31", ",", " ", "82", ",",
        " ", "28", ",", " ", 
       RowBox[{"-", "179"}], ",", " ", "20"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"actualData", " ", "=", " ", 
     RowBox[{"Transpose", "@", 
      RowBox[{"{", 
       RowBox[{"actualVoltageList", ",", " ", "offsetSecFreqHz"}], "}"}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"voltRange", " ", "=", " ", 
     RowBox[{
      RowBox[{"Max", "[", "actualVoltageList", "]"}], "-", 
      RowBox[{"Min", "[", "actualVoltageList", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"voltMidPoint", " ", "=", " ", 
     RowBox[{"Mean", "[", "actualVoltageList", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nlm", " ", "=", " ", 
     RowBox[{"NonlinearModelFit", "[", 
      RowBox[{"actualData", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "a"}], "*", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"x", "-", "b"}], ")"}], "2"]}], "+", "c"}], ",", 
       RowBox[{"{", 
        RowBox[{"a", ",", "b", ",", "c"}], "}"}], ",", " ", "x", ",", " ", 
       RowBox[{"MaxIterations", "->", "1000"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"voltMidPoint", " ", "=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", ",", "b", ",", "c"}], "}"}], "/.", " ", 
        RowBox[{"nlm", "[", "\"\<BestFitParameters\>\"", "]"}]}], ")"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"\[Kappa]", " ", "=", " ", "1.8"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"simVoltageList", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{"Voltage", ",", "  ", 
       RowBox[{"{", 
        RowBox[{"Voltage", ",", " ", 
         RowBox[{
          FractionBox[
           RowBox[{"-", "voltRange"}], "2"], "+", "voltMidPoint"}], ",", " ", 
         RowBox[{
          FractionBox["voltRange", "2"], "+", "voltMidPoint"}], ",", "0.1"}], 
        "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"secFreqs", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"getAxialRock", "[", 
        RowBox[{"getSecFreqs", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            FractionBox[
             RowBox[{"\[Kappa]", "*", 
              RowBox[{"(", 
               RowBox[{"Volt", "-", "voltMidPoint"}], ")"}]}], 
             RowBox[{"Sqrt", "[", "2", "]"}]], ",", 
            FractionBox[
             RowBox[{"\[Kappa]", "*", 
              RowBox[{"(", 
               RowBox[{"Volt", "-", "voltMidPoint"}], ")"}]}], 
             RowBox[{"Sqrt", "[", "2", "]"}]], ",", "0"}], "}"}], ",", " ", 
          "massArr", ",", " ", "knownSecFreqs", ",", " ", "knownMass", ",", 
          " ", "numIons", ",", " ", "ionPositions"}], "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"Volt", ",", " ", "simVoltageList"}], "}"}]}], "]"}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"maxSecFreq", " ", "=", " ", 
     RowBox[{"Max", "[", "secFreqs", "]"}]}], ";"}], "\n", "\n", "\n", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"getAxialRock", "[", 
             RowBox[{"getSecFreqs", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 FractionBox[
                  RowBox[{"\[Kappa]", "*", 
                   RowBox[{"(", 
                    RowBox[{"Voltage", "-", "voltMidPoint"}], ")"}]}], 
                  RowBox[{"Sqrt", "[", "2", "]"}]], ",", 
                 FractionBox[
                  RowBox[{"\[Kappa]", "*", 
                   RowBox[{"(", 
                    RowBox[{"Voltage", "-", "voltMidPoint"}], ")"}]}], 
                  RowBox[{"Sqrt", "[", "2", "]"}]], ",", "0"}], "}"}], ",", 
               " ", "massArr", ",", " ", "knownSecFreqs", ",", " ", 
               "knownMass", ",", " ", "numIons", ",", " ", "ionPositions"}], 
              "]"}], "]"}], "-", "maxSecFreq"}], ")"}], "*", "MHz"}], ",", 
         "\n", 
         RowBox[{"{", 
          RowBox[{"Voltage", ",", " ", 
           RowBox[{
            FractionBox[
             RowBox[{"-", "voltRange"}], "2"], "+", "voltMidPoint"}], ",", 
           RowBox[{
            FractionBox["voltRange", "2"], "+", "voltMidPoint"}]}], "}"}], ",",
          " ", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"{", 
           RowBox[{"Black", ",", " ", 
            RowBox[{"Thickness", "->", "0.01"}]}], "}"}]}]}], "]"}], ",", 
       "\n", 
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{"Transpose", "@", 
          RowBox[{"{", 
           RowBox[{"actualVoltageList", ",", " ", "offsetSecFreqHz"}], 
           "}"}]}], ",", " ", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"{", 
           RowBox[{"Red", ",", " ", 
            RowBox[{"PointSize", "[", "0.02", "]"}]}], "}"}]}]}], "]"}]}], 
      "}"}], ",", "\n", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"\"\<Horizontal Shim Voltages\>\"", ",", " ", "16"}], "]"}], 
        ",", " ", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<Secular Freq Shift (Hz)\>\"", ",", " ", "16"}], "]"}]}],
        "}"}]}], ",", " ", 
     RowBox[{"ImageSize", "->", "Large"}], ",", " ", 
     RowBox[{"Frame", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"True", ",", " ", "False"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"True", ",", " ", "False"}], "}"}]}], "}"}]}], ",", "\n", 
     RowBox[{"GridLines", "->", "Automatic"}]}], "\n", "]"}]}]}]], "Code",
