Cell[BoxData[{
 RowBox[{
  RowBox[{"simVoltageList", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{"Voltage", ",", "  ", 
     RowBox[{"{", 
      RowBox[{"Voltage", ",", " ", 
       RowBox[{
        FractionBox[
         RowBox[{"-", "voltRange"}], "2"], "+", "voltMidPoint"}], ",", " ", 
       RowBox[{
        FractionBox["voltRange", "2"], "+", "voltMidPoint"}], ",", "0.1"}], 
      "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"secFreqs", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"getSecFreqs", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           FractionBox[
            RowBox[{"\[Kappa]", "*", 
             RowBox[{"(", 
              RowBox[{"Volt", "-", "voltMidPoint"}], ")"}]}], 
            RowBox[{"Sqrt", "[", "2", "]"}]], ",", 
           FractionBox[
            RowBox[{"\[Kappa]", "*", 
             RowBox[{"(", 
              RowBox[{"Volt", "-", "voltMidPoint"}], ")"}]}], 
            RowBox[{"Sqrt", "[", "2", "]"}]], ",", "0"}], "}"}], ",", " ", 
         "massArr", ",", " ", "knownSecFreqs", ",", " ", "knownMass", ",", 
         " ", "numIons", ",", " ", "ionPositions"}], "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"Volt", ",", " ", "simVoltageList"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"maxSecFreq", " ", "=", " ", 
    RowBox[{"Max", "[", "secFreqs", "]"}]}], ";"}], "\n"}], "\n", 
