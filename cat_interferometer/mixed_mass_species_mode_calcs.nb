Cell[BoxData[{
 RowBox[{
  RowBox[{"testSecFreqs", " ", "=", " ", 
   RowBox[{"2", "*", "\[Pi]", "*", 
    RowBox[{"{", 
     RowBox[{".71", ",", " ", "1.8", ",", " ", "2.1"}], "}"}], "*", "MHz"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"secFreqs", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"getAxialRock", "[", 
      RowBox[{"getSecFreqs", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          FractionBox[
           RowBox[{"\[Kappa]", "*", 
            RowBox[{"(", 
             RowBox[{"Volt", "-", "voltMidPoint"}], ")"}]}], 
           RowBox[{"Sqrt", "[", "2", "]"}]], ",", 
          FractionBox[
           RowBox[{"\[Kappa]", "*", 
            RowBox[{"(", 
             RowBox[{"Volt", "-", "voltMidPoint"}], ")"}]}], 
           RowBox[{"Sqrt", "[", "2", "]"}]], ",", "0"}], "}"}], ",", " ", 
