Cell[CellGroupData[{

Cell["Anharmonic Calculations", "Section",
 CellChangeTimes->{{3.9977993029542255`*^9, 
  3.9977993075444183`*^9}},ExpressionUUID->"616f7046-89fc-5f42-a365-\
53d0fa8fd84a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ll", "[", 
    RowBox[{"q_", ",", " ", "secFreqsMHz_"}], "]"}], ":=", " ", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"\[HBar]", "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", "2", "*", "\[Pi]", "*", 
       RowBox[{"secFreqsMHz", "[", 
        RowBox[{"[", "q", "]"}], "]"}], "*", "MHz"}], ")"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"quarticDiagonalTerms", "[", 
   RowBox[{
   "nList_", ",", " ", "G4_", ",", "  ", "secFreqsMHz_", ",", " ", 
    "numModes_"}], "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"ll", "[", 
       RowBox[{"i", ",", "secFreqsMHz"}], "]"}], "4"], "*", 
     RowBox[{"G4", "[", 
      RowBox[{"[", 
       RowBox[{"i", ",", "i", ",", "i", ",", "i"}], "]"}], "]"}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"6", "*", 
        SuperscriptBox[
         RowBox[{"nList", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "2"]}], "+", 
       RowBox[{"6", "*", 
        RowBox[{"nList", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], "+", "3"}], ")"}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "numModes"}], "}"}]}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"quarticOffDiagonalTerms", "[", 
   RowBox[{
   "nList_", ",", " ", "G4_", ",", "  ", "secFreqsMHz_", ",", " ", 
    "numModes_"}], "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{"6", "*", 
     SuperscriptBox[
      RowBox[{"ll", "[", 
       RowBox[{"i", ",", " ", "secFreqsMHz"}], "]"}], "2"], "*", 
     SuperscriptBox[
      RowBox[{"ll", "[", 
       RowBox[{"j", ",", " ", "secFreqsMHz"}], "]"}], "2"], "*", 
     RowBox[{"G4", "[", 
      RowBox[{"[", 
       RowBox[{"i", ",", "i", ",", "j", ",", "j"}], "]"}], "]"}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", "*", 
        RowBox[{"nList", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], "+", "1"}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", "*", 
        RowBox[{"nList", "[", 
         RowBox[{"[", "j", "]"}], "]"}]}], "+", "1"}], ")"}]}], ",", " ", 
    "\n", "\t\t\t\t\t\t\t\t\t\t\t\t\t", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", 
      RowBox[{"numModes", "-", "1"}]}], "}"}], ",", "\n", 
    "\t\t\t\t\t\t\t\t\t\t\t\t\t", 
    RowBox[{"{", 
     RowBox[{"j", ",", 
      RowBox[{"i", "+", "1"}], ",", "numModes"}], "}"}]}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"firstOrderPert", "[", 
    RowBox[{
    "nList_", ",", " ", "G4_", ",", " ", "secFreqsMHz_", ",", " ", 
     "numModes_"}], "]"}], ":=", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"quarticDiagonalTerms", "[", 
      RowBox[{
      "nList", ",", " ", "G4", ",", "  ", "secFreqsMHz", ",", " ", 
       "numModes"}], "]"}], " ", "\n", "\t\t\t\t\t\t\t\t\t\t\t\t\t", "+", " ", 
     RowBox[{"quarticOffDiagonalTerms", "[", 
      RowBox[{
      "nList", ",", " ", "G4", ",", "  ", "secFreqsMHz", ",", " ", 
       "numModes"}], "]"}]}], ")"}]}], ";"}]}], "Code",
 CellChangeTimes->{{3.9978244230583096`*^9, 3.9978245913990097`*^9}, {
   3.997824624589199*^9, 3.997824632413679*^9}, {3.997824773351465*^9, 
   3.9978248046351585`*^9}, {3.997826020046236*^9, 3.9978260205028667`*^9}, {
   3.9978993310476284`*^9, 3.997899357063923*^9}, {3.997901026154375*^9, 
   3.997901052584549*^9}, {3.9979011502729645`*^9, 3.997901191746851*^9}, {
   3.997901755220957*^9, 3.997901804960039*^9}, {3.9979018973923397`*^9, 
   3.99790189948386*^9}, 3.9979021932503185`*^9, {3.997902223266987*^9, 
   3.997902232811182*^9}, {3.9979024437626553`*^9, 3.997902445427332*^9}},
 CellLabel->"In[51]:=",ExpressionUUID->"15502470-5bc9-ab4e-9795-187d368faf7e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Construct", " ", "Matrix", " ", "Elements"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"x3Element", "[", 
      RowBox[{"m_", ",", " ", "n_"}], "]"}], ":=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"n", "+", "1"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"n", "+", "2"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"n", "+", "3"}], ")"}]}], "]"}], "*", 
        RowBox[{"KroneckerDelta", "[", 
         RowBox[{"m", ",", " ", 
          RowBox[{"n", "+", "3"}]}], "]"}]}], "\n", "\t\t\t\t\t\t\t\t", "+", 
       RowBox[{"3", "*", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"n", "+", "1"}], ")"}], 
         RowBox[{"3", "/", "2"}]], "*", 
        RowBox[{"KroneckerDelta", "[", 
         RowBox[{"m", ",", " ", 
          RowBox[{"n", "+", "1"}]}], "]"}]}], "\n", "\t\t\t\t\t\t\t\t", "+", 
       " ", 
       RowBox[{"3", "*", 
        SuperscriptBox["n", 
         RowBox[{"3", "/", "2"}]], "*", 
        RowBox[{"KroneckerDelta", "[", 
         RowBox[{"m", ",", " ", 
          RowBox[{"n", "-", "1"}]}], "]"}]}], "\n", "\t\t\t\t\t\t\t\t", "+", 
       " ", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"(", "n", ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"n", "-", "1"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"n", "-", "2"}], ")"}]}], "]"}], "*", 
        RowBox[{"KroneckerDelta", "[", 
         RowBox[{"m", ",", " ", 
          RowBox[{"n", "-", "3"}]}], "]"}]}]}], "\n", "\t\t\t\t\t\t\t\t", 
      ")"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"x2Element", "[", 
      RowBox[{"m_", ",", " ", "n_"}], "]"}], ":=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"n", "+", "1"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"n", "+", "2"}], ")"}]}], "]"}], "*", 
        RowBox[{"KroneckerDelta", "[", 
         RowBox[{"m", ",", 
          RowBox[{"n", "+", "2"}]}], "]"}]}], "\n", "\t\t\t\t\t", "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "*", "n"}], "+", "1"}], ")"}], "*", 
        RowBox[{"KroneckerDelta", "[", 
         RowBox[{"m", ",", " ", "n"}], "]"}]}], "\n", "\t\t\t\t\t", "+", " ", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"n", "*", 
          RowBox[{"(", 
           RowBox[{"n", "-", "1"}], ")"}]}], "]"}], "*", 
        RowBox[{"KroneckerDelta", "[", 
         RowBox[{"m", ",", " ", 
          RowBox[{"n", "-", "2"}]}], "]"}]}]}], "\n", "\t\t\t\t\t", ")"}]}], 
    ";"}], "\t\t\t\t\t\t\t\t", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"x1Element", "[", 
      RowBox[{"m_", ",", " ", "n_"}], "]"}], ":=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"n", "+", "1"}], "]"}], 
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"m", ",", 
         RowBox[{"n", "+", "1"}]}], "]"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"Sqrt", "[", "n", "]"}], "*", 
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"m", ",", 
         RowBox[{"n", "-", "1"}]}], "]"}]}]}]}], ";"}], "\t", "\n", "\n", 
   "\t\t\t\t", "\n", 
   RowBox[{"(*", 
    RowBox[{"Construct", " ", "Amplitudes"}], "*)"}], 
   "\t\t\t\t\t\t\t\t\t\t\t", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"cubicDiagonalTerm", "[", 
      RowBox[{
      "mList_", ",", " ", "nList_", ",", " ", "G3_", ",", " ", "secFreqsMHz_",
        ",", " ", "numModes_"}], "]"}], ":=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"G3", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "i", ",", "i"}], "]"}], "]"}], "*", 
        SuperscriptBox[
         RowBox[{"ll", "[", 
          RowBox[{"i", ",", " ", "secFreqsMHz"}], "]"}], "3"], "*", "\n", 
        "\t\t\t\t\t\t\t\t\t\t", 
        RowBox[{"x3Element", "[", 
         RowBox[{
          RowBox[{"mList", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
          RowBox[{"nList", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "*", "\n", 
        "\t\t\t\t\t\t\t\t\t\t", 
        RowBox[{"Product", "[", 
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{
            RowBox[{"mList", "[", 
             RowBox[{"[", "q", "]"}], "]"}], ",", " ", 
            RowBox[{"nList", "[", 
             RowBox[{"[", "q", "]"}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"q", ",", " ", 
            RowBox[{"DeleteCases", "[", 
             RowBox[{
              RowBox[{"Range", "[", "numModes", "]"}], ",", " ", "i"}], 
             "]"}]}], "}"}]}], "]"}]}], "\n", "\t\t\t\t\t\t\t\t\t\t", ",", 
       "\n", "\t\t\t\t\t\t\t\t\t\t", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "1", ",", " ", "numModes"}], "}"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"cubicOffDiagonalTerm", "[", 
      RowBox[{
      "mList_", ",", " ", "nList_", ",", " ", "G3_", ",", " ", "secFreqsMHz_",
        ",", " ", "numModes_"}], "]"}], ":=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"3", "*", 
           RowBox[{"G3", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "j", ",", "j"}], "]"}], "]"}], "*", 
           SuperscriptBox[
            RowBox[{"ll", "[", 
             RowBox[{"j", ",", " ", "secFreqsMHz"}], "]"}], "2"], "*", 
           RowBox[{"ll", "[", 
            RowBox[{"i", ",", "secFreqsMHz"}], "]"}], "\n", 
           "\t\t\t\t\t\t\t\t\t\t", "*", " ", 
           RowBox[{"x1Element", "[", 
            RowBox[{
             RowBox[{"mList", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
             RowBox[{"nList", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "\n", 
           "\t\t\t\t\t\t\t\t\t\t", "*", " ", 
           RowBox[{"x2Element", "[", 
            RowBox[{
             RowBox[{"mList", "[", 
              RowBox[{"[", "j", "]"}], "]"}], ",", " ", 
             RowBox[{"nList", "[", 
              RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "\n", 
           "\t\t\t\t\t\t\t\t\t\t", "*", " ", 
