Cell[BoxData[{
 RowBox[{
  RowBox[{"testSecFreqs", " ", "=", " ", 
   RowBox[{"2", "*", "\[Pi]", "*", 
    RowBox[{"{", 
     RowBox[{".71", ",", " ", "1.8", ",", " ", "2.1"}], "}"}], "*", "MHz"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"secFreqs", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"getAxialRock", "[", 
      RowBox[{"getSecFreqs", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          FractionBox[
           RowBox[{"\[Kappa]", "*", 
            RowBox[{"(", 
             RowBox[{"Volt", "-", "voltMidPoint"}], ")"}]}], 
           RowBox[{"Sqrt", "[", "2", "]"}]], ",", 
          FractionBox[
           RowBox[{"\[Kappa]", "*", 
            RowBox[{"(", 
             RowBox[{"Volt", "-", "voltMidPoint"}], ")"}]}], 
           RowBox[{"Sqrt", "[", "2", "]"}]], ",", "0"}], "}"}], ",", " ", 
        "massArr", ",", " ", "testSecFreqs", ",", " ", "knownMass", ",", " ", 
        "numIons", ",", " ", "ionPositions"}], "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"Volt", ",", " ", "simVoltageList"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"maxSecFreq", " ", "=", " ", 
    RowBox[{"Max", "[", "secFreqs", "]"}]}], ";"}], "\n", "\n"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"getAxialRock", "[", 
          RowBox[{"getSecFreqs", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              FractionBox[
               RowBox[{"\[Kappa]", "*", 
                RowBox[{"(", 
                 RowBox[{"Voltage", "-", "voltMidPoint"}], ")"}]}], 
               RowBox[{"Sqrt", "[", "2", "]"}]], ",", 
              FractionBox[
               RowBox[{"\[Kappa]", "*", 
                RowBox[{"(", 
                 RowBox[{"Voltage", "-", "voltMidPoint"}], ")"}]}], 
               RowBox[{"Sqrt", "[", "2", "]"}]], ",", "0"}], "}"}], ",", " ", 
            "massArr", ",", " ", "testSecFreqs", ",", " ", "knownMass", ",", 
            " ", "numIons", ",", " ", "ionPositions"}], "]"}], "]"}], "-", 
         "maxSecFreq"}], ")"}], "*", "MHz"}], ",", "\n", 
      RowBox[{"{", 
       RowBox[{"Voltage", ",", " ", 
        RowBox[{
         FractionBox[
          RowBox[{"-", "voltRange"}], "2"], "+", "voltMidPoint"}], ",", 
        RowBox[{
         FractionBox["voltRange", "2"], "+", "voltMidPoint"}]}], "}"}], ",", 
      " ", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{"Black", ",", " ", 
