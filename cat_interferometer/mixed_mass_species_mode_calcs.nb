     RowBox[{"{", 
      RowBox[{"Volt", ",", " ", "simVoltageList"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"maxSecFreq", " ", "=", " ", 
    RowBox[{"Max", "[", "secFreqs", "]"}]}], ";"}], "\n", "\n"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"getAxialRock", "[", 
          RowBox[{"getSecFreqs", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              FractionBox[
               RowBox[{"\[Kappa]", "*", 
                RowBox[{"(", 
                 RowBox[{"Voltage", "-", "voltMidPoint"}], ")"}]}], 
               RowBox[{"Sqrt", "[", "2", "]"}]], ",", 
              FractionBox[
               RowBox[{"\[Kappa]", "*", 
                RowBox[{"(", 
                 RowBox[{"Voltage", "-", "voltMidPoint"}], ")"}]}], 
               RowBox[{"Sqrt", "[", "2", "]"}]], ",", "0"}], "}"}], ",", " ", 
            "massArr", ",", " ", "testSecFreqs", ",", " ", "knownMass", ",", 
            " ", "numIons", ",", " ", "ionPositions"}], "]"}], "]"}], "-", 
         "maxSecFreq"}], ")"}], "*", "MHz"}], ",", "\n", 
      RowBox[{"{", 
       RowBox[{"Voltage", ",", " ", 
        RowBox[{
         FractionBox[
          RowBox[{"-", "voltRange"}], "2"], "+", "voltMidPoint"}], ",", 
        RowBox[{
         FractionBox["voltRange", "2"], "+", "voltMidPoint"}]}], "}"}], ",", 
      " ", 
      RowBox[{"PlotStyle", "->", 
