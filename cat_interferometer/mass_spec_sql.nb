       RowBox[{
        FractionBox["\[Pi]", "2"], "+", 
        RowBox[{"\[Delta]", "*", 
         RowBox[{"(", 
          RowBox[{"tTick", "+", "tCat"}], ")"}]}]}], "]"}]}], "]"}], "4"]}], 
  ";"}], "\n", 
