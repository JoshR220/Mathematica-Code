Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"pdd", "[", 
    RowBox[{
    "\[Gamma]0_", ",", "\[Delta]_", ",", "tTick_", ",", "tCat_", ",", 
     "\[Alpha]_"}], "]"}], ":=", " ", 
   SuperscriptBox[
    RowBox[{"Cos", "[", 
     RowBox[{"2", "*", 
      RowBox[{"\[Gamma]", "[", 
       RowBox[{"\[Gamma]0", ",", " ", "\[Delta]", ",", " ", "tTick"}], "]"}], 
