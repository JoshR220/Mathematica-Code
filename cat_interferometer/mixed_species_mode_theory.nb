Cell[CellGroupData[{

Cell["Three ions - mixed species (2 bright, 1 dark)", "Section",
 CellChangeTimes->{{3.9878002188228636`*^9, 
  3.987800236900716*^9}},ExpressionUUID->"8ef14e6a-cab9-4fc0-9058-\
5d853714da49"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Eta]1", "[", 
    RowBox[{"\[Mu]_", ",", " ", "\[Omega]z_"}], "]"}], ":=", " ", 
   RowBox[{"\[Omega]z", "*", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      FractionBox["13", "10"], "+", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"10", "\[Mu]"}]], 
       RowBox[{"(", 
        RowBox[{"21", "-", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"441", "-", 
           RowBox[{"34", "\[Mu]"}], "+", 
           RowBox[{"169", 
            SuperscriptBox["\[Mu]", "2"]}]}], "]"}]}], ")"}]}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Eta]3", "[", 
    RowBox[{"\[Mu]_", ",", " ", "\[Omega]z_"}], "]"}], ":=", " ", 
   RowBox[{"\[Omega]z", "*", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      FractionBox["13", "10"], "+", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"10", "\[Mu]"}]], 
       RowBox[{"(", 
        RowBox[{"21", "+", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"441", "-", 
           RowBox[{"34", "\[Mu]"}], "+", 
           RowBox[{"169", 
            SuperscriptBox["\[Mu]", "2"]}]}], "]"}]}], ")"}]}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   FractionBox[
    RowBox[{"\[Eta]1", "[", 
     RowBox[{"\[Mu]", ",", " ", "\[Omega]z"}], "]"}], 
    RowBox[{"\[Eta]3", "[", 
     RowBox[{"\[Mu]", ",", " ", "\[Omega]z"}], "]"}]], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[Mu]", ",", "0.25", ",", "3"}], "}"}], ",", "\n", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Mass Ratio\>\"", ",", " ", "16"}], "]"}], ",", " ", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Secular Frequency Ratio\>\"", ",", " ", "16"}], "]"}]}], 
     "}"}]}], ",", "\n", 
   RowBox[{"GridLines", "->", "Automatic"}], ",", "\n", 
   RowBox[{"ImageSize", "->", "Large"}], ",", " ", 
   RowBox[{"TicksStyle", "->", 
    RowBox[{"Directive", "[", 
     RowBox[{"\"\<Label\>\"", ",", " ", "16"}], "]"}]}]}], "]"}], "\n", 
 RowBox[{"MixedModesSec", " ", "=", " ", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      FractionBox[
       RowBox[{"\[Eta]1", "[", 
        RowBox[{"\[Mu]", ",", " ", "\[Omega]z"}], "]"}], 
       RowBox[{"(", 
        RowBox[{"2", "*", "\[Pi]", "*", "kHz"}], ")"}]], ",", " ", 
      FractionBox[
       RowBox[{"\[Eta]3", "[", 
        RowBox[{"\[Mu]", ",", " ", "\[Omega]z"}], "]"}], 
       RowBox[{"(", 
        RowBox[{"2", "*", "\[Pi]", "*", "kHz"}], ")"}]]}], "}"}], ",", " ", 
