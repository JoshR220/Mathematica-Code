    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"soundDJ", "=", 
        RowBox[{"Play", "[", 
         RowBox[{
          RowBox[{"Sin", "[", 
           RowBox[{"600", "*", "\[Pi]", "*", "t"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", "0.6"}], "}"}]}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Switch", "[", 
        RowBox[{"type", ",", "\[IndentingNewLine]", "\"\<text\>\"", ",", 
         RowBox[{"SendMessage", "[", 
