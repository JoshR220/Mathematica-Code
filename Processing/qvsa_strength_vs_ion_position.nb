Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "fit", " ", "sinc", " ", "and", " ", "return", " ", "params", " ", "with", 
    " ", "error", " ", "and", " ", "confidence", " ", "intervals"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"FitSinc", "[", 
     RowBox[{"dataset_List", ",", 
      RowBox[{"timeSinc", ":", 
       RowBox[{"(", 
        RowBox[{"_Integer", "|", "_Real"}], ")"}]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"guessMax", "=", 
         RowBox[{"dataset", "[", 
          RowBox[{"[", 
           RowBox[{"First", "@", 
            RowBox[{"Ordering", "[", 
             RowBox[{
              RowBox[{"dataset", "[", 
               RowBox[{"[", 
                RowBox[{";;", ",", "2"}], "]"}], "]"}], ",", 
              RowBox[{"-", "1"}]}], "]"}]}], "]"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"guessOffset", "=", 
         RowBox[{"Mean", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Median", "[", 
             RowBox[{"dataset", "[", 
              RowBox[{"[", 
               RowBox[{";;", ",", "2"}], "]"}], "]"}], "]"}], ",", 
            RowBox[{"Mean", "[", 
             RowBox[{"dataset", "[", 
              RowBox[{"[", 
               RowBox[{";;", ",", "2"}], "]"}], "]"}], "]"}]}], "}"}], 
          "]"}]}], ",", "\[IndentingNewLine]", "guessParamList", ",", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\[Alpha]", ",", 
        "\[Beta]", ",", "\[Gamma]", ",", "\[Delta]", ",", "x", ",", 
        "\[IndentingNewLine]", "sincConstraints", ",", "\[IndentingNewLine]", 
        "sincModel", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        "fitResult"}], "\[IndentingNewLine]", "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"create", " ", "sinc", " ", "model"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"sincModel", "=", 
        RowBox[{
         RowBox[{"\[Alpha]", "*", 
          SuperscriptBox[
           RowBox[{"Sinc", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"\[Pi]", "*", "timeSinc"}], ")"}], "*", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"x", "-", "\[Beta]"}], ")"}], "*", "khz"}], ")"}]}], 
             "+", "0.00000001"}], "]"}], "2"]}], "+", "\[Delta]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"guess", " ", "sinc", " ", "fit", " ", "parameters"}], "*)"}],
        "\[IndentingNewLine]", 
       RowBox[{"guessParamList", "=", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"guessMax", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "-", "guessOffset"}], ")"}], ",", 
          RowBox[{"(*", 
           RowBox[{"rabi", " ", "frequency"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"guessMax", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"(*", 
           RowBox[{"resonance", " ", "frequency"}], "*)"}], 
          "\[IndentingNewLine]", "guessOffset"}], " ", 
         RowBox[{"(*", 
          RowBox[{"background", " ", "offset"}], "*)"}], 
         "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "constrain", " ", "search", " ", "range", " ", "for", " ", 
         "parameters"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"sincConstraints", "=", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"\[Alpha]", ">", "0"}], ",", 
           RowBox[{"\[Alpha]", "<", 
            RowBox[{"\[Alpha]RSBguess", "*", "3"}]}], ","}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"\[Beta]", ">", 
            RowBox[{"0.975", "*", "\[Beta]RSBguess"}]}], ",", 
           RowBox[{"\[Beta]", "<", 
