Cell["Prepare Fitting", "Section",
 CellChangeTimes->{{3.963801527803361*^9, 
  3.963801539242008*^9}},ExpressionUUID->"37f8e533-d165-494c-9a90-\
f6fa05699c8f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "create", " ", "abs", " ", "fit", " ", "func", " ", "for", " ", "general", 
    " ", "use"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"FitAbsFunc", "[", "data_", "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Ampl", ",", "x", ",", "x0", ",", "C0"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"With", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"fitfunc", "=", 
           RowBox[{
            RowBox[{"Ampl", "*", 
             RowBox[{"Abs", "[", 
              RowBox[{"x", "-", "x0"}], "]"}]}], "+", "C0"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"fitConstraintsDJ", "=", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Ampl", ">", "0."}], ",", 
             RowBox[{"C0", ">", "0."}]}], "}"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"fitGuessDJ", "=", 
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"Ampl", ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"Abs", "[", 
                  FractionBox[
                   RowBox[{"Subtract", "@@", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", 
                    RowBox[{";;", ",", "2"}], "]"}], "]"}]}], 
                   RowBox[{"Subtract", "@@", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", 
                    RowBox[{";;", ",", "1"}], "]"}], "]"}]}]], "]"}], "&"}], 
                "[", 
                RowBox[{"data", "[", 
                 RowBox[{"[", 
                  RowBox[{"First", "/@", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Ordering", "[", 
                    RowBox[{
                    RowBox[{"data", "[", 
                    RowBox[{"[", 
                    RowBox[{";;", ",", "2"}], "]"}], "]"}], ",", 
                    RowBox[{"-", "1"}]}], "]"}], ",", 
                    RowBox[{"Ordering", "[", 
                    RowBox[{
                    RowBox[{"data", "[", 
                    RowBox[{"[", 
                    RowBox[{";;", ",", "2"}], "]"}], "]"}], ",", "1"}], 
                    "]"}]}], "}"}]}], "]"}], "]"}], "]"}]}], "}"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{"x0", ",", 
               RowBox[{"First", "@", 
                RowBox[{"data", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"Ordering", "[", 
                    RowBox[{
                    RowBox[{"data", "[", 
                    RowBox[{"[", 
                    RowBox[{";;", ",", "2"}], "]"}], "]"}], ",", "1"}], "]"}],
                    ",", "1"}], "]"}], "]"}]}]}], "}"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{"C0", ",", 
               RowBox[{"Min", "[", 
                RowBox[{"data", "[", 
                 RowBox[{"[", 
                  RowBox[{";;", ",", "2"}], "]"}], "]"}], "]"}]}], "}"}]}], 
            "\[IndentingNewLine]", "}"}]}]}], "\[IndentingNewLine]", "}"}], 
        ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Return", "[", 
          RowBox[{"NonlinearModelFit", "[", 
           RowBox[{"data", ",", "\[IndentingNewLine]", 
            RowBox[{"Join", "[", 
             RowBox[{
              RowBox[{"{", "fitfunc", "}"}], ",", "fitConstraintsDJ"}], "]"}],
             ",", "\[IndentingNewLine]", "fitGuessDJ", ",", 
            "\[IndentingNewLine]", "x"}], "\[IndentingNewLine]", "]"}], 
          "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
       "]"}]}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.9638011650078773`*^9, 3.963801293151754*^9}, {
  3.963801517046116*^9, 3.9638015234250183`*^9}},
 CellLabel->
  "In[4285]:=",ExpressionUUID->"89cee901-4ec6-4123-822c-3da85a95fa8f"]
}, Closed]],

