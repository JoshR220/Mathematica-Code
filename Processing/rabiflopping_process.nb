Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "fit", " ", "damped", " ", "exponential", " ", "and", " ", "return", " ", 
    "fit", " ", "object"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"FitDampedExponential", "[", "\[IndentingNewLine]", 
     RowBox[{"dataset_List", ",", "\[IndentingNewLine]", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "\[IndentingNewLine]", "]"}], ":=", 
    RowBox[{"Block", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\[Alpha]", ",", "\[Beta]", ",", "\[CapitalOmega]", ",", "\[Eta]", ",",
         "t"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Module", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
         "maxIndex0", ",", "maxData0", ",", "pointsMargin", ",", "maxIndex1", 
          ",", "maxData1", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"\[Eta]0", "=", 
           RowBox[{"OptionValue", "[", "\"\<\[Eta]0\>\"", "]"}]}], ",", 
          "\[IndentingNewLine]", "guessParamList", ",", "\[IndentingNewLine]",
           "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"todo", ":", " ", 
            RowBox[{
            "use", " ", "block", " ", "to", " ", "ensure", " ", "these", " ", 
             "values", " ", "are", " ", "local", " ", "and", " ", "not", " ", 
             "affected", " ", "by", " ", "global", " ", "definitions"}]}], 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{"fitModel", "=", 
           RowBox[{
            FractionBox["\[Alpha]", "2"], 
            RowBox[{"(", 
             RowBox[{"1.", "-", 
              RowBox[{
               RowBox[{"Exp", "[", 
                RowBox[{
                 RowBox[{"-", "\[Beta]"}], "*", "t"}], "]"}], "*", 
               RowBox[{"Cos", "[", 
                RowBox[{"\[CapitalOmega]", "*", 
                 RowBox[{"(", 
                  RowBox[{"\[Eta]", "*", 
                   RowBox[{"Exp", "[", 
                    RowBox[{"-", 
                    FractionBox[
                    SuperscriptBox["\[Eta]", "2."], "2."]}], "]"}], "*", 
                   RowBox[{"LaguerreL", "[", 
                    RowBox[{"1", ",", "1", ",", 
                    SuperscriptBox["\[Eta]", "2."]}], "]"}]}], ")"}], "*", 
                 "t"}], "]"}]}]}], ")"}]}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"fitConstraints", "=", 
           RowBox[{"OptionValue", "[", "\"\<Constraints\>\"", "]"}]}], ",", 
          "\[IndentingNewLine]", "fitResult"}], "\[IndentingNewLine]", "}"}], 
        ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "get", " ", "position", " ", "of", " ", "first", " ", "peak", " ", 
          "and", " ", "use", " ", "as", " ", 
          RowBox[{"pi", "/", "2"}], " ", "time"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"maxIndex0", "=", 
          RowBox[{"First", "@", 
           RowBox[{"Ordering", "[", 
            RowBox[{
             RowBox[{"dataset", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{";;", 
                 RowBox[{"IntegerPart", "[", 
                  FractionBox[
                   RowBox[{"Length", "[", "dataset", "]"}], "5"], "]"}]}], 
                ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"-", "1"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"maxData0", "=", 
          RowBox[{"dataset", "[", 
           RowBox[{"[", "maxIndex0", "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "get", " ", "position", " ", "of", " ", "next", " ", "peak", " ", 
           "to", " ", "extract", " ", "decay", " ", "constant"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"pointsMargin", "=", 
          RowBox[{
           RowBox[{"Round", "[", 
            RowBox[{"1.4", "*", "maxIndex0"}], "]"}], "-", "1."}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"maxIndex1", "=", 
          RowBox[{"First", "@", 
           RowBox[{"Ordering", "[", 
            RowBox[{
             RowBox[{"dataset", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"pointsMargin", ";;"}], ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"-", "1"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"maxData1", "=", 
          RowBox[{"dataset", "[", 
           RowBox[{"[", 
            RowBox[{"pointsMargin", "+", "maxIndex1"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"guess", " ", "fit", " ", "parameters"}], "*)"}], 
         "\[IndentingNewLine]", 
