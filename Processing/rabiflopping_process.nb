       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "convert", " ", "dataset", " ", "into", " ", "correct", " ", 
         "units"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"datasetProcessed", "=", 
        RowBox[{"Transpose", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"datafile", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], "*", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
           "ftwToFrequencyMHz", ",", "1.", ",", "1.*^-6", ",", "1.*^-3"}], 
