Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"(*", 
   RowBox[{
   "fit", " ", "thermal", " ", "state", " ", "to", " ", "rabi", " ", 
    "flopping", " ", "and", " ", "return", " ", "fit", " ", "object"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"FitThermalState", "[", "\[IndentingNewLine]", 
     RowBox[{"dataset_List", ",", "\[IndentingNewLine]", 
      RowBox[{"\[CapitalOmega]0", ":", 
       RowBox[{"(", 
        RowBox[{"_Integer", "|", "_Real"}], ")"}]}], ",", 
      RowBox[{"\[Beta]0_", ":", 
       RowBox[{"(", 
        RowBox[{"_Integer", "|", "_Real"}], ")"}]}], ",", 
      RowBox[{"\[Eta]0_", ":", 
       RowBox[{"(", 
        RowBox[{"_Integer", "|", "_Real"}], ")"}]}], ",", 
      "\[IndentingNewLine]", "\[CapitalDelta]n_Integer", ",", 
      "\[IndentingNewLine]", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "\[IndentingNewLine]", "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"local", " ", "variables"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
       "\[CapitalOmega]", ",", "\[Beta]", ",", "\[Eta]", ",", "nAvg", ",", 
        "t", ",", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"keyword", " ", "arguments"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"n0", "=", 
         RowBox[{"OptionValue", "[", "\"\<n0\>\"", "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"numPhonons", "=", 
         RowBox[{"OptionValue", "[", "\"\<numPhonons\>\"", "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"constraints", "=", 
         RowBox[{"OptionValue", "[", "\"\<Constraints\>\"", "]"}]}]}], 
       "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Module", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"data", " ", "structures", " ", "for", " ", "fitting"}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"PnArr", "=", 
           RowBox[{"Array", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                FractionBox["1.", 
                 RowBox[{"nAvg", "+", "1."}]], ")"}], "*", 
               SuperscriptBox[
                RowBox[{"(", 
                 FractionBox["nAvg", 
                  RowBox[{"nAvg", "+", "1."}]], ")"}], "#"]}], "&"}], ",", 
             RowBox[{"IntegerPart", "[", 
              RowBox[{"numPhonons", "+", "1"}], "]"}], ",", "0"}], "]"}]}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{"\[Beta]nArr", "=", 
           RowBox[{"Array", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Exp", "[", 
               RowBox[{
                RowBox[{"-", 
                 FractionBox["t", "\[Beta]"]}], "*", 
                SqrtBox[
                 RowBox[{"#", "+", "1"}]]}], "]"}], "&"}], ",", 
             RowBox[{"IntegerPart", "[", 
              RowBox[{"numPhonons", "+", "1"}], "]"}], ",", "0"}], "]"}]}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{"\[CapitalOmega]nArr", "=", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"\[Eta]", "*", 
               RowBox[{"Exp", "[", 
                RowBox[{"-", 
                 FractionBox[
                  SuperscriptBox["\[Eta]", "2."], "2."]}], "]"}]}], ")"}], 
             RowBox[{"Abs", "[", "\[CapitalDelta]n", "]"}]], "*", 
            RowBox[{"Array", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"LaguerreL", "[", 
                RowBox[{"#", ",", 
                 RowBox[{"Abs", "[", "\[CapitalDelta]n", "]"}], ",", 
                 SuperscriptBox["\[Eta]", "2."]}], "]"}], "&"}], ",", 
              RowBox[{"IntegerPart", "[", 
               RowBox[{"numPhonons", "+", "1"}], "]"}], ",", "0"}], "]"}]}]}],
           ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"starting", " ", "values", " ", "for", " ", "fitting"}], 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{"PnArrGuess", "=", 
           RowBox[{"Array", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                FractionBox["1.", 
                 RowBox[{"n0", "+", "1."}]], ")"}], "*", 
               SuperscriptBox[
                RowBox[{"(", 
                 FractionBox["n0", 
                  RowBox[{"n0", "+", "1."}]], ")"}], "#"]}], "&"}], ",", 
             RowBox[{"IntegerPart", "[", 
              RowBox[{"numPhonons", "+", "1"}], "]"}], ",", "0"}], "]"}]}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{"guessParamList", "=", 
           RowBox[{"{", 
            RowBox[{
            "\[CapitalOmega]0", ",", "\[Beta]0", ",", "\[Eta]0", ",", "n0"}], 
            "}"}]}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", "fitting", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"fitConstraints", "=", "constraints"}], ",", 
          "\[IndentingNewLine]", "fitModel", ",", "fitResult"}], 
         "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"set", " ", 
          RowBox[{"raising", "/", "lowering"}], " ", "coefficients", " ", 
          "correctly"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"\[CapitalDelta]n", ">", "0"}], ",", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"BSB", " ", "case"}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"\[CapitalOmega]nArr", "*=", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"1.", "+", 
               RowBox[{"Range", "[", 
                RowBox[{"0", ",", 
                 RowBox[{"IntegerPart", "[", "numPhonons", "]"}]}], "]"}]}], 
              ")"}], 
             RowBox[{
              RowBox[{"-", "0.5"}], "*", 
              RowBox[{"Abs", "[", "\[CapitalDelta]n", "]"}]}]]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"\[CapitalDelta]n", "<", "0"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{"RSB", " ", "case"}], "*)"}], "\[IndentingNewLine]", 
             RowBox[{"\[CapitalOmega]nArr", "*=", 
              RowBox[{"Join", "[", 
               RowBox[{
                RowBox[{"{", "0", "}"}], ",", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"Range", "[", 
                   RowBox[{"1", ",", 
                    RowBox[{"IntegerPart", "[", "numPhonons", "]"}]}], "]"}], 
                  ")"}], 
                 RowBox[{
                  RowBox[{"-", "0.5"}], "*", 
                  RowBox[{"Abs", "[", "\[CapitalDelta]n", "]"}]}]]}], "]"}]}],
              ",", "\[IndentingNewLine]", "Null"}], "\[IndentingNewLine]", 
            "]"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]",
          "\[IndentingNewLine]", 
