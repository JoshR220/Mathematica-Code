      RowBox[{
       RowBox[{
        RowBox[{"i", ".", "e", ".", " ", "w"}], "/", " ", "sideband"}], " ", 
       "sweep"}], ")"}]}], ",", " ", 
    RowBox[{"returning", " ", "relevant", " ", "values"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ProcessDatasetEGGS", "[", 
     RowBox[{"filedir_", ",", "filekey_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"actual", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
