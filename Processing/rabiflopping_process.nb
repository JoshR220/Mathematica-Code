Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "create", " ", "a", " ", "coherent", " ", "state", " ", "phonon", " ", 
    "vector"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"CoherentState", "[", 
