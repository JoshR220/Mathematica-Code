      RowBox[{"\[Eta]0_", ":", 
       RowBox[{"(", 
        RowBox[{"_Integer", "|", "_Real"}], ")"}]}], ",", 
      "\[IndentingNewLine]", "\[CapitalDelta]n_Integer", ",", 
      "\[IndentingNewLine]", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "\[IndentingNewLine]", "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"local", " ", "variables"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
       "A", ",", "\[CapitalOmega]", ",", "\[Beta]", ",", "\[Eta]", ",", "t", 
        ",", "Pn", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"keyword", " ", "arguments"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"initialState", "=", 
         RowBox[{"OptionValue", "[", "\"\<InitialState\>\"", "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"numPhonons", "=", 
         RowBox[{"OptionValue", "[", "\"\<numPhonons\>\"", "]"}]}], ",", 
        "\[IndentingNewLine]", 
