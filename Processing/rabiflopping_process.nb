           RowBox[{"(", 
            FractionBox[
             RowBox[{"1.", "-", 
              RowBox[{"\[Beta]nArr", "*", 
               RowBox[{"Cos", "[", 
                RowBox[{
                "\[CapitalOmega]nArr", "*", "\[CapitalOmega]", "*", "t"}], 
                "]"}]}]}], "2."], ")"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"fit", "!"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"fitResult", "=", 
