Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "create", " ", "a", " ", "squeezed", " ", "state", " ", "phonon", " ", 
    "vector"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SqueezedState", "[", 
     RowBox[{
      RowBox[{"r_", ":", 
       RowBox[{"(", 
        RowBox[{"_Integer", "|", "_Real"}], ")"}]}], ",", 
      "numPhonons_Integer"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"phononArr", "=", 
        RowBox[{"Array", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             FractionBox[
              SuperscriptBox[
               RowBox[{"Tanh", "[", "r", "]"}], "#"], 
              RowBox[{
               SuperscriptBox["2.", "#"], "*", 
               RowBox[{"Cosh", "[", "r", "]"}]}]], 
             FractionBox[
              RowBox[{"#", "!"}], 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 FractionBox["#", "2"], "!"}], ")"}], "2."]]}], "]"}], "&"}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{"IntegerPart", "[", 
           RowBox[{"numPhonons", "+", "1"}], "]"}], ",", 
          "\[IndentingNewLine]", "0"}], "\[IndentingNewLine]", "]"}]}], "}"}],
       ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"ensure", " ", "odd"}], "-", 
        RowBox[{
        "numbered", " ", "fock", " ", "states", " ", "have", " ", "0", " ", 
         "population"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"phononArr", "[", 
         RowBox[{"[", 
          RowBox[{"2", ";;", ";;", "2"}], "]"}], "]"}], "=", "0."}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"return", " ", "normalized", " ", "probabilities"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{
         RowBox[{
          FractionBox["#", 
           RowBox[{"Total", "[", "#", "]"}]], "&"}], "[", "phononArr", "]"}], 
        "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
