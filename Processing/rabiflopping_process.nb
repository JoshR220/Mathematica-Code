Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"(*", 
   RowBox[{
   "specify", " ", "optional", " ", "arguments", " ", "and", " ", "their", 
    " ", "default", " ", "value", " ", "for", " ", "FitCoherentState", " ", 
    "function"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "FitSqueezedState", "]"}], "=", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\"\<r0\>\"", "->", "1.0"}], ",", "\[IndentingNewLine]", 
      RowBox[{"\"\<numPhonons\>\"", "->", "10"}], ",", "\[IndentingNewLine]", 
      RowBox[{"\"\<Constraints\>\"", "->", 
       RowBox[{"{", "}"}]}]}], "\[IndentingNewLine]", "}"}]}], ";"}], 
  "*)"}]], "Input",
 CellChangeTimes->{{3.904272819693898*^9, 3.904272824873136*^9}, {
   3.904273152329441*^9, 3.904273179281877*^9}, {3.904273531176077*^9, 
   3.9042735425415697`*^9}, {3.90431580627145*^9, 3.904315806962329*^9}, {
   3.904322943848096*^9, 3.904322949784627*^9}, {3.904323470830991*^9, 
   3.904323472170701*^9}, {3.9043237076201057`*^9, 3.904323713498725*^9}, {
   3.904326045580634*^9, 3.904326048792856*^9}, {3.904326174913103*^9, 
