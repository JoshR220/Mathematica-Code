              RowBox[{"IntegerPart", "[", 
               RowBox[{"numPhonons", "+", "1"}], "]"}], ",", "0"}], "]"}]}]}],
           ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"least", " ", "squares", " ", "fitting"}], "*)"}], 
          "\[IndentingNewLine]", "fitBasisMat", ",", "fitResult"}], 
         "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"set", " ", 
          RowBox[{"raising", "/", "lowering"}], " ", "coefficients", " ", 
          "correctly", " ", "for", " ", 
          RowBox[{"RSB", "/", "BSB"}], " ", "flopping"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
