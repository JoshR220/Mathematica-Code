        "\[IndentingNewLine]", 
        RowBox[{"constraints", "=", 
         RowBox[{"OptionValue", "[", "\"\<Constraints\>\"", "]"}]}]}], 
       "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Module", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"data", " ", "structures", " ", "for", " ", "fitting"}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"PnArr", "=", 
           RowBox[{"Array", "[", 
            RowBox[{"Pn", ",", 
             RowBox[{"IntegerPart", "[", 
              RowBox[{"numPhonons", "+", "1"}], "]"}], ",", "0"}], "]"}]}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{"\[Beta]nArr", "=", 
           RowBox[{"Array", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Exp", "[", 
               RowBox[{
                RowBox[{"-", 
                 FractionBox["t", "\[Beta]"]}], "*", 
                SqrtBox[
                 RowBox[{"#", "+", "1"}]]}], "]"}], "&"}], ",", 
             RowBox[{"IntegerPart", "[", 
              RowBox[{"numPhonons", "+", "1"}], "]"}], ",", "0"}], "]"}]}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{"\[CapitalOmega]nArr", "=", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"\[Eta]", "*", 
               RowBox[{"Exp", "[", 
                RowBox[{"-", 
                 FractionBox[
                  SuperscriptBox["\[Eta]", "2."], "2."]}], "]"}]}], ")"}], 
             RowBox[{"Abs", "[", "\[CapitalDelta]n", "]"}]], "*", 
            RowBox[{"Array", "[", 
             RowBox[{
              RowBox[{
