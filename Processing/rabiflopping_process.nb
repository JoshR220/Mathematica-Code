        RowBox[{"(*", 
         RowBox[{"keyword", " ", "arguments"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"numPhonons", "=", 
         RowBox[{"OptionValue", "[", "\"\<numPhonons\>\"", "]"}]}]}], 
       "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Module", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{"(*", 
