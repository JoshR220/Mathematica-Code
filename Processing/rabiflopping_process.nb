Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"group", " ", "the", " ", "data", " ", "as", " ", "desired"}], 
    ",", " ", 
    RowBox[{
    "then", " ", "take", " ", "the", " ", "mean", " ", "of", " ", "whatever", 
     " ", "remains"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"CollateData", "[", 
     RowBox[{"dataset_List", ",", "groupColumnList_List"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"GroupBy", "[", 
      RowBox[{"dataset", ",", "\[IndentingNewLine]", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"i", "=", "i"}], "}"}], ",", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "&"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"i", ",", "groupColumnList"}], "}"}]}], 
        "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"N", "[", 
         RowBox[{"Mean", "[", "#", "]"}], "]"}], "&"}]}], 
      "\[IndentingNewLine]", "]"}], "//", "KeySort"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.9026922070037527`*^9, 3.902692220702298*^9}, {
