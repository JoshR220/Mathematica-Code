         RowBox[{"Exp", "[", 
          RowBox[{"-", 
           SuperscriptBox[
            RowBox[{"Abs", "[", "\[Alpha]", "]"}], "2."]}], "]"}], "*", 
         RowBox[{"Array", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             FractionBox[
              SuperscriptBox[
               RowBox[{"Abs", "[", "\[Alpha]", "]"}], 
               RowBox[{"2.", "*", "#"}]], 
              RowBox[{"#", "!"}]], ")"}], "&"}], ",", "\[IndentingNewLine]", 
           RowBox[{"IntegerPart", "[", 
            RowBox[{"numPhonons", "+", "1"}], "]"}], ",", 
           "\[IndentingNewLine]", "0"}], "\[IndentingNewLine]", "]"}]}]}], 
       "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
