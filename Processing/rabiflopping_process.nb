Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "create", " ", "a", " ", "squeezed", " ", "coherent", " ", "state", " ", 
    "phonon", " ", "vector"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SqueezedCoherentState", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"r_", ":", 
       RowBox[{"(", 
        RowBox[{"_Integer", "|", "_Real", "|", "_Complex"}], ")"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"\[Phi]s_", ":", 
       RowBox[{"(", 
        RowBox[{"_Integer", "|", "_Real", "|", "_Complex"}], ")"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"\[Alpha]_", ":", 
       RowBox[{"(", 
        RowBox[{"_Integer", "|", "_Real", "|", "_Complex"}], ")"}]}], ",", 
      "\[IndentingNewLine]", "numPhonons_Integer"}], "\[IndentingNewLine]", 
     "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"coefficient", "=", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", 
            SuperscriptBox[
             RowBox[{"Abs", "[", "\[Alpha]", "]"}], "2."]}], "*", 
           RowBox[{"(", 
            RowBox[{"1.", "-", 
             RowBox[{
              RowBox[{"Tanh", "[", "r", "]"}], "*", 
              RowBox[{"Cos", "[", 
               RowBox[{
                RowBox[{"2.", "*", 
                 RowBox[{"Arg", "[", "\[Alpha]", "]"}]}], "-", "\[Phi]s"}], 
               "]"}]}]}], ")"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"hermiteArr", "=", "\[IndentingNewLine]", 
         RowBox[{"Array", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            SuperscriptBox[
             RowBox[{"Abs", "[", 
              RowBox[{"HermiteH", "[", 
               RowBox[{"#", ",", 
                FractionBox[
                 RowBox[{
                  RowBox[{"Abs", "[", "\[Alpha]", "]"}], "*", 
                  RowBox[{"Exp", "[", 
                   RowBox[{"\[ImaginaryI]", "*", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Arg", "[", "\[Alpha]", "]"}], "-", 
                    FractionBox["\[Phi]s", "2."]}], ")"}]}], "]"}]}], 
                 RowBox[{"Sqrt", "[", 
                  RowBox[{"Sinh", "[", 
                   RowBox[{"2.", "*", "r"}], "]"}], "]"}]]}], "]"}], "]"}], 
             "2."], "&"}], ",", "\[IndentingNewLine]", 
           RowBox[{"IntegerPart", "[", 
            RowBox[{"numPhonons", "+", "1"}], "]"}], ",", 
           "\[IndentingNewLine]", "0"}], "\[IndentingNewLine]", "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"phononArr", "=", 
         RowBox[{"Array", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             FractionBox[
              SuperscriptBox[
               RowBox[{"(", 
                FractionBox[
                 RowBox[{"Tanh", "[", "r", "]"}], "2."], ")"}], "#"], 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"#", "!"}], ")"}], "*", 
               RowBox[{"Cosh", "[", "r", "]"}]}]], "]"}], "&"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"IntegerPart", "[", 
            RowBox[{"numPhonons", "+", "1"}], "]"}], ",", 
           "\[IndentingNewLine]", "0"}], "\[IndentingNewLine]", "]"}]}]}], 
       "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Print", "[", "coefficient", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"hermiteArr", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"phononArr", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Total", "[", "#", "]"}], "&"}], "[", 
          RowBox[{"coefficient", "*", 
           RowBox[{"(", 
            RowBox[{"hermiteArr", "*", "phononArr"}], ")"}]}], "]"}], "]"}], 
        ";"}], "*)"}], "\[IndentingNewLine]", 
