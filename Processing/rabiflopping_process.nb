Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "fit", " ", "a", " ", "given", " ", "state", " ", "to", " ", "rabi", " ", 
    "flopping", " ", "and", " ", "return", " ", "fit", " ", "object"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"FitStateParameter", "[", "\[IndentingNewLine]", 
     RowBox[{"dataset_List", ",", "\[IndentingNewLine]", 
      RowBox[{"A0_", ":", 
       RowBox[{"(", 
        RowBox[{"_Integer", "|", "_Real"}], ")"}]}], ",", 
      RowBox[{"\[CapitalOmega]0_", ":", 
       RowBox[{"(", 
        RowBox[{"_Integer", "|", "_Real"}], ")"}]}], ",", 
      RowBox[{"\[Beta]0_", ":", 
       RowBox[{"(", 
        RowBox[{"_Integer", "|", "_Real"}], ")"}]}], ",", 
      RowBox[{"\[Eta]0_", ":", 
       RowBox[{"(", 
        RowBox[{"_Integer", "|", "_Real"}], ")"}]}], ",", 
      "\[IndentingNewLine]", "\[CapitalDelta]n_Integer", ",", "state_String", 
      ",", "\[IndentingNewLine]", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "\[IndentingNewLine]", "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"local", " ", "variables"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
       "\[Alpha]", ",", "A", ",", "\[CapitalOmega]", ",", "\[Beta]", ",", 
        "\[Eta]", ",", "t", ",", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"keyword", " ", "arguments"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"\[Alpha]0", "=", 
         RowBox[{"OptionValue", "[", "\"\<\[Alpha]0\>\"", "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"numPhonons", "=", 
         RowBox[{"OptionValue", "[", "\"\<numPhonons\>\"", "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"constraints", "=", 
         RowBox[{"OptionValue", "[", "\"\<Constraints\>\"", "]"}]}]}], 
       "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Module", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"data", " ", "structures", " ", "for", " ", "fitting"}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"PnArr", ",", "\[IndentingNewLine]", 
          RowBox[{"\[Beta]nArr", "=", 
           RowBox[{"Array", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Exp", "[", 
               RowBox[{
                RowBox[{"-", 
                 FractionBox["t", "\[Beta]"]}], "*", 
                SqrtBox[
                 RowBox[{"#", "+", "1"}]]}], "]"}], "&"}], ",", 
             RowBox[{"IntegerPart", "[", 
              RowBox[{"numPhonons", "+", "1"}], "]"}], ",", "0"}], "]"}]}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"\[CapitalOmega]nArr", "=", 
             RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"\[Eta]", "*", 
                 RowBox[{"Exp", "[", 
                  RowBox[{"-", 
                   FractionBox[
                    SuperscriptBox["\[Eta]", "2."], "2."]}], "]"}]}], ")"}], 
               RowBox[{"Abs", "[", "\[CapitalDelta]n", "]"}]], "*", 
              RowBox[{"Array", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"LaguerreL", "[", 
                  RowBox[{"#", ",", 
                   RowBox[{"Abs", "[", "\[CapitalDelta]n", "]"}], ",", 
                   SuperscriptBox["\[Eta]", "2."]}], "]"}], "&"}], ",", 
                RowBox[{"IntegerPart", "[", 
                 RowBox[{"numPhonons", "+", "1"}], "]"}], ",", "0"}], 
               "]"}]}]}], ","}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"\[CapitalOmega]nArr", "=", 
           RowBox[{"\[Eta]", "*", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"Range", "[", 
              RowBox[{"0", ",", 
               RowBox[{"IntegerPart", "[", "numPhonons", "]"}]}], "]"}], 
             "]"}]}]}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"starting", " ", "values", " ", "for", " ", "fitting"}], 
           "*)"}], "\[IndentingNewLine]", "PnArrGuess", ",", 
          "\[IndentingNewLine]", 
          RowBox[{"guessParamList", "=", 
           RowBox[{"{", 
            RowBox[{
            "A0", ",", "\[CapitalOmega]0", ",", "\[Beta]0", ",", "\[Eta]0", 
             ",", "\[Alpha]0"}], "}"}]}], ",", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", "fitting", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"fitConstraints", "=", "constraints"}], ",", 
          "\[IndentingNewLine]", "fitModel", ",", "fitResult"}], 
         "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"(*", 
          RowBox[{"set", " ", 
           RowBox[{"raising", "/", "lowering"}], " ", "coefficients", " ", 
           "correctly"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"\[CapitalDelta]n", ">", "0"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"BSB", " ", "case"}], "*)"}], "\[IndentingNewLine]", 
            RowBox[{"\[CapitalOmega]nArr", "*=", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"1.", "+", 
                RowBox[{"Range", "[", 
                 RowBox[{"0", ",", 
                  RowBox[{"IntegerPart", "[", "numPhonons", "]"}]}], "]"}]}], 
               ")"}], 
              RowBox[{
               RowBox[{"-", "0.5"}], "*", 
               RowBox[{"Abs", "[", "\[CapitalDelta]n", "]"}]}]]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"\[CapitalDelta]n", "<", "0"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{"RSB", " ", "case"}], "*)"}], "\[IndentingNewLine]", 
              RowBox[{"\[CapitalOmega]nArr", "*=", 
               RowBox[{"Join", "[", 
                RowBox[{
                 RowBox[{"{", "0", "}"}], ",", 
                 SuperscriptBox[
                  RowBox[{"(", 
                   RowBox[{"Range", "[", 
                    RowBox[{"1", ",", 
                    RowBox[{"IntegerPart", "[", "numPhonons", "]"}]}], "]"}], 
                   ")"}], 
                  RowBox[{
                   RowBox[{"-", "0.5"}], "*", 
                   RowBox[{"Abs", "[", "\[CapitalDelta]n", "]"}]}]]}], 
                "]"}]}], ",", "\[IndentingNewLine]", "Null"}], 
             "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], 
          ";"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"create", " ", "desired", " ", "state", " ", "model"}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"PnArr", "=", 
          RowBox[{"Switch", "[", 
           RowBox[{"state", ",", "\[IndentingNewLine]", "\"\<t\>\"", ",", 
            RowBox[{"Array", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 FractionBox["1.", 
                  RowBox[{"\[Alpha]", "+", "1."}]], ")"}], "*", 
                SuperscriptBox[
                 RowBox[{"(", 
                  FractionBox["\[Alpha]", 
                   RowBox[{"\[Alpha]", "+", "1."}]], ")"}], "#"]}], "&"}], 
              ",", 
              RowBox[{"IntegerPart", "[", 
               RowBox[{"numPhonons", "+", "1"}], "]"}], ",", "0"}], "]"}], 
            ",", "\[IndentingNewLine]", "\"\<c\>\"", ",", 
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{"-", 
               SuperscriptBox[
                RowBox[{"Abs", "[", "\[Alpha]", "]"}], "2."]}], "]"}], "*", 
             RowBox[{"Array", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 FractionBox[
                  SuperscriptBox[
                   RowBox[{"Abs", "[", "\[Alpha]", "]"}], 
                   RowBox[{"2.", "*", "#"}]], 
                  RowBox[{"#", "!"}]], ")"}], "&"}], ",", 
               RowBox[{"IntegerPart", "[", 
                RowBox[{"numPhonons", "+", "1"}], "]"}], ",", "0"}], "]"}]}], 
            ",", "\[IndentingNewLine]", "\"\<s\>\"", ",", 
            RowBox[{"Array", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{
                 FractionBox[
                  SuperscriptBox[
                   RowBox[{"Tanh", "[", "\[Alpha]", "]"}], "#"], 
                  RowBox[{
                   SuperscriptBox["2.", "#"], "*", 
                   RowBox[{"Cosh", "[", "\[Alpha]", "]"}]}]], 
                 FractionBox[
                  RowBox[{"#", "!"}], 
                  SuperscriptBox[
                   RowBox[{"(", 
                    RowBox[{
                    FractionBox["#", "2"], "!"}], ")"}], "2."]]}], "]"}], 
               "&"}], ",", 
              RowBox[{"IntegerPart", "[", 
               RowBox[{"numPhonons", "+", "1"}], "]"}], ",", "0"}], "]"}]}], 
           "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "ensure", " ", "squeezed", " ", "states", " ", "have", " ", 
           "nonzero", " ", "elements", " ", "for", " ", "only", " ", "even", 
           " ", "n"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"state", "==", "\"\<s\>\""}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"PnArr", "[", 
             RowBox[{"[", 
              RowBox[{"2", ";;", ";;", "2"}], "]"}], "]"}], "=", "0"}], ",", 
           "\[IndentingNewLine]", "Null"}], "\[IndentingNewLine]", "]"}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"create", " ", "initial", " ", "state", " ", "guess"}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"PnArrGuess", "=", 
          RowBox[{"PnArr", "/.", 
           RowBox[{"{", 
            RowBox[{"\[Alpha]", "->", "\[Alpha]0"}], "}"}]}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "create", " ", "fit", " ", "model", " ", "for", " ", "rabi", " ", 
           "flopping"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"fitModel", "=", 
          RowBox[{"A", "*", 
           RowBox[{"(", 
            RowBox[{"PnArr", ".", 
             RowBox[{"(", 
              FractionBox[
               RowBox[{"1.", "-", 
                RowBox[{"\[Beta]nArr", "*", 
                 RowBox[{"Cos", "[", 
                  RowBox[{
                  "\[CapitalOmega]nArr", "*", "\[CapitalOmega]", "*", "t"}], 
                  "]"}]}]}], "2."], ")"}]}], ")"}]}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"fit", "!"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"fitResult", "=", 
          RowBox[{"NonlinearModelFit", "[", "\[IndentingNewLine]", 
           RowBox[{"dataset", ",", "\[IndentingNewLine]", 
            RowBox[{"Join", "[", 
             RowBox[{"{", 
              RowBox[{"fitModel", ",", "fitConstraints"}], "}"}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                "A", ",", "\[CapitalOmega]", ",", "\[Beta]", ",", "\[Eta]", 
                 ",", "\[Alpha]"}], "}"}], ",", "guessParamList"}], "}"}], 
             "]"}], ",", "\[IndentingNewLine]", "t"}], "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"Method", "->", "\"\<NMinimize\>\""}], "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"MaxIterations", "->", 
             SuperscriptBox["10", "4"]}], "*)"}], "\[IndentingNewLine]", 
           "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"return", " ", "fit", " ", "object"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"Return", "[", "fitResult", "]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}]}], "]"}]}], ";"}]}]], "Input",
