Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"(*", 
   RowBox[{
   "specify", " ", "optional", " ", "arguments", " ", "and", " ", "their", 
    " ", "default", " ", "value", " ", "for", " ", "FitThermalState", " ", 
    "function"}], "*)"}], "\[IndentingNewLine]", 
