  RowBox[{
   RowBox[{
    RowBox[{"FitFockSpectrumLSQ", "[", "\[IndentingNewLine]", 
     RowBox[{"dataset_List", ",", "\[IndentingNewLine]", 
      RowBox[{"A0", ":", 
       RowBox[{"(", 
        RowBox[{"_Integer", "|", "_Real"}], ")"}]}], ",", 
      RowBox[{"\[CapitalOmega]0", ":", 
