     RowBox[{
      RowBox[{"\"\<n0\>\"", "->", "12.2"}], ",", "\[IndentingNewLine]", 
      RowBox[{"\"\<numPhonons\>\"", "->", "10"}], ",", "\[IndentingNewLine]", 
      RowBox[{"\"\<Constraints\>\"", "->", 
       RowBox[{"{", "}"}]}]}], "\[IndentingNewLine]", "}"}]}], ";"}], 
