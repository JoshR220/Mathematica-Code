Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "create", " ", "a", " ", "thermal", " ", "state", " ", "phonon", " ", 
    "vector"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ThermalState", "[", 
     RowBox[{
      RowBox[{"nAvg_", ":", 
       RowBox[{"(", 
        RowBox[{"_Integer", "|", "_Real"}], ")"}]}], ",", 
      "numPhonons_Integer"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"phononArr", "=", 
        RowBox[{"Array", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             FractionBox["1.", 
              RowBox[{"nAvg", "+", "1."}]], ")"}], "*", 
            SuperscriptBox[
             RowBox[{"(", 
              FractionBox["nAvg", 
               RowBox[{"nAvg", "+", "1."}]], ")"}], "#"]}], "&"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"IntegerPart", "[", 
           RowBox[{"numPhonons", "+", "1"}], "]"}], ",", 
          "\[IndentingNewLine]", "0"}], "\[IndentingNewLine]", "]"}]}], "}"}],
       ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"return", " ", "normalized", " ", "probabilities"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{
        RowBox[{
         FractionBox["#", 
          RowBox[{"Total", "[", "#", "]"}]], "&"}], "[", "phononArr", "]"}], 
       "]"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
