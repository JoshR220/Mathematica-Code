            RowBox[{"data", " ", "structures", " ", "for", " ", "fitting"}], 
            " ", "-", " ", 
            RowBox[{"phenomenological", " ", "decay"}]}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"\[Beta]nArr", "=", 
           RowBox[{"Array", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Exp", "[", 
               RowBox[{
                RowBox[{"-", 
                 FractionBox["1", "\[Beta]0"]}], "*", 
