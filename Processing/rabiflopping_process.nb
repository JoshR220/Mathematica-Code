Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"(*", 
   RowBox[{"plot", " ", "results"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fitPlotsStates", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Show", "[", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Plot", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"fitResultsThermal", "[", 
                RowBox[{"[", "#", "]"}], "]"}], "[", "\"\<BestFit\>\"", "]"}],
               ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"fitResultsCoherent", "[", 
                RowBox[{"[", "#", "]"}], "]"}], "[", "\"\<BestFit\>\"", "]"}],
               ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"fitResultsSqueezed", "[", 
                RowBox[{"[", "#", "]"}], "]"}], "[", "\"\<BestFit\>\"", 
               "]"}]}], "\[IndentingNewLine]", "}"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"t", ",", 
              RowBox[{
               RowBox[{"datasetProcessed", "[", 
                RowBox[{"[", "#", "]"}], "]"}], "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"datasetProcessed", "[", 
                RowBox[{"[", "#", "]"}], "]"}], "[", 
               RowBox[{"[", 
