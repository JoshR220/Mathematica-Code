       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "threshold", " ", "ion", " ", "fluorescence", " ", "counts", " ", 
          "into", " ", "D"}], "-", 
         RowBox[{"state", " ", "probability"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"datasetProcessed", "=", 
        RowBox[{"ThresholdCounts", "[", 
         RowBox[{"datasetProcessed", ",", "2"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"collate", " ", "data", " ", "by", " ", 
         RowBox[{"rsb", "/", "bsb"}], " ", "and", " ", "sideband", " ", 
