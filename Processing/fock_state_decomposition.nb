  RowBox[{
   RowBox[{
    RowBox[{"SqueezedState", "[", 
     RowBox[{
      RowBox[{"r_", ":", 
       RowBox[{"(", 
        RowBox[{"_Integer", "|", "_Real"}], ")"}]}], ",", 
      "numPhonons_Integer"}], "]"}], ":=", 
