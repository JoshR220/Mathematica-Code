Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"calculate", " ", "limits"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"fDJ", "=", 
     FractionBox[
      RowBox[{"(", 
       RowBox[{"\[CapitalOmega]DJ", "*", "\[Eta]DJ"}], ")"}], 
      RowBox[{"2.", "\[Pi]"}]]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fSample", "=", 
     FractionBox["1.", 
      RowBox[{"Mean", "[", 
       RowBox[{
        RowBox[{"dataDJ", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"2", ";;"}], ",", "1"}], "]"}], "]"}], "-", 
        RowBox[{"dataDJ", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"1", ";;", 
            RowBox[{"-", "2"}]}], ",", "1"}], "]"}], "]"}]}], "]"}]]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fRes", "=", 
     RowBox[{
      RowBox[{
       FractionBox["1.", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "-", 
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ")"}]], "&"}], "[", 
      RowBox[{"dataDJ", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", "1"}], "]"}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"fDJ", ",", "fSample", ",", "fRes"}], "}"}]}]}]], "Input",
