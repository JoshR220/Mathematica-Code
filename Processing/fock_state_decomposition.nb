            RowBox[{"Transpose", "[", 
             RowBox[{"{", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Join", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                  "A", ",", "\[CapitalOmega]", ",", "\[Beta]", ",", 
                   "\[Eta]"}], "}"}], ",", "PnArr"}], "]"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"Join", "[", 
                RowBox[{"guessParamList", ",", "initialState"}], "]"}]}], 
              "\[IndentingNewLine]", "}"}], "]"}], ",", "\[IndentingNewLine]",
             "t", ",", "\[IndentingNewLine]", 
            RowBox[{"MaxIterations", "->", 
             SuperscriptBox["10", "5"]}]}], "\[IndentingNewLine]", "]"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"tmp", " ", "remove"}], " ", "-", " ", 
           RowBox[{
           "fit", " ", "with", " ", "fixed", " ", "rabi", " ", "flopping", 
            " ", "parameters"}]}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"fitResult", "=", 
