Cell[CellGroupData[{

Cell["Process FFT", "Chapter",
 CellChangeTimes->{{3.9529172242684526`*^9, 3.952917225405846*^9}, 
   3.9529184051537533`*^9},ExpressionUUID->"aec1ecc5-bdc7-4b79-8e23-\
55e6e8fb5b42"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "subtract", " ", "mean", " ", "from", " ", "data", " ", "to", " ", 
    "reduce", " ", "DC", " ", "offset"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"dataDJ", "[", 
     RowBox[{"[", 
      RowBox[{";;", ",", "2"}], "]"}], "]"}], "-=", 
    RowBox[{"Mean", "[", 
     RowBox[{"dataDJ", "[", 
      RowBox[{"[", 
       RowBox[{";;", ",", "2"}], "]"}], "]"}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.952915158475564*^9, 3.9529151685239162`*^9}, 
   3.952915771187685*^9, {3.95291617147019*^9, 3.952916176279635*^9}, {
   3.952916494840975*^9, 3.952916498272241*^9}, {3.952916551504369*^9, 
   3.952916565314391*^9}, {3.952917035784425*^9, 3.952917063041905*^9}, {
   3.9529172159138823`*^9, 3.9529172164172163`*^9}},
 CellLabel->
  "In[819]:=",ExpressionUUID->"9dd79589-ea09-4628-9f81-0afb3ad4fa29"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"fourier", " ", 
    RowBox[{"transform", "!"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"fftDataY", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", 
         RowBox[{";;", 
          RowBox[{"IntegerPart", "[", 
           FractionBox[
            RowBox[{"Length", "[", "#", "]"}], "2"], "]"}]}], "]"}], "]"}], 
       "&"}], "[", 
      SuperscriptBox[
       RowBox[{"Abs", "[", 
        RowBox[{"Fourier", "[", 
         RowBox[{"dataDJ", "[", 
          RowBox[{"[", 
           RowBox[{";;", ",", "2"}], "]"}], "]"}], "]"}], "]"}], "2."], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fftDataX", "=", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", 
        FractionBox["fSample", "2."], ",", "fRes"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{";;", 
        RowBox[{"Length", "[", "fftDataY", "]"}]}], "]"}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9529161824333887`*^9, 3.9529162386512403`*^9}, {
   3.952916306178446*^9, 3.952916407967325*^9}, 3.952916464951837*^9, 
   3.952916952111287*^9, {3.9529169948349333`*^9, 3.9529170030565777`*^9}, {
   3.952919073994398*^9, 3.952919074262735*^9}},
 CellLabel->
  "In[820]:=",ExpressionUUID->"f4ba09c4-9e85-4cd8-9a0b-49ee62b082b5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"normalize", " ", 
    RowBox[{"FFT", "'"}], "d", " ", "probability", " ", "for", " ", "easier", 
    " ", "comparison"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"fftDataY", "/=", 
    RowBox[{"Total", "[", "fftDataY", "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.952919046026174*^9, 3.952919088575149*^9}},
 CellLabel->
  "In[822]:=",ExpressionUUID->"2804ab57-c5d4-4887-8730-ae412e6cdd5f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fftData", "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      FractionBox["fftDataX", "1.*^3"], ",", "fftDataY"}], "}"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[823]:=",ExpressionUUID->"5d814f5e-8a06-40a0-95a8-c9a19a51db85"]
}, Closed]],

Cell[CellGroupData[{

Cell["Plot", "Chapter",
 CellChangeTimes->{{3.952917233743222*^9, 
  3.9529172353416777`*^9}},ExpressionUUID->"fdf052d4-f860-498d-96a4-\
7df3228849d7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "calculate", " ", "and", " ", "plot", " ", "peaks", " ", "for", " ", 
    "fock", " ", "states"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"fftFockFreqs", "=", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", "nRes"}], "]"}], "+", "1."}], "]"}], "*", 
      FractionBox["fDJ", "1.*^3"]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gridLinesFock", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#", ",", 
         RowBox[{"Directive", "[", 
          RowBox[{
           RowBox[{"Thickness", "->", ".001"}], ",", "Black"}], "]"}]}], 
        "}"}], "&"}], "/@", "fftFockFreqs"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"calloutsFock", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Callout", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"fftFockFreqs", "[", 
             RowBox[{"[", "#", "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{"Max", "[", "fftDataY", "]"}], "/", "2."}]}], "}"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"\"\<n=\>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"#", "-", "1"}], "]"}]}], ",", "\[IndentingNewLine]", 
          "Right"}], "\[IndentingNewLine]", "]"}], "}"}], "&"}], "/@", 
      RowBox[{"Range", "[", 
       RowBox[{"Length", "[", "fftFockFreqs", "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fftFockPeaks", "=", 
     RowBox[{"ListPlot", "[", "calloutsFock", "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.952917230953005*^9, 3.952917316050889*^9}, {
