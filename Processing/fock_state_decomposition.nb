Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "create", " ", "a", " ", "symbolic", " ", "model", " ", "from", " ", "a", 
    " ", "given", " ", "phonon", " ", "state", " ", "distribution"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"DistributionToModel", "[", "\[IndentingNewLine]", 
     RowBox[{"dist_List", ",", "\[IndentingNewLine]", 
      RowBox[{"A_", ":", 
       RowBox[{"(", 
        RowBox[{"_Integer", "|", "_Real"}], ")"}]}], ",", 
      RowBox[{"\[CapitalOmega]_", ":", 
       RowBox[{"(", 
        RowBox[{"_Integer", "|", "_Real"}], ")"}]}], ",", 
      RowBox[{"\[Beta]_", ":", 
       RowBox[{"(", 
        RowBox[{"_Integer", "|", "_Real"}], ")"}]}], ",", 
      RowBox[{"\[Eta]_", ":", 
       RowBox[{"(", 
        RowBox[{"_Integer", "|", "_Real"}], ")"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "\[IndentingNewLine]", "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", "t", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Module", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\[CapitalDelta]n", "=", 
           RowBox[{"OptionValue", "[", "\"\<\[CapitalDelta]n\>\"", "]"}]}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{"numPhonons", "=", 
           RowBox[{
            RowBox[{"Length", "[", "dist", "]"}], "-", "1"}]}], ",", 
          "\[IndentingNewLine]", "\[Beta]nArr", ",", "\[IndentingNewLine]", 
          "\[CapitalOmega]nArr"}], "\[IndentingNewLine]", "}"}], ",", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"create", " ", "model", " ", "objects"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"\[Beta]nArr", "=", 
          RowBox[{"Array", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", 
                FractionBox["1.", "\[Beta]"]}], "*", 
               SqrtBox[
                RowBox[{"#", "+", "1."}]], "*", "t"}], "]"}], "&"}], ",", 
            RowBox[{"IntegerPart", "[", 
             RowBox[{"numPhonons", "+", "1"}], "]"}], ",", "0"}], "]"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"\[CapitalOmega]nArr", "=", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"\[Eta]", "*", 
              RowBox[{"Exp", "[", 
               RowBox[{"-", 
                FractionBox[
                 SuperscriptBox["\[Eta]", "2."], "2."]}], "]"}]}], ")"}], 
            RowBox[{"Abs", "[", "\[CapitalDelta]n", "]"}]], "*", 
           RowBox[{"Array", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"LaguerreL", "[", 
               RowBox[{"#", ",", 
                RowBox[{"Abs", "[", "\[CapitalDelta]n", "]"}], ",", 
                SuperscriptBox["\[Eta]", "2."]}], "]"}], "&"}], ",", 
             RowBox[{"IntegerPart", "[", 
              RowBox[{"numPhonons", "+", "1"}], "]"}], ",", "0"}], "]"}]}]}], 
         ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"set", " ", 
           RowBox[{"raising", "/", "lowering"}], " ", "coefficients", " ", 
           "correctly"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"\[CapitalDelta]n", ">", "0"}], ",", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"BSB", " ", "case"}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"\[CapitalOmega]nArr", "*=", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"1.", "+", 
               RowBox[{"Range", "[", 
                RowBox[{"0", ",", 
                 RowBox[{"IntegerPart", "[", "numPhonons", "]"}]}], "]"}]}], 
              ")"}], 
             RowBox[{
              RowBox[{"-", "0.5"}], "*", 
              RowBox[{"Abs", "[", "\[CapitalDelta]n", "]"}]}]]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"\[CapitalDelta]n", "<", "0"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{"RSB", " ", "case"}], "*)"}], "\[IndentingNewLine]", 
             RowBox[{"\[CapitalOmega]nArr", "*=", 
              RowBox[{"Join", "[", 
               RowBox[{
                RowBox[{"{", "0", "}"}], ",", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"Range", "[", 
                   RowBox[{"1", ",", 
                    RowBox[{"IntegerPart", "[", "numPhonons", "]"}]}], "]"}], 
                  ")"}], 
                 RowBox[{
                  RowBox[{"-", "0.5"}], "*", 
                  RowBox[{"Abs", "[", "\[CapitalDelta]n", "]"}]}]]}], "]"}]}],
              ",", "\[IndentingNewLine]", "Null"}], "\[IndentingNewLine]", 
            "]"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]",
          "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "return", " ", "expression", " ", "as", " ", "function", " ", "of", 
           " ", "t"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"Return", "[", 
          RowBox[{"dist", ".", 
           RowBox[{"(", 
            RowBox[{
             FractionBox["A", "2."], "*", 
             RowBox[{"(", 
              RowBox[{"1.", "-", 
               RowBox[{"\[Beta]nArr", "*", 
                RowBox[{"Cos", "[", 
                 RowBox[{
                 "\[CapitalOmega]nArr", "*", "\[CapitalOmega]", "*", "t"}], 
                 "]"}]}]}], ")"}]}], ")"}]}], "]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}]}], "]"}]}], ";"}]}]], "Input",
