Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"nSample", "=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox[
        RowBox[{"fSample", "/", "2."}], "fDJ"], ")"}], "2."], "-", "1"}]}], 
   ";"}], 
  RowBox[{"(*", 
   RowBox[{"nyquist", " ", "limit"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nRes", "=", 
    RowBox[{"n", "/.", 
     RowBox[{"First", "@", 
      RowBox[{"NSolve", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          FractionBox[
           RowBox[{"2.", "*", "fRes"}], "fDJ"], ")"}], "==", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{"n", "+", "1."}], "]"}], "-", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"n", "-", "0."}], "]"}]}]}], ",", "n", ",", 
        "PositiveReals"}], "]"}]}]}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"resolution", " ", "limit"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nRes", "=", 
   RowBox[{"Round", "[", "nRes", "]"}]}], ";"}], "\[IndentingNewLine]", 
