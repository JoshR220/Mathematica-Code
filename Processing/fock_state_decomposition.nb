Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "fit", " ", "arbitrary", " ", "fock", " ", "state", " ", "distribution", 
    " ", "to", " ", "rabi", " ", "flopping", " ", "data", " ", "and", " ", 
    "return", " ", "object"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"FitFockSpectrum", "[", "\[IndentingNewLine]", 
     RowBox[{"dataset_List", ",", "\[IndentingNewLine]", 
      RowBox[{"A0", ":", 
       RowBox[{"(", 
        RowBox[{"_Integer", "|", "_Real"}], ")"}]}], ",", 
      RowBox[{"\[CapitalOmega]0", ":", 
       RowBox[{"(", 
        RowBox[{"_Integer", "|", "_Real"}], ")"}]}], ",", 
      RowBox[{"\[Beta]0", ":", 
       RowBox[{"(", 
        RowBox[{"_Integer", "|", "_Real"}], ")"}]}], ",", 
      RowBox[{"\[Eta]0_", ":", 
       RowBox[{"(", 
        RowBox[{"_Integer", "|", "_Real"}], ")"}]}], ",", 
      "\[IndentingNewLine]", "\[CapitalDelta]n_Integer", ",", 
      "\[IndentingNewLine]", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "\[IndentingNewLine]", "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"local", " ", "variables"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
       "A", ",", "\[CapitalOmega]", ",", "\[Beta]", ",", "\[Eta]", ",", "t", 
        ",", "Pn", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"keyword", " ", "arguments"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"initialState", "=", 
         RowBox[{"OptionValue", "[", "\"\<InitialState\>\"", "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"numPhonons", "=", 
         RowBox[{"OptionValue", "[", "\"\<numPhonons\>\"", "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"constraints", "=", 
         RowBox[{"OptionValue", "[", "\"\<Constraints\>\"", "]"}]}]}], 
       "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Module", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"data", " ", "structures", " ", "for", " ", "fitting"}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"PnArr", "=", 
           RowBox[{"Array", "[", 
            RowBox[{"Pn", ",", 
             RowBox[{"IntegerPart", "[", 
              RowBox[{"numPhonons", "+", "1"}], "]"}], ",", "0"}], "]"}]}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{"\[Beta]nArr", "=", 
           RowBox[{"Array", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Exp", "[", 
               RowBox[{
                RowBox[{"-", 
                 FractionBox["t", "\[Beta]"]}], "*", 
                SqrtBox[
                 RowBox[{"#", "+", "1"}]]}], "]"}], "&"}], ",", 
             RowBox[{"IntegerPart", "[", 
              RowBox[{"numPhonons", "+", "1"}], "]"}], ",", "0"}], "]"}]}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{"\[CapitalOmega]nArr", "=", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"\[Eta]", "*", 
               RowBox[{"Exp", "[", 
                RowBox[{"-", 
                 FractionBox[
                  SuperscriptBox["\[Eta]", "2."], "2."]}], "]"}]}], ")"}], 
             RowBox[{"Abs", "[", "\[CapitalDelta]n", "]"}]], "*", 
            RowBox[{"Array", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"LaguerreL", "[", 
                RowBox[{"#", ",", 
                 RowBox[{"Abs", "[", "\[CapitalDelta]n", "]"}], ",", 
                 SuperscriptBox["\[Eta]", "2."]}], "]"}], "&"}], ",", 
              RowBox[{"IntegerPart", "[", 
               RowBox[{"numPhonons", "+", "1"}], "]"}], ",", "0"}], "]"}]}]}],
           ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"parameters", " ", "&"}], " ", "initial", " ", "values"}],
            "*)"}], "\[IndentingNewLine]", 
          RowBox[{"guessParamList", "=", 
           RowBox[{"{", 
            RowBox[{
            "A0", ",", "\[CapitalOmega]0", ",", "\[Beta]0", ",", "\[Eta]0"}], 
            "}"}]}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", "fitting", "*)"}], "\[IndentingNewLine]", 
          "fitConstraints", ",", "fitModel", ",", "fitResult"}], 
         "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"set", " ", 
          RowBox[{"raising", "/", "lowering"}], " ", "coefficients", " ", 
          "correctly"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"\[CapitalDelta]n", ">", "0"}], ",", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"BSB", " ", "case"}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"\[CapitalOmega]nArr", "*=", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"1.", "+", 
               RowBox[{"Range", "[", 
                RowBox[{"0", ",", 
                 RowBox[{"IntegerPart", "[", "numPhonons", "]"}]}], "]"}]}], 
              ")"}], 
             RowBox[{
              RowBox[{"-", "0.5"}], "*", 
              RowBox[{"Abs", "[", "\[CapitalDelta]n", "]"}]}]]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"\[CapitalDelta]n", "<", "0"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{"RSB", " ", "case"}], "*)"}], "\[IndentingNewLine]", 
             RowBox[{"\[CapitalOmega]nArr", "*=", 
              RowBox[{"Join", "[", 
               RowBox[{
                RowBox[{"{", "0", "}"}], ",", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"Range", "[", 
                   RowBox[{"1", ",", 
                    RowBox[{"IntegerPart", "[", "numPhonons", "]"}]}], "]"}], 
                  ")"}], 
                 RowBox[{
                  RowBox[{"-", "0.5"}], "*", 
                  RowBox[{"Abs", "[", "\[CapitalDelta]n", "]"}]}]]}], "]"}]}],
              ",", "\[IndentingNewLine]", "Null"}], "\[IndentingNewLine]", 
            "]"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]",
          "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "create", " ", "fit", " ", "model", " ", "for", " ", "rabi", " ", 
           "flopping"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"fitModel", "=", 
          RowBox[{"PnArr", ".", 
           RowBox[{"(", 
            RowBox[{
             FractionBox["A", "2."], "*", 
             RowBox[{"(", 
              RowBox[{"1.", "-", 
               RowBox[{"\[Beta]nArr", "*", 
                RowBox[{"Cos", "[", 
                 RowBox[{
                 "\[CapitalOmega]nArr", "*", "\[CapitalOmega]0", "*", "t"}], 
                 "]"}]}]}], ")"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"(*", 
           RowBox[{"tmp", " ", "remove"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"fitModel", "=", 
            RowBox[{"fitModel", "/.", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"A", "->", "ADJ"}], ",", 
               RowBox[{"\[Beta]", "->", "\[Beta]DJ"}], ",", 
               RowBox[{"\[CapitalOmega]", "->", "\[CapitalOmega]DJ"}], ",", 
               RowBox[{"\[Eta]", "->", "\[Eta]DJ"}]}], "}"}]}]}], ";"}], 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"tmp", " ", "remove"}], "*)"}], "*)"}], 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "set", " ", "probability", " ", "conservation", " ", 
           "constraints"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"fitConstraints", "=", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"0.", "<", "#", "<", "1."}], "&"}], "/@", "PnArr"}], 
              ","}], "*)"}], "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"Total", "[", "PnArr", "]"}], "==", "1."}], "*)"}], 
            "\[IndentingNewLine]", "}"}], "//", "Flatten"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"fitConstraints", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"fitConstraints", ",", "constraints"}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"fit", "!"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"fitResult", "=", 
          RowBox[{"NonlinearModelFit", "[", "\[IndentingNewLine]", 
           RowBox[{"dataset", ",", "\[IndentingNewLine]", 
            RowBox[{"Join", "[", 
             RowBox[{"{", 
              RowBox[{"fitModel", ",", "fitConstraints"}], "}"}], "]"}], ",", 
