Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"sinc", "-", 
    RowBox[{
    "squared", " ", "function", " ", "for", " ", "spetroscopy", " ", 
     "fitting"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SincModel", "[", 
     RowBox[{
     "\[Alpha]_", ",", "\[Beta]_", ",", "\[Delta]_", ",", "t_", ",", "x_"}], 
     "]"}], ":=", 
    RowBox[{
     RowBox[{"\[Alpha]", "*", 
      SuperscriptBox[
       RowBox[{"Sinc", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[Pi]", "*", "t"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", "-", "\[Beta]"}], ")"}], "*", "khz"}], ")"}]}], "+",
          "0.0000000001"}], "]"}], "2"]}], "+", "\[Delta]"}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{{3.902707876228842*^9, 3.90270793627313*^9}, {
  3.90270802120969*^9, 3.9027080216643953`*^9}},
 CellLabel->"In[46]:=",ExpressionUUID->"b9349f4b-aece-4ed6-87c3-a1a2921d325c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "fit", " ", "sinc", " ", "and", " ", "return", " ", "params", " ", "with", 
    " ", "error", " ", "and", " ", "confidence", " ", "intervals"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"FitSinc", "[", 
     RowBox[{"dataset_List", ",", 
      RowBox[{"timeSinc", ":", 
       RowBox[{"(", 
        RowBox[{"_Integer", "|", "_Real"}], ")"}]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"guessMax", "=", 
         RowBox[{"dataset", "[", 
          RowBox[{"[", 
           RowBox[{"First", "@", 
            RowBox[{"Ordering", "[", 
             RowBox[{
              RowBox[{"dataset", "[", 
               RowBox[{"[", 
                RowBox[{";;", ",", "2"}], "]"}], "]"}], ",", 
              RowBox[{"-", "1"}]}], "]"}]}], "]"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"guessOffset", "=", 
         RowBox[{"Mean", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Median", "[", 
             RowBox[{"dataset", "[", 
              RowBox[{"[", 
               RowBox[{";;", ",", "2"}], "]"}], "]"}], "]"}], ",", 
            RowBox[{"Mean", "[", 
             RowBox[{"dataset", "[", 
              RowBox[{"[", 
               RowBox[{";;", ",", "2"}], "]"}], "]"}], "]"}]}], "}"}], 
          "]"}]}], ",", "\[IndentingNewLine]", "guessParamList", ",", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\[Alpha]", ",", 
        "\[Beta]", ",", "\[Gamma]", ",", "\[Delta]", ",", "x", ",", 
        "\[IndentingNewLine]", "sincConstraints", ",", "\[IndentingNewLine]", 
        "sincModel", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        "fitResult"}], "\[IndentingNewLine]", "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"create", " ", "sinc", " ", "model"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"sincModel", "=", 
        RowBox[{
         RowBox[{"\[Alpha]", "*", 
          SuperscriptBox[
           RowBox[{"Sinc", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"\[Pi]", "*", "timeSinc"}], ")"}], "*", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"x", "-", "\[Beta]"}], ")"}], "*", "khz"}], ")"}]}], 
             "+", "0.00000001"}], "]"}], "2"]}], "+", "\[Delta]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"guess", " ", "sinc", " ", "fit", " ", "parameters"}], "*)"}],
        "\[IndentingNewLine]", 
       RowBox[{"guessParamList", "=", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"guessMax", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "-", "guessOffset"}], ")"}], ",", 
          RowBox[{"(*", 
           RowBox[{"rabi", " ", "frequency"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"guessMax", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"(*", 
           RowBox[{"resonance", " ", "frequency"}], "*)"}], 
          "\[IndentingNewLine]", "guessOffset"}], " ", 
         RowBox[{"(*", 
          RowBox[{"background", " ", "offset"}], "*)"}], 
         "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "constrain", " ", "search", " ", "range", " ", "for", " ", 
         "parameters"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"sincConstraints", "=", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"\[Alpha]", ">", "0"}], ",", 
           RowBox[{"\[Alpha]", "<", 
            RowBox[{"\[Alpha]RSBguess", "*", "3"}]}], ","}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"\[Beta]", ">", 
            RowBox[{"0.975", "*", "\[Beta]RSBguess"}]}], ",", 
           RowBox[{"\[Beta]", "<", 
            RowBox[{"1.025", "*", "\[Beta]RSBguess"}]}]}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"\[Delta]", ">", "0"}], "\[IndentingNewLine]", "}"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"fit", " ", "sinc", " ", "model"}], " ", "-", " ", 
         RowBox[{
         "nonlinearmodelfit", " ", "to", " ", "extract", " ", "extra", " ", 
          "fit", " ", "information"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"fitResult", "=", 
        RowBox[{"NonlinearModelFit", "[", "\[IndentingNewLine]", 
         RowBox[{"dataset", ",", "\[IndentingNewLine]", 
          RowBox[{"Join", "[", 
           RowBox[{"{", 
            RowBox[{"sincModel", ",", "sincConstraints"}], "}"}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\[Alpha]", ",", "\[Beta]", ",", "\[Delta]"}], "}"}], 
             ",", "guessParamList"}], "}"}], "]"}], ",", 
          "\[IndentingNewLine]", "x", ",", "\[IndentingNewLine]", 
          RowBox[{"MaxIterations", "->", 
           SuperscriptBox["10", "4"]}]}], "\[IndentingNewLine]", "]"}]}], ";",
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"todo", ":", " ", 
         RowBox[{
         "return", " ", "parameters", " ", "and", " ", "their", " ", 
          "error"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{
        "fitResult", "[", "\"\<ParameterConfidenceIntervalTableEntries\>\"", 
         "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{{3.902706194411989*^9, 3.9027062525469437`*^9}, {
