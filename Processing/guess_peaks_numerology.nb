ce6454a86aa5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"generate", " ", "combination", " ", "mode", " ", "frequencies"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Omega]Coefficients", "=", 
     RowBox[{"Tuples", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"-", "\[Omega]Order"}], ",", "\[Omega]Order"}], "]"}], ",", 
       RowBox[{"Length", "[", "\[Omega]Known", "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "select", " ", "only", " ", "combination", " ", "modes", " ", "of", " ", 
     "order", " ", "below", " ", "\[Omega]Order"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Omega]Coefficients", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"\[Omega]Coefficients", ",", 
       RowBox[{
        RowBox[{"0", "<", 
         RowBox[{"Total", "[", 
          RowBox[{"Abs", "/@", "#"}], "]"}], "<=", "\[Omega]Order"}], "&"}]}],
       "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "create", " ", "an", " ", "association", " ", "of", " ", "mode", " ", 
     "coefficients", " ", "to", " ", "the", " ", "frequencies"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Omega]Guess", "=", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{"\[Omega]Coefficients", ",", 
       RowBox[{"\[Omega]Coefficients", ".", 
        RowBox[{"Keys", "[", "\[Omega]Known", "]"}]}]}], "]"}]}], 
    ";"}]}]}]], "Input",
