Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "return", " ", "only", " ", "a", " ", "section", " ", "of", " ", "the", 
     " ", "dataset", " ", "centered", " ", "around", " ", "the", " ", "max", 
     " ", "amplitude"}], ";", " ", 
    RowBox[{
    "helpful", " ", "for", " ", "eliminating", " ", "statistical", " ", 
     "noise", " ", "and", " ", "speeding", " ", "up", " ", "fitting"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ReduceDataset", "[", 
     RowBox[{"data_", ",", "rangeLimiter_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"maxInd", "=", 
         RowBox[{"First", "@", 
          RowBox[{"Ordering", "[", 
           RowBox[{
            RowBox[{"data", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "2"}], "]"}], "]"}], ",", 
            RowBox[{"-", "1"}]}], "]"}]}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"spanSteps", "=", 
         RowBox[{"Round", "[", 
          RowBox[{
           RowBox[{"N", "[", "rangeLimiter", "]"}], "/", 
           RowBox[{"(", 
            FractionBox[
             RowBox[{
              RowBox[{"data", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}], "-", 
              RowBox[{"data", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "1"}], "]"}], "]"}]}], 
             RowBox[{"Length", "[", "data", "]"}]], ")"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", "redIndStart", ",", "redIndStop"}], 
       "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"redIndStart", ",", "redIndStop"}], "}"}], "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Clip", "[", 
           RowBox[{"#", ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"Length", "[", "data", "]"}]}], "}"}]}], "]"}], "&"}], "/@", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"maxInd", "-", "spanSteps"}], ",", 
           RowBox[{"maxInd", "+", "spanSteps"}]}], "}"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{"data", "[", 
         RowBox[{"[", 
          RowBox[{"redIndStart", ";;", "redIndStop"}], "]"}], "]"}], "]"}], 
       ";"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
