Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "workaround", " ", "to", " ", "process", " ", "single", " ", "voltage", 
    " ", "sweep"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"If", "[", "\[IndentingNewLine]", 
