Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "do", " ", "a", " ", "complex", " ", "least", " ", "squares", " ", "fit", 
    " ", "to", " ", "the", " ", "data", " ", "and", " ", "extract", " ", 
    "the", " ", "voltage", " ", "minimum"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ExtractVoltageComplexFit", "[", "dataset_", "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"least", " ", "squares"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"lsqM", "=", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"ConstantArray", "[", 
             RowBox[{"1", ",", 
              RowBox[{"Length", "[", "dataset", "]"}]}], "]"}], ",", 
            RowBox[{"dataset", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "1"}], "]"}], "]"}]}], "}"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"lsqB", "=", 
         RowBox[{"dataset", "[", 
          RowBox[{"[", 
           RowBox[{";;", ",", "2"}], "]"}], "]"}]}], ",", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", "models", "*)"}], "\[IndentingNewLine]", "lsqConst", 
        ",", "\[IndentingNewLine]", "lsqSlope", ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"processed", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
        "voltageMinimum"}], "\[IndentingNewLine]", "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"do", " ", "least", " ", "squares", " ", "on", " ", "data"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"lsqConst", ",", "lsqSlope"}], "}"}], "=", 
        RowBox[{"LeastSquares", "[", 
         RowBox[{"lsqM", ",", "lsqB"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"extract", " ", "minimum", " ", "from", " ", "parameters"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"voltageMinimum", "=", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Re", "[", "lsqConst", "]"}], "*", 
             RowBox[{"Re", "[", "lsqSlope", "]"}]}], ")"}], "+", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Im", "[", "lsqConst", "]"}], "*", 
             RowBox[{"Im", "[", "lsqSlope", "]"}]}], ")"}]}], 
          SuperscriptBox[
           RowBox[{"Norm", "[", "lsqSlope", "]"}], "2"]]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "voltageMinimum", "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.8933059259279947`*^9, 3.893305936046115*^9}, {
