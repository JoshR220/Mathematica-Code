         FractionBox["rsb", "bsb"], " ", "ratio", " ", "array"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"sidebandRatio", "=", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"rsbData", "[", 
            RowBox[{"[", 
             RowBox[{";;", ",", "1"}], "]"}], "]"}], ",", 
