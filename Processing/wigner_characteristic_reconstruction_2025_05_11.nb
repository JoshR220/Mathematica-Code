Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "characteristic", " ", "function", " ", "for", " ", "the", " ", "ground", 
    " ", "state"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Chi]Squeezed", "[", 
     RowBox[{"x_", ",", "y_", ",", 
      RowBox[{"\[Sigma]_", ":", "1."}], ",", 
      RowBox[{"r_", ":", "0."}], ",", 
      RowBox[{"\[Theta]_", ":", "0.5"}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{"Exp", "[", 
        FractionBox[
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["#1", "2."], "+", 
            SuperscriptBox["#2", "2."]}], ")"}]}], 
         RowBox[{"2.", 
          SuperscriptBox["\[Sigma]", "2."]}]], "]"}]}], "&"}], "[", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Cosh", "[", "r", "]"}], "*", "x"}], "+", 
       RowBox[{
        RowBox[{"Sinh", "[", "r", "]"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"x", "*", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "+", 
          RowBox[{"y", "*", 
           RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], ")"}]}]}], ",", 
      RowBox[{"(*", 
       RowBox[{"x", " ", "-", " ", "squeezed"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Cosh", "[", "r", "]"}], "*", "x"}], "+", 
       RowBox[{
        RowBox[{"Sinh", "[", "r", "]"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"x", "*", 
           RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "-", 
          RowBox[{"y", "*", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}]}]}]}], 
     RowBox[{"(*", 
      RowBox[{"y", " ", "-", " ", "squeezed"}], "*)"}], "\[IndentingNewLine]",
      "]"}]}], ";"}]}]], "Input",
