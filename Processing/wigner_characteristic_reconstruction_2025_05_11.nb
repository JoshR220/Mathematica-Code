                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], "}"}]}], 
               "\[IndentingNewLine]", "]"}]}], "]"}]}]}], 
          "\[IndentingNewLine]", "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
