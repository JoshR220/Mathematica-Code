          RowBox[{"Print", "[", "r0eqArrFinal", "]"}], ";"}], "*)"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "format", " ", "equilibrium", " ", "positions", " ", "into", " ", 
          "usable", " ", "format"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"get", " ", "R0Mn"}], " ", "=", " ", 
          SuperscriptBox[
           RowBox[{"(", 
            SuperscriptBox["R", "ij"], ")"}], 
           RowBox[{"-", "1"}]]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"R0Mn", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"i", "==", "j"}], ",", "0", ",", "\[IndentingNewLine]", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"Norm", "[", 
                RowBox[{
                 RowBox[{"r0eqArrFinal", "[", 
                  RowBox[{"[", 
                   RowBox[{";;", ",", "i"}], "]"}], "]"}], " ", "-", " ", 
                 RowBox[{"r0eqArrFinal", "[", 
                  RowBox[{"[", 
                   RowBox[{";;", ",", "j"}], "]"}], "]"}]}], "]"}], ")"}], 
              RowBox[{"-", "1"}]]}], "\[IndentingNewLine]", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "numIons"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "numIons"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"get", " ", "L0Mn"}], " ", "=", " ", 
          SuperscriptBox[
           SubscriptBox["R", "\[Alpha]"], "ij"]}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"L0Mn", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
