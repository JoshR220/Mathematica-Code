90d4faecfd60"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"secular", " ", "frequency", " ", "calculations"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{
     "\[Omega]SecRadial", ",", "\[Omega]SecAxial", ",", "\[Omega]SecXYZ"}], 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Omega]SecRadial", "[", 
      RowBox[{"q_", ",", "a_", ",", "\[Beta]_"}], "]"}], ":=", 
     RowBox[{
      FractionBox["\[Beta]", "2."], "*", 
      RowBox[{"\[Beta]MathieuFunc", "[", 
       RowBox[{"q", ",", "a"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Omega]SecAxial", "[", 
      RowBox[{"a_", ",", "\[Beta]_"}], "]"}], ":=", 
     RowBox[{
      FractionBox["\[Beta]", "2."], "*", 
      RowBox[{"\[Beta]MathieuFunc", "[", 
       RowBox[{"0.", ",", 
        RowBox[{"2.", "a"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Omega]SecXYZ", "[", 
      RowBox[{"q_", ",", "ar_", ",", "az_", ",", "\[Beta]_"}], "]"}], ":=", 
     RowBox[{
      FractionBox["\[Beta]", "2."], "*", 
      RowBox[{"(", 
       RowBox[{"\[Beta]MathieuFunc", "@@@", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"q", ",", 
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{"az", "-", "ar"}], ")"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"q", ",", 
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{"az", "+", "ar"}], ")"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0.", ",", 
            RowBox[{"2.", "*", "az"}]}], "}"}]}], "}"}]}], ")"}]}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.889582364949794*^9, 3.889582497007784*^9}, {
  3.889583183927239*^9, 3.8895832071530867`*^9}, {3.8896297090107107`*^9, 
