Cell[CellGroupData[{

Cell["Motional Mode Calculation - 1", "Section",
 CellChangeTimes->{{3.896808816932506*^9, 3.896808816999442*^9}, {
  3.89682827598534*^9, 3.896828280826826*^9}, {3.9772648660636787`*^9, 
