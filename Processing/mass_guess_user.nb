                RowBox[{"numIons", ",", "numIons"}], "}"}]}], "]"}]}], 
            "\[IndentingNewLine]", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"iDim", ",", "3"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"jDim", ",", "3"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"calculate", " ", 
          SubscriptBox["B", "ij"]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"idMat", "=", 
         RowBox[{"Outer", "[", 
          RowBox[{"Times", ",", 
           RowBox[{"IdentityMatrix", "[", "3", "]"}], ",", 
           RowBox[{
            RowBox[{"ConstantArray", "[", 
             RowBox[{"1.", ",", 
              RowBox[{"{", 
               RowBox[{"numIons", ",", "numIons"}], "}"}]}], "]"}], "-", 
            RowBox[{"IdentityMatrix", "[", "numIons", "]"}]}], ",", "2", ",", 
           "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"L0Mn2", "=", 
         RowBox[{"Outer", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             SuperscriptBox["R0Mn", "2"], "*", "#1", "*", "#2"}], "&"}], ",", 
           "L0Mn", ",", "L0Mn", ",", "1"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"L0MnMix", "=", 
         RowBox[{"Map", "[", 
