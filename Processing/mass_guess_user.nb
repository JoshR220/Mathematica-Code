Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"base", " ", "motional", " ", "mode", " ", "calculation"}], "*)"}],
   "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "MotionalModes", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"MotionalModes", "[", 
      RowBox[{"mArr_List", ",", "xyzFreq_List", ",", 
       RowBox[{"\[Lambda]3_", ":", "0.0"}], ",", 
       RowBox[{"\[Lambda]4_", ":", "0.0"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"chainFreq", "=", 
          RowBox[{"Transpose", "[", "xyzFreq", "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"numIons", "=", 
          RowBox[{"Length", "[", "mArr", "]"}]}], ",", "\[IndentingNewLine]", 
         
         RowBox[{"scaleArr", "=", 
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{"mArr", ",", 
              FractionBox["1", "mArr"]}], "]"}], "]"}], "*", 
           RowBox[{"(", 
            SuperscriptBox[
             RowBox[{"xyzFreq", "[", 
              RowBox[{"[", 
               RowBox[{";;", ",", "3"}], "]"}], "]"}], "2"], ")"}]}]}], ",", 
         "\[IndentingNewLine]", "z0eq", ",", "z0eqArr", ",", 
         "\[IndentingNewLine]", "L0EQlist", ",", "guessz0eq", ",", "L0Mn", 
         ",", "L0MnMat", ",", "\[IndentingNewLine]", "VMatX", ",", "VMatY", 
         ",", "VMatZ"}], "\[IndentingNewLine]", "}"}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "set", " ", "up", " ", "objects", " ", "for", " ", "equilibrium", " ",
          "positions"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"z0eqArr", " ", "=", " ", 
         RowBox[{"Array", "[", 
          RowBox[{"z0eq", ",", "numIons"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"L0EQlist", "=", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"z0eqArr", "[", 
               RowBox[{"[", "#", "]"}], "]"}], "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1.5", "*", "\[Lambda]3"}], ")"}], "*", 
               SuperscriptBox[
                RowBox[{"z0eqArr", "[", 
                 RowBox[{"[", "#", "]"}], "]"}], "2"]}], "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"2.", "*", "\[Lambda]4"}], ")"}], "*", 
               SuperscriptBox[
                RowBox[{"z0eqArr", "[", 
                 RowBox[{"[", "#", "]"}], "]"}], "3"]}]}], ")"}], "\[Equal]", 
            
            RowBox[{"(", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Sum", "[", 
               RowBox[{
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"z0eqArr", "[", 
                    RowBox[{"[", "#", "]"}], "]"}], " ", "-", " ", 
                   RowBox[{"z0eqArr", "[", 
                    RowBox[{"[", "k", "]"}], "]"}]}], ")"}], 
                 RowBox[{"-", "2"}]], ",", 
                RowBox[{"{", 
                 RowBox[{"k", ",", "1", ",", 
                  RowBox[{"#", "-", "1"}]}], "}"}]}], "]"}], " ", 
              "\[IndentingNewLine]", "-", " ", 
              RowBox[{"Sum", "[", 
               RowBox[{
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"z0eqArr", "[", 
                    RowBox[{"[", "#", "]"}], "]"}], " ", "-", " ", 
                   RowBox[{"z0eqArr", "[", 
                    RowBox[{"[", "k", "]"}], "]"}]}], ")"}], 
                 RowBox[{"-", "2"}]], ",", 
                RowBox[{"{", 
                 RowBox[{"k", ",", " ", 
                  RowBox[{"#", "+", "1"}], ",", "numIons"}], "}"}]}], "]"}]}],
              "\[IndentingNewLine]", ")"}]}], "&"}], "/@", 
          RowBox[{"Range", "[", "numIons", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "guess", " ", "axial", " ", "equilibrium", " ", "positions"}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"guessz0eq", "=", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{
              RowBox[{"-", "#"}], ",", "#", ",", 
              FractionBox[
               RowBox[{"2", "*", "#"}], 
               RowBox[{"(", 
                RowBox[{"numIons", "-", "1"}], ")"}]]}], "]"}], "&"}], "[", 
           SuperscriptBox["numIons", 
            RowBox[{"(", 
             RowBox[{"1", "/", "3"}], ")"}]], "]"}], "//", "N"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"guessz0eq", "=", 
         RowBox[{"Transpose", "[", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"{", "z0eqArr", "}"}], ",", 
            RowBox[{"{", "guessz0eq", "}"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"z0eqArr", "=", 
         RowBox[{"z0eqArr", "/.", 
          RowBox[{"Chop", "[", 
           RowBox[{"FindRoot", "[", 
            RowBox[{"L0EQlist", ",", "guessz0eq"}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "format", " ", "axial", " ", "equilibrium", " ", "positions", " ", 
          "into", " ", "usable", " ", "format"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"L0Mn", "=", 
         RowBox[{"Abs", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"i", "==", "j"}], ",", "0", ",", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"z0eqArr", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "-", 
                 RowBox[{"z0eqArr", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}], ")"}], 
               RowBox[{"-", "3"}]]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "numIons"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "numIons"}], "}"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"L0MnMat", "=", 
         RowBox[{
          RowBox[{"DiagonalMatrix", "[", 
           RowBox[{"Total", "[", 
            RowBox[{"L0Mn", ",", 
             RowBox[{"{", "2", "}"}]}], "]"}], "]"}], "-", "L0Mn"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"extract", " ", "secular", " ", "frequencies"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"VMatZ", "=", 
         RowBox[{"scaleArr", "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"DiagonalMatrix", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "+", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"3.", "*", "\[Lambda]3"}], ")"}], "*", "#"}], "+", 
                 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"6.", "*", "\[Lambda]4"}], ")"}], "*", 
                  SuperscriptBox["#", "2"]}]}], ")"}], "&"}], "/@", 
              "z0eqArr"}], "]"}], "+", 
            RowBox[{"2", "*", "L0MnMat"}]}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"VMatY", "=", 
         RowBox[{"scaleArr", "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"DiagonalMatrix", "[", 
             SuperscriptBox[
              RowBox[{"(", 
               FractionBox[
                RowBox[{"chainFreq", "[", 
                 RowBox[{"[", 
                  RowBox[{"2", ",", ";;"}], "]"}], "]"}], 
                RowBox[{"chainFreq", "[", 
                 RowBox[{"[", 
                  RowBox[{"3", ",", ";;"}], "]"}], "]"}]], ")"}], "2"], "]"}],
             "-", "L0MnMat"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"VMatX", "=", 
         RowBox[{"scaleArr", "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"DiagonalMatrix", "[", 
             SuperscriptBox[
              RowBox[{"(", 
               FractionBox[
                RowBox[{"chainFreq", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", ";;"}], "]"}], "]"}], 
                RowBox[{"chainFreq", "[", 
                 RowBox[{"[", 
                  RowBox[{"3", ",", ";;"}], "]"}], "]"}]], ")"}], "2"], "]"}],
             "-", "L0MnMat"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "return", " ", "secular", " ", "frequencies", " ", "in", " ", 
          "usable", " ", "form"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{";;", ",", "1"}], "]"}], "]"}], "]"}], ",", 
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "2"}], "]"}], "]"}]}], "}"}], "&"}], "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Eigensystem", "[", "VMatX", "]"}], ",", 
           RowBox[{"Eigensystem", "[", "VMatY", "]"}], ",", 
           RowBox[{"Eigensystem", "[", "VMatZ", "]"}]}], "}"}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.896663786690157*^9, 3.8966638032147217`*^9}, 
   3.896664036694713*^9, {3.896664136804324*^9, 3.896664221971251*^9}, {
