              RowBox[{"ordD", ",", "ordAQ"}], "]"}]}], ",", 
            "\[IndentingNewLine]", "\[Beta]", ",", "\[IndentingNewLine]", 
            "PositiveReals"}], "\[IndentingNewLine]", "]"}]}]}]}], 
       "\[IndentingNewLine]", "]"}], "[", 
