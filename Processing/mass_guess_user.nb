Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"convenience", " ", "solver", " ", 
     RowBox[{"function", ":", " ", 
      RowBox[{
      "solves", " ", "mathieu", " ", "analytically", " ", "up", " ", "to", 
       " ", "order", " ", "ordD", " ", "in", " ", "the", " ", "D", " ", 
       "matrix"}]}]}], ",", " ", 
