            RowBox[{"3", ",", "numIons"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"guessr0eq", "=", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0.", ",", 
             RowBox[{"{", 
              RowBox[{"2", ",", "numIons"}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{
               RowBox[{"-", "1."}], ",", "1.", ",", 
               FractionBox["2.", 
                RowBox[{"(", 
                 RowBox[{"numIons", "-", "1."}], ")"}]]}], "]"}], "*", 
             SuperscriptBox["numIons", 
              RowBox[{"(", 
               FractionBox["1.", "3."], ")"}]]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"guessr0eq", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"r0eqArr", ",", "guessr0eq"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"2", ",", "3"}], "}"}], ",", 
             RowBox[{"{", "1", "}"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "set", " ", "up", " ", "force", " ", "balancing", " ", "equations", 
          " ", "for", " ", "equilibrium", " ", "positions"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"L0EQlist", "=", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"r0eqArr", "[", 
              RowBox[{"[", 
               RowBox[{"dim", ",", "ion"}], "]"}], "]"}], ")"}], "\[Equal]", 
            RowBox[{
             RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                FractionBox[
                 RowBox[{"chainFreq", "[", 
                  RowBox[{"[", 
                   RowBox[{"3", ",", "ion"}], "]"}], "]"}], 
                 RowBox[{"chainFreq", "[", 
                  RowBox[{"[", 
                   RowBox[{"dim", ",", "ion"}], "]"}], "]"}]], ")"}], "2"], 
              "*", 
              RowBox[{"(", 
               RowBox[{"Sum", "[", 
                RowBox[{
                 FractionBox[
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"r0eqArr", "[", 
                    RowBox[{"[", 
                    RowBox[{"dim", ",", "ion"}], "]"}], "]"}], " ", "-", " ", 
                    
                    RowBox[{"r0eqArr", "[", 
                    RowBox[{"[", 
                    RowBox[{"dim", ",", "k"}], "]"}], "]"}]}], ")"}], 
                  SuperscriptBox[
                   RowBox[{"(", 
                    RowBox[{"Norm", "[", 
                    RowBox[{
                    RowBox[{"r0eqArr", "[", 
                    RowBox[{"[", 
                    RowBox[{";;", ",", "ion"}], "]"}], "]"}], " ", "-", " ", 
                    RowBox[{"r0eqArr", "[", 
                    RowBox[{"[", 
                    RowBox[{";;", ",", "k"}], "]"}], "]"}]}], "]"}], ")"}], 
                   "3"]], ",", 
                 RowBox[{"{", 
                  RowBox[{"k", ",", 
                   RowBox[{"Delete", "[", 
                    RowBox[{
                    RowBox[{"Range", "[", "numIons", "]"}], ",", "ion"}], 
                    "]"}]}], "}"}]}], "]"}], " ", ")"}]}], 
             "\[IndentingNewLine]", "+", 
             RowBox[{
              FractionBox["qe", 
               RowBox[{"l0", "*", "amu"}]], "*", 
              FractionBox[
               RowBox[{"offsetArr", "[", 
                RowBox[{"[", "dim", "]"}], "]"}], 
               RowBox[{
                RowBox[{"mArr", "[", 
                 RowBox[{"[", "ion", "]"}], "]"}], "*", 
                SuperscriptBox[
                 RowBox[{"chainFreq", "[", 
                  RowBox[{"[", 
                   RowBox[{"dim", ",", "ion"}], "]"}], "]"}], "2"]}]]}]}]}], 
           ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"dim", ",", "3"}], "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"ion", ",", "numIons"}], "}"}]}], "\[IndentingNewLine]", 
          "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"guess", " ", "equilibrium", " ", "positions"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"r0eqArrFinal", "=", 
         RowBox[{"r0eqArr", "/.", 
          RowBox[{"Chop", "[", 
           RowBox[{"FindRoot", "[", 
            RowBox[{
             RowBox[{"Flatten", "[", "L0EQlist", "]"}], ",", "guessr0eq"}], 
            "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"r0eqArrFinal", "=", 
           RowBox[{"Transpose", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"#", "-", "offsetArr"}], ")"}], "&"}], "/@", 
             RowBox[{"Transpose", "[", "r0eqArrFinal", "]"}]}], "]"}]}], 
          ";"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"(*", 
