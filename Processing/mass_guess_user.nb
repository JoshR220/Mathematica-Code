Cell["Create Secular Frequency Functions for Arb. Mathieu Order", "Section",
 CellChangeTimes->{{3.896671281701329*^9, 3.89667129609478*^9}, {
  3.896828270465576*^9, 3.896828273727934*^9}, {3.977288461145687*^9, 
