             RowBox[{"{", "4", "}"}]}], "]"}], ",", 
           RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"L0MnFinal", "=", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "*", "scaleArr"}], "&"}], ",", 
           RowBox[{"L0MnSelf", "+", "L0MnMix", "+", "trapFreqMat"}], ",", 
