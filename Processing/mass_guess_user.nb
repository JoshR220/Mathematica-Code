 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "recursion", " ", "functions", " ", "to", " ", "define", " ", "mathieu", 
    " ", "equations"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{"D2n", ",", "recur"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"D2n", "[", "n_", "]"}], ":=", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", "q", ",", "\[Beta]"}], "}"}], ",", 
       FractionBox[
        RowBox[{"a", "-", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "*", "n"}], "-", "\[Beta]"}], ")"}], "2"]}], "q"]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"recur", "[", 
      RowBox[{"i_Integer", ",", "stop_Integer", ",", 
       RowBox[{"dir", ":", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "|", "1"}], ")"}]}]}], "]"}], ":=", 
     FractionBox["1", 
      RowBox[{
       RowBox[{"D2n", "[", 
        RowBox[{"i", "*", "dir"}], "]"}], "-", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"i", "\[GreaterEqual]", "stop"}], ",", "0", ",", 
         RowBox[{"recur", "[", 
          RowBox[{
           RowBox[{"i", "+", "1"}], ",", "stop", ",", "dir"}], "]"}]}], 
        "]"}]}]]}], ";"}]}]}]], "Input",
