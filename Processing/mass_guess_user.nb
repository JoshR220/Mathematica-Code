            RowBox[{"a", "-", 
             RowBox[{"q", "*", 
              RowBox[{"(", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"recur", "[", 
                 RowBox[{"1", ",", 
                  RowBox[{"ordD", "+", "1"}], ",", "1"}], "]"}], "+", 
                RowBox[{"recur", "[", 
                 RowBox[{"1", ",", 
                  RowBox[{"ordD", "+", "1"}], ",", 
                  RowBox[{"-", "1"}]}], "]"}]}], "\[IndentingNewLine]", 
               RowBox[{"(*", 
                RowBox[{"expand", " ", 
                 RowBox[{"{", 
                  RowBox[{"a", ",", "q", ",", "\[Beta]"}], "}"}], " ", 
                 "perturbatively"}], "*)"}], "\[IndentingNewLine]", ")"}]}]}],
             "/.", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"a", "\[Rule]", 
               RowBox[{"\[Epsilon]", "*", "a"}]}], ",", 
              RowBox[{"q", "->", 
               RowBox[{"\[Epsilon]", "*", "q"}]}], ",", 
              RowBox[{"\[Beta]", "\[Rule]", 
               RowBox[{"\[Epsilon]", "*", "\[Beta]"}]}]}], "}"}]}], ",", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
            "expand", " ", "the", " ", "series", " ", "in", " ", "\[Epsilon]",
              " ", "from", " ", 
             RowBox[{"orders", " ", "[", 
              RowBox[{"0", ",", 
               RowBox[{"ordAQ", "+", "1"}]}], "]"}]}], "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"\[Epsilon]", ",", "0", ",", 
             RowBox[{"ordAQ", "+", "1"}]}], "}"}]}], "\[IndentingNewLine]", 
          "]"}], "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"reduce", " ", "perturbation", " ", "terms"}], "*)"}], 
         "\[IndentingNewLine]", "]"}], "/.", 
        RowBox[{"{", 
         RowBox[{"\[Epsilon]", "\[Rule]", "1"}], "}"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}]}]}]], "Input",
