          RowBox[{";;", ",", "3"}], "]"}], "]"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"0", "|", "0."}], ")"}], "->", "0.01"}], "}"}]}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"dsR", "=", 
       RowBox[{"Transpose", "[", 
