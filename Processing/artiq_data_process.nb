            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "<", "freqCenter"}], "&"}]}], 
         "]"}], "[", 
        RowBox[{"[", 
         RowBox[{";;", ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"dsB", "=", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{"datasetProcessed", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ">=", "freqCenter"}], "&"}]}], 
         "]"}], "[", 
        RowBox[{"[", 
         RowBox[{";;", ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"dsR", ",", "dsB"}], "}"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{"CollateDataSimple", "[", 
          RowBox[{"#", ",", 
           RowBox[{"{", "1", "}"}]}], "]"}], "&"}], "/@", 
        RowBox[{"{", 
         RowBox[{"dsR", ",", "dsB"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"(*", 
       RowBox[{
       "replace", " ", "0", " ", "uncertainties", " ", "with", " ", "some", 
        " ", "minimum", " ", "value", " ", "then", " ", "convert", " ", "to", 
        " ", "Around"}], "*)"}], "\[IndentingNewLine]", "\t", 
