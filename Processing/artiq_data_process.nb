Cell[CellGroupData[{

Cell["Group In Small Batches", "Subsection",
 CellChangeTimes->{{3.953144364726475*^9, 
  3.9531443711748123`*^9}},ExpressionUUID->"f47678e2-7406-432f-bc33-\
34e59d77e454"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"process", " ", "data", " ", "in", " ", "fixed", " ", "batches"}],
     " ", "-", " ", 
    RowBox[{"separately", " ", "process", " ", 
     RowBox[{"freq", "/", "phase"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"KKFunc", "[", 
     RowBox[{"data_", ",", "batchSize_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"freqDiff", "=", 
         RowBox[{"Mean", "[", 
          RowBox[{"data", "[", 
           RowBox[{"[", 
            RowBox[{";;", ",", "1"}], "]"}], "]"}], "]"}]}], ",", 
        "\[IndentingNewLine]", "sc1", ",", "scR", ",", "scB", ",", "scR2", 
        ",", "scB2"}], "\[IndentingNewLine]", "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"sc1", "=", 
        RowBox[{"GroupBy", "[", 
         RowBox[{"data", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "<", "freqDiff"}], "&"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"scR", "=", 
        RowBox[{"sc1", "[", "True", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"scB", "=", 
        RowBox[{"sc1", "[", "False", "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"scR2", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Mean", "/@", 
           RowBox[{"ArrayReshape", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"scR", "[", 
              RowBox[{"[", 
               RowBox[{";;", 
                RowBox[{
                 RowBox[{"IntegerPart", "[", 
                  RowBox[{
                   RowBox[{"Length", "[", "scR", "]"}], "/", "batchSize"}], 
                  "]"}], "*", "batchSize"}]}], "]"}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"IntegerPart", "[", 
                RowBox[{
                 RowBox[{"Length", "[", "scR", "]"}], "/", "batchSize"}], 
                "]"}], ",", "batchSize", ",", 
               RowBox[{
                RowBox[{"Dimensions", "[", "scR", "]"}], "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], 
            "\[IndentingNewLine]", "]"}]}], ")"}], "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", "4"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"scB2", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Mean", "/@", 
           RowBox[{"ArrayReshape", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"scB", "[", 
              RowBox[{"[", 
               RowBox[{";;", 
                RowBox[{
                 RowBox[{"IntegerPart", "[", 
                  RowBox[{
                   RowBox[{"Length", "[", "scB", "]"}], "/", "batchSize"}], 
                  "]"}], "*", "batchSize"}]}], "]"}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"IntegerPart", "[", 
                RowBox[{
                 RowBox[{"Length", "[", "scB", "]"}], "/", "batchSize"}], 
                "]"}], ",", "batchSize", ",", 
               RowBox[{
                RowBox[{"Dimensions", "[", "scB", "]"}], "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], 
            "\[IndentingNewLine]", "]"}]}], ")"}], "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", "4"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{"Mean", "@", 
         RowBox[{"(", 
          RowBox[{"CoherentC", "[", 
           RowBox[{"scR2", "/", 
            RowBox[{"(", 
             RowBox[{"scB2", "+", "1.*^-7"}], ")"}]}], "]"}], ")"}]}], "]"}], 
       ";"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.9530921126484375`*^9, 3.953092207982286*^9}, {
  3.953141741808487*^9, 
  3.953141755911048*^9}},ExpressionUUID->"eca5e391-e1b9-423e-bb98-\
6c75273fa030"],

