Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"implement", " ", "threshold", " ", 
    RowBox[{"counts", "!"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ThresholdCounts", "[", 
     RowBox[{"dataset_List", ",", "countsColumn_Integer", ",", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"results", "=", "dataset"}], ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "find", " ", "state", " ", "discrimination", " ", "threshold"}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"countThreshold", "=", 
         RowBox[{"If", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"OptionValue", "[", "\"\<Threshold\>\"", "]"}], "!=", 
            RowBox[{"-", "1"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"OptionValue", "[", "\"\<Threshold\>\"", "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"FindThreshold", "[", 
            RowBox[{
             RowBox[{"dataset", "[", 
              RowBox[{"[", 
               RowBox[{";;", ",", "countsColumn"}], "]"}], "]"}], ",", 
             RowBox[{"Method", "->", "\"\<MinimumError\>\""}]}], "]"}]}], 
          "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "}"}], ",",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
