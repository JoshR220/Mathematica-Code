Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"implement", " ", "collate", " ", "data"}], " ", "-", " ", 
    RowBox[{"simple", "!"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "CollateDataSimple", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"CollateDataSimple", "[", 
      RowBox[{"dataset_List", ",", "groupColumnList_List"}], "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"procFuncDJ", ",", "dsDJ"}], "}"}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "organize", " ", "data", " ", "by", " ", "sweep", " ", "column", 
         RowBox[{"(", "s", ")"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"procFuncDJ", "[", "data_", "]"}], ":=", "data"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"dsDJ", "=", 
         RowBox[{"CollateData", "[", "\[IndentingNewLine]", 
          RowBox[{
          "dataset", ",", "\[IndentingNewLine]", "groupColumnList", ",", 
           "\[IndentingNewLine]", 
           RowBox[{"\"\<ProcessFunction\>\"", "->", "procFuncDJ"}]}], 
          "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"(*", 
          RowBox[{
          "replace", " ", "0", " ", "uncertainty", " ", "with", " ", "0.01"}],
           "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"dsDJ", "[", 
            RowBox[{"[", 
             RowBox[{";;", ",", "3"}], "]"}], "]"}], "=", 
           RowBox[{
            RowBox[{"dsDJ", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "3"}], "]"}], "]"}], "/.", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"0", "|", "0."}], ")"}], "->", "0.01"}], "}"}]}]}], 
          ";"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"Return", "[", 
