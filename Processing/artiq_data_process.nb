          RowBox[{"Around", "@@@", 
           RowBox[{"dsR", "[", 
            RowBox[{"[", 
             RowBox[{";;", ",", 
              RowBox[{"{", 
               RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "]"}]}]}], "}"}], 
