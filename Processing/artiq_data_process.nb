       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Omega]", "*", "1.", "*", "\[Pi]"}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{"t", "-", "t0"}], ")"}]}], "]"}]}], "+", "COff"}]}], ";"}], 
