  RowBox[{
   RowBox[{
    RowBox[{"\[Chi]Squeezed", "[", 
     RowBox[{"x_", ",", "y_", ",", 
      RowBox[{"\[Sigma]_", ":", "1."}], ",", 
      RowBox[{"r_", ":", "0."}], ",", 
      RowBox[{"\[Theta]_", ":", "0.5"}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{"Exp", "[", 
