Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"sort", " ", "images", " ", "by", " ", "groupstring"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"kinoImages", "=", 
     RowBox[{
      RowBox[{"AssociationThread", "[", 
       RowBox[{"kinoProcStr", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Import", "[", "#", "]"}], "&"}], "/@", "kinoFileStr"}]}], 
       "]"}], "//", "KeySort"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "set", " ", "image", " ", "times", " ", "by", " ", "groupstring", " ", 
     "distances"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"imgTimes", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"normalizedFrameTime", "*", 
        RowBox[{"(", 
         FractionBox[
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"2", ";;", 
              RowBox[{"-", "1"}]}], "]"}], "]"}], "-", 
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"1", ";;", 
              RowBox[{"-", "2"}]}], "]"}], "]"}]}], 
          RowBox[{"Max", "[", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"2", ";;", 
               RowBox[{"-", "1"}]}], "]"}], "]"}], "-", 
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"1", ";;", 
               RowBox[{"-", "2"}]}], "]"}], "]"}]}], "]"}]], ")"}]}], "&"}], 
      "[", 
      RowBox[{"Keys", "[", "kinoImages", "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"imgTimes", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"imgTimes", ",", 
       RowBox[{"{", 
        RowBox[{"2", "*", "normalizedFrameTime"}], "}"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
