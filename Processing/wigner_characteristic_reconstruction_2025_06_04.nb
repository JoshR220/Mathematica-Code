           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "&"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"i", ",", "groupColumnList"}], "}"}]}], 
        "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"N", "[", 
         RowBox[{"Mean", "[", "#", "]"}], "]"}], "&"}]}], 
      "\[IndentingNewLine]", "]"}], "//", "KeySort"}]}], ";"}]}]], "Input",
