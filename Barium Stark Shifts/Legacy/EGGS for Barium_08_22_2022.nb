          RowBox[{"\[Pi]", "/", 
           RowBox[{"Keys", "[", 
            RowBox[{"Heff", "[", "HDJ", "]"}], "]"}]}], "/", "nm"}]}], "//", 
        "Sort"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"calculate", " ", "stark", " ", "shifts"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"HeffDJ", "=", 
     RowBox[{"Heff", "[", "HDJint", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"HeffSS", "=", 
     RowBox[{"Heff0", "[", "HeffDJ", "]"}]}], ";"}]}]}]], "Input",
