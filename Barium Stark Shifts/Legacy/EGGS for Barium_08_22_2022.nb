   RowBox[{"take", " ", "to", " ", "interaction", " ", "picture"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"HDJint", "=", 
     RowBox[{"ToIntPic", "[", 
      RowBox[{"HDJ", ",", "U0"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
