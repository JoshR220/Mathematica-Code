Cell[BoxData[
 RowBox[{
  RowBox[{"HeffEx", "[", "Heff1_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ind", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Tuples", "[", 
          RowBox[{"{", 
           RowBox[{"#", ",", "#"}], "}"}], "]"}], "&"}], "[", 
        RowBox[{"Range", "[", 
         RowBox[{"Length", "[", "Heff1", "]"}], "]"}], "]"}]}], ",", 
      RowBox[{"wm", "=", 
       RowBox[{"Keys", "[", "Heff1", "]"}]}], ",", 
      RowBox[{"hm", "=", 
       RowBox[{"Values", "[", "Heff1", "]"}]}], ",", "Hmn", ",", "Hres"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"Hmn", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
