Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveSchrodinger", "[", 
    RowBox[{"H_", ",", "initialstate_", ",", "t1_", ",", "t2_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"Dispatch", "[", 
      RowBox[{"First", "@", 
       RowBox[{"NDSolve", "[", 
        RowBox[{"#", ",", "\[Psi]BasisTOT", ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "t1", ",", "t2"}], "}"}], ",", 
         RowBox[{"MaxSteps", "\[Rule]", "\[Infinity]"}], ",", 
         RowBox[{"Method", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"\"\<StiffnessSwitching\>\"", ",", 
            RowBox[{"Method", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"Automatic", ",", "Automatic"}], "}"}]}], ",", 
            RowBox[{
            "\"\<EquationSimplification\>\"", "\[Rule]", "\"\<Solve\>\""}]}], 
           "}"}]}]}], "]"}]}], "]"}], "&"}], "[", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Psi]BasisTOT", "/.", 
          RowBox[{"{", 
           RowBox[{"t", "\[Rule]", "t1"}], "}"}]}], ")"}], "\[Equal]", 
        "initialstate"}], "]"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Thread", "[", 
         RowBox[{
          RowBox[{"\[Psi]diff", "+", 
           RowBox[{
            FractionBox["\[ImaginaryI]", "\[HBar]"], "*", 
            RowBox[{"(", "#", ")"}]}]}], "\[Equal]", "0"}], "]"}], "&"}], "[", 
       RowBox[{"H", ".", "\[Psi]BasisTOT"}], "]"}]}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.8305488764938307`*^9, 3.83054888358689*^9}, 
   3.830548948225078*^9, {3.830549072548839*^9, 3.8305491240920067`*^9}, {
   3.8305494186527987`*^9, 3.8305494288513947`*^9}, {3.830549787189258*^9, 
