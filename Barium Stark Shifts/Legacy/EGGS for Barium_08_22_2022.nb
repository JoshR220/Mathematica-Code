Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "remove", " ", "negligible", " ", "eigenvector", " ", "component", " ", 
    "values"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Delta]Eigenvec", "=", 
