Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Heff", "[", "Ham_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"arrayrules", "=", 
        RowBox[{"Expand", "[", 
         RowBox[{
          RowBox[{"ArrayRules", "[", 
           RowBox[{"SparseArray", "[", "Ham", "]"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{";;", 
            RowBox[{"-", "2"}]}], "]"}], "]"}], "]"}]}], ",", 
       RowBox[{"arraydim", "=", 
        RowBox[{"Dimensions", "[", "Ham", "]"}]}], ",", "\[IndentingNewLine]",
        "ind", ",", " ", "expr", ",", " ", "vals", ",", " ", 
       "coefficientsArr", ",", "exponentsArr", ",", "uniqueExponents", ",", 
       "coefficientsArrPositions", ",", "hcoeffArr", ",", "hcoeffPos", ",", 
       "hMatArr", ",", "hMatArr2"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "split", " ", "index", " ", "from", " ", "values", " ", "and", " ", 
       "get", " ", "each", " ", "element", " ", "of", " ", "sum", " ", 
       "separately"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ind", "=", 
       RowBox[{"arrayrules", "[", 
        RowBox[{"[", 
         RowBox[{";;", ",", "1"}], "]"}], "]"}]}], ";", 
      RowBox[{"expr", "=", 
       RowBox[{
        RowBox[{"arrayrules", "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", "2"}], "]"}], "]"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x_", "+", "0."}], "\[RuleDelayed]", "x"}], "}"}]}]}], ";", 
      
      RowBox[{"vals", "=", 
       RowBox[{"List", "@@@", "expr"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "separate", " ", "coefficients", " ", "from", " ", "exponent"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"coefficientsArr", "=", 
       RowBox[{"vals", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x_", "*", 
           RowBox[{"\[ExponentialE]", "^", 
            RowBox[{"(", "__", ")"}]}]}], "\[RuleDelayed]", "x"}], "}"}]}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"exponentsArr", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Exponent", "[", 
          RowBox[{"#", ",", "\[ExponentialE]"}], "]"}], "&"}], "/@", 
        "vals"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "then", " ", "strip", " ", "zeros", " ", "and", " ", "t", " ", "from", 
        " ", "exponent"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"exponentsArr", "=", 
       RowBox[{"Re", "[", 
        RowBox[{"exponentsArr", "/.", 
         RowBox[{"{", 
          RowBox[{"t", "\[Rule]", 
           RowBox[{"-", "\[ImaginaryI]"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "make", " ", "exponent", " ", "same", " ", "precision", " ", "as", " ",
         "later", " ", "exp"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"exponentsArr", "=", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{"exponentsArr", ",", "9"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"get", " ", "unique", " ", "exponents"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"uniqueExponents", "=", 
       RowBox[{
        RowBox[{"DeleteDuplicates", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{"Flatten", "[", "exponentsArr", "]"}], "]"}], "]"}], "//", 
        "Sort"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "get", " ", "coefficient", " ", "positions", " ", "for", " ", "each", 
        " ", "unique", " ", "exponent"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"coefficientsArrPositions", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{"exponentsArr", ",", "#"}], "]"}], "&"}], "/@", 
        "uniqueExponents"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"get", " ", "coefficients"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"hcoeffArr", "=", 
       RowBox[{"Apply", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"coefficientsArr", "[", 
           RowBox[{"[", "##", "]"}], "]"}], "&"}], ",", 
         "coefficientsArrPositions", ",", 
         RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"get", " ", "positions"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"hcoeffPos", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"ind", "[", 
          RowBox[{"[", 
           RowBox[{"#", ",", ";;"}], "]"}], "]"}], "&"}], "/@", 
        RowBox[{"coefficientsArrPositions", "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", ";;", ",", "1"}], "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "create", " ", "matrix", " ", "for", " ", "each", " ", "unique", " ", 
        "exponent"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"hMatArr", "=", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"SparseArray", "[", 
           RowBox[{
            RowBox[{"#1", "\[Rule]", "#2"}], ",", "arraydim"}], "]"}], "&"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"hcoeffPos", ",", "hcoeffArr"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{"AssociationThread", "[", 
        RowBox[{"uniqueExponents", "->", "hMatArr"}], "]"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.850962371601091*^9, {3.850962445440716*^9, 3.850962451748048*^9}, {
   3.850962489761401*^9, 3.850962550962253*^9}, 3.8509631259528723`*^9, {
