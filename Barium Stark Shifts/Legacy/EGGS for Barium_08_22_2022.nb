Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"remove", " ", "negligible", " ", "eigenvalues"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"todo", ":", " ", 
    RowBox[{"allow", " ", "customizable", " ", "cutoff"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
