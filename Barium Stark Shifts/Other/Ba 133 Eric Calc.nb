  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Efield", "[", 
      RowBox[{"Int_", ",", "\[Theta]_", ",", "\[Omega]_"}], "]"}], " ", ":=", 
     " ", 
     RowBox[{"(", " ", 
      RowBox[{
       RowBox[{"Emag", " ", "=", " ", 
        SqrtBox[
         FractionBox[
          RowBox[{"2", " ", "Int"}], 
          RowBox[{"\[Epsilon]o", " ", "c"}]]]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Ex", " ", "=", " ", 
        RowBox[{"Emag", " ", 
         RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Ey", " ", "=", " ", "0"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Ez", " ", "=", " ", 
        RowBox[{"Emag", " ", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"E\[Sigma]m", " ", "=", " ", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["1", 
           SqrtBox["2"]]}], 
         RowBox[{"(", 
          RowBox[{"Ex", " ", "+", " ", 
           RowBox[{"\[ImaginaryI]", " ", "Ey"}]}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"E\[Pi]", " ", "=", " ", "Ez"}], ";", "\[IndentingNewLine]", 
       RowBox[{"E\[Sigma]p", " ", "=", 
        RowBox[{
         FractionBox["1", 
          SqrtBox["2"]], 
         RowBox[{"(", 
          RowBox[{"Ex", " ", "-", " ", 
           RowBox[{"\[ImaginaryI]", " ", "Ey"}]}], ")"}]}]}], " ", ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{
         "E\[Sigma]m", ",", "E\[Pi]", ",", "E\[Sigma]p", ",", "\[Omega]"}], 
         "}"}], "]"}], ";"}], "\[IndentingNewLine]", ")"}]}], ";"}], 
