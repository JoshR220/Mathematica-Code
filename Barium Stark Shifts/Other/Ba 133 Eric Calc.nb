Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Now", " ", "define", " ", "dipole", " ", "moment", " ", "between", " ", 
    "hyperfine", " ", "states"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Then", " ", "hyperfine", " ", "basis", " ", "dipoles", " ", 
    RowBox[{"are", ":"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"dreducedHyperfine", "[", 
     RowBox[{"Jp_", ",", "Fp_", ",", "J_", ",", "F_", ",", "dreducedJ_"}], 
     "]"}], ":=", " ", 
    RowBox[{"dreducedJ", " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{"Fp", "+", "J", "+", "1", "+", 
       RowBox[{"1", "/", "2"}]}]], 
     SqrtBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "Fp"}], "+", "1"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "J"}], "+", "1"}], ")"}]}]], 
     RowBox[{"SixJSymbol", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"J", ",", "Jp", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Fp", ",", "F", ",", 
         RowBox[{"1", "/", "2"}]}], "}"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"dreducedHyperfine", "::", "usage"}], " ", "=", " ", 
     "\"\< dreducedHyperfine[Jp,Fp,J,F,dreducedJ] gives the reduced matrix \
element of the transition dipole moment in the hyperfine basis. Jp & Fp are \
the excited state quantum numbers. J & F are the ground state. dreducedJ is \
the reduced matrix element in the J basis, which is found by solving \
\!\(\*FractionBox[\(1\), \(4  \[Pi]\\\ \
\[Epsilon]o\)]\)\!\(\*FractionBox[\(4\), \
\(3\)]\)\!\(\*FractionBox[\(\*SuperscriptBox[\(dreducedJ\), \(2\)] \
\*SuperscriptBox[\(\[Omega]\), \(3\)]\), \(\[HBar]\\\ \*SuperscriptBox[\(c\), \
\(3\)]\)]\) \[Equal] \!\(\*FractionBox[\((2\\\ J\\\  + \\\ 1)\), \((2\\\ Jp + \
1)\)]\)\!\(\*FractionBox[\(1\), \(\[Tau]\)]\).  \>\""}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dif", "[", 
     RowBox[{
     "Fp_", ",", "mFp_", ",", "F_", ",", "mF_", ",", " ", "q_", ",", 
      "dreducedF_"}], "]"}], ":=", " ", 
    RowBox[{"dreducedF", " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{"Fp", "-", "1", "+", "mF"}]], 
     SqrtBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "F"}], "+", "1"}], ")"}]], 
     RowBox[{"ThreeJSymbol", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Fp", ",", "mFp"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "q"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"F", ",", 
         RowBox[{"-", "mF"}]}], "}"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"dif", "::", "usage"}], " ", "=", " ", 
     "\"\<dif[Fp,mFp,F,mF, q,dreducedF] gives the transition dipole moment \
between hyperfine states. Fp & mFp are excited state quantum numbers. F & mF \
are ground state quantum numbers. q is the radiation polarization -1 for \!\(\
\*SuperscriptBox[\(\[Sigma]\), \(-\)]\), 0 for \[Pi], +1 for \
\!\(\*SuperscriptBox[\(\[Sigma]\), \(+\)]\) (as viewed in the emission \
process). dreducedF comes from dreducedHyperfine function\>\""}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",ExpressionUUID->"65357f1a-97b4-46e8-\
91be-ca2e7c13a5b2"],

