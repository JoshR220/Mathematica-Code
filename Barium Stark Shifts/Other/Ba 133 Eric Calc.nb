    "Rememer", " ", "the", " ", "point", " ", "of", " ", "the", " ", 
     "Lindblad", " ", "relaxation", " ", "part", " ", "is", " ", "that", " ", 
     "you", " ", "add", " ", "up", " ", "each", " ", "distinguishable", " ", 
     "decay", " ", "mode", " ", 
     RowBox[{"separately", ".", " ", "If"}], " ", "something", " ", "is", " ",
      "indistinguishable", " ", "then", " ", "you", " ", "add", " ", "it", 
     " ", "up", " ", "as", " ", "one", " ", "relaxation", " ", 
     RowBox[{"bit", ".", " ", "I"}], " ", "imagine", " ", "if", " ", "a", " ",
      "big", " ", "B"}], "-", 
    RowBox[{
    "field", " ", "is", " ", "turned", " ", "on", " ", "to", " ", "make", " ",
      "these", " ", "decays", " ", "distinguishable", " ", "then", " ", "the",
      " ", "Hamiltonian", " ", "evolution", " ", "part", " ", "will", " ", 
     "suppress", " ", "the", " ", "Zeeman", " ", "coherence", " ", 
     RowBox[{"stuff", ".", " ", "This"}], " ", "part", " ", "is", " ", "a", 
     " ", "little", " ", "kludgy", " ", "but", " ", "would", " ", "probably", 
     " ", "take", " ", "a", " ", "while", " ", "to", " ", "make", " ", "it", 
     " ", "nice", " ", "and", " ", 
     RowBox[{"automatic", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "So", " ", "need", " ", "a", " ", "function", " ", "that", " ", "adds", 
     " ", "all", " ", "of", " ", "the", " ", "decays", " ", "of", " ", "one", 
     " ", "polarization", " ", "from", " ", "one", " ", "group", " ", "of", 
     " ", "states"}], ",", " ", 
    RowBox[{"specficied", " ", "by", " ", "F", " ", "and", " ", "config"}], 
    ",", " ", 
    RowBox[{"to", " ", "another", " ", "group", " ", "of", " ", "states"}], 
