Cell[BoxData[{
 RowBox[{
  RowBox[{"Cuse", "[", 
   RowBox[{
   "config1_", ",", " ", "F1_", ",", "config2_", ",", "F2_", ",", "q_"}], 
   "]"}], " ", ":=", "  ", 
  RowBox[{"Sum", "[", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"KroneckerDelta", "[", 
      RowBox[{"config1", ",", 
       RowBox[{"config", "/.", 
        RowBox[{"State", "[", 
         RowBox[{"[", 
          RowBox[{"jj", ",", "8"}], "]"}], "]"}]}]}], "]"}], " ", 
     RowBox[{"KroneckerDelta", "[", 
      RowBox[{"F1", ",", " ", 
       RowBox[{"F", "/.", 
        RowBox[{"State", "[", 
         RowBox[{"[", 
          RowBox[{"jj", ",", "3"}], "]"}], "]"}]}]}], "]"}], " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Cop", "[", 
         RowBox[{"ii", ",", "jj", ",", "q"}], "]"}], " ", 
        RowBox[{"KroneckerDelta", "[", 
         RowBox[{"config2", ",", 
          RowBox[{"config", "/.", 
           RowBox[{"State", "[", 
            RowBox[{"[", 
             RowBox[{"ii", ",", "8"}], "]"}], "]"}]}]}], "]"}], " ", 
        RowBox[{"KroneckerDelta", "[", 
         RowBox[{"F2", ",", " ", 
          RowBox[{"F", "/.", 
           RowBox[{"State", "[", 
            RowBox[{"[", 
             RowBox[{"ii", ",", "3"}], "]"}], "]"}]}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"ii", ",", "1", ",", "36"}], "}"}]}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"jj", ",", "1", ",", "36"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Cuse", "::", "usage"}], " ", "=", " ", 
   "\"\<Cuse[config1_, F1_,config2_,F2_] gives the relaxation matrix for a \
decay from one F state to another. config1 and F1 specify the excited state, \
while config2 and F2 specify the lower state that is decayed to. q is the \
polarization of the decay mode. It's emission so \[Sigma]m is q = 1, \
etc.\>\""}], ";"}]}], "Input",
 CellChangeTimes->{{3.735054688943968*^9, 3.735054705061606*^9}, {
