Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Define", " ", "the", " ", "density", " ", "matrix"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"\[Rho]", " ", "=", " ", 
    RowBox[{"ToExpression", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"StringJoin", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Rho]\>\"", ",", " ", 
          RowBox[{"ToString", "[", "ii", "]"}], ",", "\"\<b\>\"", ",", 
          RowBox[{"ToString", "[", "jj", "]"}], ",", "\"\<[t]\>\""}], "}"}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"ii", ",", "1", ",", "36"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"jj", ",", "1", ",", "36"}], "}"}]}], "]"}], "]"}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{
  3.734978822884287*^9, {3.734978932771624*^9, 3.734978953172407*^9}, {
   3.734980760362988*^9, 
   3.734980762923126*^9}},ExpressionUUID->"5d0fafe2-653c-4ac6-bac9-\
b8316fe234fa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Damping", " ", "given", " ", "by"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Ldamp", "[", 
     RowBox[{"X_", ",", "A_"}], "]"}], " ", ":=", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "2"]}], 
     RowBox[{"(", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Transpose", "[", "X", "]"}], ".", "X", ".", "A"}], " ", "+", 
       " ", 
       RowBox[{"A", ".", 
        RowBox[{"Transpose", "[", "X", "]"}], ".", "X"}], "-", " ", 
       RowBox[{"2", " ", 
        RowBox[{"X", ".", "A", ".", 
         RowBox[{"Transpose", "[", "X", "]"}]}]}]}], ")"}]}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "To", " ", "get", " ", "the", " ", "Zeeman", " ", "coherence", " ", 
      "decay", " ", "right", " ", "you", " ", "have", " ", "to", " ", 
      "correctly", " ", "account", " ", "for", " ", "the", " ", "sign", " ", 
      "of", " ", "the", " ", "dipole", " ", "matrix", " ", 
      RowBox[{"element", "!"}], " ", "Since", " ", 
      RowBox[{"I", "'"}], "m", " ", "square", " ", "rooting", " ", "to", " ", 
      "get", " ", "magnitude", " ", "it", " ", "disappears"}], ",", " ", 
     RowBox[{
     "so", " ", "have", " ", "to", " ", "add", " ", "it", " ", "back"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"WhichSign", "[", 
     RowBox[{"ii_", ",", "jj_", ",", "q_"}], "]"}], ":=", 
    RowBox[{"Sign", "[", 
     RowBox[{"dif", "[", 
      RowBox[{
       RowBox[{"F", "/.", 
        RowBox[{"State", "[", 
         RowBox[{"[", 
          RowBox[{"ii", ",", "3"}], "]"}], "]"}]}], ",", 
       RowBox[{"Mf", "/.", 
        RowBox[{"State", "[", 
         RowBox[{"[", 
          RowBox[{"ii", ",", "4"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"F", "/.", 
        RowBox[{"State", "[", 
         RowBox[{"[", 
          RowBox[{"jj", ",", "3"}], "]"}], "]"}]}], ",", 
       RowBox[{"Mf", "/.", 
        RowBox[{"State", "[", 
         RowBox[{"[", 
          RowBox[{"jj", ",", "4"}], "]"}], "]"}]}], ",", "q", ",", "1"}], 
      "]"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Cop", "[", 
     RowBox[{"ii_", ",", "jj_", ",", "q_"}], "]"}], " ", ":=", " ", 
    RowBox[{
     SqrtBox[
      RowBox[{"\[CapitalGamma]", "[", 
       RowBox[{"ii", ",", "jj"}], "]"}]], " ", 
     RowBox[{"WhichSign", "[", 
      RowBox[{"ii", ",", "jj", ",", "q"}], "]"}], 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"KroneckerDelta", "[", 
         RowBox[{"kk", ",", "ii"}], "]"}], " ", 
        RowBox[{"KroneckerDelta", "[", 
         RowBox[{"mm", ",", "jj"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"kk", ",", "1", ",", "36"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"mm", ",", "1", ",", "36"}], "}"}]}], "]"}]}]}]}]}]], "Input",
 CellChangeTimes->{{3.697574157394246*^9, 3.697574166546051*^9}, {
