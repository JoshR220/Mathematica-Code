    RowBox[{"kg", " ", ">", " ", "0"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Joule", " ", "=", " ", 
   RowBox[{"kg", " ", 
    FractionBox[
     SuperscriptBox["meter", "2"], 
     SuperscriptBox["second", "2"]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Newton", " ", "=", " ", 
   FractionBox[
    RowBox[{"kg", " ", "meter"}], 
