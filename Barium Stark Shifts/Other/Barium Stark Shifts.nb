Cell[TextData[{
 "We want to express ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"<", "\[Gamma]"}], ",", "F", ",", 
    RowBox[{
     SubscriptBox["m", "F"], "|", " ", "dipole", " ", "|", 
     RowBox[{"\[Gamma]", "'"}]}], ",", 
    RowBox[{"F", "'"}], ",", 
    RowBox[{
     RowBox[{
      SubscriptBox["m", "F"], "'"}], ">"}]}], TraditionalForm]],
  ExpressionUUID->"a09424d5-9c8f-46e5-8a64-d765babbc441"],
 " in terms of cg/#j coefficients and a reduced <J||dipole||J\
\[CloseCurlyQuote]> operator.  Here are the equations we\[CloseCurlyQuote]ll \
use:\n",
