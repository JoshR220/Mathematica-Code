Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Ispin", " ", "=", " ", 
    RowBox[{"1", "/", "2"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Barium", "-", "133"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fdp", "[", 
    RowBox[{"J_", ",", "Jp_", ",", "F_", ",", "Fp_", ",", "Ispin_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{"jdipoleElement", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"Fp", "+", "J", "+", "1", "+", "Ispin"}]], 
    SqrtBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "Fp"}], "+", "1"}], ")"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "J"}], "+", "1"}], ")"}]}]], 
    RowBox[{"SixJSymbol", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"J", ",", "Jp", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"Fp", ",", "F", ",", "Ispin"}], "}"}]}], "]"}]}]}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"mffdp", "[", 
     RowBox[{
     "J_", ",", "F_", ",", "mF_", ",", "Jp_", ",", "Fp_", ",", "mFp_", ",", 
      "Ispin_", ",", " ", "q_"}], "]"}], " ", ":=", " ", 
    RowBox[{
     RowBox[{"fdp", "[", 
      RowBox[{"J", ",", "Jp", ",", "F", ",", "Fp", ",", "Ispin"}], "]"}], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{"Fp", "-", "1", "+", "mF"}]], 
     SqrtBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "Fp"}], "+", "1"}], ")"}]], 
     RowBox[{"ThreeJSymbol", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Fp", ",", "mFp"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "q"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"F", ",", 
         RowBox[{"-", "mF"}]}], "}"}]}], "]"}]}]}], 
