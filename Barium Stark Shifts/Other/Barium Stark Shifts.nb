Cell["\<\
Define constants, parameters, derived units, and derived quantities.\
\>", "Subsection",
 CellChangeTimes->{{3.850493742299488*^9, 
  3.850493748697576*^9}},ExpressionUUID->"357257b1-86e5-4627-887e-\
83e59285d4a4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ee", "=", " ", 
    RowBox[{"1.602176634*^-19", " ", "coulomb"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"Electron", " ", "Charge"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[HBar]", " ", "=", " ", 
    RowBox[{
     FractionBox["6.62607015*^-34", 
      RowBox[{"2", "\[Pi]"}]], "Joule", " ", "second"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"reduced", " ", "planck", " ", "constant"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"c", " ", "=", " ", 
    RowBox[{"299792458", " ", 
     FractionBox["meter", "second"]}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Speed", " ", "of", " ", "light"}], "*)"}], 
  " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Epsilon]0", " ", "=", " ", 
    RowBox[{"8.8541878128*^-12", 
     FractionBox["farad", "meter"]}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Vacuum", " ", "permittivity"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Alpha]", " ", "=", " ", 
    FractionBox[
     SuperscriptBox["ee", "2"], 
     RowBox[{
     "4", " ", "\[Pi]", " ", "\[Epsilon]0", " ", "\[HBar]", " ", "c"}]]}], 
   ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Fine", " ", "Structure", " ", "Constant"}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Intensity", " ", "=", " ", 
     FractionBox[
      RowBox[{"2", "P"}], 
      RowBox[{"\[Pi]", " ", 
       SuperscriptBox["w0", "2"]}]]}], ";"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Efield", " ", "=", " ", 
   SqrtBox[
    FractionBox[
     RowBox[{"4", " ", "P"}], 
     RowBox[{"\[Pi]", " ", 
      SuperscriptBox["w0", "2"], "c", " ", "\[Epsilon]0"}]]]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"$Assumptions", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"coulomb", ">", "0"}], ",", " ", 
    RowBox[{"meter", " ", ">", " ", "0"}], ",", " ", 
