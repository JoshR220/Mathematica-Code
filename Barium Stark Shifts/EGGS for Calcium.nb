Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveSchrodinger", "[", 
    RowBox[{"H_", ",", "initialstate_", ",", "t1_", ",", "t2_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"Dispatch", "[", 
      RowBox[{"First", "@", 
       RowBox[{"NDSolve", "[", 
        RowBox[{"#", ",", "\[Psi]BasisTOT", ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "t1", ",", "t2"}], "}"}], ",", 
         RowBox[{"MaxSteps", "\[Rule]", "\[Infinity]"}], ",", 
         RowBox[{"Method", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"\"\<StiffnessSwitching\>\"", ",", 
            RowBox[{"Method", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"Automatic", ",", "Automatic"}], "}"}]}], ",", 
            RowBox[{
            "\"\<EquationSimplification\>\"", "\[Rule]", "\"\<Solve\>\""}]}], 
           "}"}]}]}], "]"}]}], "]"}], "&"}], "[", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Psi]BasisTOT", "/.", 
          RowBox[{"{", 
           RowBox[{"t", "\[Rule]", "t1"}], "}"}]}], ")"}], "\[Equal]", 
        "initialstate"}], "]"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Thread", "[", 
         RowBox[{
          RowBox[{"\[Psi]diff", "+", 
           RowBox[{
            FractionBox["\[ImaginaryI]", "\[HBar]"], "*", 
            RowBox[{"(", "#", ")"}]}]}], "\[Equal]", "0"}], "]"}], "&"}], "[", 
       RowBox[{"H", ".", "\[Psi]BasisTOT"}], "]"}]}], "]"}], "]"}]}], 
  ";"}]], "Input",
