Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Heff0", "[", "Heff_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"wm", "=", 
        RowBox[{"Keys", "[", "Heff", "]"}]}], ",", 
       RowBox[{"hm", "=", 
        RowBox[{"Values", "[", "Heff", "]"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{"(", 
        FractionBox["1", 
         RowBox[{"\[HBar]", "*", "wm"}]], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Commutator", "[", 
           RowBox[{
            RowBox[{"ConjugateTranspose", "[", "#", "]"}], ",", "#"}], "]"}], 
          "&"}], "/@", "hm"}], ")"}]}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.845582117027522*^9, 3.850960806271926*^9, {3.8509619195594807`*^9, 
   3.850961928285178*^9}, {3.85096226045028*^9, 3.850962291839176*^9}, {
