Cell[BoxData[
 RowBox[{
  RowBox[{"CoherentState", "[", 
   RowBox[{"qubitstate_", ",", "\[Alpha]Arr_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"startInd", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Reverse", "[", 
            RowBox[{"Apply", "[", 
             RowBox[{"Times", ",", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"Reverse", "[", "numLevels", "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{";;", 
                   RowBox[{"#", "-", "1"}]}], "]"}], "]"}], "&"}], "/@", 
               RowBox[{"Range", "[", "numQubits", "]"}]}], ",", "2"}], "]"}], 
            "]"}], ".", "qubitstate"}], ")"}], "*", "numPhononStates"}], "+", 
        "1"}]}], ",", 
      RowBox[{"\[Alpha]Arr2", "=", 
       RowBox[{"Flatten", "[", "\[Alpha]Arr", "]"}]}], ",", "coherentfunc", 
      ",", "prob"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"coherentfunc", "[", 
       RowBox[{"n_", ",", "\[Alpha]_"}], "]"}], ":=", 
      FractionBox[
       SuperscriptBox["\[Alpha]", "n"], 
       SqrtBox[
        RowBox[{"n", "!"}]]]}], ";", "\[IndentingNewLine]", 
     RowBox[{"prob", "=", 
      RowBox[{"Times", "@@", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Thread", "[", 
           RowBox[{"coherentfunc", "[", 
            RowBox[{
             RowBox[{"Basis", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{";;", "numPhononStates"}], ",", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"numQubits", "+", "1"}], ")"}], "+", "#"}]}], "]"}],
               "]"}], ",", 
             RowBox[{"\[Alpha]Arr2", "[", 
              RowBox[{"[", "#", "]"}], "]"}]}], "]"}], "]"}], "&"}], ",", 
         RowBox[{"Range", "[", "numModesTOT", "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"SparseArray", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Band", "[", 
         RowBox[{"{", "startInd", "}"}], "]"}], "\[Rule]", 
        RowBox[{"Normalize", "[", "prob", "]"}]}], ",", "numStates"}], 
      "]"}]}]}], "]"}]}]], "Input",
