Cell[BoxData[
 RowBox[{
  RowBox[{"HeffEx", "[", "Heff1_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ind", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Tuples", "[", 
          RowBox[{"{", 
           RowBox[{"#", ",", "#"}], "}"}], "]"}], "&"}], "[", 
        RowBox[{"Range", "[", 
         RowBox[{"Length", "[", "Heff1", "]"}], "]"}], "]"}]}], ",", 
      RowBox[{"wm", "=", 
       RowBox[{"Keys", "[", "Heff1", "]"}]}], ",", 
      RowBox[{"hm", "=", 
       RowBox[{"Values", "[", "Heff1", "]"}]}], ",", "Hmn", ",", "Hres"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"Hmn", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"2", "\[HBar]"}]], 
       RowBox[{"(", 
        RowBox[{
         FractionBox["1", 
          RowBox[{"wm", "[", 
           RowBox[{"[", "i", "]"}], "]"}]], "+", 
         FractionBox["1", 
          RowBox[{"wm", "[", 
           RowBox[{"[", "j", "]"}], "]"}]]}], ")"}], "*", 
       RowBox[{"Commutator", "[", 
        RowBox[{
         RowBox[{"ConjugateTranspose", "[", 
          RowBox[{"hm", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", 
         RowBox[{"hm", "[", 
          RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "*", 
       RowBox[{"Exp", "[", 
        RowBox[{"\[ImaginaryI]", "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"wm", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "-", 
           RowBox[{"wm", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "*", "t"}], "]"}]}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"Plus", "@@", 
      RowBox[{"(", 
       RowBox[{"Hmn", "@@@", "ind"}], ")"}]}]}]}], "]"}]}]], "Input",
