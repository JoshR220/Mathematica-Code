  RowBox[{"ThermalState", "[", 
   RowBox[{"qubitstate_", ",", "temp_"}], "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"startInd", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Reverse", "[", 
            RowBox[{"Apply", "[", 
             RowBox[{"Times", ",", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"Reverse", "[", "numLevels", "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{";;", 
                   RowBox[{"#", "-", "1"}]}], "]"}], "]"}], "&"}], "/@", 
               RowBox[{"Range", "[", "numQubits", "]"}]}], ",", "2"}], "]"}], 
            "]"}], ".", "qubitstate"}], ")"}], "*", "numPhononStates"}], "+", 
        "1"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"prob", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "\[HBar]"}], "/", 
             RowBox[{"(", 
              RowBox[{"kb", "*", "temp"}], ")"}]}], "*", 
            RowBox[{"(", 
             RowBox[{"#1", ".", "#2"}], ")"}]}], "]"}], "]"}], "&"}], "[", 
        RowBox[{
         RowBox[{"Basis", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{";;", "numPhononStates"}], ",", 
            RowBox[{
             RowBox[{"numQubits", "+", "2"}], ";;"}]}], "]"}], "]"}], ",", 
         RowBox[{"Flatten", "[", 
          RowBox[{"MapIndexed", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"wmvals", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"First", "@", "#2"}], ",", "#1"}], "]"}], "]"}], 
             "&"}], ",", "activeModes"}], "]"}], "]"}]}], "]"}]}]}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{"SparseArray", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Band", "[", 
        RowBox[{"{", "startInd", "}"}], "]"}], "\[Rule]", 
       RowBox[{"Normalize", "[", "prob", "]"}]}], ",", "numStates"}], "]"}]}],
    "]"}]}]], "Input",
 CellChangeTimes->{{3.8302897136827297`*^9, 3.830289722651119*^9}, {
   3.830290055266679*^9, 3.8302900782369556`*^9}, {3.83029011961371*^9, 
