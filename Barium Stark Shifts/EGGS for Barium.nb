Cell[CellGroupData[{

Cell["Effective Hamiltonian Method (James & Jerke)", "Subsection",
 CellChangeTimes->{{3.82176573707802*^9, 3.821765755056943*^9}, {
   3.8217662567532177`*^9, 3.82176625781892*^9}, {3.821766538737349*^9, 
   3.8217665402727747`*^9}, {3.824209821294939*^9, 3.824209821558941*^9}, {
   3.824222859107787*^9, 3.824222887094288*^9}, {3.8242241578222513`*^9, 
   3.824224158070086*^9}, {3.824250254095443*^9, 3.8242502838949537`*^9}, 
   3.824809467017304*^9, {3.824813804121241*^9, 3.8248138086487427`*^9}, 
   3.829679740047473*^9, {3.852716164590959*^9, 
   3.852716170215062*^9}},ExpressionUUID->"62cb7819-af1d-441d-b065-\
182ad6557fb2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"calculates", " ", "the", " ", "James"}], " ", "&"}], " ", 
    "Jerke", " ", "effective", " ", "Hamiltonian", " ", "from", " ", "an", 
    " ", "interaction", " ", "picture", " ", "Hamiltonian"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Heff", "[", "Ham_", "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"arrayrules", "=", 
         RowBox[{"Expand", "[", 
          RowBox[{
           RowBox[{"ArrayRules", "[", 
            RowBox[{"SparseArray", "[", "Ham", "]"}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{";;", 
             RowBox[{"-", "2"}]}], "]"}], "]"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"arraydim", "=", 
         RowBox[{"Dimensions", "[", "Ham", "]"}]}], ",", 
        "\[IndentingNewLine]", "ind", ",", " ", "expr", ",", " ", "vals", ",",
         " ", "\[IndentingNewLine]", "coefficientsArr", ",", "exponentsArr", 
        ",", "uniqueExponents", ",", "coefficientsArrPositions", ",", 
        "\[IndentingNewLine]", "hcoeffArr", ",", "hcoeffPos", ",", "hMatArr", 
        ",", "hMatArr2"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "split", " ", "index", " ", "from", " ", "values", " ", "and", " ", 
        "get", " ", "each", " ", "element", " ", "of", " ", "sum", " ", 
        "separately"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ind", "=", 
        RowBox[{"arrayrules", "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", "1"}], "]"}], "]"}]}], ";", 
       RowBox[{"expr", "=", 
        RowBox[{
         RowBox[{"arrayrules", "[", 
          RowBox[{"[", 
           RowBox[{";;", ",", "2"}], "]"}], "]"}], "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"x_", "+", "0."}], "\[RuleDelayed]", "x"}], "}"}]}]}], ";", 
       RowBox[{"vals", "=", 
        RowBox[{"List", "@@@", "expr"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "separate", " ", "coefficients", " ", "from", " ", "exponent"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"coefficientsArr", "=", 
        RowBox[{"vals", "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"x_", "*", 
            RowBox[{"\[ExponentialE]", "^", 
             RowBox[{"(", "__", ")"}]}]}], "\[RuleDelayed]", "x"}], "}"}]}]}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"exponentsArr", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Exponent", "[", 
           RowBox[{"#", ",", "\[ExponentialE]"}], "]"}], "&"}], "/@", 
         "vals"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "then", " ", "strip", " ", "zeros", " ", "and", " ", "t", " ", "from",
          " ", "exponent"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"exponentsArr", "=", 
        RowBox[{"Im", "[", 
         RowBox[{
          RowBox[{"ComplexExpand", "[", "exponentsArr", "]"}], "/.", 
          RowBox[{"{", 
           RowBox[{"t", "->", "1"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "make", " ", "exponent", " ", "same", " ", "precision", " ", "as", 
         " ", "later", " ", "exp"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"exponentsArr", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{"exponentsArr", ",", "9"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"get", " ", "unique", " ", "exponents"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"uniqueExponents", "=", 
        RowBox[{
         RowBox[{"DeleteDuplicates", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"Flatten", "[", "exponentsArr", "]"}], "]"}], "]"}], "//", 
         "Sort"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "remove", " ", "any", " ", "pesky", " ", "zeros", " ", "from", " ", 
         "the", " ", "list"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"uniqueExponents", "=", 
        RowBox[{"DeleteCases", "[", 
         RowBox[{"uniqueExponents", ",", "0"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "get", " ", "coefficient", " ", "positions", " ", "for", " ", "each", 
         " ", "unique", " ", "exponent"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"coefficientsArrPositions", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{"exponentsArr", ",", "#"}], "]"}], "&"}], "/@", 
         "uniqueExponents"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"get", " ", "coefficients"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"hcoeffArr", "=", 
        RowBox[{"Apply", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"coefficientsArr", "[", 
            RowBox[{"[", "##", "]"}], "]"}], "&"}], ",", 
          "coefficientsArrPositions", ",", 
          RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"get", " ", "positions"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"hcoeffPos", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"ind", "[", 
           RowBox[{"[", 
            RowBox[{"#", ",", ";;"}], "]"}], "]"}], "&"}], "/@", 
         RowBox[{"coefficientsArrPositions", "[", 
          RowBox[{"[", 
           RowBox[{";;", ",", ";;", ",", "1"}], "]"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "create", " ", "matrix", " ", "for", " ", "each", " ", "unique", " ", 
