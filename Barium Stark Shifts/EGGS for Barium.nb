Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"calculate", " ", "transition", " ", "coefficients"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"FFcoefficients", "=", 
    RowBox[{
     RowBox[{"Outer", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"SixJSymbol", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"#2", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"#1", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"#1", "[", 
              RowBox[{"[", "3", "]"}], "]"}], ",", 
             RowBox[{"#2", "[", 
              RowBox[{"[", "3", "]"}], "]"}], ",", "K"}], "}"}]}], "]"}], "*", 
         SqrtBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "*", 
              RowBox[{"#1", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "+", "1"}], ")"}], "*", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "*", 
              RowBox[{"#1", "[", 
               RowBox[{"[", "3", "]"}], "]"}]}], "+", "1"}], ")"}]}]], "*", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#1", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "+", "1", "+", "K", "-", 
            RowBox[{"#1", "[", 
             RowBox[{"[", "3", "]"}], "]"}], "+", 
            RowBox[{"#2", "[", 
             RowBox[{"[", "4", "]"}], "]"}], "-", 
            RowBox[{"#1", "[", 
             RowBox[{"[", "4", "]"}], "]"}]}], ")"}]]}], "&"}], ",", 
       "BasisHF", ",", "BasisHF", ",", "1"}], "]"}], "//", "SparseArray"}]}], 
   ";"}]}]], "Input",
