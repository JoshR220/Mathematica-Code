99f320a1e516"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
    RowBox[{
    "M1", " ", "hyperfine", " ", "transitions", " ", "require", " ", 
     "\[CapitalDelta]F"}], "=", "0"}], ",", " ", 
   RowBox[{"\[PlusMinus]", "1"}], ",", " ", 
   RowBox[{
    RowBox[{"and", " ", 
     SubscriptBox["\[CapitalDelta]M", "F"]}], "=", "0"}], ",", " ", 
   RowBox[{"\[PlusMinus]", "1"}]}], "*)"}]], "Input",
 CellChangeTimes->{{3.870768608671205*^9, 3.870768639063366*^9}},
 CellLabel->
