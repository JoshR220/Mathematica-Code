Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"create", " ", "hamiltonian"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"hma", "=", 
     RowBox[{"SparseArray", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"10", ",", "21"}], "}"}], "->", 
          FractionBox[
           RowBox[{"-", "1"}], 
           RowBox[{"2", 
            SqrtBox["5"]}]]}], ",", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"21", ",", "10"}], "}"}], "->", 
          FractionBox[
           RowBox[{"-", "1"}], 
           RowBox[{"2", 
            SqrtBox["5"]}]]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"36", ",", "36"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"HDJ", "=", 
      RowBox[{
       RowBox[{
        FractionBox["\[CapitalOmega]585", "2"], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"\[ImaginaryI]", "*", "\[Omega]532", "*", "t"}], "]"}], 
          "+", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], "*", "\[Omega]532", "*", "t"}], 
           "]"}]}], ")"}], "*", "hma"}], "//", "FullSimplify"}]}], ";"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"HDJ", "=", 
     RowBox[{"HamBar", "[", 
      RowBox[{
       RowBox[{"\[Omega]455", "+", "\[Delta]455"}], ",", "\[CapitalOmega]455",
        ",", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"HDJ", "=", 
     RowBox[{
      RowBox[{"ToIntPic", "[", 
       RowBox[{"HDJ", ",", "U0"}], "]"}], "//", "TrigToExp"}]}], 
    ";"}]}]}]], "Input",
