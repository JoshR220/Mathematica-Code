Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "diagonalize", " ", "and", " ", "remove", " ", "very", " ", "small", " ", 
    "values"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"DiagonalizeHeff", "[", "Hmat_", "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Delta]Eigenval", "=", 
         RowBox[{
          RowBox[{"Max", "[", "Hmat", "]"}], "*", "1*^-6"}]}], ",", 
        "\[IndentingNewLine]", "eigenval", ",", "eigenvec", ",", 
        "\[Delta]Eigenvec"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"eigenval", ",", "eigenvec"}], "}"}], "=", 
        RowBox[{"Eigensystem", "[", "Hmat", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"eigenval", "/=", 
        RowBox[{"(", 
         RowBox[{"\[HBar]", "*", "wkhz"}], ")"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"eigenval", "=", 
        RowBox[{"Chop", "[", 
         RowBox[{"eigenval", ",", "\[Delta]Eigenval"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"\[Delta]Eigenvec", "=", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"Mean", "[", 
           RowBox[{"Max", "/@", "eigenvec"}], "]"}], "*", "1*^-6"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"eigenvec", "=", 
        RowBox[{"Chop", "[", 
         RowBox[{"eigenvec", ",", "\[Delta]Eigenvec"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{"eigenval", ",", "eigenvec"}], "}"}], "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"diagonalHeffResArr", "=", 
     RowBox[{"DiagonalizeHeff", "/@", "HeffSSArr"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.870918618821525*^9, 3.870918704839335*^9}, {
