Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"the", " ", "M1x0", " ", "operator", " ", "addresses", " ", 
      SubscriptBox["\[CapitalDelta]M", "F"]}], "=", 
     RowBox[{"0", " ", "transitions"}]}], ";", " ", 
    RowBox[{
     RowBox[{
     "we", " ", "use", " ", "it", " ", "to", " ", "prevent", " ", "the", " ", 
      "forbidden", " ", "\[CapitalDelta]F"}], "=", 
     RowBox[{
      RowBox[{"0", " ", 
       SubscriptBox["M", "F"]}], "=", 
      RowBox[{
       RowBox[{"0", " ", "->", " ", 
        SubscriptBox["M", "F"]}], "=", 
       RowBox[{"0", " ", "transition"}]}]}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"M1x0", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"#", ",", "#"}], "]"}], "&"}], "[", 
      RowBox[{
       RowBox[{
        RowBox[{"KroneckerDelta", "[", 
         RowBox[{"0", ",", "#"}], "]"}], "&"}], "/@", 
       RowBox[{"BasisHF", "[", 
        RowBox[{"[", 
         RowBox[{";;", ",", "4"}], "]"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"M1x", "=", 
     RowBox[{"L0", "*", "J0", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Fx", "+", "F0"}], ")"}], "*", 
         RowBox[{"(", 
          RowBox[{"\[Sigma]x", "+", "\[Pi]0"}], ")"}]}], "-", 
        RowBox[{"F0", "*", "M1x0"}]}], ")"}]}]}], ";"}]}]}]], "Input",
