Cell[TextData[{
 "FFcoefficients (matrix): the coefficient terms and the 6-j symbols (i.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{
      RowBox[{"F", "'"}], "-", "F", "+", 
      SubscriptBox[
       RowBox[{"m", "'"}], "F"], "-", 
      SubscriptBox["m", "F"]}]], 
    SqrtBox[
     FractionBox[
      RowBox[{
       RowBox[{"2", "F"}], "+", "1"}], 
      RowBox[{
       RowBox[{"2", 
        RowBox[{"F", "'"}]}], "+", "1"}]]]}], TraditionalForm]],
  ExpressionUUID->"de0f7592-95e7-4b00-909d-460b052ce33c"],
 ")\nFF6 (matrix): \nFFm (matrix): the Clebsch-Gordan coefficients for \
transitions with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]m", "F"], "=", 
    RowBox[{"-", "1"}]}], TraditionalForm]],ExpressionUUID->
  "4a8dba2f-a222-4817-98bf-d1686b71b323"],
 "\n\nFFp (matrix): the Clebsch-Gordan coefficients for transitions with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]m", "F"], "=", 
    RowBox[{"+", "1"}]}], TraditionalForm]],ExpressionUUID->
  "903999c1-0566-4601-b89c-c75b041119c4"],
 "\n\nFF0 (matrix): the Clebsch-Gordan coefficients for transitions into the \
same ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["m", "F"], " "}], TraditionalForm]],ExpressionUUID->
  "28fc154b-3e73-479b-af8b-d2236c1410e3"],
 "state/"
}], "Text",
 CellChangeTimes->{{3.870316705613405*^9, 3.870316897714604*^9}, {
