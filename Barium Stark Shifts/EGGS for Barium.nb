Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "transforms", " ", "a", " ", "Hamiltonian", " ", "to", " ", "the", " ", 
    "interaction", " ", "picture", " ", "with", " ", "respect", " ", "to", 
    " ", "U"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ToIntPic", "[", 
     RowBox[{"H_", ",", "U_"}], "]"}], ":=", 
    RowBox[{"With", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Udag", "=", 
        RowBox[{
         RowBox[{"ComplexExpand", "[", 
          RowBox[{"ConjugateTranspose", "[", 
           RowBox[{"Normal", "[", "U", "]"}], "]"}], "]"}], "//", 
         "SparseArray"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{"Udag", ".", "H", ".", "U"}], "]"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.825514591762899*^9, 3.825514644455316*^9}, {
