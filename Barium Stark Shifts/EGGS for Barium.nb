Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveSchrodinger", "[", 
    RowBox[{"H_", ",", "initialstate_", ",", "t1_", ",", "t2_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"Dispatch", "[", 
      RowBox[{"First", "@", 
       RowBox[{"NDSolve", "[", 
        RowBox[{
        "#", ",", "\[IndentingNewLine]", "Basis\[Psi]", ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"t", ",", "t1", ",", "t2"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"MaxSteps", "\[Rule]", "\[Infinity]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Method", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"\"\<StiffnessSwitching\>\"", ",", 
            RowBox[{"Method", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"Automatic", ",", "Automatic"}], "}"}]}], ",", 
            RowBox[{
            "\"\<EquationSimplification\>\"", "\[Rule]", "\"\<Solve\>\""}]}], 
           "}"}]}]}], "]"}]}], "]"}], "&"}], "[", "\[IndentingNewLine]", 
    RowBox[{"Join", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Basis\[Psi]", "/.", 
          RowBox[{"{", 
           RowBox[{"t", "\[Rule]", "t1"}], "}"}]}], ")"}], "\[Equal]", 
        "initialstate"}], "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Thread", "[", 
         RowBox[{
          RowBox[{"Basis\[Psi]Diff", "+", 
           RowBox[{
            FractionBox["\[ImaginaryI]", "\[HBar]"], "*", 
            RowBox[{"(", "#", ")"}]}]}], "\[Equal]", "0"}], "]"}], "&"}], "[", 
       RowBox[{"H", ".", "Basis\[Psi]"}], "]"}]}], "\[IndentingNewLine]", 
     "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.8305488764938307`*^9, 3.83054888358689*^9}, 
   3.830548948225078*^9, {3.830549072548839*^9, 3.8305491240920067`*^9}, {
