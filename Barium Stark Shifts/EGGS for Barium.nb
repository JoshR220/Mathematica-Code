Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "create", " ", "matrices", " ", "to", " ", "select", " ", "different", " ",
     "dipole", " ", "transitions"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"transitionMatrixL", "[", 
      RowBox[{"LJstate1_", ",", "LJstate2_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Outer", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{
            RowBox[{"LJstate1", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"#1", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "*", 
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{
            RowBox[{"LJstate2", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"#2", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "*", 
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{
            RowBox[{"LJstate1", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", 
            RowBox[{"#1", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "*", 
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{
            RowBox[{"LJstate2", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", 
            RowBox[{"#2", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "&"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"BasisHF", "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", 
           RowBox[{";;", "2"}]}], "]"}], "]"}], ",", 
        RowBox[{"BasisHF", "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", 
           RowBox[{";;", "2"}]}], "]"}], "]"}], ",", "\[IndentingNewLine]", 
        "1"}], "]"}], "//", "SparseArray"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"transitionMatrices", "=", 
     RowBox[{
      RowBox[{"Values", "[", "transitionDipoleMoments", "]"}], ".", 
      RowBox[{"(", 
       RowBox[{"transitionMatrixL", "@@@", 
        RowBox[{"Keys", "[", "transitionDipoleMoments", "]"}]}], ")"}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"transitionMatrices", "+=", 
     RowBox[{"Transpose", "[", "transitionMatrices", "]"}]}], 
    ";"}]}]}]], "Input",
