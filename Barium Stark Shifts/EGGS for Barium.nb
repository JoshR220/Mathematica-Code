Cell[BoxData[{
 RowBox[{
  RowBox[{"ProcessHeffArr", "[", 
   RowBox[{"eigenval_", ",", "eigenvecs_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "nonzeroIndices", ",", "nonzeroEigenvalues", ",", "nonzeroEigenvectors", 
      ",", "separatedEigenvectors", ",", "stateIndices", ",", 
      "stateCoefficients"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"get", " ", "nonzero", " ", "eigenvalues"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"nonzeroIndices", ",", "nonzeroEigenvalues"}], "}"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{"Keys", "[", "#", "]"}], "]"}], ",", 
          RowBox[{"Values", "[", "#", "]"}]}], "}"}], "&"}], "[", 
       RowBox[{
        RowBox[{"ArrayRules", "[", "eigenval", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{";;", 
          RowBox[{"-", "2"}]}], "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"get", " ", "nonzero", " ", "eigenvectors"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"nonzeroEigenvectors", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"eigenvecs", "[", 
         RowBox[{"[", "#", "]"}], "]"}], "&"}], "/@", "nonzeroIndices"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "separate", " ", "eigenvector", " ", "indices", " ", "and", " ", 
       "values"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"separatedEigenvectors", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"ArrayRules", "[", "#", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{";;", 
            RowBox[{"-", "2"}]}], "]"}], "]"}], ")"}], "&"}], "/@", 
       "nonzeroEigenvectors"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"stateIndices", ",", "stateCoefficients"}], "}"}], "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Flatten", "[", 
            RowBox[{"Keys", "[", "#", "]"}], "]"}], ",", 
           RowBox[{"Values", "[", "#", "]"}]}], "}"}], "&"}], "/@", 
        "separatedEigenvectors"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"todo", ":", " ", 
       RowBox[{
       "associate", " ", "stateindices", " ", "to", " ", "coefficients"}]}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{"{", 
       RowBox[{
       "nonzeroEigenvalues", ",", "nonzeroIndices", ",", "stateIndices", ",", 
        "stateCoefficients"}], "}"}], "]"}], ";"}]}], "\[IndentingNewLine]", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"processedHeffArr", "=", 
   RowBox[{"ProcessHeffArr", "@@@", "diagonalHeffResArr"}]}], ";"}]}], "Input",\

