Cell[CellGroupData[{

Cell["Total Momentum Operators", "Subsection",
 CellChangeTimes->{{3.853222871910651*^9, 3.853222878453944*^9}, {
  3.870317746313308*^9, 
  3.870317754106748*^9}},ExpressionUUID->"814f6b32-04b8-4492-b80f-\
748251f53f6b"],

Cell[TextData[{
 "These operators are used to enforce manage transitions between angular \
momentum states.\nThe value after the first letter indicates the transition \
supported.\n\t",
 StyleBox["0",
  FontSlant->"Italic"],
 " indicates transitions to the same total momentum state (e.g. \
\[CapitalDelta]J=0).\n\t",
 StyleBox["p ",
  FontSlant->"Italic"],
 "(plus) indicates transitions that raise the total momentum (e.g. \
\[CapitalDelta]F = +1).\n",
 StyleBox["\tm",
  FontSlant->"Italic"],
 " (minus) indicates transitions that lower the total momentum (e.g. \
\[CapitalDelta]F = -1).\n\t",
 StyleBox["x ",
  FontSlant->"Italic"],
 "is the Pauli-x operator for that quantum number (i.e. supports ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]J", "=", 
   RowBox[{"\[PlusMinus]", "1"}]}]], "Input",
  CellChangeTimes->{{3.8703181370835533`*^9, 3.870318151943672*^9}},
  ExpressionUUID->"588d4bf2-ebea-4f86-9293-f3d8f528d948"],
 " transitions)."
}], "Text",
 CellChangeTimes->{{3.870316705613405*^9, 3.870316897714604*^9}, {
  3.870317016965652*^9, 3.8703170406826878`*^9}, {3.870317104725752*^9, 
  3.870317120743404*^9}, {3.870317201311895*^9, 3.870317287942412*^9}, {
  3.870317521873152*^9, 3.870317609160407*^9}, {3.870317647144536*^9, 
  3.870317680368848*^9}, {3.870317866316079*^9, 
  3.870318183343202*^9}},ExpressionUUID->"8131556a-3e91-46b7-8aff-\
49de19e52bd6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"orbital", " ", "angular", " ", "momentum", " ", "operator"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"L0", "=", 
     RowBox[{"SparseArray", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Outer", "[", 
         RowBox[{"KroneckerDelta", ",", "#", ",", "#"}], "]"}], "&"}], "[", 
       RowBox[{"BasisHF", "[", 
        RowBox[{"[", 
         RowBox[{";;", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"L0", "-=", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"#", ",", "#"}], "]"}]}], "&"}], "[", 
     RowBox[{
      RowBox[{
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"0", ",", "#"}], "]"}], "&"}], "/@", 
      RowBox[{"BasisHF", "[", 
       RowBox[{"[", 
        RowBox[{";;", ",", "1"}], "]"}], "]"}]}], "]"}], ";"}]}]}]], "Input",
