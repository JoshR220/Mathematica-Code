     RowBox[{"{", 
      RowBox[{"Hmn", ",", "Hres", ",", "\[IndentingNewLine]", 
       RowBox[{"ind", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Tuples", "[", 
           RowBox[{"{", 
            RowBox[{"#", ",", "#"}], "}"}], "]"}], "&"}], "[", 
