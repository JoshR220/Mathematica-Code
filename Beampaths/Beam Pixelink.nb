Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
    RowBox[{"bgrX", "=", 
     RowBox[{"Mean", "[", 
      RowBox[{"xVals", "[", 
       RowBox[{"[", 
        RowBox[{";;", "100"}], "]"}], "]"}], "]"}]}], ";", 
    RowBox[{"bgrY", "=", 
     RowBox[{"Mean", "[", 
      RowBox[{"yVals", "[", 
       RowBox[{"[", 
        RowBox[{";;", "100"}], "]"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x2", "=", 
     RowBox[{"xVals", "-", "bgrX"}]}], ";", 
    RowBox[{"y2", "=", 
     RowBox[{"yVals", "-", "bgrY"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maxX", "=", 
     RowBox[{"Max", "[", "x2", "]"}]}], ";", 
    RowBox[{"maxY", "=", 
     RowBox[{"Max", "[", "y2", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"intX", "=", 
     RowBox[{"Interpolation", "[", "xVals", "]"}]}], ";", 
    RowBox[{"intY", "=", 
     RowBox[{"Interpolation", "[", "yVals", "]"}]}], ";"}]}], "*)"}]], "Input",
 CellChangeTimes->{{3.8558542583996487`*^9, 3.855854361905806*^9}, {
   3.8558544128056974`*^9, 3.8558544226666236`*^9}, {3.8558551412365055`*^9, 
