Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
    RowBox[{"xRes", "=", 
     RowBox[{"x", "/.", 
      RowBox[{"(", 
       RowBox[{"FindRoot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"intX", "[", "x", "]"}], "\[Equal]", 
          RowBox[{"0.5", "maxX"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "500"}], "}"}]}], "]"}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"yRes", "=", 
     RowBox[{"y", "/.", 
      RowBox[{"(", 
       RowBox[{"FindRoot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"intY", "[", "y", "]"}], "\[Equal]", 
          RowBox[{"0.5", " ", "maxY"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"y", ",", "380"}], "}"}]}], "]"}], ")"}]}]}], ";"}]}], 
  "*)"}]], "Input",
 CellChangeTimes->{{3.8558549613144083`*^9, 3.8558550555548306`*^9}, {
  3.855855245791801*^9, 3.8558553251366596`*^9}, {3.8558583009590383`*^9, 
  3.8558583012421675`*^9}},
