Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   FractionBox[
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"xRes", ",", "yRes"}], "}"}], "-", "center2"}], "]"}], 
    SqrtBox[
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"Log", "[", "2", "]"}]}]]], "*", 
   RowBox[{"pixelWidth", "/", "um"}]}], "*)"}]], "Input",
