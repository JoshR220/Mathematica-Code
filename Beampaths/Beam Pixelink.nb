Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"center2", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Position", "[", 
        RowBox[{"x2", ",", "maxX"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
      RowBox[{
       RowBox[{"Position", "[", 
        RowBox[{"y2", ",", "maxY"}], "]"}], "[", 
       RowBox[{"[", 
