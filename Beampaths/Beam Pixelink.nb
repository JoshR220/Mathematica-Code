Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"fit", " ", "a", " ", "gaussian", " ", "profile"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"note", ":", " ", 
    RowBox[{
    "factor", " ", "of", " ", "2", " ", "in", " ", "exponent", " ", "is", " ", 
     RowBox[{"b", "/", "c"}], " ", "intensity", " ", "is", " ", "square", " ",
      "of", " ", "electric", " ", "field"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"xFitEqn", "=", 
     RowBox[{
      RowBox[{"a", "*", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "2"}], 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox[
            RowBox[{"(", 
             RowBox[{"x", "-", "x0"}], ")"}], "wx"], ")"}], "2"]}], "]"}]}], 
      "+", "b"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"yFitEqn", "=", 
     RowBox[{
      RowBox[{"a", "*", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "2"}], 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox[
