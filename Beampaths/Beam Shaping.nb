         "]"}]}], ",", "\[IndentingNewLine]", "distFreeMat", ",", 
       "\[IndentingNewLine]", "matDJ", ",", "\[IndentingNewLine]", 
       "BeamExprArr", ",", "\[IndentingNewLine]", "z", ",", 
       "\[IndentingNewLine]", "data"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"distFreeMat", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"mFree", "[", "#", "]"}], "&"}], "/@", "distFreePos"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"matDJ", "=", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Dot", "[", 
           RowBox[{"#1", ",", "#2"}], "]"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Values", "[", "elements2", "]"}], ",", 
           RowBox[{"distFreeMat", "[", 
            RowBox[{"[", 
             RowBox[{";;", 
