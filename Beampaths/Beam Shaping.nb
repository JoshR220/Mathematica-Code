          RowBox[{"Range", "[", 
           RowBox[{"0", ",", 
            RowBox[{"distFreePos", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", 
            RowBox[{"0.1", "mm"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "BeamExprArr", "]"}]}], "}"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", "data", "]"}], ";"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",
