Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ApertureEfficiency", "[", 
    RowBox[{
     RowBox[{"q", "[", 
      RowBox[{"z_", ",", "b_"}], "]"}], ",", "w_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "2"}], 
          SuperscriptBox[
           RowBox[{"(", 
            FractionBox["x", "#"], ")"}], "2"]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"-", "w"}], ",", "w"}], "}"}]}], "]"}], 
      RowBox[{"#", 
       SqrtBox[
        FractionBox["\[Pi]", "2"]]}]], "&"}], "[", 
    RowBox[{"BeamWaist", "[", 
     RowBox[{"q", "[", 
      RowBox[{"z", ",", "b"}], "]"}], "]"}], "]"}]}], ";"}]], "Input",
