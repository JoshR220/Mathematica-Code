Cell[BoxData[{
 RowBox[{
  RowBox[{"clipTMP", "=", 
   RowBox[{"2", "*", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       SqrtBox[
        FractionBox["2", 
         RowBox[{"\[Pi]", "*", 
          SuperscriptBox["w", "2"]}]]], 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "2"}], 
         FractionBox[
          SuperscriptBox["x", "2"], 
          SuperscriptBox["w", "2"]]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "w1", ",", "\[Infinity]"}], "}"}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"TrapClipping", "[", 
    RowBox[{"wTMP_", ",", "w1TMP_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"Evaluate", "[", "clipTMP", "]"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"w", "->", "wTMP"}], ",", 
       RowBox[{"w1", "->", "w1TMP"}]}], "}"}]}], "//", "N"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.857658987949189*^9, 3.857659114401967*^9}, {
  3.857659456525613*^9, 3.857659469967663*^9}},
