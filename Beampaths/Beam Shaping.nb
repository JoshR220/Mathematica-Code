              RowBox[{"mFree", "[", "z", "]"}], ".", "#"}], ")"}], "[", 
            RowBox[{"q", "[", 
             RowBox[{"z0", ",", "b0"}], "]"}], "]"}], "]"}], "]"}], "&"}], "/@",
         "matDJ"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"data", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"BeamExprArr", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "/.", 
            RowBox[{"{", 
