Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"OptimizeCollimation", "[", 
    RowBox[{
    "q0_List", ",", "fx_", ",", "fy_", ",", "placement_List", ",", 
     "endPos_"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"zArr", "=", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"placement", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", "endPos", ",", 
           RowBox[{"5", "mm"}]}], "]"}], "//", "N"}]}], ",", "z", ",", 
       "\[IndentingNewLine]", 
       RowBox[{"posArr", "=", 
        RowBox[{
         RowBox[{"Subsets", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{
             RowBox[{"placement", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{
              RowBox[{"placement", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "-", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"fy", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "+", 
                RowBox[{"fy", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}], ",", 
             RowBox[{"2", "mm"}]}], "]"}], ",", 
           RowBox[{"{", "2", "}"}]}], "]"}], "//", "N"}]}], ",", 
       "\[IndentingNewLine]", "waistX", ",", "waistXArr", ",", "x1", ",", 
       "\[IndentingNewLine]", "waistY", ",", "waistYArr", ",", "y1", ",", 
       "\[IndentingNewLine]", "collimateVal", ",", "collimateValArr", ",", 
       "result"}], "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"waistX", "=", 
       RowBox[{"BeamWaist", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"mFree", "[", "z", "]"}], ".", 
           RowBox[{"mFree", "[", 
            RowBox[{
             RowBox[{"placement", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "-", "x1"}], "]"}], ".", 
           RowBox[{"mLens", "[", "fx", "]"}], ".", 
           RowBox[{"mFree", "[", "x1", "]"}]}], ")"}], "[", 
         RowBox[{"q0", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"waistY", "=", 
       RowBox[{"BeamWaist", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"mFree", "[", "z", "]"}], ".", 
           RowBox[{"mFree", "[", 
            RowBox[{
             RowBox[{"placement", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "-", 
             RowBox[{"(", 
              RowBox[{"y1", "+", 
               RowBox[{"fy", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "+", 
               RowBox[{"fy", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}], "]"}], ".", 
           RowBox[{"mTelescope", "[", 
            RowBox[{
             RowBox[{"fy", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"fy", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ".", 
           RowBox[{"mFree", "[", "y1", "]"}]}], ")"}], "[", 
         RowBox[{"q0", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"collimateVal", "=", 
       RowBox[{
        RowBox[{"ComplexExpand", "[", 
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"waistX", "-", "waistY"}], ")"}], "2"], "/.", 
             RowBox[{"{", 
              RowBox[{"z", "->", "#"}], "}"}]}], "&"}], "/@", "zArr"}], "]"}],
          "]"}], "//", "Chop"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"collimateValArr", "=", 
       RowBox[{
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"collimateVal", "/.", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"x1", "->", "#1"}], ",", 
              RowBox[{"y1", "->", "#2"}]}], "}"}]}], "&"}], ",", 
          RowBox[{"posArr", "//", "Transpose"}]}], "]"}], "//", "Chop"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"result", "=", 
       RowBox[{"Sort", "[", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{"posArr", "->", "collimateValArr"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Return", "[", "result", "]"}], ";"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.854757955021881*^9, 3.854758013939054*^9}, {
   3.854759717063652*^9, 3.854759737521353*^9}, {3.854769736280497*^9, 
   3.854770054080586*^9}, {3.854771626667295*^9, 3.854771921924189*^9}, {
