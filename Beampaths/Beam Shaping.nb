Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FiberEfficiency", "[", 
    RowBox[{
     RowBox[{"q", "[", 
      RowBox[{"z_", ",", "b_"}], "]"}], ",", "w_", ",", "d_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox["2", 
       RowBox[{"\[Pi]", "*", "w", "*", "#"}]], "*", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"Integrate", "[", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                FractionBox["x", "#"], ")"}], "2"], "+", 
              SuperscriptBox[
               RowBox[{"(", 
                FractionBox["x", "w"], ")"}], "2"]}], ")"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", 
            RowBox[{"-", "d"}], ",", "d"}], "}"}]}], "]"}], ")"}], "2"]}], 
     "&"}], "[", 
    RowBox[{"BeamWaist", "[", 
     RowBox[{"q", "[", 
      RowBox[{"z", ",", "b"}], "]"}], "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.8544942935807657`*^9, 3.8544943016235533`*^9}, {
