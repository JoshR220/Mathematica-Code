Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"convert", " ", "double"}], "-", 
    RowBox[{"sided", " ", "to", " ", "single"}], "-", "sided"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"GetSingleSidedX", "[", "data_List", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OddQ", "[", "#2", "]"}], ",", 
        RowBox[{"#1", "[", 
         RowBox[{"[", 
          RowBox[{";;", 
           FractionBox[
            RowBox[{"#2", "-", "1"}], "2"]}], "]"}], "]"}], ",", 
        RowBox[{"#1", "[", 
         RowBox[{"[", 
          RowBox[{";;", 
           FractionBox[
            RowBox[{"#2", "-", "2"}], "2"]}], "]"}], "]"}]}], "]"}], "&"}], 
     "[", 
     RowBox[{"data", ",", 
      RowBox[{"Length", "[", "data", "]"}]}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.868057351948847*^9, 3.868057422110368*^9}, {
