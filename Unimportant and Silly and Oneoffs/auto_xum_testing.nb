Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"play", " ", "sound", " ", "when", " ", "finished"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Done", "[", 
     RowBox[{
      RowBox[{"type_", ":", "\"\<email\>\""}], ",", 
      RowBox[{"msg_", ":", "\"\<\>\""}]}], "]"}], ":=", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"soundDJ", "=", 
        RowBox[{"Play", "[", 
         RowBox[{
          RowBox[{"Sin", "[", 
           RowBox[{"600", "*", "\[Pi]", "*", "t"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", "0.6"}], "}"}]}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Switch", "[", 
        RowBox[{"type", ",", "\[IndentingNewLine]", "\"\<text\>\"", ",", 
         RowBox[{"SendMessage", "[", 
          RowBox[{"\"\<SMS\>\"", ",", "msg"}], "]"}], ",", 
         "\[IndentingNewLine]", "\"\<email\>\"", ",", 
         RowBox[{"SendMail", "[", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<To\>\"", "\[Rule]", "\"\<claytonho@g.ucla.edu\>\""}],
             ",", 
            RowBox[{"\"\<Subject\>\"", "\[Rule]", 
             RowBox[{"ToString", "[", "$MachineName", "]"}]}], ",", 
            RowBox[{
            "\"\<From\>\"", "\[Rule]", "\"\<claytonho@physics.ucla.edu\>\""}],
             ",", 
            RowBox[{
            "\"\<Server\>\"", "\[Rule]", "\"\<smtp.physics.ucla.edu\>\""}], 
            ",", 
            RowBox[{"\"\<EncryptionProtocol\>\"", "\[Rule]", "\"\<SSL\>\""}], 
            ",", 
            RowBox[{"\"\<PortNumber\>\"", "\[Rule]", "465"}], ",", 
            RowBox[{
            "\"\<UserName\>\"", "\[Rule]", 
             "\"\<claytonho@physics.ucla.edu\>\""}], ",", 
            RowBox[{"\"\<Body\>\"", "\[Rule]", "msg"}], ",", 
            RowBox[{"\"\<Password\>\"", "\[Rule]", "\"\<I2Ic1zIS2R\>\""}]}], 
           "|>"}], "]"}], ",", "\"\<none\>\"", ",", 
         RowBox[{"EmitSound", "[", "soundDJ", "]"}]}], "\[IndentingNewLine]", 
        "]"}], ";"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.826594436410388*^9, 3.826594442160191*^9}, {
