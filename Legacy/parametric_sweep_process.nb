   "create", " ", "lorentz", " ", "model", " ", "for", " ", "fitting"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"lorentzModel", "=", 
     FractionBox["\[Alpha]", 
      SqrtBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["x", "2"], "-", 
           SuperscriptBox["\[Beta]", "2"]}], ")"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "*", "\[Gamma]"}], ")"}], "2"]}]]]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lorentzConstraints", "=", 
     RowBox[{"{", "}"}]}], ";"}]}]}]], "Input",
