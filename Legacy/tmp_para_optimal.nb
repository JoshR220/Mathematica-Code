Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"convert", " ", "double"}], "-", 
    RowBox[{"sided", " ", "to", " ", "single"}], "-", "sided"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"GetSingleSidedX", "[", "data_List", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OddQ", "[", "#2", "]"}], ",", 
        RowBox[{"#1", "[", 
         RowBox[{"[", 
          RowBox[{";;", 
           FractionBox[
            RowBox[{"#2", "-", "1"}], "2"]}], "]"}], "]"}], ",", 
        RowBox[{"#1", "[", 
         RowBox[{"[", 
          RowBox[{";;", 
           FractionBox[
            RowBox[{"#2", "-", "2"}], "2"]}], "]"}], "]"}]}], "]"}], "&"}], 
     "[", 
     RowBox[{"data", ",", 
      RowBox[{"Length", "[", "data", "]"}]}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.868057351948847*^9, 3.868057422110368*^9}, {
  3.86805764013393*^9, 3.868057672667088*^9}, {3.868058265974622*^9, 
  3.868058266068492*^9}},
 CellLabel->
  "In[5335]:=",ExpressionUUID->"6e38a0ca-d618-46a3-88ee-e1b9fba272c5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GetSingleSidedY", "[", "data_List", "]"}], ":=", 
   RowBox[{"With", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"trimmedData", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"OddQ", "[", "#2", "]"}], ",", 
           RowBox[{"#1", "[", 
            RowBox[{"[", 
             RowBox[{";;", 
              FractionBox[
               RowBox[{"#2", "-", "1"}], "2"]}], "]"}], "]"}], ",", 
           RowBox[{"#1", "[", 
            RowBox[{"[", 
             RowBox[{";;", 
              FractionBox[
               RowBox[{"#2", "-", "2"}], "2"]}], "]"}], "]"}]}], "]"}], "&"}],
         "[", 
        RowBox[{"data", ",", 
         RowBox[{"Length", "[", "data", "]"}]}], "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "*", "#1"}], "-", 
          RowBox[{
           RowBox[{"UnitVector", "[", 
            RowBox[{"#2", ",", "1"}], "]"}], "*", 
           RowBox[{"#1", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}]}], ")"}], "&"}], "[", 
       RowBox[{"trimmedData", ",", 
        RowBox[{"Length", "[", "trimmedData", "]"}]}], "]"}], "]"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.868057676527474*^9, 3.8680577668575373`*^9}, {
   3.868057926792749*^9, 3.868057936240552*^9}, {3.868058619396123*^9, 
