Cell[CellGroupData[{

Cell["Dataset Processing", "Subsection",
 CellChangeTimes->{{3.868057345094574*^9, 3.868057349780558*^9}, {
  3.868585602213936*^9, 3.868585604134692*^9}, {3.88864857707878*^9, 
  3.8886485802715816`*^9}},ExpressionUUID->"5fa15fb7-4ede-4d15-9fef-\
4a5c9d4abc7a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "import", " ", "raw", " ", "counts", " ", "and", " ", "demodulate"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ProcessDatasetCounts", "[", "filename_", "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"actual", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"dataset", ",", "\[IndentingNewLine]", 
       RowBox[{"datasetFrequencies", "=", 
        RowBox[{"Import", "[", 
         RowBox[{"filename", ",", 
          RowBox[{"{", "\"\</datasets/xArr\>\"", "}"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"datasetCounts", "=", 
        RowBox[{"Import", "[", 
         RowBox[{"filename", ",", 
          RowBox[{"{", "\"\</datasets/results\>\"", "}"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", "correlatedSignal", ",", "correlatedAmplitude", 
       ",", "correlatedPhase", ",", "\[IndentingNewLine]", 
       RowBox[{"(*", "parameters", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"modulationAmplitude", "=", 
        RowBox[{"Import", "[", 
         RowBox[{"filename", ",", 
          RowBox[{"{", "\"\</datasets/modulation_amplitude_vpp\>\"", "}"}]}], 
         "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"shimVoltage", "=", 
        RowBox[{"Import", "[", 
         RowBox[{"filename", ",", 
          RowBox[{"{", "\"\</datasets/dc_channel_voltage\>\"", "}"}]}], 
         "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", "processing", "*)"}], "\[IndentingNewLine]", "results"}],
       "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"refine", " ", "dataset"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"dataset", "=", 
       RowBox[{"AssociationThread", "[", 
        RowBox[{"datasetFrequencies", "->", "datasetCounts"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"dataset", "=", 
         RowBox[{"KeySort", "[", "dataset", "]"}]}], ";"}], "*)"}], 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"demodulate", " ", "counts"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"correlatedSignal", "=", 
       RowBox[{"KeyValueMap", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          FractionBox[
           RowBox[{"Total", "[", 
            RowBox[{"Exp", "[", 
             RowBox[{"\[ImaginaryI]", "*", 
              RowBox[{"(", 
               RowBox[{"2", "*", "\[Pi]", "*", "#1", "*", "1*^6"}], ")"}], 
              "*", "#2"}], "]"}], "]"}], 
           RowBox[{"Length", "[", "#2", "]"}]], "&"}], ",", 
         "\[IndentingNewLine]", "dataset"}], "\[IndentingNewLine]", "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"correlatedAmplitude", ",", "correlatedSignal"}], "}"}], "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"AbsArg", "[", "correlatedSignal", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"format", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"results", "=", 
       RowBox[{"Transpose", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"datasetFrequencies", ",", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"shimVoltage", ",", 
              RowBox[{"Length", "[", "correlatedAmplitude", "]"}]}], "]"}], 
            ",", "##"}], "}"}], "&"}], "@@", 
         RowBox[{"{", 
          RowBox[{"correlatedAmplitude", ",", "correlatedSignal"}], "}"}]}], 
        "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"clean", " ", "up", " ", "mess"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Remove", "[", 
       RowBox[{"dataset", ",", "datasetFrequencies", ",", "datasetCounts"}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"ClearSystemCache", "[", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"ClearInOut", "[", "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"return", " ", "dataset"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Return", "[", "results", "]"}], ";"}]}], "\[IndentingNewLine]",
     "]"}]}]}]], "Input",
 CellChangeTimes->{{3.888648536682171*^9, 3.8886485726203203`*^9}, {
   3.888648758579917*^9, 3.8886487641404476`*^9}, {3.888649183505869*^9, 
   3.888649372846376*^9}, {3.888649432099969*^9, 3.888649434795904*^9}, {
   3.888649536138497*^9, 3.8886495513131356`*^9}, {3.8886496241354074`*^9, 
   3.8886496616934633`*^9}, 3.888649712342311*^9, {3.888649765629044*^9, 
   3.888649776460787*^9}, {3.888649828923542*^9, 3.8886498480913315`*^9}, {
   3.888649880457444*^9, 3.8886498975209103`*^9}, {3.8886512483309407`*^9, 
