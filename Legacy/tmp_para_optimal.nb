             RowBox[{"datasetRaw", "[", 
              RowBox[{"[", 
               RowBox[{";;", ",", "3"}], "]"}], "]"}], ",", 
             RowBox[{"datasetRaw", "[", 
              RowBox[{"[", 
               RowBox[{";;", ",", "4"}], "]"}], "]"}]}]}]}]}], "}"}], 
        "\[IndentingNewLine]", "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"results", "=", "datasetRaw"}], ";", "\[IndentingNewLine]", 
