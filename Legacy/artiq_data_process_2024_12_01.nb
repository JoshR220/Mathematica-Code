Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"processing", " ", "function"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"processfunc", "[", 
     RowBox[{"dataset_", ",", 
      RowBox[{"numFilter_Integer", ":", "20"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
       "datasetFinal", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"dataset", " ", "length"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"dataLength", "=", "2500"}], ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "mean", " ", "point", " ", "pairs", " ", "if", " ", "we", " ", 
          "have", " ", "5000", " ", "points"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"datasetY", "=", 
         RowBox[{"If", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "dataset", "]"}], "==", "2500"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"dataset", "[", 
            RowBox[{"[", 
             RowBox[{";;", ",", "2"}], "]"}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"Mean", "/@", 
            RowBox[{"ArrayReshape", "[", 
             RowBox[{
              RowBox[{"dataset", "[", 
               RowBox[{"[", 
                RowBox[{";;", ",", "2"}], "]"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"IntegerPart", "[", 
                 FractionBox[
                  RowBox[{"Length", "[", 
                   RowBox[{"dataset", "[", 
                    RowBox[{"[", 
                    RowBox[{";;", ",", "2"}], "]"}], "]"}], "]"}], "2"], 
                 "]"}], ",", "2"}], "}"}]}], "]"}]}]}], "\[IndentingNewLine]",
           "]"}]}]}], "\[IndentingNewLine]", "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"apply", " ", "mean", " ", "filter"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"datasetY", "=", 
        RowBox[{"MeanFilter", "[", 
         RowBox[{"datasetY", ",", "numFilter"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"make", " ", "3", "d", " ", 
          RowBox[{"w", "/", "y"}]}], "-", 
         RowBox[{"axis", " ", "as", " ", "\"\<time\>\""}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"datasetFinal", "=", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"ConstantArray", "[", 
            RowBox[{
             RowBox[{"dataset", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", "2500"}], "]"}], 
           ",", "\[IndentingNewLine]", 
           RowBox[{"Range", "[", "dataLength", "]"}], ",", 
           "\[IndentingNewLine]", "datasetY"}], "\[IndentingNewLine]", "}"}], 
         "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", "return", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{"datasetFinal", "[", 
         RowBox[{"[", 
          RowBox[{";;", ";;", "5"}], "]"}], "]"}], "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
