Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"sinc", " ", "-", " ", 
    RowBox[{"fit", " ", "model"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"fitModel", "=", 
    RowBox[{"1.", "-", 
     RowBox[{
      FractionBox[
       SuperscriptBox["\[Alpha]", "2."], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"x", "-", "\[Beta]"}], ")"}], "2."], "+", 
         SuperscriptBox["\[Alpha]", "2."]}], ")"}]], "*", 
      RowBox[{"(", 
       SuperscriptBox[
        RowBox[{"Sin", "[", 
         RowBox[{"1.", "*", "\[Pi]", "*", "\[Gamma]", 
          SqrtBox[
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"x", "-", "\[Beta]"}], ")"}], "2."], "+", 
            SuperscriptBox["\[Alpha]", "2."]}]]}], "]"}], "2."], ")"}]}], "-",
      "\[Delta]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.933729549093647*^9, 3.933729602020977*^9}, {
