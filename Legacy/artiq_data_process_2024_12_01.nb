Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
     "fit", " ", "each", " ", "data", " ", "bin", " ", "with", " ", "a", " ", 
      "sinc", " ", "function"}], " ", "&"}], " ", "extract", " ", "freq"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"fitSinc", "[", 
     RowBox[{"data_", ",", 
      RowBox[{"timeUS_", ":", "timeReadoutUS"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"fitting", " ", "variables"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
       "fitModelDJ", ",", "\[IndentingNewLine]", "fitRes", ",", 
        "\[IndentingNewLine]", "fitParams", ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"fit", " ", 
          RowBox[{"results", "/", "plots"}]}], "*)"}], "\[IndentingNewLine]", 
        "rawDataPlot", ",", "\[IndentingNewLine]", "fittedDataPlot", ",", 
        "\[IndentingNewLine]", "summaryResult", ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"guess", " ", "parameters"}], "*)"}], "\[IndentingNewLine]", 
        "guess\[Alpha]", ",", "\[IndentingNewLine]", 
        RowBox[{"guess\[Beta]", "=", 
         RowBox[{"data", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"First", "@", 
             RowBox[{"Ordering", "[", 
              RowBox[{
               RowBox[{"data", "[", 
                RowBox[{"[", 
                 RowBox[{";;", ",", "2"}], "]"}], "]"}], ",", "1"}], "]"}]}], 
            ",", "1"}], "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"guess\[Delta]", "=", 
         RowBox[{"1.", "-", 
          RowBox[{"data", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"First", "@", 
              RowBox[{"Ordering", "[", 
               RowBox[{
                RowBox[{"data", "[", 
                 RowBox[{"[", 
                  RowBox[{";;", ",", "2"}], "]"}], "]"}], ",", 
                RowBox[{"-", "1"}]}], "]"}]}], ",", "2"}], "]"}], "]"}]}]}]}],
        "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"prepare", " ", "fitting"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"fitModelDJ", "=", 
         RowBox[{"fitModel", "/.", 
          RowBox[{"{", 
           RowBox[{"\[Gamma]", "->", "timeUS"}], "}"}]}]}], ";"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"fitModelDJ", "=", 
        RowBox[{"fitModel", "/.", 
         RowBox[{"{", 
          RowBox[{"\[Delta]", "->", "0."}], "}"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"guess\[Alpha]", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"2.", "*", 
           RowBox[{"ArcSin", "[", 
            FractionBox[
             RowBox[{"Sqrt", "[", "#", "]"}], 
             RowBox[{"\[Pi]", "*", "timeUS"}]], "]"}]}], "&"}], "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1.", "-", 
            RowBox[{"Min", "[", 
             RowBox[{"data", "[", 
              RowBox[{"[", 
               RowBox[{";;", ",", "2"}], "]"}], "]"}], "]"}]}], ")"}], "-", 
          "guess\[Delta]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"fit", "!"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"fitRes", "=", 
        RowBox[{"NonlinearModelFit", "[", "\[IndentingNewLine]", 
         RowBox[{"data", ",", "\[IndentingNewLine]", 
