Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"sinc", " ", "-", " ", 
    RowBox[{"fit", " ", "model"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"fitModel", "=", 
    RowBox[{"1.", "-", 
     RowBox[{
      FractionBox[
       SuperscriptBox["\[Alpha]", "2."], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"x", "-", "\[Beta]"}], ")"}], "2."], "+", 
         SuperscriptBox["\[Alpha]", "2."]}], ")"}]], "*", 
      RowBox[{"(", 
       SuperscriptBox[
        RowBox[{"Sin", "[", 
         RowBox[{"1.", "*", "\[Pi]", "*", "\[Gamma]", 
          SqrtBox[
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"x", "-", "\[Beta]"}], ")"}], "2."], "+", 
            SuperscriptBox["\[Alpha]", "2."]}]]}], "]"}], "2."], ")"}]}], "-",
      "\[Delta]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.933729549093647*^9, 3.933729602020977*^9}, {
   3.9337299631629753`*^9, 3.933729970561409*^9}, 3.9337300918376923`*^9, {
   3.9337301244654417`*^9, 3.933730124867745*^9}, {3.933730185760539*^9, 
   3.9337302962457533`*^9}, {3.933731766359438*^9, 3.9337317669326897`*^9}, 
   3.933731806227927*^9, 3.9337323107520447`*^9, {3.9337323505030622`*^9, 
   3.9337323863509693`*^9}, {3.9337324299836607`*^9, 3.93373245047432*^9}, {
   3.933732548997797*^9, 3.933732557174473*^9}, {3.934139198079578*^9, 
   3.9341391986479826`*^9}},
 CellLabel->"In[74]:=",ExpressionUUID->"9c233fc2-0f7a-462a-adf5-d4976ddd042b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
     "fit", " ", "each", " ", "data", " ", "bin", " ", "with", " ", "a", " ", 
      "sinc", " ", "function"}], " ", "&"}], " ", "extract", " ", "freq"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"fitSinc", "[", 
     RowBox[{"data_", ",", "timeUS_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"fitting", " ", "variables"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
       "fitModelDJ", ",", "\[IndentingNewLine]", "fitRes", ",", 
        "\[IndentingNewLine]", "fitParams", ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"fit", " ", 
          RowBox[{"results", "/", "plots"}]}], "*)"}], "\[IndentingNewLine]", 
        "rawDataPlot", ",", "\[IndentingNewLine]", "fittedDataPlot", ",", 
        "\[IndentingNewLine]", "summaryResult", ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"guess", " ", "parameters"}], "*)"}], "\[IndentingNewLine]", 
        "guess\[Alpha]", ",", "\[IndentingNewLine]", 
        RowBox[{"guess\[Beta]", "=", 
         RowBox[{"data", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"First", "@", 
             RowBox[{"Ordering", "[", 
              RowBox[{
               RowBox[{"data", "[", 
                RowBox[{"[", 
                 RowBox[{";;", ",", "2"}], "]"}], "]"}], ",", "1"}], "]"}]}], 
            ",", "1"}], "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"guess\[Delta]", "=", 
         RowBox[{"1.", "-", 
          RowBox[{"data", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"First", "@", 
              RowBox[{"Ordering", "[", 
               RowBox[{
                RowBox[{"data", "[", 
                 RowBox[{"[", 
                  RowBox[{";;", ",", "2"}], "]"}], "]"}], ",", 
                RowBox[{"-", "1"}]}], "]"}]}], ",", "2"}], "]"}], "]"}]}]}]}],
        "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"prepare", " ", "fitting"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"fitModelDJ", "=", 
        RowBox[{"fitModel", "/.", 
         RowBox[{"{", 
          RowBox[{"\[Gamma]", "->", "timeUS"}], "}"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"guess\[Alpha]", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"2.", "*", 
           RowBox[{"ArcSin", "[", 
            FractionBox[
             RowBox[{"Sqrt", "[", "#", "]"}], 
             RowBox[{"\[Pi]", "*", "timeUS"}]], "]"}]}], "&"}], "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1.", "-", 
            RowBox[{"Min", "[", 
             RowBox[{"data", "[", 
              RowBox[{"[", 
               RowBox[{";;", ",", "2"}], "]"}], "]"}], "]"}]}], ")"}], "-", 
          "guess\[Delta]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"fit", "!"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"fitRes", "=", 
        RowBox[{"NonlinearModelFit", "[", "\[IndentingNewLine]", 
         RowBox[{"data", ",", "\[IndentingNewLine]", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{"fitModelDJ", ",", "\[IndentingNewLine]", 
            RowBox[{"\[Delta]", ">", "0."}]}], "\[IndentingNewLine]", "}"}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\[Alpha]", ",", "\[Beta]", ",", "\[Delta]"}], "}"}], 
             ",", "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{
              "guess\[Alpha]", ",", "guess\[Beta]", ",", "guess\[Delta]"}], 
              "}"}]}], "\[IndentingNewLine]", "}"}], "]"}], ",", 
          "\[IndentingNewLine]", "x"}], "\[IndentingNewLine]", "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"get", " ", "fit", " ", "params"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"fitParams", "=", 
        RowBox[{"Style", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
           "fitRes", "[", "\"\<ParameterConfidenceIntervalTable\>\"", "]"}], 
           "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Background", "->", "White"}], ",", 
            RowBox[{"FontColor", "->", "Black"}], ",", 
            RowBox[{"FontSize", "->", "15"}]}], "}"}]}], 
         "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"plot", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"rawDataPlot", "=", 
        RowBox[{"ListLinePlot", "[", "\[IndentingNewLine]", 
         RowBox[{"data", ",", "\[IndentingNewLine]", 
          RowBox[{"PlotRange", "->", "Full"}]}], "\[IndentingNewLine]", 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"fittedDataPlot", "=", 
        RowBox[{"Plot", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"fitRes", "[", "x", "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"x", ",", 
            RowBox[{"data", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
            RowBox[{"data", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"PlotRange", "->", "Full"}], ",", "\[IndentingNewLine]", 
          RowBox[{"PlotStyle", "->", "Red"}]}], "\[IndentingNewLine]", 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"summaryResult", "=", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{"fitParams", ",", "\[IndentingNewLine]", 
          RowBox[{"Show", "[", "\[IndentingNewLine]", 
           RowBox[{
           "rawDataPlot", ",", "\[IndentingNewLine]", "fittedDataPlot"}], 
           "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "}"}]}], 
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Beta]", "/.", 
           RowBox[{"fitRes", "[", "\"\<BestFitParameters\>\"", "]"}]}], ",", 
          "fitRes", ",", "summaryResult"}], "}"}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.9337281556656933`*^9, 3.933728165893359*^9}, {
  3.9337293866188107`*^9, 3.933729411148065*^9}, {3.9337325474551373`*^9, 
