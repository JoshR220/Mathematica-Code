Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"displace", " ", "ramsey", " ", "fit", " ", "function"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"fitfunc", "=", 
     RowBox[{
      RowBox[{"4.", 
       SuperscriptBox["\[CapitalOmega]", "2."], 
       SuperscriptBox["\[Tau]", "2."], 
       SuperscriptBox[
        RowBox[{"Sinc", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"2.", "*", "\[Pi]"}], ")"}], "*", 
           FractionBox[
            RowBox[{
             RowBox[{"(", 
              RowBox[{"x", "-", "\[Beta]"}], ")"}], "*", "\[Tau]"}], "2."]}], 
          "+", "1.*^-5"}], "]"}], "2."], 
       SuperscriptBox[
        RowBox[{"Sin", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"2.", "*", "\[Pi]"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{
            FractionBox[
             RowBox[{
              RowBox[{"(", 
               RowBox[{"x", "-", "\[Beta]"}], ")"}], "*", 
              RowBox[{"(", 
               RowBox[{"T", "+", "\[Tau]"}], ")"}]}], "2."], "+", "\[Phi]"}], 
           ")"}]}], "]"}], "2."]}], "+", "\[Delta]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"set", " ", "fixed", " ", "values"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fitfunc", "=", 
     RowBox[{"fitfunc", "/.", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Tau]", "->", 
         RowBox[{"(", 
          RowBox[{"timeEGGSus", "*", "1.*^-6"}], ")"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"T", "->", 
         RowBox[{"(", 
          RowBox[{"timeRamseyUS", "*", "1.*^-6"}], ")"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\[Beta]", "->", 
         RowBox[{"Mean", "[", 
          RowBox[{"dsN", "[", 
           RowBox[{"[", 
            RowBox[{";;", ",", "1"}], "]"}], "]"}], "]"}]}]}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"\[Phi]", "->", "0."}], "*)"}], "\[IndentingNewLine]", 
       "}"}]}]}], ";"}]}]}]], "Input",
