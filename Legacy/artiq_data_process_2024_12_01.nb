Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PSKFunc", "[", "psknum_", "]"}], ":=", 
   RowBox[{"With", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"phiArr", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Riffle", "[", 
           RowBox[{
            RowBox[{"ConstantArray", "[", 
             RowBox[{"0.", ",", "#"}], "]"}], ",", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"\[Pi]", ",", "#"}], "]"}]}], "]"}], "&"}], "[", 
         RowBox[{"IntegerPart", "[", 
          FractionBox[
           RowBox[{"psknum", "+", "1"}], "2"], "]"}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"detArr", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[Delta]", "*", "T"}], ")"}], "*", 
           FractionBox[
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", 
              RowBox[{"IntegerPart", "[", "#", "]"}]}], "]"}], 
            RowBox[{"#", "+", "1."}]]}], "&"}], "[", "psknum", "]"}]}]}], 
      "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Return", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[CapitalOmega]", "*", 
          FractionBox["T", 
           RowBox[{"psknum", "+", "1."}]]}], ")"}], "*", 
        RowBox[{"Sinc", "[", 
         RowBox[{"\[Delta]", "*", 
          FractionBox["T", 
           RowBox[{"2.", "*", 
            RowBox[{"(", 
             RowBox[{"psknum", "+", "1."}], ")"}]}]]}], "]"}], "*", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"\[ImaginaryI]", "*", "\[Delta]"}], ")"}]}], "*", 
          FractionBox["T", 
           RowBox[{"2.", "*", 
            RowBox[{"(", "psknum", ")"}]}]]}], "]"}], "*", 
        RowBox[{"Total", "[", 
         RowBox[{"Exp", "[", 
          RowBox[{"\[ImaginaryI]", "*", 
           RowBox[{"(", 
            RowBox[{"detArr", "+", "phiArr"}], ")"}]}], "]"}], "]"}]}], 
       "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]], "Input",
