Cell["Create Fit Basis", "Subsubsection",
 CellChangeTimes->{{3.933886463223291*^9, 
  3.933886466148037*^9}},ExpressionUUID->"88bf3251-b68a-42e0-af50-\
04548685f6e8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"data", " ", "structures", " ", "for", " ", "fitting"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Beta]nArr", "=", 
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           FractionBox["1", "\[Beta]0"]}], "*", 
          SqrtBox[
           RowBox[{"#", "+", "1"}]]}], "]"}], "&"}], ",", 
       RowBox[{"IntegerPart", "[", 
        RowBox[{"numPhonons", "+", "1"}], "]"}], ",", "0"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalOmega]nArr", "=", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"\[Eta]0", "*", 
         RowBox[{"Exp", "[", 
          RowBox[{"-", 
           FractionBox[
            SuperscriptBox["\[Eta]0", "2."], "2."]}], "]"}]}], ")"}], 
       RowBox[{"Abs", "[", "\[CapitalDelta]n", "]"}]], "*", 
      RowBox[{"Array", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"LaguerreL", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Abs", "[", "\[CapitalDelta]n", "]"}], ",", 
           SuperscriptBox["\[Eta]0", "2."]}], "]"}], "&"}], ",", 
        RowBox[{"IntegerPart", "[", 
         RowBox[{"numPhonons", "+", "1"}], "]"}], ",", "0"}], "]"}]}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.933886509524455*^9, 
  3.9338865184929028`*^9}},ExpressionUUID->"f2dbd113-034b-4e72-803e-\
ae698f617cd9"]
}, Open  ]],

