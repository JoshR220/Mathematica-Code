Cell[CellGroupData[{

Cell["Fit Line to Extract Drift From Fitted Sinc Summary", "Subsubsection",
 CellChangeTimes->{{3.93373289983814*^9, 3.933732908300006*^9}, {
  3.933733595598565*^9, 3.933733600493425*^9}, {3.9341439001360836`*^9, 
  3.93414390092735*^9}, {3.9341456653018227`*^9, 3.934145681597373*^9}, {
  3.9341457709313755`*^9, 
  3.9341457711874743`*^9}},ExpressionUUID->"febd6187-27fe-49d1-ac5f-\
d9af26815b50"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "filter", " ", "noisy", " ", "data", " ", "to", " ", "ease", " ", 
    "fitting"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"filteredDataTMP", "=", "fittedSincAbsFreqDataDriftkHz"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"filteredDataTMP", "[", 
      RowBox[{"[", 
       RowBox[{";;", ",", "2"}], "]"}], "]"}], "=", 
     RowBox[{"MedianFilter", "[", 
      RowBox[{
       RowBox[{"filteredDataTMP", "[", 
        RowBox[{"[", 
         RowBox[{";;", ",", "2"}], "]"}], "]"}], ",", "8"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"try", " ", "to", " ", "fit", " ", "drift", " ", "results"}], 
      " ", "&"}], " ", "plot", " ", "results"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fittedSincSummaryFitWeights", "=", 
     RowBox[{
      RowBox[{
       FractionBox["1.", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"#", "[", "\"\<Error\>\"", "]"}], ")"}], "2."]], "&"}], "/@", 
      RowBox[{"fittedSincAbsFreqDataDriftkHzErr", "[", 
       RowBox[{"[", 
        RowBox[{";;", ",", "2"}], "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"fit", "!"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fittedSincSummaryFitRes", "=", 
     RowBox[{"LinearModelFit", "[", "\[IndentingNewLine]", 
      RowBox[{"filteredDataTMP", ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"1", ",", "t"}], "}"}], ",", "\[IndentingNewLine]", "t"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Weights", "->", "fittedSincSummaryFitWeights"}], "*)"}], 
      "\[IndentingNewLine]", "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9341451756474047`*^9, 3.93414524425694*^9}, {
  3.934145351014769*^9, 3.934145412732832*^9}, {3.9341454575616693`*^9, 
  3.9341455139430375`*^9}, {3.9341456302638416`*^9, 3.934145644108268*^9}, {
  3.9341456983817987`*^9, 3.934145709477497*^9}, {3.93414586389196*^9, 
