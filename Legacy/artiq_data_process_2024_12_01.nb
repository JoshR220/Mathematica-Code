Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"process", " ", "dataset"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"datasetProcessed", "=", 
     RowBox[{"ThresholdCounts", "[", 
      RowBox[{
       RowBox[{"dataset", "[", 
        RowBox[{"[", 
         RowBox[{";;", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "6", ",", "2"}], "}"}]}], "]"}], "]"}], ",", 
       "3"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"datasetProcessed", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", "datasetProcessed", "]"}], "*", 
       RowBox[{"{", 
        RowBox[{"ftwToFrequencyMHz", ",", "1.*^-3", ",", "1"}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"freqCenter", "=", 
     RowBox[{"Mean", "[", 
      RowBox[{"datasetProcessed", "[", 
       RowBox[{"[", 
        RowBox[{";;", ",", "1"}], "]"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"process", " ", "rsb", " ", "and", " ", "bsb"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dsR", "=", 
     RowBox[{
      RowBox[{"Select", "[", 
       RowBox[{"datasetProcessed", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "<", "freqCenter"}], "&"}]}], 
       "]"}], "[", 
      RowBox[{"[", 
       RowBox[{";;", ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dsB", "=", 
     RowBox[{
      RowBox[{"Select", "[", 
