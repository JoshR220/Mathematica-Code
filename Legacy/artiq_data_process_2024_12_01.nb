Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "import", " ", "dataset", " ", "from", " ", "dir", " ", "and", " ", 
     "filename"}], ",", " ", 
    RowBox[{"return", " ", "dataset", " ", "and", " ", "parameters"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ImportDatasetARTIQTimestamped", "[", 
     RowBox[{
      RowBox[{"filedirs_", ":", 
       RowBox[{"(", 
        RowBox[{"_String", "|", "_List"}], ")"}]}], ",", 
      RowBox[{"ridName", ":", 
       RowBox[{"(", 
        RowBox[{"_String", "|", "_Integer"}], ")"}]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"filenameDJ", ",", "\[IndentingNewLine]", 
        RowBox[{"fileDirectories", "=", "filedirs"}], ",", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"dataset", " ", "values"}], "*)"}], "\[IndentingNewLine]", 
        "datasetRaw", ",", "\[IndentingNewLine]", "timestampedCounts", ",", 
        "\[IndentingNewLine]", "parameterList"}], "\[IndentingNewLine]", 
       "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"ensure", " ", "filedirs", " ", "is", " ", "a", " ", "list"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Head", "[", "fileDirectories", "]"}], "==", "String"}], 
         ",", "\[IndentingNewLine]", 
         RowBox[{"fileDirectories", "=", 
          RowBox[{"{", "filedirs", "}"}]}]}], "\[IndentingNewLine]", "]"}], 
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"ensure", " ", "import", " ", "directory", " ", "exists"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"AnyTrue", "[", 
           RowBox[{"DirectoryQ", "/@", "filedirs"}], "]"}]}], ",", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "stop", " ", "execution", " ", "if", " ", "import", " ", 
           "directory", " ", 
           RowBox[{"doesn", "'"}], "t", " ", "exist"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
          "MessageDialog", "[", 
           "\"\<Failure :(\\nError: Import directory not found.\>\"", "]"}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{
          "FrontEndTokenExecute", "[", "\"\<EvaluatorAbort\>\"", "]"}], 
          ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"filenameDJ", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"FileNames", "[", 
           RowBox[{
            RowBox[{"\"\<*\>\"", "<>", 
             RowBox[{"ToString", "[", "#", "]"}], "<>", "\"\<*.h5\>\""}], ",",
             "filedirs", ",", "Infinity"}], "]"}], "&"}], "[", "ridName", 
         "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"stop", " ", "execution", " ", "if", " ", "file", " ", 
         RowBox[{"doesn", "'"}], "t", " ", "exist"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "filenameDJ", "]"}], "==", "0"}], ",", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"MessageDialog", "[", 
           RowBox[{"\"\<Failure :(\\nError: Specified file not found (\>\"", "<>", 
            RowBox[{"ToString", "[", "ridName", "]"}], "<>", "\"\<).\>\""}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{
          "FrontEndTokenExecute", "[", "\"\<EvaluatorAbort\>\"", "]"}]}], ",",
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"filenameDJ", "=", 
           RowBox[{"First", "@", "filenameDJ"}]}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "extract", " ", "file", " ", "results", " ", "as", " ", "list", " ", 
         "and", " ", "parameters", " ", "as", " ", "an", " ", "association"}],
         "*)"}], "\[IndentingNewLine]", 
       RowBox[{"datasetRaw", "=", 
        RowBox[{"Import", "[", 
         RowBox[{"filenameDJ", ",", 
          RowBox[{"{", "\"\</datasets/results\>\"", "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"timestampedCounts", "=", 
        RowBox[{"Import", "[", 
         RowBox[{"filenameDJ", ",", 
          RowBox[{"{", "\"\</datasets/timestamped_counts\>\"", "}"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"parameterList", "=", 
        RowBox[{"Import", "[", 
         RowBox[{"filenameDJ", ",", 
          RowBox[{"{", 
           RowBox[{"\"\<Attributes\>\"", ",", "\"\</arguments\>\""}], "}"}]}],
          "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{
         "datasetRaw", ",", "timestampedCounts", ",", "parameterList"}], 
         "}"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}]}]], "Input",
