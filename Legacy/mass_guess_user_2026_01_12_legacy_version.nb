               SuperscriptBox[
                RowBox[{"chainFreq", "[", 
                 RowBox[{"[", 
                  RowBox[{"dim", ",", "ion"}], "]"}], "]"}], "2"]}]]}]}]}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"dim", ",", "3"}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"ion", ",", "numIons"}], "}"}]}], "\[IndentingNewLine]", 
         "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
