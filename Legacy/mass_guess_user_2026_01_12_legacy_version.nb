         RowBox[{"Length", "[", "mArr", "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"chainFreq", "=", 
         RowBox[{"Transpose", "[", "xyzFreq", "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"scaleArr", "=", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
