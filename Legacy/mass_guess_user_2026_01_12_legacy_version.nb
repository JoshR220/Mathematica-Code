  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"MotionalModes2", "[", 
     RowBox[{"mArr_List", ",", "xyzFreq_List", ",", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"\[Lambda]3_", ":", "0.0"}], ",", 
        RowBox[{"\[Lambda]4_", ":", "0.0"}], ","}], "*)"}], 
      RowBox[{"offsetArr_List", ":", 
       RowBox[{"{", 
