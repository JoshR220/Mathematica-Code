                    RowBox[{"r0eqArr", "[", 
                    RowBox[{"[", 
                    RowBox[{";;", ",", "k"}], "]"}], "]"}]}], "]"}], ")"}], 
                  "3"]], ",", 
                RowBox[{"{", 
                 RowBox[{"k", ",", 
                  RowBox[{"Delete", "[", 
                   RowBox[{
                    RowBox[{"Range", "[", "numIons", "]"}], ",", "ion"}], 
                   "]"}]}], "}"}]}], "]"}], " ", ")"}]}], 
            "\[IndentingNewLine]", "+", 
            RowBox[{
             FractionBox["qe", 
              RowBox[{"l0", "*", "amu"}]], "*", 
             FractionBox[
              RowBox[{"offsetArr", "[", 
               RowBox[{"[", "dim", "]"}], "]"}], 
