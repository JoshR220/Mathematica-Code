                   RowBox[{"r0eqArr", "[", 
                    RowBox[{"[", 
                    RowBox[{"dim", ",", "k"}], "]"}], "]"}]}], ")"}], 
                 SuperscriptBox[
                  RowBox[{"(", 
                   RowBox[{"Norm", "[", 
