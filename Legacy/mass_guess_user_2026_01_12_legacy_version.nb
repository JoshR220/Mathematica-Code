            RowBox[{"{", "1", "}"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "set", " ", "up", " ", "force", " ", "balancing", " ", "equations", 
         " ", "for", " ", "equilibrium", " ", "positions"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"L0EQlist", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"r0eqArr", "[", 
