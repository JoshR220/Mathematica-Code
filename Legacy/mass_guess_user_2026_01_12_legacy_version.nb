Cell[CellGroupData[{

Cell["Secular Frequency Calculation", "Subsection",
 CellChangeTimes->{{3.896671281701329*^9, 3.89667129609478*^9}, {
  3.896828270465576*^9, 
  3.896828273727934*^9}},ExpressionUUID->"e667165b-cb33-44fc-8ea7-\
90d4faecfd60"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"secular", " ", "frequency", " ", "calculations"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[Omega]SecRadial", "[", 
      RowBox[{"q_", ",", "a_", ",", "\[Beta]_"}], "]"}], ":=", 
     RowBox[{
      FractionBox["\[Beta]", "2"], 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        FractionBox[
         SuperscriptBox["q", "2"], "2"], "-", "a"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Omega]SecAxial", "[", 
      RowBox[{"a_", ",", "\[Beta]_"}], "]"}], ":=", 
     RowBox[{
      FractionBox["\[Beta]", "2"], 
      RowBox[{"Sqrt", "[", 
       RowBox[{"2", "*", "a"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Omega]SecXYZ", "[", 
      RowBox[{"q_", ",", "ar_", ",", "az_", ",", "\[Beta]_"}], "]"}], ":=", 
     RowBox[{
      FractionBox["\[Beta]", "2"], 
      RowBox[{"Sqrt", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          FractionBox[
           SuperscriptBox["q", "2"], "2"], "-", 
          RowBox[{"(", 
           RowBox[{"az", "-", "ar"}], ")"}]}], ",", 
         RowBox[{
          FractionBox[
           SuperscriptBox["q", "2"], "2"], "-", 
          RowBox[{"(", 
           RowBox[{"az", "+", "ar"}], ")"}]}], ",", 
         RowBox[{"2", "*", "az"}]}], "}"}], "]"}]}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.889582364949794*^9, 3.889582497007784*^9}, {
  3.889583183927239*^9, 3.8895832071530867`*^9}, {3.8896297090107107`*^9, 
  3.8896297143448753`*^9}, {3.896663730921279*^9, 3.8966637311914263`*^9}},
 CellLabel->
  "In[1760]:=",ExpressionUUID->"641e1538-aba5-4910-b596-c89e0c3fa2c5"]
