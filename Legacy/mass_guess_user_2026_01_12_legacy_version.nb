            RowBox[{"xyzFreq", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "3"}], "]"}], "]"}], "2"], ")"}]}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"l0", "=", 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox["ke2", 
            RowBox[{
             RowBox[{"mArr", "[", 
              RowBox[{"[", 
               RowBox[{"-", "1"}], "]"}], "]"}], "*", "amu", "*", 
             SuperscriptBox[
              RowBox[{"xyzFreq", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", 
                 RowBox[{"-", "1"}]}], "]"}], "]"}], "2"]}]], ")"}], 
          FractionBox["1", "3"]]}], ",", "\[IndentingNewLine]", "guessr0eq", 
        ",", "r0eq", ",", "r0eqArr", ",", "r0eqArrFinal", ",", "L0EQlist", 
        ",", "\[IndentingNewLine]", "L0Mn", ",", "R0Mn", ",", "trapFreqMat", 
        ",", "\[IndentingNewLine]", "idMat", ",", "L0Mn2", ",", "L0MnMix", 
        ",", "L0MnSelf", ",", "L0MnFinal", ",", "\[IndentingNewLine]", 
        "res"}], "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "set", " ", "up", " ", "infra", " ", "to", " ", "guess", " ", 
        "equilibrium", " ", "positions"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"r0eqArr", " ", "=", " ", 
        RowBox[{"Array", "[", 
