Cell[CellGroupData[{

Cell["Relevant Functions", "Subsection",
 CellChangeTimes->{{3.901479187445284*^9, 
  3.9014791904059362`*^9}},ExpressionUUID->"12801550-a009-45d2-901b-\
5b88db182bc1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "do", " ", "a", " ", "complex", " ", "least", " ", "squares", " ", "fit", 
    " ", "to", " ", "the", " ", "data", " ", "and", " ", "extract", " ", 
    "the", " ", "voltage", " ", "minimum"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ExtractVoltageComplexFit", "[", "dataset_", "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"least", " ", "squares"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"lsqM", "=", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"ConstantArray", "[", 
             RowBox[{"1", ",", 
              RowBox[{"Length", "[", "dataset", "]"}]}], "]"}], ",", 
            RowBox[{"dataset", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "1"}], "]"}], "]"}]}], "}"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"lsqB", "=", 
         RowBox[{"dataset", "[", 
          RowBox[{"[", 
           RowBox[{";;", ",", "2"}], "]"}], "]"}]}], ",", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", "models", "*)"}], "\[IndentingNewLine]", "lsqConst", 
        ",", "\[IndentingNewLine]", "lsqSlope", ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"processed", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
        "voltageMinimum"}], "\[IndentingNewLine]", "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"do", " ", "least", " ", "squares", " ", "on", " ", "data"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"lsqConst", ",", "lsqSlope"}], "}"}], "=", 
        RowBox[{"LeastSquares", "[", 
         RowBox[{"lsqM", ",", "lsqB"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"extract", " ", "minimum", " ", "from", " ", "parameters"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"voltageMinimum", "=", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Re", "[", "lsqConst", "]"}], "*", 
             RowBox[{"Re", "[", "lsqSlope", "]"}]}], ")"}], "+", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Im", "[", "lsqConst", "]"}], "*", 
             RowBox[{"Im", "[", "lsqSlope", "]"}]}], ")"}]}], 
          SuperscriptBox[
           RowBox[{"Norm", "[", "lsqSlope", "]"}], "2"]]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "voltageMinimum", "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.8933059259279947`*^9, 3.893305936046115*^9}, {
  3.8933070060904512`*^9, 3.8933070464525747`*^9}, {3.893344683521441*^9, 
  3.893344767206064*^9}, {3.89334483085704*^9, 3.893344862015226*^9}, {
  3.8933449897687883`*^9, 3.8933449992792397`*^9}, {3.893345041452388*^9, 
  3.893345179617578*^9}, {3.8933452703484488`*^9, 3.893345276583662*^9}, {
  3.8933454900755577`*^9, 3.893345491169454*^9}, {3.901477213053645*^9, 
  3.9014772245738993`*^9}, {3.901477407204014*^9, 3.901477408491344*^9}},
 CellLabel->
