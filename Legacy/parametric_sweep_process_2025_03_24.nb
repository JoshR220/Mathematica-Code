Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"guess", " ", "amplitude", " ", "values"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"guessAmplitudeFitParams", "=", 
     RowBox[{"Values", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", 
          RowBox[{"First", "@", 
           RowBox[{"Ordering", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{";;", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"-", "1"}]}], "]"}]}], "]"}], "]"}], "&"}], "/@", 
       "reducedAmplitudeData"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
