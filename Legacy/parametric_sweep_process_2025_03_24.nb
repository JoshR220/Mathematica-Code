Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "create", " ", "lorentz", " ", "model", " ", "for", " ", "fitting"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"amplitudeModel", "=", 
     FractionBox["\[Alpha]", 
      SqrtBox[
