          RowBox[{"{", 
           RowBox[{
            RowBox[{"#2", "*", 
             FractionBox["0.001", "2"], 
             SqrtBox[
              RowBox[{
               RowBox[{"2", "*", 
                SuperscriptBox["#1", "2"]}], "-", "0.001"}]]}], ",", "#1", 
