33887136ae02"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"create", " ", "sinc", " ", "model", " ", "for", " ", "fitting"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"sincModel", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         SuperscriptBox["\[Alpha]", "2"], 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"x", "-", "\[Beta]"}], ")"}], "2"], "+", 
          SuperscriptBox["\[Alpha]", "2"]}]], "*", 
        SuperscriptBox[
         RowBox[{"Sin", "[", 
          RowBox[{"\[Pi]", "*", "\[Gamma]", "*", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"x", "-", "\[Beta]"}], ")"}], "2"], "+", 
             SuperscriptBox["\[Alpha]", "2"]}], "]"}]}], "]"}], "2"]}], ")"}],
       "+", "\[Delta]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"sincModel", "=", 
      RowBox[{
       RowBox[{
        FractionBox[
         SuperscriptBox["\[Alpha]", "3"], 
         RowBox[{"Abs", "[", "\[Alpha]", "]"}]], 
        RowBox[{"(", 
         RowBox[{
          FractionBox["1", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"x", "-", "\[Beta]"}], ")"}], "2"], "+", 
            SuperscriptBox["\[Alpha]", "2"]}]], "*", 
          SuperscriptBox[
           RowBox[{"Sin", "[", 
            RowBox[{"\[Gamma]", "*", 
             RowBox[{"Sqrt", "[", 
              RowBox[{
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"x", "-", "\[Beta]"}], ")"}], "2"], "+", 
               SuperscriptBox["\[Alpha]", "2"]}], "]"}]}], "]"}], "2"]}], 
         ")"}]}], "+", "\[Delta]"}]}], ";"}], "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.8996060716427717`*^9, 3.89960607373109*^9}, {
  3.899606306982938*^9, 3.899606331915073*^9}, {3.899607712380865*^9, 
  3.899607714606291*^9}, {3.899608302440249*^9, 3.899608304667342*^9}, {
  3.8996085133288383`*^9, 3.8996085134080257`*^9}, {3.899608888280566*^9, 
