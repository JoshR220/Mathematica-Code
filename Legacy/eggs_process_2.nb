Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"import", " ", "already", " ", "demodulated", " ", "dataset"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ProcessDataset", "[", "filename_", "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"actual", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"datasetRaw", "=", 
         RowBox[{"Import", "[", 
          RowBox[{"filename", ",", 
           RowBox[{"{", "\"\</datasets/results\>\"", "}"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", "parameters", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"modulationAmplitude", "=", 
           RowBox[{"Import", "[", 
            RowBox[{"filename", ",", 
             RowBox[{
             "{", "\"\</datasets/modulation_amplitude_vpp\>\"", "}"}]}], 
            "]"}]}], ","}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"(*", "processing", "*)"}], "\[IndentingNewLine]", "results", 
        ",", "\[IndentingNewLine]", "carrierFreqMHz", ",", 
        "\[IndentingNewLine]", "countThreshold"}], "\[IndentingNewLine]", 
       "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"convert", " ", "data", " ", "to", " ", "frequency"}], ",", 
        " ", "counts"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"results", "=", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"datasetRaw", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "1"}], "]"}], "]"}], "*", 
            "ftwToFrequencyMHz"}], ",", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{
              RowBox[{"AOM", "/", "readout"}], " ", "frequency"}], ",", " ", 
             "MHz"}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"datasetRaw", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "4"}], "]"}], "]"}], "*", "1.*^-3"}], ",", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"sideband", " ", "frequency"}], ",", " ", "kHz"}], 
            "*)"}], "\[IndentingNewLine]", 
           RowBox[{"datasetRaw", "[", 
            RowBox[{"[", 
             RowBox[{";;", ",", "2"}], "]"}], "]"}]}], 
          RowBox[{"(*", "counts", "*)"}], "\[IndentingNewLine]", "}"}], 
         "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"calculate", " ", "values", " ", "for", " ", "processing"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"guess", " ", 
         RowBox[{"AOM", "/", "readout"}], " ", "frequency"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"carrierFreqMHz", "=", 
        RowBox[{"Mean", "[", 
         RowBox[{"results", "[", 
          RowBox[{"[", 
           RowBox[{";;", ",", "1"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"find", " ", "count", " ", "threshold"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"countThreshold", "=", 
        RowBox[{"FindThreshold", "[", 
         RowBox[{"results", "[", 
          RowBox[{"[", 
           RowBox[{";;", ",", "3"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"process", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "create", " ", "copy", " ", "of", " ", "dataset", " ", "and", " ", 
         "directly", " ", "threshold", " ", "counts", " ", "into", " ", 
         "states"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"results", "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", 
           RowBox[{"-", "1"}]}], "]"}], "]"}], "=", 
        RowBox[{"1.", "-", 
         RowBox[{"UnitStep", "[", 
          RowBox[{
           RowBox[{"results", "[", 
            RowBox[{"[", 
             RowBox[{";;", ",", 
              RowBox[{"-", "1"}]}], "]"}], "]"}], "-", "countThreshold"}], 
          "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"average", " ", "states", " ", "into", " ", "probabilities"}],
         "*)"}], "\[IndentingNewLine]", 
       RowBox[{"results", "=", 
        RowBox[{
         RowBox[{"GroupBy", "[", "\[IndentingNewLine]", 
          RowBox[{"results", ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{";;", "2"}], "]"}], "]"}], "&"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"N", "[", 
             RowBox[{"Mean", "[", "#", "]"}], "]"}], "&"}]}], 
          "\[IndentingNewLine]", "]"}], "//", "Values"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"group", " ", "by", " ", 
         RowBox[{"RSB", "/", "BSB"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"results", "=", 
        RowBox[{"GroupBy", "[", "\[IndentingNewLine]", 
         RowBox[{"results", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"First", "[", "#", "]"}], "<", "carrierFreqMHz"}], 
           "&"}]}], "\[IndentingNewLine]", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"results", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"results", "[", "True", "]"}], ",", 
          RowBox[{"results", "[", "False", "]"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"remove", " ", 
          RowBox[{"AOM", "/", "readout"}], " ", "frequency", " ", "and", " ", 
          "sort", " ", "by", " ", "x"}], "-", "axis"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"results", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"SortBy", "[", 
           RowBox[{"#", ",", "First"}], "]"}], "&"}], "/@", 
         RowBox[{"results", "[", 
          RowBox[{"[", 
           RowBox[{";;", ",", ";;", ",", 
            RowBox[{"2", ";;"}]}], "]"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"clean", " ", "up", " ", "mess"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"Remove", "[", "datasetRaw", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"ClearSystemCache", "[", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"return", " ", "dataset"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "results", "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.888648536682171*^9, 3.8886485726203203`*^9}, {
   3.888648758579917*^9, 3.8886487641404476`*^9}, {3.888649183505869*^9, 
   3.888649372846376*^9}, {3.888649432099969*^9, 3.888649434795904*^9}, {
   3.888649536138497*^9, 3.8886495513131356`*^9}, {3.8886496241354074`*^9, 
   3.8886496616934633`*^9}, 3.888649712342311*^9, {3.888649765629044*^9, 
   3.888649776460787*^9}, {3.888649828923542*^9, 3.8886498480913315`*^9}, {
   3.888649880457444*^9, 3.8886498975209103`*^9}, {3.8886512483309407`*^9, 
   3.8886512516254506`*^9}, {3.889241196414268*^9, 3.889241196863369*^9}, {
