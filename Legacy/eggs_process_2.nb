Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"guess", " ", "sinc", " ", "model", " ", "fit", " ", "params"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Beta]RSBguess", ",", "\[Alpha]RSBguess"}], "}"}], "=", 
     RowBox[{"rsbDataset", "[", 
      RowBox[{"[", 
       RowBox[{"First", "@", 
        RowBox[{"Ordering", "[", 
         RowBox[{
          RowBox[{"rsbDataset", "[", 
           RowBox[{"[", 
            RowBox[{";;", ",", "2"}], "]"}], "]"}], ",", 
          RowBox[{"-", "1"}]}], "]"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Gamma]RSBguess", "=", 
     RowBox[{"timeHeatSeconds", "*", "1000"}]}], ";"}], 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"factor", " ", "of", " ", "1000", " ", "is", " ", 
       RowBox[{"b", "/", "c"}], " ", "x"}], "-", 
      RowBox[{"axis", " ", "is", " ", "in", " ", "kHz"}]}], ")"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Delta]RSBguess", "=", 
     RowBox[{"Median", "[", 
      RowBox[{"rsbDataset", "[", 
       RowBox[{"[", 
        RowBox[{";;", ",", "2"}], "]"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"guessRSBSincFitParams", "=", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Alpha]RSBguess", "-", "\[Delta]RSBguess"}], ",", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"\[Alpha]", " ", "is", " ", "rabi", " ", "frequency"}], ";"}],
        "*)"}], "\[IndentingNewLine]", "\[Beta]RSBguess", ",", 
      RowBox[{"(*", 
       RowBox[{"\[Beta]", " ", "is", " ", "resonance"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"\[Gamma]RSBguess", "*", "scaleFactorDJ"}], ",", 
      RowBox[{"(*", 
       RowBox[{"\[Gamma]", " ", "is", " ", "evolution", " ", "time"}], "*)"}],
       "\[IndentingNewLine]", "\[Delta]RSBguess"}], 
     RowBox[{"(*", 
      RowBox[{"\[Delta]", " ", "is", " ", "offset"}], "*)"}], 
     "\[IndentingNewLine]", "}"}]}]}]}]], "Input",
