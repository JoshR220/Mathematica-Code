Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "process", " ", "results", " ", "specific", " ", "to", " ", "each", " ", 
    "experiment", " ", "type"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Switch", "[", 
    RowBox[{
    "procStyle", ",", "\[IndentingNewLine]", "\"\<SBR\>\"", ",", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{"(*", 
      RowBox[{"process", " ", "rsb", " ", "and", " ", "bsb"}], "*)"}], 
     "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"freqCenter", "=", 
       RowBox[{"Mean", "[", 
        RowBox[{"datasetProcessed", "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", "1"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"dsR", "=", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{"datasetProcessed", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "<", "freqCenter"}], "&"}]}], 
         "]"}], "[", 
        RowBox[{"[", 
         RowBox[{";;", ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"dsB", "=", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{"datasetProcessed", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ">=", "freqCenter"}], "&"}]}], 
         "]"}], "[", 
        RowBox[{"[", 
         RowBox[{";;", ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"dsR", ",", "dsB"}], "}"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Values", "[", 
          RowBox[{"CollateData", "[", 
           RowBox[{"#", ",", 
            RowBox[{"{", "1", "}"}]}], "]"}], "]"}], "&"}], "/@", 
        RowBox[{"{", 
         RowBox[{"dsR", ",", "dsB"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
      "\t", 
      RowBox[{"dsRawPlot", "=", 
       RowBox[{"{", 
        RowBox[{"dsR", ",", "dsB"}], "}"}]}], ";", "\[IndentingNewLine]", 
      "\t", 
      RowBox[{"(*", 
       RowBox[{"process", " ", "phonon", " ", "number"}], "*)"}], 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"dsN", "=", "dsR"}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{
       RowBox[{"dsN", "[", 
        RowBox[{"[", 
         RowBox[{";;", ",", "2"}], "]"}], "]"}], "=", 
       RowBox[{"CoherentC", "[", 
        RowBox[{
         RowBox[{"dsR", "[", 
          RowBox[{"[", 
           RowBox[{";;", ",", "2"}], "]"}], "]"}], "/", 
         RowBox[{"dsB", "[", 
          RowBox[{"[", 
           RowBox[{";;", ",", "2"}], "]"}], "]"}]}], "]"}]}], ";"}], ",", 
     "\[IndentingNewLine]", "\t", "\[IndentingNewLine]", "\t", 
     RowBox[{"(*", "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "\"\<RAP\>\"", ",", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"dsN", "=", 
       RowBox[{"Values", "[", 
        RowBox[{"CollateData", "[", 
         RowBox[{
          RowBox[{"datasetProcessed", "[", 
           RowBox[{"[", 
            RowBox[{";;", ",", 
             RowBox[{"{", 
              RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "]"}], ",", 
          RowBox[{"{", "1", "}"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"dsRawPlot", "=", 
       RowBox[{"{", "dsN", "}"}]}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{
       RowBox[{"dsN", "[", 
        RowBox[{"[", 
         RowBox[{";;", ",", "2"}], "]"}], "]"}], "=", 
       RowBox[{"CoherentARP", "[", 
        RowBox[{"1.", "-", 
         RowBox[{"dsN", "[", 
          RowBox[{"[", 
           RowBox[{";;", ",", "2"}], "]"}], "]"}]}], "]"}]}], ";"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "\"\<729\>\"", ",", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"dsN", "=", 
       RowBox[{"Values", "[", 
