        RowBox[{"[", 
         RowBox[{";;", ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"dsB", "=", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{"datasetProcessed", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ">=", "freqCenter"}], "&"}]}], 
         "]"}], "[", 
        RowBox[{"[", 
         RowBox[{";;", ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"dsR", ",", "dsB"}], "}"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Values", "[", 
          RowBox[{"CollateData", "[", 
           RowBox[{"#", ",", 
            RowBox[{"{", "1", "}"}]}], "]"}], "]"}], "&"}], "/@", 
        RowBox[{"{", 
         RowBox[{"dsR", ",", "dsB"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
