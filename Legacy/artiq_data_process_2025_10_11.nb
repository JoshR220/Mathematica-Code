Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "process", " ", "results", " ", "specific", " ", "to", " ", "each", " ", 
    "experiment", " ", "type"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Switch", "[", 
    RowBox[{
    "procStyle", ",", "\[IndentingNewLine]", "\"\<SBR\>\"", ",", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{"(*", 
      RowBox[{"process", " ", "rsb", " ", "and", " ", "bsb"}], "*)"}], 
     "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"freqCenter", "=", 
       RowBox[{"Mean", "[", 
        RowBox[{"datasetProcessed", "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", "1"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"dsR", "=", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{"datasetProcessed", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "<", "freqCenter"}], "&"}]}], 
