           RowBox[{
            RowBox[{"2", "\[Pi]"}], "+", 
            RowBox[{"Clip", "[", 
             RowBox[{
              RowBox[{"data", "[", 
               RowBox[{"[", 
                RowBox[{";;", ",", "2"}], "]"}], "]"}], ",", 
              RowBox[{"{", 
