Cell[CellGroupData[{

Cell["Extract Minimum", "Section",
 CellChangeTimes->{{3.8929508825232763`*^9, 3.892950890366887*^9}, {
  3.89296838624815*^9, 
  3.8929683866791973`*^9}},ExpressionUUID->"a44b091e-316e-4cd5-b465-\
9695743c18dc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "takes", " ", "a", " ", "complex", " ", "signal", " ", "as", " ", "a", " ",
     "function", " ", "of", " ", "a", " ", "variable", " ", 
    RowBox[{"(", 
     RowBox[{"i", ".", "e", ".", " ", "voltage"}], ")"}], " ", "and", " ", 
    "extracts", " ", "the", " ", "minimum"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ExtractVoltageComplexFit", "[", "dataset_", "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"(*", "datasets", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"datasetVoltage", "=", 
         RowBox[{"dataset", "[", 
          RowBox[{"[", 
           RowBox[{";;", ",", "1"}], "]"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"datasetComplex", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Re", "[", "#", "]"}], ",", 
             RowBox[{"Im", "[", "#", "]"}]}], "}"}], "&"}], "/@", 
          RowBox[{"dataset", "[", 
           RowBox[{"[", 
            RowBox[{";;", ",", "2"}], "]"}], "]"}]}]}], ",", 
        "\[IndentingNewLine]", "datasetProjection", ",", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", "models", "*)"}], "\[IndentingNewLine]", "complexModel",
         ",", "\[IndentingNewLine]", "complexModelParams", ",", 
        "\[IndentingNewLine]", "parametricModel", ",", "\[IndentingNewLine]", 
        "parametricModelParams", ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"processed", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
        "voltageMinimum"}], "\[IndentingNewLine]", "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "fit", " ", "dataset", " ", "to", " ", "a", " ", "line", " ", "in", 
        " ", "the", " ", "complex", " ", "plane"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"complexModel", "=", 
        RowBox[{"LinearModelFit", "[", 
         RowBox[{"datasetComplex", ",", "x", ",", "x"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"complexModelParams", "=", 
        RowBox[{"complexModel", "[", "\"\<BestFitParameters\>\"", "]"}]}], 
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "get", " ", "projection", " ", "of", " ", "dataset", " ", "along", 
         " ", "line", " ", "in", " ", "complex", " ", "plane"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"datasetProjection", "=", 
        RowBox[{"datasetComplex", ".", 
         RowBox[{"Normalize", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"complexModelParams", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "fit", " ", "voltage", " ", "to", " ", "the", " ", "fitted", " ", 
         "complex", " ", "line"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"parametricModel", "=", 
        RowBox[{"LinearModelFit", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"datasetVoltage", ",", "datasetProjection"}], "}"}], 
           "]"}], ",", "x", ",", "x"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"parametricModelParams", "=", 
        RowBox[{"parametricModel", "[", "\"\<BestFitParameters\>\"", "]"}]}], 
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "calculate", " ", "voltage", " ", "that", " ", "minimizes", " ", 
         "distance", " ", "from", " ", "center"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"voltageMinimum", "=", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["1", 
           RowBox[{"parametricModelParams", "[", 
            RowBox[{"[", "2", "]"}], "]"}]]}], 
         RowBox[{"(", 
          RowBox[{
           FractionBox[
            RowBox[{
             RowBox[{"complexModelParams", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "*", 
             RowBox[{"complexModelParams", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], 
            RowBox[{"1", "+", 
             SuperscriptBox[
              RowBox[{"complexModelParams", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "2"]}]], "+", 
           RowBox[{"parametricModelParams", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "voltageMinimum", "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.892968493874032*^9, 3.892968519624531*^9}, {
   3.892968607188488*^9, 3.892968613290123*^9}, 3.8929686529601088`*^9, {
   3.892968708268105*^9, 3.8929687423628607`*^9}, {3.8929687793381233`*^9, 
   3.89296888641754*^9}, {3.893008640314122*^9, 3.893008976444563*^9}, {
   3.893009018710635*^9, 3.8930090584441547`*^9}, 3.8930091250706472`*^9, {
   3.8930094989656267`*^9, 3.89300951124505*^9}, {3.893009759853909*^9, 
   3.893009815948184*^9}},
 CellLabel->
  "In[3160]:=",ExpressionUUID->"e903dc3c-3f64-4c67-b9ee-d3b545ba8238"],

