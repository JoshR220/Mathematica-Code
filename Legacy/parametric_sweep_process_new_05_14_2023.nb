                RowBox[{"-", "\[Pi]"}], ",", 
                RowBox[{"-", 
                 FractionBox["\[Pi]", "2"]}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "0"}], "}"}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Pi]", ",", 
