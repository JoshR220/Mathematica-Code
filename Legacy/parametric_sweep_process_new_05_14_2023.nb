Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "create", " ", "lorentz", " ", "model", " ", "for", " ", "fitting"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"amplitudeModel", "=", 
     FractionBox["\[Alpha]", 
      SqrtBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["x", "2"], "-", 
           SuperscriptBox["\[Beta]", "2"]}], ")"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "*", "\[Gamma]"}], ")"}], "2"]}]]]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"amplitudeConstraints", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Beta]", "<", "4"}], ",", 
       RowBox[{"\[Beta]", ">", "0"}]}], "}"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.8908622811725388`*^9, 3.890862282170538*^9}, {
   3.890862330689254*^9, 3.890862364696516*^9}, {3.8908624280391235`*^9, 
