Cell["Linear Complex Fit", "Subsection",
 CellChangeTimes->{{3.889060152428585*^9, 3.8890601645231133`*^9}, {
   3.8908754823190203`*^9, 3.890875482510666*^9}, 3.8908759713804336`*^9, {
