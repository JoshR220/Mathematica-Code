Cell[CellGroupData[{

Cell["Extract Minimum", "Section",
 CellChangeTimes->{{3.8929508825232763`*^9, 3.892950890366887*^9}, {
  3.89296838624815*^9, 
  3.8929683866791973`*^9}},ExpressionUUID->"a44b091e-316e-4cd5-b465-\
9695743c18dc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "do", " ", "a", " ", "complex", " ", "least", " ", "squares", " ", "fit", 
    " ", "to", " ", "the", " ", "data", " ", "and", " ", "extract", " ", 
    "the", " ", "voltage", " ", "minimum"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ExtractVoltageComplexFit", "[", "dataset_", "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"least", " ", "squares"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"lsqM", "=", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"ConstantArray", "[", 
             RowBox[{"1", ",", 
              RowBox[{"Length", "[", "dataset", "]"}]}], "]"}], ",", 
            RowBox[{"dataset", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "1"}], "]"}], "]"}]}], "}"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"lsqB", "=", 
         RowBox[{"dataset", "[", 
          RowBox[{"[", 
           RowBox[{";;", ",", "2"}], "]"}], "]"}]}], ",", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", "models", "*)"}], "\[IndentingNewLine]", "lsqConst", 
        ",", "\[IndentingNewLine]", "lsqSlope", ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"processed", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
        "voltageMinimum"}], "\[IndentingNewLine]", "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"do", " ", "least", " ", "squares", " ", "on", " ", "data"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"lsqConst", ",", "lsqSlope"}], "}"}], "=", 
        RowBox[{"LeastSquares", "[", 
         RowBox[{"lsqM", ",", "lsqB"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"extract", " ", "minimum", " ", "from", " ", "parameters"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"voltageMinimum", "=", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{
           RowBox[{
            RowBox[{"Re", "[", "lsqConst", "]"}], "*", 
            RowBox[{"Re", "[", "lsqSlope", "]"}]}], "+", 
           RowBox[{
            RowBox[{"Im", "[", "lsqConst", "]"}], 
            RowBox[{"Im", "[", "lsqSlope", "]"}]}]}], 
          SuperscriptBox[
           RowBox[{"Norm", "[", "lsqSlope", "]"}], "2"]]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "voltageMinimum", "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.8933059259279947`*^9, 3.893305936046115*^9}, {
  3.8933070060904512`*^9, 3.8933070464525747`*^9}, {3.893344683521441*^9, 
  3.893344767206064*^9}, {3.89334483085704*^9, 3.893344862015226*^9}, {
