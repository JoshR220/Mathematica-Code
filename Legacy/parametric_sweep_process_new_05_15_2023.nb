Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"fit", " ", "amplitude", " ", "model"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"amplitudeFits", "=", 
      RowBox[{"ParallelMap", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"FindFit", "[", 
          RowBox[{
           RowBox[{"reducedAmplitudeData", "[", 
            RowBox[{"[", "#", "]"}], "]"}], ",", 
           RowBox[{"Join", "[", 
            RowBox[{"{", 
             RowBox[{"amplitudeModel", ",", "amplitudeConstraints"}], "}"}], 
            "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Alpha]", ",", 
             RowBox[{"(*", "\[Beta]", "*)"}], 
             RowBox[{"{", 
              RowBox[{"\[Beta]", ",", 
               RowBox[{"reducedAmplitudePeakFreq", "[", 
                RowBox[{"[", "#", "]"}], "]"}]}], "}"}], ",", "\[Gamma]"}], 
            "}"}], ",", "x"}], "]"}], "&"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Range", "[", 
         RowBox[{"Length", "[", "reducedAmplitudeData", "]"}], "]"}]}], 
       "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"amplitudeFits", "=", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"Keys", "[", "reducedAmplitudeData", "]"}], "->", 
       "amplitudeFits"}], "]"}]}], ";"}]}]}]], "Input",
