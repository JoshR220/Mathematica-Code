Cell[CellGroupData[{

Cell["Rotate Phase (Phase Unwrapping)", "Subsection",
 CellChangeTimes->{{3.893013815923934*^9, 
  3.89301382099832*^9}},ExpressionUUID->"ca9f92e5-ff4c-411b-bae5-\
5a980debc3d5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PhaseRotate", "[", 
    RowBox[{"dataset_", ",", "angle_"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"phaseX", "=", 
        RowBox[{"dataset", "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", "1"}], "]"}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"phaseValues", "=", 
        RowBox[{"dataset", "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", "2"}], "]"}], "]"}]}], ",", 
       "\[IndentingNewLine]", "rotatedPhaseValues"}], "\[IndentingNewLine]", 
      "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"rotatedPhaseValues", "=", 
        RowBox[{"Arg", "[", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"\[ImaginaryI]", "*", 
            RowBox[{"dataset", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "2"}], "]"}], "]"}]}], "]"}], "*", 
          RowBox[{"Exp", "[", 
           RowBox[{"\[ImaginaryI]", "*", "angle"}], "]"}]}], "]"}]}], ";"}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rotatedPhaseValues", "=", 
       RowBox[{"Arg", "[", 
        RowBox[{"Exp", "[", 
         RowBox[{"\[ImaginaryI]", "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"dataset", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "2"}], "]"}], "]"}], "-", "angle"}], ")"}]}],
          "]"}], "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"phaseX", ",", "rotatedPhaseValues"}], "}"}], "]"}], 
       "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.893014968854604*^9, 3.8930149707411757`*^9}, {
  3.893040860036109*^9, 3.8930408775083303`*^9}},
 CellLabel->
  "In[2050]:=",ExpressionUUID->"6a74ef3d-4333-4723-a34f-0f897e68faca"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PhaseThreshold", "[", "dataset_", "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"phaseValues", "=", 
        RowBox[{"dataset", "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", "2"}], "]"}], "]"}]}], ",", 
       "\[IndentingNewLine]", "phaseThreshold1", ",", "\[IndentingNewLine]", 
       "phaseMean1", ",", "\[IndentingNewLine]", "phaseValues2", ",", 
       "\[IndentingNewLine]", "phaseMean2", ",", "\[IndentingNewLine]", 
       "phaseThreshold2"}], "\[IndentingNewLine]", "}"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"cycle", " ", "1"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"phaseThreshold1", "=", 
       RowBox[{"FindThreshold", "[", 
        RowBox[{"Arg", "[", 
         RowBox[{"Exp", "[", 
          RowBox[{"\[ImaginaryI]", "*", "phaseValues"}], "]"}], "]"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"phaseMean1", "=", 
       RowBox[{"GroupBy", "[", 
        RowBox[{"phaseValues", ",", 
         RowBox[{
          RowBox[{"#", ">", "phaseThreshold1"}], "&"}], ",", "Mean"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"phaseMean1", "=", 
       RowBox[{"Mean", "[", 
        RowBox[{"Values", "[", "phaseMean1", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"cycle", " ", "2"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"phaseValues2", "=", 
       RowBox[{"Arg", "[", 
        RowBox[{"Exp", "[", 
         RowBox[{"\[ImaginaryI]", "*", 
          RowBox[{"(", 
           RowBox[{"phaseValues", "-", "phaseMean1"}], ")"}]}], "]"}], 
