Cell["Fit Amplitude", "Subsection",
 CellChangeTimes->{{3.889060152428585*^9, 3.8890601645231133`*^9}, {
   3.890862184836545*^9, 3.8908621859644213`*^9}, {3.8929453265177603`*^9, 
