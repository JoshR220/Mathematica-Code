Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
    RowBox[{"PhaseThresholdRDX", "[", "dataset_", "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"phaseValues", "=", 
         RowBox[{"dataset", "[", 
          RowBox[{"[", 
           RowBox[{";;", ",", "2"}], "]"}], "]"}]}], ",", 
        "\[IndentingNewLine]", "phaseThreshold1", ",", "\[IndentingNewLine]", 
        "phaseValues2", ",", "\[IndentingNewLine]", "phaseThreshold2", ",", 
        "\[IndentingNewLine]", "phaseThreshold3", ",", "\[IndentingNewLine]", 
        "th2", ",", "th3"}], "\[IndentingNewLine]", "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"phaseThreshold1", "=", 
        RowBox[{"FindThreshold", "[", 
         RowBox[{"Arg", "[", 
          RowBox[{"Exp", "[", 
           RowBox[{"\[ImaginaryI]", "*", "phaseValues"}], "]"}], "]"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"phaseValues2", "=", 
          RowBox[{"Arg", "[", 
           RowBox[{"Exp", "[", 
            RowBox[{"\[ImaginaryI]", "*", 
             RowBox[{"(", 
              RowBox[{"phaseValues", "-", "phaseThreshold1"}], ")"}]}], "]"}],
            "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"phaseThreshold2", "=", 
          RowBox[{"FindThreshold", "[", "phaseValues2", "]"}]}], ";"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"th2", "=", 
        RowBox[{"GroupBy", "[", 
         RowBox[{"phaseValues", ",", 
          RowBox[{
           RowBox[{"#", ">", "phaseThreshold1"}], "&"}], ",", "Mean"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"th3", "=", 
        RowBox[{"Mean", "[", 
         RowBox[{"Values", "[", "th2", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"phaseThreshold3", "=", 
          RowBox[{"Total", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"Values", "[", "th2", "]"}], "]"}], "]"}]}], ";"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "th3", "]"}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "*)"}]], "Input",
