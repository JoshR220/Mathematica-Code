          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "\[ImaginaryI]"}], "*", "\[Phi]"}], "+", 
            RowBox[{
             RowBox[{"Conjugate", "[", "\[Alpha]", "]"}], "*", 
             RowBox[{"(", 
              RowBox[{"x", "+", 
               RowBox[{"\[ImaginaryI]", "*", "y"}]}], ")"}]}]}], "]"}], "+", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"\[ImaginaryI]", "*", "\[Phi]"}], "-", 
            RowBox[{"\[Alpha]", "*", 
             RowBox[{"(", 
              RowBox[{"x", "-", 
               RowBox[{"\[ImaginaryI]", "*", "y"}]}], ")"}]}]}], "]"}]}], 
