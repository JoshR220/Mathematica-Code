Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"prepare", " ", "for", " ", "fourier"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"charPrep", "=", 
     RowBox[{"charRe", "+", 
      RowBox[{"\[ImaginaryI]", "*", "charIm"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"charPrep", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], "*", "#"}], "]"}], "*", 
          "charRe"}], "+", 
         RowBox[{"1", "*", "\[ImaginaryI]", "*", 
          RowBox[{"Exp", "[", 
           RowBox[{"\[ImaginaryI]", "*", 
            RowBox[{"(", "#", ")"}]}], "]"}], "*", "charIm"}]}], "&"}], "[", 
       "\[Theta]rot", "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rotMat", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], 
          RowBox[{"i", "+", "j"}]], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "#1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "#2"}], "}"}]}], "]"}], "&"}], "@@", 
      RowBox[{"Dimensions", "[", "charPrep", "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
