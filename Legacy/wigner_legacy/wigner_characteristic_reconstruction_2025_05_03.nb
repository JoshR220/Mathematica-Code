       RowBox[{"-", "1.5"}], ",", "1.5", ",", "0.15"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gridVals", "[", 
    RowBox[{"[", 
     RowBox[{";;", ",", ";;", ",", "3"}], "]"}], "]"}], "=", 
   RowBox[{
    RowBox[{"Apply", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Chi]Coherent", "[", 
