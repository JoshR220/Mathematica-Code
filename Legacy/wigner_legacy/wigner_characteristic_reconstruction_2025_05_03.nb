Cell[BoxData[{
 RowBox[{
  RowBox[{"gridVals", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", "y", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "1.5"}], ",", "1.5", ",", "0.15"}], "}"}], ",", 
     RowBox[{"{", 
