Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "characteristic", " ", "function", " ", "for", " ", "a", " ", "cat", " ", 
    "state"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Chi]Cat", "[", 
     RowBox[{"x_", ",", "y_", ",", "\[Alpha]_", ",", "\[Phi]_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["x", "2."], "+", 
            SuperscriptBox["y", "2."]}], ")"}]}], "/", "2."}], "]"}], 
       RowBox[{"2.", "*", 
        RowBox[{"(", 
         RowBox[{"1.", "+", 
          RowBox[{
           RowBox[{"Cos", "[", "\[Phi]", "]"}], "*", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", 
              SuperscriptBox[
               RowBox[{"Abs", "[", "\[Alpha]", "]"}], "2."]}], "/", "2."}], 
            "]"}]}]}], ")"}]}]]}], "*", 
     RowBox[{"(", "\[IndentingNewLine]", 
      RowBox[{"1.", "+", 
       RowBox[{"Exp", "[", 
        RowBox[{"2.", "*", "\[ImaginaryI]", "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"y", "*", 
            RowBox[{"Re", "[", "\[Alpha]", "]"}]}], "-", 
           RowBox[{"x", "*", 
            RowBox[{"Im", "[", "\[Alpha]", "]"}]}]}], ")"}]}], "]"}], "+", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           SuperscriptBox[
            RowBox[{"Abs", "[", "\[Alpha]", "]"}], "2."]}], "/", "2."}], 
         "]"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "\[ImaginaryI]"}], "*", "\[Phi]"}], "+", 
            RowBox[{
             RowBox[{"Conjugate", "[", "\[Alpha]", "]"}], "*", 
             RowBox[{"(", 
              RowBox[{"x", "+", 
               RowBox[{"\[ImaginaryI]", "*", "y"}]}], ")"}]}]}], "]"}], "+", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"\[ImaginaryI]", "*", "\[Phi]"}], "-", 
            RowBox[{"\[Alpha]", "*", 
             RowBox[{"(", 
              RowBox[{"x", "-", 
               RowBox[{"\[ImaginaryI]", "*", "y"}]}], ")"}]}]}], "]"}]}], 
         ")"}]}]}], "\[IndentingNewLine]", ")"}]}]}], ";"}]}]], "Input",
