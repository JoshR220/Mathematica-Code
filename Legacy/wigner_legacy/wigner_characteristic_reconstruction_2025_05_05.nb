Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "prepare", " ", "calculation", " ", "of", " ", "fourier", " ", 
    "matrices"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Beta]x", "=", 
     RowBox[{"dsGridCharRe", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", ";;", ",", "1"}], "]"}], "]"}]}], ";", 
    RowBox[{"\[Beta]y", "=", 
     RowBox[{"dsGridCharRe", "[", 
      RowBox[{"[", 
       RowBox[{";;", ",", "1", ",", "2"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Gamma]x", "=", 
     RowBox[{"dsCharReWigner", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", ";;", ",", "1"}], "]"}], "]"}]}], ";", 
    RowBox[{"\[Gamma]y", "=", 
     RowBox[{"dsCharReWigner", "[", 
      RowBox[{"[", 
       RowBox[{";;", ",", "1", ",", "2"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"create", " ", "manual", " ", "fourier", " ", "matrices"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Mki", "=", 
     RowBox[{"Exp", "[", 
      RowBox[{"2.", "*", "\[ImaginaryI]", "*", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"\[Gamma]y", ",", "\[Beta]x"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Fjl", "=", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "2."}], "*", "\[ImaginaryI]", "*", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"\[Beta]y", ",", "\[Gamma]x"}], "]"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
