   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"scde1", "=", 
     RowBox[{"FourierMatrix", "[", 
      RowBox[{
       RowBox[{"Dimensions", "[", "dsCharReWigner", "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
