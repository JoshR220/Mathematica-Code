Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"fftFunc", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{"-", 
    RowBox[{"Sum", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"dsCharReWigner", "[", 
          RowBox[{"[", 
           RowBox[{"iy", ",", "ix", ",", "3"}], "]"}], "]"}], "+", 
         RowBox[{"\[ImaginaryI]", "*", 
          RowBox[{"dsCharImWigner", "[", 
           RowBox[{"[", 
            RowBox[{"iy", ",", "ix", ",", "3"}], "]"}], "]"}]}]}], ")"}], "*",
        "\[IndentingNewLine]", 
       RowBox[{"Exp", "[", 
        RowBox[{"2.", "*", "\[ImaginaryI]", "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"dsCharReWigner", "[", 
             RowBox[{"[", 
              RowBox[{"iy", ",", "ix", ",", "1"}], "]"}], "]"}], "*", "y"}], 
           "-", 
           RowBox[{
            RowBox[{"dsCharReWigner", "[", 
             RowBox[{"[", 
              RowBox[{"iy", ",", "ix", ",", "2"}], "]"}], "]"}], "*", "x"}]}],
           ")"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"ix", ",", 
        RowBox[{
         RowBox[{"Dimensions", "[", "dsCharReWigner", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"iy", ",", 
        RowBox[{
         RowBox[{"Dimensions", "[", "dsCharImWigner", "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "\[IndentingNewLine]", 
     "]"}]}]}], ";"}]], "Input",
