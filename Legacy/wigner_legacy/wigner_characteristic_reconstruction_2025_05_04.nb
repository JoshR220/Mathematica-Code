Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"create", " ", "colored", " ", "image"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ColorImage", "[", "data_List", "]"}], ":=", 
    RowBox[{"With", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"dataRGB", "=", 
        RowBox[{"Map", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"List", "@@", 
            RowBox[{"colorFunc", "[", "#", "]"}]}], "&"}], ",", 
          "\[IndentingNewLine]", 
          FractionBox["data", 
           RowBox[{"Max", "[", "data", "]"}]], ",", "\[IndentingNewLine]", 
          RowBox[{"{", "2", "}"}]}], "\[IndentingNewLine]", "]"}]}], "}"}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Return", "[", "\[IndentingNewLine]", 
        RowBox[{"Image", "[", 
         RowBox[{"dataRGB", ",", 
          RowBox[{"ImageSize", "->", 
           RowBox[{"Scaled", "[", "0.3", "]"}]}]}], "]"}], 
        "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}]}],
    ";"}]}]], "Input",
 CellChangeTimes->{{3.9543761708871202`*^9, 3.9543762573915377`*^9}, {
  3.954380563181697*^9, 3.9543805654833593`*^9}, {3.9543812505021815`*^9, 
