Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "subtract", " ", "offset", " ", "and", " ", "rescale", " ", "amplitude", 
    " ", "for", " ", "real"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"dsCharFitProcRe", "=", "dsCharRe"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"dsCharFitProcRe", "[", 
      RowBox[{"[", 
       RowBox[{";;", ",", ";;", ",", "3"}], "]"}], "]"}], "=", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"dsCharFitProcRe", "[", 
           RowBox[{"[", 
