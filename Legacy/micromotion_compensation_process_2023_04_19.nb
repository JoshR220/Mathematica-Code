   RowBox[{"create", " ", "plot", " ", "of", " ", "fitted", " ", "equation"}],
    "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"fitSinEqns", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"fitSinFunc", "@@", "#"}], "&"}], "/@", 
      RowBox[{"fittedParameters", "[", 
       RowBox[{"[", 
