  3.8776543082379303`*^9}},ExpressionUUID->"0669e6d7-a217-4e8e-94ae-\
6595f794e57c"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
    RowBox[{"fitSinFunc", "[", 
     RowBox[{"A_", ",", "\[Omega]_", ",", "\[Phi]_", ",", "C_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"A", "*", 
      RowBox[{"Sin", "[", 
       RowBox[{
        RowBox[{"\[Omega]", "*", "x"}], "+", "\[Phi]"}], "]"}]}], "+", 
     "C"}]}], ";"}], "*)"}]], "Input",
