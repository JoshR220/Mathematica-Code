            RowBox[{"[", 
             RowBox[{"1", ",", 
              RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], "}"}]}], "]"}], 
       "&"}], "/@", "fitSinEqns"}]}], ";"}]}], "*)"}]], "Input",
