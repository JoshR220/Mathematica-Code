 RowBox[{
  RowBox[{"(*", 
   RowBox[{"create", " ", "sinc", " ", "model", " ", "for", " ", "fitting"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"sincModel", "=", 
    RowBox[{
     RowBox[{
      FractionBox[
       SuperscriptBox["\[Alpha]", "2"], 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "-", "\[Beta]"}], ")"}], "2"], "+", 
        SuperscriptBox["\[Alpha]", "2"]}]], "*", 
      SuperscriptBox[
       RowBox[{"Sin", "[", 
        RowBox[{"\[Pi]", "*", "\[Gamma]", "*", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"x", "-", "\[Beta]"}], ")"}], "2"], "+", 
           SuperscriptBox["\[Alpha]", "2"]}], "]"}]}], "]"}], "2"]}], "+", 
     "\[Delta]"}]}], ";"}]}]], "Input",
 CellLabel->
  "In[5746]:=",ExpressionUUID->"168812f2-ddd8-41f6-aaca-452c30d9ac51"],

