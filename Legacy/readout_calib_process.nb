Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"play", " ", "sound", " ", "when", " ", "finished"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Done", "[", 
     RowBox[{
      RowBox[{"type_", ":", "\"\<email\>\""}], ",", 
      RowBox[{"msg_", ":", "\"\<\>\""}]}], "]"}], ":=", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"soundDJ", "=", 
        RowBox[{"Play", "[", 
         RowBox[{
          RowBox[{"Sin", "[", 
           RowBox[{"600", "*", "\[Pi]", "*", "t"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", "0.6"}], "}"}]}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Switch", "[", 
        RowBox[{"type", ",", "\[IndentingNewLine]", "\"\<text\>\"", ",", 
         RowBox[{"SendMessage", "[", 
          RowBox[{"\"\<SMS\>\"", ",", "msg"}], "]"}], ",", 
         "\[IndentingNewLine]", "\"\<email\>\"", ",", 
         RowBox[{"SendMail", "[", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<To\>\"", "\[Rule]", "\"\<claytonho@g.ucla.edu\>\""}],
             ",", 
            RowBox[{"\"\<Subject\>\"", "\[Rule]", 
             RowBox[{"ToString", "[", "$MachineName", "]"}]}], ",", 
            RowBox[{
            "\"\<From\>\"", "\[Rule]", "\"\<claytonho@physics.ucla.edu\>\""}],
             ",", 
