Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "return", " ", "sorted", " ", "peaks", " ", "from", " ", "a", " ", "2"}], 
    "-", 
    RowBox[{"D", " ", "list", " ", "of", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "y"}], "}"}]}]}], "*)"}], "\[IndentingNewLine]", 
  
  RowBox[{
   RowBox[{
    RowBox[{"CalculatePeaks", "[", 
     RowBox[{"dataset_", ",", 
      RowBox[{"\[Sigma]_", ":", "0.1"}], ",", 
      RowBox[{"s_", ":", "0"}], ",", 
      RowBox[{"t_", ":", "0"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"datasetPeaks", "=", 
        RowBox[{"FindPeaks", "[", 
         RowBox[{
          RowBox[{"dataset", "[", 
           RowBox[{"[", 
            RowBox[{";;", ",", "2"}], "]"}], "]"}], ",", "\[Sigma]", ",", "s",
           ",", "t"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "ensure", " ", "dataset", " ", "indices", " ", "from", " ", 
        "findpeaks", " ", "are", " ", "integers"}], "*)"}], 
