Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "select", " ", "file", " ", "with", " ", "give", " ", "RID", " ", "from", 
    " ", "all", " ", "subdirectories"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"filenamesAll", "=", 
     RowBox[{"FileNames", "[", 
      RowBox[{"\"\<*.h5\>\"", ",", "directoryString", ",", "Infinity"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "get", " ", "only", " ", "first", " ", "file", " ", "that", " ", 
     "matches"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"filenameDJ", "=", 
     RowBox[{"First", "@", 
      RowBox[{"Select", "[", 
       RowBox[{"filenamesAll", ",", 
        RowBox[{
         RowBox[{"StringContainsQ", "[", 
          RowBox[{"#", ",", 
           RowBox[{"ToString", "[", "ridDJ", "]"}]}], "]"}], "&"}]}], 
       "]"}]}]}], ";"}]}]}]], "Input",
