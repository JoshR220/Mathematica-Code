Cell[CellGroupData[{

Cell["Guess Modes", "Section",
 CellChangeTimes->{{3.889575646054837*^9, 
  3.889575650563376*^9}},ExpressionUUID->"d0e804dd-2eee-40f3-825a-\
ce6454a86aa5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"generate", " ", "combination", " ", "mode", " ", "frequencies"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Omega]Coefficients", "=", 
     RowBox[{"Tuples", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"-", "\[Omega]Order"}], ",", "\[Omega]Order"}], "]"}], ",", 
       RowBox[{"Length", "[", "\[Omega]Known", "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Omega]Coefficients", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"\[Omega]Coefficients", ",", 
       RowBox[{
        RowBox[{"0", "<", 
         RowBox[{"Total", "[", 
          RowBox[{"Abs", "/@", "#"}], "]"}], "<=", "\[Omega]Order"}], "&"}]}],
       "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Omega]Guess", "=", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{"\[Omega]Coefficients", ",", 
       RowBox[{"\[Omega]Coefficients", ".", 
        RowBox[{"Keys", "[", "\[Omega]Known", "]"}]}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.8895644262181063`*^9, 3.889564443486746*^9}, {
   3.8895644795347843`*^9, 3.889564480940523*^9}, {3.889565687553549*^9, 
   3.889565719158668*^9}, {3.889565816599762*^9, 3.889565821523332*^9}, {
   3.8895659120348597`*^9, 3.88956591438492*^9}, {3.889568831691969*^9, 
   3.8895688585165997`*^9}, {3.8895694620519857`*^9, 3.889569464032196*^9}, {
   3.889570651028905*^9, 3.889570653342575*^9}, 3.8895708209746304`*^9, {
   3.889570864305168*^9, 3.889570874854061*^9}, {3.889570936540893*^9, 
   3.889570936915017*^9}},
 CellLabel->
  "In[41710]:=",ExpressionUUID->"4c8d6479-e39d-4f82-8d57-0167f31baeec"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"find", " ", "likely", " ", "combination", " ", "modes"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Omega]Candidates", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Nearest", "[", 
        RowBox[{"\[Omega]Guess", ",", "#", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "\[Omega]Tolerance"}], "}"}]}], "]"}], "&"}], "/@", 
      RowBox[{"peakList", "[", 
       RowBox[{"[", 
        RowBox[{";;", ",", "1"}], "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Omega]Candidates", "=", 
     RowBox[{"%", "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "}"}], "->", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0"}], "}"}], "}"}]}], "}"}]}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.889566121210794*^9, 3.889566124720544*^9}, {
   3.889566209042623*^9, 3.8895662661934147`*^9}, {3.889566312975533*^9, 
