Cell[CellGroupData[{

Cell["Peak Figures", "Section",
 CellChangeTimes->{{3.889568973197994*^9, 3.889568974004417*^9}, {
  3.8895756601974077`*^9, 3.889575680478096*^9}, {3.889575853744841*^9, 
  3.8895758731171827`*^9}},ExpressionUUID->"d6ca2da3-8405-47e6-829e-\
bc7dedbe801f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"format", " ", "peak", " ", "data", " ", "for", " ", "plotting"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"peakPlotData", "=", 
     RowBox[{"MapThread", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Labeled", "[", 
         RowBox[{"#1", ",", "#2", ",", "Left"}], "]"}], "&"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"peakList", ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"First", "/@", "\[Omega]Candidates"}], ")"}], ".", 
          RowBox[{"(", 
           RowBox[{"Values", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Subscript", "[", 
               RowBox[{"\"\<n\>\"", ",", "#"}], "]"}], "&"}], "/@", 
             "\[Omega]Known"}], "]"}], ")"}]}]}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"format", " ", "peak", " ", "plot"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"peakPlot", "=", 
     RowBox[{"ListPlot", "[", "\[IndentingNewLine]", 
      RowBox[{"peakPlotData", ",", "\[IndentingNewLine]", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"Directive", "[", "\[IndentingNewLine]", 
         RowBox[{"Orange", ",", "\[IndentingNewLine]", 
          RowBox[{"PointSize", "[", "0.01", "]"}]}], "\[IndentingNewLine]", 
         "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.882305777128131*^9, 3.8823058018889236`*^9}, {
   3.882305862722*^9, 3.882305948232787*^9}, {3.882306026487815*^9, 
