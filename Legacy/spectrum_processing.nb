Cell[CellGroupData[{

Cell["Dataset Processing", "Subsection",
 CellChangeTimes->{{3.868057345094574*^9, 3.868057349780558*^9}, {
  3.868585602213936*^9, 3.868585604134692*^9}, {3.88864857707878*^9, 
  3.8886485802715816`*^9}},ExpressionUUID->"bace3437-f1c9-4ca2-9cf3-\
7f97e12c6f9e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"process", " ", "spectrum", " ", "dataset"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ProcessSpectrumDataset", "[", "filename_", "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"actual", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"dataRaw", "=", 
         RowBox[{"Import", "[", 
          RowBox[{"filename", ",", 
           RowBox[{"{", "\"\</datasets/results\>\"", "}"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", "dataProcessed"}], "\[IndentingNewLine]", 
       "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"process", " ", "dataset"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"dataRaw", "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", "1"}], "]"}], "]"}], "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"dataRaw", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "1"}], "]"}], "]"}], "*", "ftwToMHz"}], "-", 
           "carrierFreqMHz"}], ")"}], "*", "2"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "group", " ", "and", " ", "threshold", " ", "counts", " ", "into", 
         " ", "probability"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"dataProcessed", "=", 
        RowBox[{
         RowBox[{"GroupBy", "[", 
          RowBox[{"dataRaw", ",", 
           RowBox[{"First", "->", "Last"}], ",", 
           RowBox[{
            RowBox[{"Mean", "@", 
             RowBox[{"HeavisideTheta", "[", 
              RowBox[{"#", "-", "countsThreshold"}], "]"}]}], "&"}]}], "]"}], 
         "//", "KeySort"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"additional", " ", "processing"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"dataProcessed", "=", 
        RowBox[{
         RowBox[{"1", "-", "dataProcessed"}], "//", "N"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"clean", " ", "up", " ", "mess"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"Remove", "[", "dataRaw", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"ClearSystemCache", "[", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"ClearInOut", "[", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"return", " ", "dataset"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Keys", "[", "#", "]"}], ",", 
             RowBox[{"Values", "[", "#", "]"}]}], "}"}], "]"}], "&"}], "[", 
         "dataProcessed", "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.888648536682171*^9, 3.8886485726203203`*^9}, {
   3.888648758579917*^9, 3.8886487641404476`*^9}, {3.888649183505869*^9, 
   3.888649372846376*^9}, {3.888649432099969*^9, 3.888649434795904*^9}, {
