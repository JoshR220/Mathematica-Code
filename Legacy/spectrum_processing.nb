Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"formatted", " ", "data", " ", "for", " ", "peak", " ", "table"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"peakTableData", "=", 
     RowBox[{"MapThread", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#1", ",", "#2", ",", "#3", ",", 
          RowBox[{
           FractionBox[
            RowBox[{"Abs", "[", 
             RowBox[{"#1", "-", "#2"}], "]"}], "#1"], "*", "100"}]}], "}"}], 
        "&"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"peakList", "[", 
          RowBox[{"[", 
           RowBox[{";;", ",", "1"}], "]"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Apply", "[", 
          RowBox[{"\[Omega]Guess", ",", "\[Omega]Candidates", ",", 
           RowBox[{"{", "1", "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"First", "/@", "\[Omega]Candidates"}], ")"}], ".", 
          RowBox[{"(", 
           RowBox[{"Values", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Subscript", "[", 
               RowBox[{"\"\<n\>\"", ",", "#"}], "]"}], "&"}], "/@", 
             "\[Omega]Known"}], "]"}], ")"}]}]}], "\[IndentingNewLine]", 
        "}"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"peakTableHeadings", "=", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"\"\<Peak \>\"", "<>", 
          RowBox[{"ToString", "[", "#", "]"}]}], "&"}], "/@", 
        RowBox[{"Range", "[", 
         RowBox[{"Length", "[", "peakTableData", "]"}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
        "\"\<Actual Frequency (MHz)\>\"", ",", " ", 
         "\"\<Expected Frequency\>\"", ",", "\"\<Mode\>\"", ",", 
         "\"\<Error (%)\>\""}], "}"}]}], "\[IndentingNewLine]", "}"}]}], 
    ";"}]}]}]], "Input",
