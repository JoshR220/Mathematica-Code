  RowBox[{
   RowBox[{"spectrumPlot", "=", 
    RowBox[{"ListLinePlot", "[", "\[IndentingNewLine]", 
     RowBox[{"dataset", ",", "\[IndentingNewLine]", 
      RowBox[{"PlotRange", "->", "Full"}], ",", "\[IndentingNewLine]", 
