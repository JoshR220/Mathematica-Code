         RowBox[{"{", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
            "\"\<Population (\!\(\*SubscriptBox[\(D\), \(5/2\)]\))\>\"", ",", 
             
             RowBox[{"{", 
              RowBox[{"Black", ",", 
               RowBox[{"Directive", "[", "15", "]"}]}], "}"}]}], "]"}], ",", 
           "None"}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{"\"\<Frequency (MHz)\>\"", ",", 
             RowBox[{"{", 
              RowBox[{"Black", ",", 
               RowBox[{"Directive", "[", "15", "]"}]}], "}"}]}], "]"}], ",", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"\"\<Spectrum - RIDs: \>\"", "<>", 
              RowBox[{"ToString", "[", "ridDJ", "]"}]}], ",", 
