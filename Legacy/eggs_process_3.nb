Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"guess", " ", "sinc", " ", "model", " ", "fit", " ", "params"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Beta]RSBguess", ",", "\[Alpha]RSBguess"}], "}"}], "=", 
     RowBox[{"rsbDataset", "[", 
      RowBox[{"[", 
       RowBox[{"First", "@", 
        RowBox[{"Ordering", "[", 
         RowBox[{
          RowBox[{"rsbDataset", "[", 
           RowBox[{"[", 
            RowBox[{";;", ",", "2"}], "]"}], "]"}], ",", 
          RowBox[{"-", "1"}]}], "]"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Gamma]RSBguess", "=", 
     RowBox[{"timeHeatSeconds", "*", "1000"}]}], ";"}], 
   RowBox[{"(*", 
