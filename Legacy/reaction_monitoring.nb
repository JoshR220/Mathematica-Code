Cell[CellGroupData[{

Cell["Remove Background/Drifts", "Subsubsection",
 CellChangeTimes->{{3.8878463067778883`*^9, 
  3.887846311516354*^9}},ExpressionUUID->"c958390a-a184-440f-9e8c-\
aec9eebcbab7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"InterpolateTo", "[", 
    RowBox[{"dataset_", ",", "length_"}], "]"}], ":=", 
   RowBox[{"With", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"interpolatedDataset", "=", 
       RowBox[{"ListInterpolation", "[", 
        RowBox[{"dataset", ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"length", "+", "1"}]}], "}"}]}], "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"interpolatedDataset", "[", 
      RowBox[{"Range", "[", "length", "]"}], "]"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.887846648125103*^9, 3.887846694802917*^9}, {
  3.887846791027104*^9, 3.887846800590931*^9}, {3.887846849076194*^9, 
  3.887846886016122*^9}},
 CellLabel->
  "In[2909]:=",ExpressionUUID->"91326ec3-dff8-4e91-b6a1-6e5b9cd7b918"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BackgroundRemove", "[", 
    RowBox[{"dataset_", ",", "cutoff_"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"InterpolateTo", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"LowpassFilter", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"GaussianFilter", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"LowpassFilter", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"dataset", "[", 
               RowBox[{"[", 
                RowBox[{";;", ";;", 
                 RowBox[{"IntegerPart", "[", 
                  FractionBox["cutoff", "10"], "]"}]}], "]"}], "]"}], ",", 
              "\[IndentingNewLine]", 
              FractionBox["1", 
               RowBox[{"1.5", "*", "cutoff"}]]}], "\[IndentingNewLine]", 
             "]"}], "[", 
            RowBox[{"[", 
             RowBox[{";;", ";;", 
              RowBox[{"IntegerPart", "[", 
               FractionBox["cutoff", "4"], "]"}]}], "]"}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"cutoff", "*", "10"}], ",", "cutoff"}], "}"}]}], 
          "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
         FractionBox["1", 
          RowBox[{"1.5", "*", "cutoff"}]]}], "\[IndentingNewLine]", "]"}], 
       ",", 
       RowBox[{"Length", "[", "dataset", "]"}]}], "]"}]}], 
