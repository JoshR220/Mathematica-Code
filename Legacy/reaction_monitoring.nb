Cell[CellGroupData[{

Cell["Discriminate Dataset Distributions", "Subsubsection",
 CellChangeTimes->{{3.8878470310072393`*^9, 
  3.887847069878757*^9}},ExpressionUUID->"c938741c-e2a5-4bfd-ada3-\
3b4b2ee6ef43"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"DiscriminateDataset", "[", "dataset_", "]"}], ":=", 
   RowBox[{"With", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"thresholdValue", "=", 
       RowBox[{"FindThreshold", "[", "dataset", "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"HeavisideTheta", "[", 
      RowBox[{"dataset", "-", "thresholdValue"}], "]"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.887847049679634*^9, 3.887847138809731*^9}},
 CellLabel->
  "In[2941]:=",ExpressionUUID->"2968dde2-622d-4617-8c75-5776d622731d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"res3", "=", 
    RowBox[{"ParallelMap", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"DiscriminateDataset", "[", "#", "]"}], "&"}], ",", "res21"}], 
     "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"res4", "=", 
    RowBox[{"N", "[", 
     RowBox[{"Mean", "/@", "res3"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.887847140885399*^9, 3.887847194323989*^9}, {
  3.887847237266708*^9, 3.8878472964953833`*^9}, {3.887847341221924*^9, 
  3.887847343096266*^9}, {3.887847804287928*^9, 3.887847847255219*^9}, {
  3.887848102421351*^9, 3.8878481127784023`*^9}},
 CellLabel->
  "In[2955]:=",ExpressionUUID->"a942cd94-12c4-45f0-bf0e-8b40eebc6b7b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.447808`", ",", "Null"}], "}"}]], "Output",
 CellChangeTimes->{{3.887847838523511*^9, 3.887847851338573*^9}, 
