Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"plotsDiscriminated", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"FindThreshold", "[", 
         RowBox[{"res21", "[", 
          RowBox[{"[", "#", "]"}], "]"}], "]"}], ",", 
        RowBox[{"res4", "[", 
         RowBox[{"[", "#", "]"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
      
      RowBox[{"ListLinePlot", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"res21", "[", 
           RowBox[{"[", 
            RowBox[{"#", ",", 
             RowBox[{";;", ";;", "100"}]}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"res3", "[", 
            RowBox[{"[", 
             RowBox[{"#", ",", 
              RowBox[{";;", ";;", "100"}]}], "]"}], "]"}], "*", "10"}]}], 
         "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"PlotRange", "->", "Automatic"}], ",", "\[IndentingNewLine]", 
        
        RowBox[{"PlotStyle", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Opacity", "[", "1.0", "]"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"Opacity", "[", "0.7", "]"}], "}"}]}], "}"}]}]}], 
       "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Histogram", "[", 
       RowBox[{"res21", "[", 
        RowBox[{"[", "#1", "]"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
     "}"}], "&"}], "/@", 
   RowBox[{"Range", "[", 
    RowBox[{"Length", "[", "datasets", "]"}], "]"}]}]}]], "Input",
