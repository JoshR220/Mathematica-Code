               RowBox[{"[", 
                RowBox[{"3", ",", "1"}], "]"}], "]"}]}], 
             RowBox[{
              RowBox[{"bsbData", "[", 
               RowBox[{"[", 
                RowBox[{";;", ",", "2"}], "]"}], "]"}], "-", 
              RowBox[{"rsbFitParams", "[", 
               RowBox[{"[", 
                RowBox[{"3", ",", "1"}], "]"}], "]"}]}]], "]"}]}], 
          "\[IndentingNewLine]", "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
