        RowBox[{"\[Alpha]", ">", "0"}], ",", 
        RowBox[{"\[Beta]", ">", "0"}], ",", 
        RowBox[{
         RowBox[{"Abs", "[", "\[Gamma]", "]"}], "<", 
         FractionBox["\[Pi]", "2"]}]}], "*)"}], "}"}]}], ";"}]}]}]], "Input",
