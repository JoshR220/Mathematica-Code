Cell[CellGroupData[{

Cell["Sided Conversion", "Subsection",
 CellChangeTimes->{{3.868057345094574*^9, 3.868057349780558*^9}, {
  3.868585602213936*^9, 
  3.868585604134692*^9}},ExpressionUUID->"a21bb5b2-5527-4793-bcae-\
fc354c4ac04a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"convert", " ", "double"}], "-", 
    RowBox[{"sided", " ", "to", " ", "single"}], "-", "sided"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"GetSingleSidedX", "[", "data_List", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OddQ", "[", "#2", "]"}], ",", 
        RowBox[{"#1", "[", 
         RowBox[{"[", 
          RowBox[{";;", 
           FractionBox[
            RowBox[{"#2", "-", "1"}], "2"]}], "]"}], "]"}], ",", 
        RowBox[{"#1", "[", 
         RowBox[{"[", 
          RowBox[{";;", 
           FractionBox[
            RowBox[{"#2", "-", "2"}], "2"]}], "]"}], "]"}]}], "]"}], "&"}], 
     "[", 
     RowBox[{"data", ",", 
      RowBox[{"Length", "[", "data", "]"}]}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.868057351948847*^9, 3.868057422110368*^9}, {
  3.86805764013393*^9, 3.868057672667088*^9}, {3.868058265974622*^9, 
  3.868058266068492*^9}},
 CellLabel->
  "In[451]:=",ExpressionUUID->"6e38a0ca-d618-46a3-88ee-e1b9fba272c5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GetSingleSidedY", "[", "data_List", "]"}], ":=", 
   RowBox[{"With", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"trimmedData", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"OddQ", "[", "#2", "]"}], ",", 
           RowBox[{"#1", "[", 
            RowBox[{"[", 
             RowBox[{";;", 
              FractionBox[
               RowBox[{"#2", "-", "1"}], "2"]}], "]"}], "]"}], ",", 
           RowBox[{"#1", "[", 
            RowBox[{"[", 
             RowBox[{";;", 
              FractionBox[
               RowBox[{"#2", "-", "2"}], "2"]}], "]"}], "]"}]}], "]"}], "&"}],
         "[", 
        RowBox[{"data", ",", 
         RowBox[{"Length", "[", "data", "]"}]}], "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "*", "#1"}], "-", 
          RowBox[{
           RowBox[{"UnitVector", "[", 
            RowBox[{"#2", ",", "1"}], "]"}], "*", 
           RowBox[{"#1", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}]}], ")"}], "&"}], "[", 
       RowBox[{"trimmedData", ",", 
        RowBox[{"Length", "[", "trimmedData", "]"}]}], "]"}], "]"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.868057676527474*^9, 3.8680577668575373`*^9}, {
   3.868057926792749*^9, 3.868057936240552*^9}, {3.868058619396123*^9, 
   3.868058732253022*^9}, {3.8681140407194242`*^9, 3.868114041337182*^9}, 
   3.868254071501975*^9, {3.868585562824115*^9, 3.86858559408847*^9}},
 CellLabel->
  "In[452]:=",ExpressionUUID->"fe1e70ab-c82e-465a-9bcd-16b44a299fc1"]
}, Closed]],

Cell[CellGroupData[{

Cell["Dataset Processing", "Subsection",
 CellChangeTimes->{{3.868057345094574*^9, 3.868057349780558*^9}, {
  3.868585602213936*^9, 3.868585604134692*^9}, {3.88864857707878*^9, 
  3.8886485802715816`*^9}},ExpressionUUID->"5fa15fb7-4ede-4d15-9fef-\
4a5c9d4abc7a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "import", " ", "raw", " ", "counts", " ", "and", " ", "demodulate"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ProcessDatasetCounts", "[", "filename_", "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"actual", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"dataset", ",", "\[IndentingNewLine]", 
       RowBox[{"datasetFrequencies", "=", 
        RowBox[{"Import", "[", 
         RowBox[{"filename", ",", 
          RowBox[{"{", "\"\</datasets/xArr\>\"", "}"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"datasetCounts", "=", 
        RowBox[{"Import", "[", 
         RowBox[{"filename", ",", 
          RowBox[{"{", "\"\</datasets/results\>\"", "}"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", "correlatedSignal", ",", "correlatedAmplitude", 
       ",", "correlatedPhase", ",", "\[IndentingNewLine]", 
       RowBox[{"(*", "parameters", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"modulationAmplitude", "=", 
        RowBox[{"Import", "[", 
         RowBox[{"filename", ",", 
          RowBox[{"{", "\"\</datasets/modulation_amplitude_vpp\>\"", "}"}]}], 
         "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"shimVoltage", "=", 
        RowBox[{"Import", "[", 
         RowBox[{"filename", ",", 
          RowBox[{"{", "\"\</datasets/dc_channel_voltage\>\"", "}"}]}], 
         "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", "processing", "*)"}], "\[IndentingNewLine]", "results"}],
       "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"refine", " ", "dataset"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"dataset", "=", 
       RowBox[{"AssociationThread", "[", 
        RowBox[{"datasetFrequencies", "->", "datasetCounts"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"dataset", "=", 
         RowBox[{"KeySort", "[", "dataset", "]"}]}], ";"}], "*)"}], 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"demodulate", " ", "counts"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"correlatedSignal", "=", 
       RowBox[{"KeyValueMap", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          FractionBox[
           RowBox[{"Total", "[", 
            RowBox[{"Exp", "[", 
             RowBox[{"\[ImaginaryI]", "*", 
              RowBox[{"(", 
               RowBox[{"2", "*", "\[Pi]", "*", "#1", "*", "1*^6"}], ")"}], 
              "*", "#2"}], "]"}], "]"}], 
           RowBox[{"Length", "[", "#2", "]"}]], "&"}], ",", 
         "\[IndentingNewLine]", "dataset"}], "\[IndentingNewLine]", "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"correlatedAmplitude", ",", "correlatedSignal"}], "}"}], "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"AbsArg", "[", "correlatedSignal", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"format", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"results", "=", 
       RowBox[{"Transpose", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"datasetFrequencies", ",", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"shimVoltage", ",", 
              RowBox[{"Length", "[", "correlatedAmplitude", "]"}]}], "]"}], 
            ",", "##"}], "}"}], "&"}], "@@", 
         RowBox[{"{", 
          RowBox[{"correlatedAmplitude", ",", "correlatedSignal"}], "}"}]}], 
