Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "import", " ", "dataset", " ", "from", " ", "dir", " ", "and", " ", 
     "filename"}], ",", " ", 
    RowBox[{"return", " ", "dataset", " ", "and", " ", "parameters"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ImportDatasetARTIQ", "[", 
     RowBox[{"filedir_String", ",", 
      RowBox[{"ridName", ":", 
       RowBox[{"(", 
        RowBox[{"_String", "|", "_Integer"}], ")"}]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"filenamesAll", ",", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "select", " ", "file", " ", "with", " ", "give", " ", "RID", " ", 
          "from", " ", "all", " ", "subdirectories"}], "*)"}], 
        "\[IndentingNewLine]", "filenameDJ", ",", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"dataset", " ", "values"}], "*)"}], "\[IndentingNewLine]", 
        "datasetRaw", ",", "\[IndentingNewLine]", "parameterList"}], 
       "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"ensure", " ", "import", " ", "directory", " ", "exists"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"DirectoryQ", "[", "filedir", "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "stop", " ", "execution", " ", "if", " ", "import", " ", 
           "directory", " ", 
           RowBox[{"doesn", "'"}], "t", " ", "exist"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"MessageDialog", "[", 
           RowBox[{
           "\"\<Failure :(\\nError: Import directory not found (\>\"", "<>", 
            "filedir", "<>", "\"\<).\>\""}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
          "FrontEndTokenExecute", "[", "\"\<EvaluatorAbort\>\"", "]"}]}], ",",
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "get", " ", "all", " ", "files", " ", "in", " ", "directory"}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"filenamesAll", "=", 
           RowBox[{"FileNames", "[", 
            RowBox[{"\"\<*.h5\>\"", ",", "filedir", ",", "Infinity"}], 
            "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"ensure", " ", "desired", " ", "file", " ", "exists"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"filenameDJ", "=", 
        RowBox[{"SelectFirst", "[", "\[IndentingNewLine]", 
         RowBox[{"filenamesAll", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"StringContainsQ", "[", 
            RowBox[{"#", ",", 
             RowBox[{"ToString", "[", "ridName", "]"}]}], "]"}], "&"}]}], 
         "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"stop", " ", "execution", " ", "if", " ", "file", " ", 
         RowBox[{"doesn", "'"}], "t", " ", "exist"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"FileExistsQ", "[", "filenameDJ", "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"MessageDialog", "[", 
           RowBox[{
           "\"\<Failure :(\\nError: Specified file not found (\>\"", "<>", 
            "filenameDJ", "<>", "\"\<).\>\""}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
          "FrontEndTokenExecute", "[", "\"\<EvaluatorAbort\>\"", "]"}]}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "extract", " ", "file", " ", "results", " ", "as", " ", "list", " ", 
         "and", " ", "parameters", " ", "as", " ", "an", " ", "association"}],
         "*)"}], "\[IndentingNewLine]", 
       RowBox[{"datasetRaw", "=", 
        RowBox[{"Import", "[", 
         RowBox[{"filenameDJ", ",", 
          RowBox[{"{", "\"\</datasets/results\>\"", "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"parameterList", "=", 
        RowBox[{"Import", "[", 
         RowBox[{"filenameDJ", ",", 
          RowBox[{"{", 
           RowBox[{"\"\<Attributes\>\"", ",", "\"\</arguments\>\""}], "}"}]}],
          "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{"datasetRaw", ",", "parameterList"}], "}"}], "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.902692277675261*^9, 3.902692347651432*^9}, {
