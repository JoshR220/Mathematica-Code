  3.902773828301989*^9}},ExpressionUUID->"0f1d6dba-30b3-4297-b360-\
d66bb2c31dd9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"eggs", " ", "batch", " ", "processing", " ", "full"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"th0", "=", 
     RowBox[{"ImportDatasetARTIQ", "[", 
      RowBox[{"directoryString", ",", 
       RowBox[{"ToString", "[", "rid", "]"}]}], "]"}]}], ";", "\n", 
    RowBox[{"th1", "=", 
     RowBox[{"CollateData", "[", 
      RowBox[{"th0", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"th2", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"th0", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "[", "\"\<time_eggs_heating_ms\>\"", 
       "]"}], "*", "1.*^-3"}]}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"yz0", "=", 
     RowBox[{"th0", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"yz0", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", "yz0", "]"}], "*", 
       RowBox[{"{", 
        RowBox[{
        "ftwToFrequencyMHz", ",", "1.", ",", "1.*^-6", ",", "1.*^-3"}], 
        "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"yz0", "=", 
     RowBox[{"ThresholdCounts", "[", 
      RowBox[{"yz0", ",", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"yz0", "=", 
     RowBox[{"CollateData", "[", 
      RowBox[{"yz0", ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "4"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]",
     "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"process", " ", "rsb"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"yz10", "=", 
     RowBox[{
      RowBox[{"yz0", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "//", "Values"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"yz10", "=", 
     RowBox[{"yz10", "[", 
      RowBox[{"[", 
       RowBox[{";;", ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "2"}], "}"}]}], "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"yz10", "=", 
     RowBox[{"SortBy", "[", 
      RowBox[{"yz10", ",", "First"}], "]"}]}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"process", " ", "bsb"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"yz11", "=", 
     RowBox[{
      RowBox[{"yz0", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "//", "Values"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"yz11", "=", 
     RowBox[{"yz11", "[", 
      RowBox[{"[", 
       RowBox[{";;", ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "2"}], "}"}]}], "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"yz11", "=", 
     RowBox[{"SortBy", "[", 
      RowBox[{"yz11", ",", "First"}], "]"}]}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"fit", " ", "rsb"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"yz20", "=", 
     RowBox[{"FitSinc", "[", 
      RowBox[{"yz10", ",", "th2"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"%", "//", 
      RowBox[{"MatrixForm", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Show", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"ListPlot", "[", "yz10", "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Plot", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"SincModel", "[", 
              RowBox[{"##", ",", "th2", ",", "\[Delta]"}], "]"}], "&"}], "@@", 
            RowBox[{"yz20", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "1"}], "]"}], "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"\[Delta]", ",", 
             RowBox[{"yz10", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
             RowBox[{"yz10", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], "}"}]}], 
          "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"subtract", " ", "background", " ", "and", " ", "create", " ", 
         FractionBox["rsb", "bsb"], " ", "ratio", " ", "array"}], "*)"}], 
       "\[IndentingNewLine]", "yz21"}]}], "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"yz10", "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", "1"}], "]"}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Ramp", "[", 
         FractionBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"yz10", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "2"}], "]"}], "]"}], "-", 
            RowBox[{"yz20", "[", 
             RowBox[{"[", 
              RowBox[{"3", ",", "1"}], "]"}], "]"}]}], ")"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"yz11", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "2"}], "]"}], "]"}], "-", 
            RowBox[{"yz20", "[", 
             RowBox[{"[", 
              RowBox[{"3", ",", "1"}], "]"}], "]"}]}], ")"}]], "]"}]}], 
       "\[IndentingNewLine]", "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "convert", " ", "to", " ", "phonon", " ", "number", " ", "assuming", " ",
       "coherent", " ", "state"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"yz22", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"yz21", "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", "1"}], "]"}], "]"}], ",", 
        RowBox[{"CoherentC", "[", 
         RowBox[{"yz21", "[", 
          RowBox[{"[", 
           RowBox[{";;", ",", "2"}], "]"}], "]"}], "]"}]}], "}"}], "]"}]}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"fit", " ", "sinc", " ", "to", " ", "phonon", " ", "number"}], 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{"yz23", "=", 
     RowBox[{"FitSinc", "[", 
      RowBox[{"yz22", ",", "th2"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"%", "//", 
     RowBox[{"MatrixForm", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Show", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ListPlot", "[", "yz22", "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Plot", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"SincModel", "[", 
             RowBox[{"##", ",", "th2", ",", "\[Delta]"}], "]"}], "&"}], "@@", 
           RowBox[{"yz23", "[", 
            RowBox[{"[", 
             RowBox[{";;", ",", "1"}], "]"}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"\[Delta]", ",", 
            RowBox[{"yz22", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
            RowBox[{"yz22", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], "}"}]}], 
