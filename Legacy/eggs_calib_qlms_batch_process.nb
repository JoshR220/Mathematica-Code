Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"threshold", " ", "counts", " ", "into", " ", "s"}], "-", 
    RowBox[{"state", " ", "vs", " ", "d"}], "-", 
    RowBox[{"state", " ", "probability"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ThresholdCounts", "[", 
     RowBox[{"dataset_List", ",", "countsColumn_Integer"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "find", " ", "state", " ", "discrimination", " ", "threshold"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"countThreshold", "=", 
         RowBox[{"FindThreshold", "[", 
          RowBox[{
           RowBox[{"dataset", "[", 
            RowBox[{"[", 
             RowBox[{";;", ",", "countsColumn"}], "]"}], "]"}], ",", 
           RowBox[{"Method", "->", "\"\<MinimumError\>\""}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"results", "=", "dataset"}]}], "\[IndentingNewLine]", "}"}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "directly", " ", "threshold", " ", "counts", " ", "into", " ", "D"}], 
        "-", 
        RowBox[{"state", " ", "probability"}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"results", "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", "countsColumn"}], "]"}], "]"}], "=", 
        RowBox[{"1.", "-", 
         RowBox[{"UnitStep", "[", 
          RowBox[{
