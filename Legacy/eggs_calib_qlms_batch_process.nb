095a781eafe9"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "batch", " ", "process", " ", "eggs", " ", "data", " ", "for", " ", 
     "calibration", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"i", ".", "e", ".", " ", "w"}], "/", " ", "sideband"}], " ", 
       "sweep"}], ")"}]}], ",", " ", 
    RowBox[{"returning", " ", "relevant", " ", "values"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ProcessDatasetEGGS", "[", 
     RowBox[{"filedir_", ",", "filekey_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"actual", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"datafile", "=", 
          RowBox[{"ImportDatasetARTIQ", "[", 
           RowBox[{"filedir", ",", 
            RowBox[{"ToString", "[", "filekey", "]"}]}], "]"}]}], ","}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{
       "datafile", ",", "\[IndentingNewLine]", "heatingTimeSeconds", ",", 
        "\[IndentingNewLine]", 
        RowBox[{"results", "=", 
         RowBox[{"<|", "|>"}]}], ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", "processing", "*)"}], "\[IndentingNewLine]", 
        "datasetProcessed", ",", "\[IndentingNewLine]", "rsbData", ",", 
        "bsbData", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", "analysis", "*)"}], "\[IndentingNewLine]", 
        "sidebandRatio", ",", "phononData", ",", "\[IndentingNewLine]", 
        "rsbFitParams", ",", "phononFitParams"}], "\[IndentingNewLine]", 
       "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"import", " ", "dataset"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"datafile", "=", 
        RowBox[{"ImportDatasetARTIQ", "[", 
         RowBox[{"filedir", ",", 
          RowBox[{"ToString", "[", "filekey", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "extract", " ", "heating", " ", "time", " ", "from", " ", "parameter",
          " ", "list"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"heatingTimeSeconds", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"datafile", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "[", 
          "\"\<time_eggs_heating_ms\>\"", "]"}], "*", "ms"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "convert", " ", "dataset", " ", "into", " ", "correct", " ", 
         "units"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"datasetProcessed", "=", 
        RowBox[{"Transpose", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"datafile", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], "*", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
           "ftwToFrequencyMHz", ",", "1.", ",", "1.*^-6", ",", "1.*^-3"}], 
           "}"}]}], "\[IndentingNewLine]", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "threshold", " ", "ion", " ", "fluorescence", " ", "counts", " ", 
          "into", " ", "D"}], "-", 
         RowBox[{"state", " ", "probability"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"datasetProcessed", "=", 
        RowBox[{"ThresholdCounts", "[", 
         RowBox[{"datasetProcessed", ",", "2"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"collate", " ", "data", " ", "by", " ", 
         RowBox[{"rsb", "/", "bsb"}], " ", "and", " ", "sideband", " ", 
         "frequency"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"datasetProcessed", "=", 
        RowBox[{"CollateData", "[", 
         RowBox[{"datasetProcessed", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "4"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"separate", " ", 
          RowBox[{"rsb", "/", "bsb"}], " ", "data", " ", "as", " ", "2"}], 
         "-", 
         RowBox[{"D", " ", "datasetss"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"rsbData", ",", "bsbData"}], "}"}], "=", 
        RowBox[{
         RowBox[{
          RowBox[{"SortBy", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"Values", "[", "#", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", 
               RowBox[{"{", 
                RowBox[{"4", ",", "2"}], "}"}]}], "]"}], "]"}], ",", 
            "\[IndentingNewLine]", "First"}], "\[IndentingNewLine]", "]"}], 
          "&"}], "/@", 
         RowBox[{"Values", "[", "datasetProcessed", "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"fit", " ", "rsb"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"rsbFitParams", "=", 
        RowBox[{"FitSinc", "[", 
         RowBox[{"rsbData", ",", "heatingTimeSeconds"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"add", " ", "intermediate", " ", "results"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"AssociateTo", "[", 
        RowBox[{"results", ",", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"todo", ":", " ", 
            RowBox[{"plot", " ", "style"}]}], ",", " ", 
           RowBox[{"axes", " ", "units"}]}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"\"\<ParameterList\>\"", "->", 
            RowBox[{"datafile", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"\"\<BSBData\>\"", "->", "bsbData"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"\"\<RSBData\>\"", "->", "rsbData"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"\"\<RSBFitParams\>\"", "->", "rsbFitParams"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"\"\<SBPlot\>\"", "->", 
            RowBox[{"Show", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"ListPlot", "[", "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"rsbData", ",", "bsbData"}], "}"}], 
               "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{"Plot", "[", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"SincModel", "[", 
                   RowBox[{"##", ",", "heatingTimeSeconds", ",", "\[Delta]"}],
                    "]"}], "&"}], "@@", 
                 RowBox[{"rsbFitParams", "[", 
                  RowBox[{"[", 
                   RowBox[{";;", ",", "1"}], "]"}], "]"}]}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{"{", 
                 RowBox[{"\[Delta]", ",", 
                  RowBox[{"rsbData", "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
                  RowBox[{"rsbData", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], "}"}]}], 
               "\[IndentingNewLine]", "]"}]}], "]"}]}]}], 
          "\[IndentingNewLine]", "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"subtract", " ", "background", " ", "and", " ", "create", " ", 
         FractionBox["rsb", "bsb"], " ", "ratio", " ", "array"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"sidebandRatio", "=", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"rsbData", "[", 
            RowBox[{"[", 
             RowBox[{";;", ",", "1"}], "]"}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"Ramp", "[", 
            FractionBox[
             RowBox[{
              RowBox[{"rsbData", "[", 
               RowBox[{"[", 
                RowBox[{";;", ",", "2"}], "]"}], "]"}], "-", 
              RowBox[{"rsbFitParams", "[", 
               RowBox[{"[", 
                RowBox[{"3", ",", "1"}], "]"}], "]"}]}], 
             RowBox[{
              RowBox[{"bsbData", "[", 
               RowBox[{"[", 
                RowBox[{";;", ",", "2"}], "]"}], "]"}], "-", 
              RowBox[{"rsbFitParams", "[", 
               RowBox[{"[", 
                RowBox[{"3", ",", "1"}], "]"}], "]"}]}]], "]"}]}], 
          "\[IndentingNewLine]", "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "convert", " ", "to", " ", "phonon", " ", "number", " ", "assuming", 
         " ", "coherent", " ", "state"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"phononData", "=", "sidebandRatio"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"phononData", "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", "2"}], "]"}], "]"}], "=", 
        RowBox[{"CoherentC", "[", 
         RowBox[{"sidebandRatio", "[", 
          RowBox[{"[", 
           RowBox[{";;", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"fit", " ", "sinc", " ", "to", " ", "phonon", " ", "number"}],
         "*)"}], "\[IndentingNewLine]", 
       RowBox[{"phononFitParams", "=", 
        RowBox[{"FitSinc", "[", 
         RowBox[{"sidebandRatio", ",", "heatingTimeSeconds"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "add", " ", "intermediate", " ", "computations", " ", "to", " ", 
         "output"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"AssociateTo", "[", 
        RowBox[{"results", ",", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"todo", ":", " ", 
            RowBox[{"plot", " ", "style"}]}], ",", " ", 
           RowBox[{"axes", " ", "units"}]}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"\"\<SidebandRatioData\>\"", "->", "sidebandRatio"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"\"\<PhononData\>\"", "->", "phononData"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"\"\<PhononFitParams\>\"", "->", "phononFitParams"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"\"\<PhononPlot\>\"", "->", 
            RowBox[{"Show", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"ListPlot", "[", "phononData", "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"Plot", "[", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"SincModel", "[", 
                   RowBox[{"##", ",", "heatingTimeSeconds", ",", "\[Delta]"}],
                    "]"}], "&"}], "@@", 
                 RowBox[{"phononFitParams", "[", 
                  RowBox[{"[", 
                   RowBox[{";;", ",", "1"}], "]"}], "]"}]}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{"{", 
                 RowBox[{"\[Delta]", ",", 
                  RowBox[{"phononData", "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
                  RowBox[{"phononData", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], "}"}]}], 
               "\[IndentingNewLine]", "]"}]}], "]"}]}]}], 
          "\[IndentingNewLine]", "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"clean", " ", "up", " ", "mess"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"Remove", "[", 
        RowBox[{
        "datafile", ",", "datasetProcessed", ",", "rsbData", ",", "bsbData", 
         ",", "sidebandRatio", ",", "phononData", ",", "rsbFitParams", ",", 
         "phononFitParams"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Remove", "[", "datafile", "]"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"ClearSystemCache", "[", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"return", " ", "dataset"}], "*)"}], "\[IndentingNewLine]", 
