            RowBox[{"\[ImaginaryI]", "*", 
             RowBox[{"(", 
              RowBox[{
              "2", "*", "\[Pi]", "*", "modulationFrequencies", "*", "1*^6"}], 
              ")"}], "*", 
             RowBox[{"(", "#2", ")"}]}], "-", 
            RowBox[{"\[ImaginaryI]", "*", "phaseOffsetDJ"}]}], "]"}], "]"}], 
         RowBox[{"Length", "[", "#2", "]"}]], "&"}], ",", 
       "\[IndentingNewLine]", "datasets"}], "\[IndentingNewLine]", "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"correlatedAmplitude", ",", "correlatedPhase"}], "}"}], "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"AbsArg", "[", "correlatedSignal", "]"}], "]"}]}], 
    ";"}]}]}]], "Input",
