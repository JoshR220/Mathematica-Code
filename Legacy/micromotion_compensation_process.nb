Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "associate", " ", "demodulated", " ", "data", " ", "with", " ", "dataset", 
    " ", "keys"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"correlatedAmplitudeSorted", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"datasetKeys", ",", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", "correlatedAmplitude", "}"}], "]"}], ",", "2"}], "]"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"correlatedPhaseSorted", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"datasetKeys", ",", 
