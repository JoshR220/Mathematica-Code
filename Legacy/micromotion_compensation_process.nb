Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GetSingleSidedY", "[", "data_List", "]"}], ":=", 
   RowBox[{"With", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"trimmedData", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"OddQ", "[", "#2", "]"}], ",", 
           RowBox[{"#1", "[", 
            RowBox[{"[", 
             RowBox[{";;", 
              FractionBox[
               RowBox[{"#2", "-", "1"}], "2"]}], "]"}], "]"}], ",", 
           RowBox[{"#1", "[", 
            RowBox[{"[", 
             RowBox[{";;", 
              FractionBox[
               RowBox[{"#2", "-", "2"}], "2"]}], "]"}], "]"}]}], "]"}], "&"}],
         "[", 
        RowBox[{"data", ",", 
         RowBox[{"Length", "[", "data", "]"}]}], "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "*", "#1"}], "-", 
          RowBox[{
           RowBox[{"UnitVector", "[", 
            RowBox[{"#2", ",", "1"}], "]"}], "*", 
           RowBox[{"#1", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}]}], ")"}], "&"}], "[", 
       RowBox[{"trimmedData", ",", 
        RowBox[{"Length", "[", "trimmedData", "]"}]}], "]"}], "]"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.868057676527474*^9, 3.8680577668575373`*^9}, {
