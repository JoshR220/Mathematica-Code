   RowBox[{
   "combine", " ", "raw", " ", "data", " ", "into", " ", "single", " ", 
    "list"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"datasets", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"AssociationThread", "[", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "->", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "&"}], "/@", 
      "datafilesRaw"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"datasets", "=", 
     RowBox[{"Merge", "[", 
      RowBox[{"datasets", ",", 
       RowBox[{
        RowBox[{"Join", "@@", "#"}], "&"}]}], "]"}]}], ";"}]}]}]], "Input",
