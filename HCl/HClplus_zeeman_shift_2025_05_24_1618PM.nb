Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Transition", " ", "moment"}], ";", " ", 
    RowBox[{
     RowBox[{"Doesn", "'"}], "t", " ", "include", " ", "parity", " ", 
     "check"}], ";", " ", 
    RowBox[{
    "leaving", " ", "out", " ", "reduced", " ", "matrix", " ", "element"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"\[Mu]", "[", 
    RowBox[{
    "Fp_", ",", "mFp_", ",", "F1p_", ",", "F_", ",", "mF_", ",", "F1_", ",", 
     "q_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"F", "-", "mF"}]], 
    RowBox[{"ThreeJSymbol", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"F", ",", 
        RowBox[{"-", "mF"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "q"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"Fp", ",", "mFp"}], "}"}]}], "]"}], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"Fp", "+", "F1", "+", "1", "+", 
      RowBox[{"1", "/", "2"}]}]], 
    SqrtBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "F"}], "+", "1"}], ")"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "Fp"}], "+", "1"}], ")"}]}]], 
    RowBox[{"SixJSymbol", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"F1p", ",", "Fp", ",", 
        RowBox[{"1", "/", "2"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"F", ",", "F1", ",", "1"}], "}"}]}], "]"}], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"F1p", " ", "+", " ", 
      RowBox[{"3", "/", "2"}], "+", "1", " ", "+", " ", 
      RowBox[{"3", "/", "2"}]}]], 
    SqrtBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "F1"}], "+", "1"}], ")"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "F1p"}], "+", "1"}], ")"}]}]], 
    RowBox[{"SixJSymbol", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"3", "/", "2"}], ",", "F1p", ",", 
        RowBox[{"3", "/", "2"}]}], "}"}], ",", 
      RowBox[{"{", 
