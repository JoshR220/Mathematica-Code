       RowBox[{
       "create", " ", "projector", " ", "onto", " ", "the", " ", "state", " ",
         "you", " ", "want"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"proj", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"ii", ",", "1", ",", 
           RowBox[{"Length", "[", "Ham", "]"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"proj", "[", 
        RowBox[{"[", "StateNumber", "]"}], "]"}], " ", "=", " ", "1"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Find", " ", "the", " ", "eigenvector", " ", "with", " ", "the", " ", 
        "maximum", " ", "projection", " ", "onto", " ", "the", " ", "desired",
         " ", "state"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"projEvecs", " ", "=", " ", 
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"ES", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ".", "proj"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pos", " ", "=", " ", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"Position", "[", 
          RowBox[{"projEvecs", ",", " ", 
           RowBox[{"Max", "[", "projEvecs", "]"}]}], "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"Return", "[", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ES", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "pos"}], "]"}], "]"}], ",", 
         RowBox[{"ES", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "pos"}], "]"}], "]"}]}], "}"}], "]"}]}], 
     "\[IndentingNewLine]", ")"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
