Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"Seems", " ", "reasonable", " ", "I", " ", 
   RowBox[{"guess", ".", " ", "need"}], " ", "to", " ", "automate", " ", 
   "this", " ", "transition", " ", 
   RowBox[{"stuff", ".", " ", "I"}], " ", "just", " ", "want", " ", "to", " ",
    "specify", " ", "the", " ", "states", " ", "and", " ", "have", " ", "it", 
   " ", "tell", " ", "me", " ", "all", " ", "the", " ", "possible", " ", "mF",
    " ", "trnsitions"}], "*)"}]], "Input",
