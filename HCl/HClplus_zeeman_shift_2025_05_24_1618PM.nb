Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
  "Function", " ", "to", " ", "find", " ", "states", " ", "that", " ", "have",
    " ", "the", " ", "desired", " ", "Q", "#s"}], "*)"}]], "Input",
