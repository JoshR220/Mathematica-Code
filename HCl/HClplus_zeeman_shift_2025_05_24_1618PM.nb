  "In[381]:=",ExpressionUUID->"601de08a-5eca-4142-aeb1-5a3852d091a1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"This", " ", "function"}], ",", " ", 
    RowBox[{"defined", " ", "above"}], ",", " ", 
    RowBox[{
    "gives", " ", "me", " ", "a", " ", "transition", " ", "if", " ", "I", " ",
      "give", " ", "it", " ", "the", " ", "index", " ", "of", " ", "the", " ",
      "state"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Transition", "[", 
     RowBox[{"indexUpper_", ",", "indexLower_", ",", " ", "BGauss_"}], "]"}], 
    " ", ":=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"StateEngergy", "[", 
       RowBox[{
        RowBox[{"Hmag", "[", 
         FractionBox["BGauss", "10000."], "]"}], ",", "indexUpper"}], "]"}], 
      "[", 
      RowBox[{"[", "1", "]"}], "]"}], "-", 
     RowBox[{
      RowBox[{"StateEngergy", "[", 
       RowBox[{
        RowBox[{"Hmag", "[", 
         FractionBox["BGauss", "10000."], "]"}], ",", "indexLower"}], "]"}], 
      "[", 
      RowBox[{"[", "1", "]"}], "]"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Now", " ", "I", " ", "need", " ", "a", " ", "function", " ", "that", " ",
      "searches", " ", "my", " ", "States", " ", "to", " ", "find", " ", 
     "all", " ", "the", " ", "indices", " ", "with", " ", "the", " ", 
     "approporiate", " ", "Q", 
     RowBox[{"#s", ".", " ", "I"}], " ", "just", " ", "want", " ", "to", " ", 
     "give", " ", "it", " ", "F"}], ",", "F1", ",", " ", 
    RowBox[{"parity", " ", "of", " ", "each", " ", 
     RowBox[{"level", "."}]}]}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.937047417251725*^9, 3.937047485950485*^9}},
