   3.9370542982051563`*^9},
 CellLabel->
  "In[383]:=",ExpressionUUID->"83ec83f4-d678-4972-abf9-3915d56e5977"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FindIndices", "[", 
   RowBox[{"F_", ",", "F1_", ",", "parity_"}], "]"}], " ", ":=", " ", 
  RowBox[{"(", " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"surviveF1", " ", "=", " ", 
     RowBox[{"Position", "[", 
      RowBox[{
       RowBox[{"\"\<F1\>\"", "/.", "States"}], ",", " ", "F1"}], "]"}]}], ";",
     "\[IndentingNewLine]", 
