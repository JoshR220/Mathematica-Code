Cell[TextData[{
 "Basis for lambda doubling| J\[CapitalOmega] \
\[PlusMinus]\[RightAngleBracket] = ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    SqrtBox["2"]], TraditionalForm]],ExpressionUUID->
  "82d46c88-1954-4eef-b095-78cae9c357ea"],
 "(|\[CapitalLambda] = 1; S,\[CapitalSigma]; J\[CapitalOmega] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "J"], TraditionalForm]],ExpressionUUID->
  "9bc5a21f-9f7b-47e3-b9d8-307444ba2de5"],
 "\[RightAngleBracket] \[PlusMinus] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    RowBox[{"J", "-", "S"}]], TraditionalForm]],ExpressionUUID->
  "9e8a0058-a1bf-4d46-b1b6-b9d82c115a92"],
 "|\[CapitalLambda] = -1; S,-\[CapitalSigma]; J-\[CapitalOmega] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "J"], TraditionalForm]],ExpressionUUID->
  "453815a9-448a-464c-b428-8788a3d8ba8e"],
 "\[RightAngleBracket])\nThe matrix elements are (all of these are diagonal \
in \[CapitalLambda] and \[CapitalOmega]):\n\
\[LeftAngleBracket]J\[CapitalOmega]\[PlusMinus]| H |J\[CapitalOmega] \
\[PlusMinus]\[RightAngleBracket] = ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]],ExpressionUUID->
  "3f0b4437-60ff-451a-b66b-0296af997f1a"],
 "(\[LeftAngleBracket]\[CapitalLambda] = 1; S,\[CapitalSigma]; J\
\[CapitalOmega] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "J"], TraditionalForm]],ExpressionUUID->
  "c9fbefbf-5cf8-47b4-90e8-7acae3f82641"],
 "| H |\[CapitalLambda] = 1; S,\[CapitalSigma]; J\[CapitalOmega] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "J"], TraditionalForm]],ExpressionUUID->
  "4cd710c6-3d41-4bee-a36e-c4c02c6df474"],
 "\[RightAngleBracket] +",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    RowBox[{
     RowBox[{"2", "J"}], "-", 
     RowBox[{"2", "S"}]}]], TraditionalForm]],ExpressionUUID->
  "870da9b3-d992-4ec7-95e4-793be3cd8111"],
 "\[LeftAngleBracket]\[CapitalLambda] = -1; S,-\[CapitalSigma]; J-\
\[CapitalOmega] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "J"], TraditionalForm]],ExpressionUUID->
  "1b0aca0e-23ea-40b3-ad19-fd8ac1b6c17a"],
 "| H |\[CapitalLambda] = -1; S,-\[CapitalSigma]; J-\[CapitalOmega] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "J"], TraditionalForm]],ExpressionUUID->
  "1e9d4070-21b8-4670-96c8-b6fcf461abcd"],
 "\[RightAngleBracket]\n2J -2S = 2*3/2 0- 2*1/2 =2\n\[LeftAngleBracket]J\
\[CapitalOmega]\[PlusMinus]| H |J\[CapitalOmega] \[PlusMinus]\
\[RightAngleBracket] = ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]],ExpressionUUID->
  "3af8eb05-3c51-4eb4-85be-0e3f38eec971"],
 "(\[LeftAngleBracket]\[CapitalLambda] = 1; S,\[CapitalSigma]; J\
\[CapitalOmega] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "J"], TraditionalForm]],ExpressionUUID->
  "0a05e511-b039-4bbb-8753-20c999fe2765"],
 "| H |\[CapitalLambda] = 1; S,\[CapitalSigma]; J\[CapitalOmega] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "J"], TraditionalForm]],ExpressionUUID->
  "058601dd-9fed-44d6-aa6a-c4441a92ada9"],
 "\[RightAngleBracket] ",
 Cell[BoxData[
  FormBox["+", TraditionalForm]],ExpressionUUID->
  "7c442fb1-f140-4158-9c3c-d45b426230fc"],
 "\[LeftAngleBracket]\[CapitalLambda] = -1; S,-\[CapitalSigma]; J-\
\[CapitalOmega] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "J"], TraditionalForm]],ExpressionUUID->
  "22fb0c72-eefd-42b5-8834-16751c22bedb"],
 "| H |\[CapitalLambda] = -1; S,-\[CapitalSigma]; J-\[CapitalOmega] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "J"], TraditionalForm]],ExpressionUUID->
  "08545638-e698-43c7-8eff-f0fbfbbe97c7"],
 "\[RightAngleBracket]"
}], "Text",
 CellChangeTimes->{{3.936896148066737*^9, 3.936896254724841*^9}, {
