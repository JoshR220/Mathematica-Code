Cell[BoxData[
 RowBox[{
  RowBox[{"fn", "[", "td_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Cos", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "*", "n"}], "+", "\[Beta]"}], ")"}], "*", "td"}], 
          "]"}], "-", 
         RowBox[{"Cos", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "*", "n"}], "+", "\[Beta]"}], ")"}], "*", 
           RowBox[{"(", 
            RowBox[{"td", "-", 
             RowBox[{"2", "*", "t0"}]}], ")"}]}], "]"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "*", "n"}], "+", "\[Beta]"}], ")"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", 
        RowBox[{"-", "ordhold"}], ",", "ordhold"}], "}"}]}], "]"}], "/.", 
    "\[Beta]hold"}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "\[Rule]", "ahold"}], ",", 
     RowBox[{"q", "\[Rule]", "qhold"}]}], "}"}]}]}]], "Input",
 CellChangeTimes->{{3.824567998551606*^9, 3.824568027814599*^9}, {
  3.824568122249679*^9, 3.8245681955728292`*^9}, {3.824568251536778*^9, 
  3.824568251900002*^9}, {3.82456830195755*^9, 3.824568334117009*^9}, {
