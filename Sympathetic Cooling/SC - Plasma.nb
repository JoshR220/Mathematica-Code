Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ri1", "[", "td_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{
      RowBox[{"rMat", "[", 
       RowBox[{"Ai1", ",", "Bi1", ",", 
        RowBox[{"ahold", "*", 
         RowBox[{"mi", "/", "mj"}]}], ",", 
        RowBox[{"qhold", "*", 
         RowBox[{"mi", "/", "mj"}]}], ",", "ordhold"}], "]"}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"t", "\[Rule]", 
         RowBox[{"td", "*", "0.5", "*", "wmhz", "*", "w"}]}], "/.", 
        "solnsMOTION"}], "}"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ri2", "[", "td_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{
      RowBox[{"rMat", "[", 
       RowBox[{"Ai2", ",", "Bi2", ",", 
        RowBox[{"ahold", "*", 
         RowBox[{"mi", "/", "mj"}]}], ",", 
        RowBox[{"qhold", "*", 
         RowBox[{"mi", "/", "mj"}]}], ",", "ordhold"}], "]"}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"t", "\[Rule]", 
         RowBox[{"td", "*", "0.5", "*", "wmhz", "*", "w"}]}], "/.", 
        "solnsMOTION"}], "}"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ui1", "[", "td_", "]"}], ":=", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"ri1", "[", "t", "]"}], ",", "t"}], "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{"t", "\[Rule]", "td"}], "}"}]}]}], ";", 
  RowBox[{
   RowBox[{"ui2", "[", "td_", "]"}], ":=", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"ri2", "[", "t", "]"}], ",", "t"}], "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{"t", "\[Rule]", "td"}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"iVals2", "=", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"ri1", "[", "0", "]"}], "\[Equal]", 
         RowBox[{"iIC", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"ui1", "[", "0", "]"}], "\[Equal]", 
         RowBox[{"iIC", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"Ai1", ",", "Bi1"}], "}"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";", 
  RowBox[{"Ai1", "=", 
   RowBox[{"Ai1", "/.", "iVals2"}]}], ";", 
  RowBox[{"Bi1", "=", 
   RowBox[{"Bi1", "/.", "iVals2"}]}], ";"}], "\[IndentingNewLine]"}], "Input",\

 CellChangeTimes->{{3.824548654969808*^9, 3.824548680889518*^9}, {
   3.824548743182137*^9, 3.8245487574331923`*^9}, {3.824552957631415*^9, 
   3.824552995573842*^9}, {3.824553027414044*^9, 3.824553049566599*^9}, {
