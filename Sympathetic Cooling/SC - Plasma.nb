Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"mathieu", " ", "trajectories"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"D2n", "[", "n_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"a", "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "*", "n"}], "+", "\[Beta]"}], ")"}], "^", "2"}]}], 
       ")"}], "/", "q"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"recur", "[", 
      RowBox[{"i_", ",", "stop_", ",", "dir_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"D2n", "[", 
          RowBox[{"i", "*", "dir"}], "]"}], "-", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"i", "\[GreaterEqual]", "stop"}], ",", "0", ",", 
           RowBox[{"recur", "[", 
            RowBox[{
             RowBox[{"i", "+", "1"}], ",", "stop", ",", "dir"}], "]"}]}], 
          "]"}]}], ")"}]}], "//", "FullSimplify"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"getBetaEQ", "[", 
      RowBox[{"ordD_", ",", "ordAQ_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Normal", "[", 
       RowBox[{"Series", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"a", "-", 
           RowBox[{"q", "*", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"recur", "[", 
               RowBox[{"1", ",", 
                RowBox[{"ordD", "+", "1"}], ",", "1"}], "]"}], "+", 
              RowBox[{"recur", "[", 
               RowBox[{"1", ",", 
                RowBox[{"ordD", "+", "1"}], ",", 
                RowBox[{"-", "1"}]}], "]"}]}], ")"}]}]}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"a", "\[Rule]", 
             RowBox[{"\[Epsilon]", "*", "a"}]}], ",", 
            RowBox[{"q", "\[Rule]", 
             RowBox[{"\[Epsilon]", "*", "q"}]}], ",", 
            RowBox[{"\[Beta]", "\[Rule]", 
             RowBox[{"\[Epsilon]", "*", "\[Beta]"}]}]}], "}"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Epsilon]", ",", "0", ",", 
           RowBox[{"ordAQ", "+", "1"}]}], "}"}]}], "]"}], "]"}], "/.", 
      RowBox[{"{", 
       RowBox[{"\[Epsilon]", "\[Rule]", "1"}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"solveMathieu", "[", 
     RowBox[{"ordD_", ",", "ordAQ_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Beta]", "^", "2"}], "\[Equal]", 
        RowBox[{"getBetaEQ", "[", 
         RowBox[{"ordD", ",", "ordAQ"}], "]"}]}], ",", "\[Beta]", ",", 
       "PositiveReals"}], "]"}], "//", "FullSimplify"}]}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "This", " ", "is", " ", "just", " ", "for", " ", "ease", " ", "of", " ", 
     "use"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rMat", "[", 
     RowBox[{"A0_", ",", "B0_", ",", "ad_", ",", "qd_", ",", "ord_"}], "]"}], 
    ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"C2n", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"recur", "[", 
            RowBox[{"#", ",", "ord", ",", "1"}], "]"}], "&"}], "/@", 
          RowBox[{"Range", "[", "ord", "]"}]}]}], ",", 
        RowBox[{"Cn2n", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"recur", "[", 
            RowBox[{"#", ",", "ord", ",", 
             RowBox[{"-", "1"}]}], "]"}], "&"}], "/@", 
          RowBox[{"Range", "[", "ord", "]"}]}]}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"C2n", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Apply", "[", 
           RowBox[{"Times", ",", 
            RowBox[{"C2n", "[", 
             RowBox[{"[", 
              RowBox[{";;", "#"}], "]"}], "]"}]}], "]"}], "&"}], "/@", 
         RowBox[{"Range", "[", "ord", "]"}]}]}], ";", 
       RowBox[{"Cn2n", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Apply", "[", 
           RowBox[{"Times", ",", 
            RowBox[{"Cn2n", "[", 
             RowBox[{"[", 
              RowBox[{";;", "#"}], "]"}], "]"}]}], "]"}], "&"}], "/@", 
         RowBox[{"Range", "[", "ord", "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"A0", "*", 
              RowBox[{"Cos", "[", 
               RowBox[{"\[Beta]", "*", "t"}], "]"}]}], "+", 
             RowBox[{"B0", "*", 
              RowBox[{"Sin", "[", 
               RowBox[{"\[Beta]", "*", "t"}], "]"}]}]}], ")"}], "+", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"C2n", "[", 
                RowBox[{"[", "n", "]"}], "]"}], "*", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"A0", "*", 
                  RowBox[{"Cos", "[", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"2", "*", "n"}], "+", "\[Beta]"}], ")"}], "*", 
                    "t"}], "]"}]}], "+", 
                 RowBox[{"B0", "*", 
                  RowBox[{"Sin", "[", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"2", "*", "n"}], "+", "\[Beta]"}], ")"}], "*", 
                    "t"}], "]"}]}]}], ")"}]}], "+", 
              RowBox[{
               RowBox[{"Cn2n", "[", 
                RowBox[{"[", "n", "]"}], "]"}], "*", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"A0", "*", 
                  RowBox[{"Cos", "[", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "2"}], "*", "n"}], "+", "\[Beta]"}], ")"}], 
                    "*", "t"}], "]"}]}], "+", 
                 RowBox[{"B0", "*", 
                  RowBox[{"Sin", "[", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "2"}], "*", "n"}], "+", "\[Beta]"}], ")"}], 
                    "*", "t"}], "]"}]}]}], ")"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"n", ",", "1", ",", "ord"}], "}"}]}], "]"}]}], "/.", 
          RowBox[{"Normal", "[", 
           RowBox[{"solveMathieu", "[", 
            RowBox[{"ord", ",", "ord"}], "]"}], "]"}]}], "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"a", "\[Rule]", "ad"}], ",", 
           RowBox[{"q", "\[Rule]", "qd"}]}], "}"}]}], "//", 
        "FullSimplify"}]}]}], "]"}]}]}]}]], "Input",
