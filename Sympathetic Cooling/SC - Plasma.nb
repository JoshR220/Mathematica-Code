Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "n_", "]"}], ":=", 
  RowBox[{
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", "\[CapitalDelta]pperp", ")"}], "^", "2"}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"b2", "\[Rule]", 
         RowBox[{
          RowBox[{"b0", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "+", "db"}]}], ",", 
        RowBox[{"b1", "\[Rule]", 
         RowBox[{
          RowBox[{"b0", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "-", "db"}]}]}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"ti", ",", "0", ",", 
       RowBox[{"n", "*", "tmax"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"tj", ",", "0", ",", 
       RowBox[{"n", "*", "tmax"}]}], "}"}]}], "]"}], "/", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"n", "*", "tmax"}], ")"}], "^", "2"}]}]}]], "Input",
 CellChangeTimes->{{3.8245872520754747`*^9, 3.824587326897381*^9}, {
  3.824587404079061*^9, 3.824587409560742*^9}, {3.824587636612154*^9, 
  3.8245876414952497`*^9}, {3.824589199884396*^9, 3.824589205229425*^9}, {
  3.824589801844935*^9, 3.82458987451623*^9}, {3.824590615324526*^9, 
  3.824590618267145*^9}, {3.824591110042807*^9, 3.8245911180706387`*^9}},
 CellLabel->
  "In[300]:=",ExpressionUUID->"122c9551-d1f3-4be0-a297-066a7cbd42ec"],

