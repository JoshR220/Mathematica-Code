Cell[BoxData[{
 RowBox[{
  RowBox[{"newAidBid", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"ri1", "[", "t0", "]"}], "\[Equal]", 
          RowBox[{"ri2", "[", "t0", "]"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"ui2", "[", "t0", "]"}], "-", 
           RowBox[{"ui1", "[", "t0", "]"}]}], "\[Equal]", "dphold"}]}], "}"}],
        ",", 
       RowBox[{"{", 
        RowBox[{"Ai2", ",", "Bi2"}], "}"}]}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{"dphold", "\[Rule]", "\[CapitalDelta]p"}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
