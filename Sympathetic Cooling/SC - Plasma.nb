   RowBox[{
    RowBox[{"Chop", "[", 
     RowBox[{"Ai2", "/.", "newAidBid"}], "]"}], "//", "Simplify"}]}], ";", 
  RowBox[{"Bi2", "=", 
   RowBox[{
    RowBox[{"Chop", "[", 
     RowBox[{"Bi2", "/.", "newAidBid"}], "]"}], "//", "Simplify"}]}], 
