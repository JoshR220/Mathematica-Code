  RowBox[{"rho", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"Num", "-", "1"}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"Pi", "*", 
      RowBox[{"b0", "[", 
       RowBox[{"[", 
        RowBox[{"-", "1"}], "]"}], "]"}], "*", 
      RowBox[{
       RowBox[{"(", "5*^-4", ")"}], "^", "2"}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
