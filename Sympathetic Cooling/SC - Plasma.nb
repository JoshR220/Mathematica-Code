        RowBox[{"{", 
         RowBox[{
          RowBox[{"ri", "\[Rule]", 
           RowBox[{"ri", "[", "ti", "]"}]}], ",", 
          RowBox[{"rj", "\[Rule]", 
           RowBox[{"rj", "[", "tj", "]"}]}], ",", 
          RowBox[{"ui", "\[Rule]", 
           RowBox[{"ui", "[", "ti", "]"}]}], ",", 
