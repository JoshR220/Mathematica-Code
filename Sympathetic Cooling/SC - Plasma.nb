 RowBox[{
  RowBox[{"iVals3", "=", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"ri", "[", "0", "]"}], "\[Equal]", 
         RowBox[{"iIC", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"0.5", "*", "mi", "*", 
          RowBox[{
           RowBox[{"ui", "[", "0", "]"}], "^", "2"}]}], "\[Equal]", 
         RowBox[{"0.5", "*", "kb", "*", "100"}]}]}], "}"}], ",", 
      RowBox[{"{", 
